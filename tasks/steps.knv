(export ->command command run!)

(defstruct command
  :desc str
  :dir str
  :cmd str
  :args (vec str))

(defn run! (step)
  (println "== " (:desc step))
  (if (run-command! (:dir step)
                    (:cmd step)
                    (clone (:args step)))
    (ok (do))
    (err (str (:desc step) " failed"))))

(def run-command!
  (rust "std::process::Command::new({1}).args({2}).current_dir({0}).status().map(|{!status}| {!status}.success()).unwrap_or(false)"
    (fn ((ref str) (ref str) (vec (ref str)))
      bool)))
