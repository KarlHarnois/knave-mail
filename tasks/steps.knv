(export ->command command run! run-all!)

(defstruct command
  :desc str
  :dir str
  :cmd str
  :args (vec str))

(type run-all!
  (fn ((ref (vec command)))
    (result unit string)))

(defn run-all! (commands)
  (loop (index 0)
    (match (get commands index)
      ((some cmd)
       (match (run! cmd)
         ((ok _) (recur (inc index)))
         ((err problem) (err problem))))
      (none (ok (do))))))

(defn run! (cmd)
  (println "== " (:desc cmd))
  (if (run-command! (:dir cmd)
                    (:cmd cmd)
                    (clone (:args cmd)))
    (ok (do))
    (err (str (:desc cmd) " failed"))))

(def run-command!
  (rust "std::process::Command::new({1}).args({2}).current_dir({0}).status().map(|{!status}| {!status}.success()).unwrap_or(false)"
    (fn ((ref str) (ref str) (vec (ref str)))
      bool)))
