(use steps ->command run!)

(def install-binary
  "install -Dm755 target/knave/knave-mail/knave-mail \"$HOME/.local/bin/knave-mail\"")

(deftask install ()
  "Builds the frontend and the release binary, then installs knave-mail to ~/.local/bin."
  (try (run! (->command :desc "frontend dependencies"
                        :dir "frontend"
                        :cmd "bun"
                        :args (vec "install" "--frozen-lockfile"))))
  (try (run! (->command :desc "frontend build"
                        :dir "frontend"
                        :cmd "bun"
                        :args (vec "run" "build"))))
  (try (run! (->command :desc "knave build --release"
                        :dir "."
                        :cmd "knave"
                        :args (vec "build" "--release"))))
  (try (run! (->command :desc "install to ~/.local/bin"
                        :dir "."
                        :cmd "sh"
                        :args (vec "-c" install-binary))))
  (ok (println "Installed knave-mail to ~/.local/bin/knave-mail.")))
