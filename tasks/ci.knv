(use steps ->command run!)

(def capped-bun-test
  "if systemd-run --user --scope --quiet true 2>/dev/null; then exec systemd-run --user --scope --quiet -p MemoryMax=3G bun test; else exec bun test; fi")

(deftask ci ()
  "Runs every check in order: formatting, file lengths, the frontend, the build, the knave tests and the GUI scenarios."
  (try (run! (->command :desc "knave fmt --check"
                        :dir "."
                        :cmd "knave"
                        :args (vec "fmt" "--check"))))
  (try (run! (->command :desc "file lengths"
                        :dir "."
                        :cmd "knave"
                        :args (vec "task" "check-file-lengths"))))
  (try (run! (->command :desc "frontend lint"
                        :dir "frontend"
                        :cmd "bun"
                        :args (vec "run" "lint"))))
  (try (run! (->command :desc "frontend typecheck"
                        :dir "frontend"
                        :cmd "bun"
                        :args (vec "run" "typecheck"))))
  (try (run! (->command :desc "frontend tests"
                        :dir "frontend"
                        :cmd "sh"
                        :args (vec "-c" capped-bun-test))))
  (try (run! (->command :desc "frontend build"
                        :dir "frontend"
                        :cmd "bun"
                        :args (vec "run" "build"))))
  (try (run! (->command :desc "knave build"
                        :dir "."
                        :cmd "knave"
                        :args (vec "build"))))
  (try (run! (->command :desc "knave tests"
                        :dir "."
                        :cmd "knave"
                        :args (vec "test"))))
  (try (run! (->command :desc "GUI scenarios"
                        :dir "."
                        :cmd "knave"
                        :args (vec "task" "e2e"))))
  (ok (println "All checks passed.")))
