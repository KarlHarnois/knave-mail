(theme :font "Iosevka"
       :message-font "Iosevka Aile"
       :font-size 14
       (light :background "#ffffff"
              :foreground "#0b0b0b"
              :muted "#555555"
              :border "#d4d4d4"
              :selection "#e8e8e8"
              :cursor "#0b0b0b"
              :accent "#0b0b0b"
              :error "#0b0b0b"
              :star "#0b0b0b"
              :status-bar "#f5f5f5"
              :html-mail "#ffffff")
       (dark :background "#0b0b0b"
             :foreground "#f5f5f5"
             :muted "#929292"
             :border "#3d3d3d"
             :selection "#262626"
             :cursor "#f5f5f5"
             :accent "#f5f5f5"
             :error "#f5f5f5"
             :star "#f5f5f5"
             :status-bar "#161616"
             :html-mail "#ffffff"))
