(use domain/queued-relabel ->relabel-request)
(use app/mail-app mail-app)
(use domain/freshness ->listing-request freshness)
(use adapters/driving/cli/cli-result cli-result)
(use adapters/driving/cli/command cli-command reply-scope)
(use adapters/driving/cli/help usage-text)

(use domain/mail ->draft ->message-ref ->thread-query
                 ->thread-ref draft thread-query
                 thread-summary)

(use domain/mail-error mail-error)

(use app/client/account-book add-account! list-accounts!
                             remove-account!)

(use app/client/mail-reader list-labels! list-threads!
                            open-thread!)

(use app/client/mail-writer draft! send-draft!)
(use domain/reply draft-kind)
(use adapters/driving/cli/waiting all-delivered)
(use app/client/mail-labeler relabel-threads!)
(use app/client/mail-syncer sync-account!)

(export ->cli-request cli-request run-cli-command! sending)

(defenum sending
  deliver
  preview)

(defstruct cli-request
  :command cli-command
  :account string
  :body string
  :sending sending)

(type run-cli-command!
  (fn ((mut mail-app) (ref cli-request))
    (result cli-result mail-error)))

(defn run-cli-command! (client request)
  (let (account (ref (:account request)))
    (match (ref (:command request))
      (list-accounts (ok (cli-result/accounts-listed (try (list-accounts!
                                                            client)))))
      (add-account (ok (cli-result/account-added (try (add-account! client)))))
      ((remove-account email)
       (do
         (try (remove-account! client email))
         (ok cli-result/done)))
      (list-labels (ok (cli-result/labels-listed (try (list-labels! client
                                                                    account)))))
      ((list-threads scope query limit freshness)
       (ok (cli-result/threads-listed
             (try (list-threads! client account
                                 (ref (->listing-request
                                        :threads (->thread-query (clone scope)
                                                                 (clone query)
                                                                 limit)
                                        :freshness (clone freshness))))))))
      ((show-thread thread-id format)
       (ok (cli-result/thread-shown
             (try (open-thread! client (ref (thread-in account thread-id))))
             (clone format))))
      ((send to cc subject)
       (deliver-or-show! client request
                         (->draft (clone to)
                                  (clone cc)
                                  (clone subject)
                                  (clone (:body request))
                                  none)))
      ((reply message-id scope)
       (let (drafted (try (draft! client
                                  (ref (message-in account message-id))
                                  (reply-kind scope))))
         (deliver-or-show! client request
                           (with-written-body drafted (ref (:body request))))))
      ((forward message-id to)
       (let (drafted (try (draft! client
                                  (ref (message-in account message-id))
                                  draft-kind/forward)))
         (deliver-or-show! client request
                           (assoc (with-written-body drafted
                                                     (ref (:body request)))
                                  :to (clone to)))))
      ((relabel change thread-ids)
       (do
         (try (relabel-threads! client
                                (ref (->relabel-request :account (str account)
                                                        :thread-ids (clone thread-ids)
                                                        :change (clone
                                                                  change)))))
         (all-delivered client account)))
      (sync (do
              (try (sync-account! client account))
              (ok cli-result/done)))
      (help (ok (cli-result/help-shown (usage-text)))))))

(type deliver-or-show!
  (fn ((mut mail-app) (ref cli-request) draft)
    (result cli-result mail-error)))

(defn deliver-or-show! (client request written)
  (match (:sending request)
    (preview (ok (cli-result/draft-shown written)))
    (deliver (do
               (try (send-draft! client
                                 (ref (:account request))
                                 (ref written)))
               (ok cli-result/done)))))

(defn reply-kind (scope)
  (match scope
    (sender draft-kind/reply)
    (everyone draft-kind/reply-all)))

(type with-written-body
  (fn (draft (ref str)) draft))

(defn with-written-body (drafted written)
  (let (body (str written (:body drafted)))
    (assoc drafted :body body)))

(defn message-in (account message-id)
  (->message-ref :account (str account)
                 :message-id (str message-id)))

(defn thread-in (account thread-id)
  (->thread-ref :account (str account)
                :thread-id (str thread-id)))
