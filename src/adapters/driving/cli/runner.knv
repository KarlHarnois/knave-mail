(use domain/freshness freshness)
(use adapters/driving/cli/cli-result cli-result)
(use adapters/driving/cli/command cli-command)
(use adapters/driving/cli/help usage-text)
(use adapters/driving/cli/label-words change-named)

(use domain/mail ->draft ->message-ref ->thread-query
                 ->thread-ref draft thread-query
                 thread-summary)

(use domain/mail-error mail-error)

(use ports/driving/account-book account-book add-account!
                                list-accounts!
                                remove-account!)

(use ports/driving/mail-reader list-labels! list-threads!
                               mail-reader open-thread!)

(use ports/driving/mail-writer draft! mail-writer
                               send-draft!)

(use domain/reply draft-kind)

(use ports/driving/mail-labeler mail-labeler
                                relabel-threads!)

(use ports/driving/mail-syncer mail-syncer sync-account!)

(export ->cli-request cli-request run-cli-command!)

(defstruct cli-request
  :command cli-command
  :account string
  :body string
  :dry-run bool)

(type run-cli-command!
  (where ((client account-book mail-reader mail-writer
                  mail-labeler mail-syncer))
    (fn ((mut client) (ref cli-request))
      (result cli-result mail-error))))

(defn run-cli-command! (client request)
  (let (account (ref (:account request)))
    (match (ref (:command request))
      (list-accounts (ok (cli-result/accounts-listed (try (list-accounts!
                                                            client)))))
      (add-account (ok (cli-result/account-added (try (add-account! client)))))
      ((remove-account email)
       (do
         (try (remove-account! client email))
         (ok cli-result/done)))
      (list-labels (ok (cli-result/labels-listed (try (list-labels! client
                                                                    account)))))
      ((list-threads label query limit fresh)
       (ok (cli-result/threads-listed
             (try (threads-for!
                    client account
                    (ref (->thread-query (clone label) (clone query) limit))
                    (deref fresh))))))
      ((show-thread thread-id format)
       (ok (cli-result/thread-shown
             (try (open-thread! client (ref (thread-in account thread-id))))
             (clone format))))
      ((send to cc subject)
       (deliver-or-show! client request
                         (->draft (clone to)
                                  (clone cc)
                                  (clone subject)
                                  (clone (:body request))
                                  none)))
      ((reply message-id all)
       (let (drafted (try (draft! client
                                  (ref (message-in account message-id))
                                  (if (deref all)
                                    draft-kind/reply-all
                                    draft-kind/reply))))
         (deliver-or-show! client request
                           (with-written-body drafted (ref (:body request))))))
      ((forward message-id to)
       (let (drafted (try (draft! client
                                  (ref (message-in account message-id))
                                  draft-kind/forward)))
         (deliver-or-show! client request
                           (assoc (with-written-body drafted
                                                     (ref (:body request)))
                                  :to (clone to)))))
      ((relabel change thread-ids)
       (do
         (try (relabel-threads! client account thread-ids
                                (ref (try (change-named change)))))
         (ok cli-result/done)))
      (sync (do
              (try (sync-account! client account))
              (ok cli-result/done)))
      (help (ok (cli-result/help-shown (usage-text)))))))

(type deliver-or-show!
  (where ((client mail-writer))
    (fn ((mut client) (ref cli-request) draft)
      (result cli-result mail-error))))

(defn deliver-or-show! (client request written)
  (if (:dry-run request)
    (ok (cli-result/draft-shown written))
    (do
      (try (send-draft! client
                        (ref (:account request))
                        (ref written)))
      (ok cli-result/done))))

(type with-written-body
  (fn (draft (ref str)) draft))

(defn with-written-body (drafted written)
  (let (body (str written (:body drafted)))
    (assoc drafted :body body)))

(type threads-for!
  (where ((client mail-reader))
    (fn ((mut client)
         (ref str)
         (ref thread-query)
         bool)
      (result (vec thread-summary) mail-error))))

(defn threads-for! (client account query fresh)
  (list-threads! client account query
                 (if fresh freshness/fresh freshness/cached)))

(defn message-in (account message-id)
  (->message-ref :account (str account)
                 :message-id (str message-id)))

(defn thread-in (account thread-id)
  (->thread-ref :account (str account)
                :thread-id (str thread-id)))
