(use adapters/driving/cli/cli-result cli-result)

(use adapters/driving/json/mail-json accounts-json
                                     draft-json labels-json
                                     summaries-json
                                     thread-json)

(use adapters/json/value empty-object json-value)
(use domain/mail-error error-kind error-message mail-error)

(export error-json-text result-json-text)

(def schema-version 1)

(defn result-json-text (outcome)
  (document-text schema-version (ref (result-json outcome))))

(defn result-json (outcome)
  (match outcome
    ((accounts-listed accounts) (accounts-json accounts))
    ((labels-listed labels) (labels-json labels))
    ((threads-listed summaries) (summaries-json summaries))
    ((thread-shown shown _) (thread-json shown))
    ((draft-shown written) (draft-json written))
    ((account-added account)
     (accounts-json (ref (vec (clone account)))))
    (done (empty-object))
    ((help-shown text) (text-json text))))

(defn error-json-text (failure)
  (error-document-text schema-version
                       (error-kind failure)
                       (error-message failure)))

(def document-text
  (rust "serde_json::json!({{\"schema\": {0}, \"result\": {1}}}).to_string()"
    (fn (i64 (ref json-value)) string)))

(def error-document-text
  (rust "serde_json::json!({{\"schema\": {0}, \"error\": {{\"kind\": {1}, \"message\": {2}}}}}).to_string()"
    (fn (i64 (ref str) (ref str)) string)))

(def text-json
  (rust "serde_json::Value::String({0}.clone())"
    (fn ((ref string)) json-value)))
