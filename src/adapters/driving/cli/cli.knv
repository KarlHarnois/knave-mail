(use adapters/driving/cli/arguments parsed-arguments switch?
                                    value-of)

(use adapters/driving/cli/cli-result cli-result)

(use adapters/driving/cli/command arguments->cli-command
                                  cli-command)

(use adapters/driving/cli/exit-codes exit-code success-code)

(use adapters/driving/cli/json-presenter cli-result->json-text
                                         mail-error->json-text)

(use adapters/driving/cli/runner ->cli-request
                                 run-cli-command! sending)

(use adapters/driving/cli/text-presenter cli-result->text)
(use domain/mail-error error-message mail-error)
(use app/client/account-book list-accounts!)
(use app/mail-app mail-app)

(export run-cli!)

(defenum cli-output
  text
  json)

(defstruct cli-options
  :account (option string)
  :sending sending
  :output cli-output)

(defn run-cli! (client parsed)
  (let (options (arguments->options parsed))
    (match (cli-outcome! client parsed (ref options))
      ((ok outcome)
       (do
         (print-result (:output options) (ref outcome))
         success-code))
      ((err failure)
       (do
         (print-failure (:output options) (ref failure))
         (exit-code (ref failure)))))))

(defn arguments->options (parsed)
  (->cli-options :account (value-of parsed "--account")
                 :sending (if (switch? parsed "--dry-run")
                            sending/preview sending/deliver)
                 :output (if (switch? parsed "--json")
                           cli-output/json
                           cli-output/text)))

(type cli-outcome!
  (fn ((mut mail-app)
       (ref parsed-arguments)
       (ref cli-options))
    (result cli-result mail-error)))

(defn cli-outcome! (client parsed options)
  (let (command (try (arguments->cli-command parsed))
        account (try (chosen-account! client
                                      (ref (:account options))
                                      (ref command)))
        body (try (body-for (ref command))))
    (run-cli-command! client
                      (ref (->cli-request :command command
                                          :account account
                                          :body body
                                          :sending (clone (:sending
                                                            options)))))))

(type chosen-account!
  (fn ((mut mail-app)
       (ref (option string))
       (ref cli-command))
    (result string mail-error)))

(defn chosen-account! (client account command)
  (match account
    ((some email) (ok (clone email)))
    (none (default-account! client command))))

(type default-account!
  (fn ((mut mail-app) (ref cli-command))
    (result string mail-error)))

(defn default-account! (client command)
  (if (needs-account? command)
    (first-account! client)
    (ok (str ""))))

(type first-account!
  (fn ((mut mail-app))
    (result string mail-error)))

(defn first-account! (client)
  (match (first (try (list-accounts! client)))
    ((some account) (ok (clone (:email account))))
    (none (err (mail-error/auth-required (str "no account yet; run `knave-mail accounts add`"))))))

(defn needs-account? (command)
  (match command
    (list-accounts false)
    (add-account false)
    ((remove-account _) false)
    (help false)
    (_ true)))

(defn body-for (command)
  (match command
    ((send _ _ _) (standard-input))
    ((reply _ _) (standard-input))
    ((forward _ _) (standard-input))
    (_ (ok (str "")))))

(defn print-result (output outcome)
  (match output
    (json (println (cli-result->json-text outcome)))
    (text (print-unless-empty (cli-result->text outcome)))))

(defn print-failure (output failure)
  (match output
    (json (eprintln (mail-error->json-text failure)))
    (text (eprintln (str "knave-mail: " (error-message failure))))))

(defn print-unless-empty (text)
  (unless (empty? text) (println text)))

(defn standard-input ()
  (map-err (slurp stdin)
    (fn (problem)
      (mail-error/usage (str "cannot read the message body: " problem)))))
