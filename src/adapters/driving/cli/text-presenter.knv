(use adapters/driving/cli/cli-result cli-result)
(use adapters/driving/cli/command-options body-format)
(use domain/labels starred? unread?)
(use domain/mail draft label message thread thread-summary)

(export cli-result->text)

(defn cli-result->text (outcome)
  (match outcome
    ((accounts-listed accounts)
     (lines-of (-> (iter accounts)
                   (map (fn (account) (clone (:email account))))
                   collect)))
    ((labels-listed labels)
     (lines-of (-> (iter labels)
                   (map (fn (label) (label-line label)))
                   collect)))
    ((threads-listed summaries)
     (lines-of (-> (iter summaries)
                   (map (fn (summary) (summary-line summary)))
                   collect)))
    ((thread-shown shown format) (thread->text shown format))
    ((draft-shown written) (draft->text written))
    ((account-added account) (str "Added " (:email account)))
    (done (str ""))
    ((help-shown text) (clone text))))

(type label-line
  (fn ((ref label)) string))

(defn label-line (shown)
  (str (padded (:name shown) 24)
       (:unread shown)
       " unread"))

(type summary-line
  (fn ((ref thread-summary)) string))

(defn summary-line (summary)
  (str (padded (:id summary) 20)
       (date-text (:date summary))
       "  "
       (if (unread? (ref (:labels summary)))
         "N" " ")
       (if (starred? (ref (:labels summary)))
         "*" " ")
       " "
       (padded (:participants summary) 28)
       (:subject summary)))

(defn thread->text (shown format)
  (lines-of (-> (iter (:messages shown))
                (map (fn (shown-message) (message->text shown-message format)))
                collect)))

(type message->text
  (fn ((ref message) (ref body-format))
    string))

(defn message->text (shown format)
  (str "Message: "
       (:id shown)
       "\n" "From: "
       (:from shown)
       "\n" "To: "
       (join (:to shown) ", ")
       "\n" "Date: "
       (date-text (:date shown))
       "\n" "Subject: "
       (:subject shown)
       "\n\n"
       (body-in-format shown format)
       "\n"))

(type body-in-format
  (fn ((ref message) (ref body-format))
    string))

(defn body-in-format (shown format)
  (match format
    (html (unwrap-or (clone (:html shown))
                     (clone (:text shown))))
    (plain (clone (:text shown)))))

(type draft->text
  (fn ((ref draft)) string))

(defn draft->text (written)
  (str "To: "
       (join (:to written) ", ")
       "\n" "Cc: "
       (join (:cc written) ", ")
       "\n" "Subject: "
       (:subject written)
       "\n\n"
       (:body written)))

(defn lines-of (lines) (join lines "\n"))

(def padded
  (rust "format!(\"{{:<width$}} \", {0}.chars().take({1} - 1).collect::<String>(), width = {1} - 1)"
    (fn ((ref str) usize) string)))

(def date-text
  (rust "native::dates::date_text({0})" (fn (int) string)))
