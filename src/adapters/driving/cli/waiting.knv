(use app/mail-app mail-app)
(use adapters/driving/cli/cli-result cli-result)
(use domain/mail-error mail-error)
(use app/client/mail-labeler waiting-changes)

(export all-delivered)

(type all-delivered
  (fn ((ref mail-app) (ref str))
    (result cli-result mail-error)))

(defn all-delivered (client account)
  (let (waiting (try (waiting-changes client account)))
    (if (pos? waiting)
      (err (mail-error/network (str waiting
                                    (still-waiting waiting)
                                    " for Gmail; the window sends them when it next opens")))
      (ok cli-result/done))))

(defn still-waiting (waiting)
  (if (= waiting 1)
    " label change still waits"
    " label changes still wait"))
