(use domain/collections appended one-of?)

(export ->parsed-arguments parse-arguments parsed-arguments
        positional rest-positionals switch? value-of
        values-of)

(def valued-options
  (vec "--account" "--label" "--query" "--limit" "--format"
       "--to" "--cc" "--subject" "--backend" "--latency"
       "--fail" "--e2e-script" "--cache"
       "--credentials-file" "--client-id" "--client-secret"
       "--gmail-base-url" "--token-url" "--auth-url"
       "--theme" "--keymap" "--browser" "--log-file"
       "--log-level"))

(defstruct parsed-arguments
  :positionals (vec string)
  :options (vec (pair string string))
  :switches (vec string))

(type parse-arguments
  (fn ((ref (vec string)))
    (result parsed-arguments string)))

(defn parse-arguments (tokens)
  (parsed-from tokens 0
               (->parsed-arguments (vec) (vec) (vec))))

(type parsed-from
  (fn ((ref (vec string)) usize parsed-arguments)
    (result parsed-arguments string)))

(defn parsed-from (tokens index parsed)
  (match (get tokens index)
    ((some token)
     (recur tokens
            (+ index (token-width token))
            (try (with-token parsed tokens index))))
    (none (ok parsed))))

(defn valued? (token)
  (one-of? (as-str token) valued-options))

(defn token-width (token)
  (if (valued? token) 2 1))

(type with-token
  (fn (parsed-arguments (ref (vec string)) usize)
    (result parsed-arguments string)))

(defn with-token (parsed tokens index)
  (let (token (at tokens index))
    (cond
      ((valued? token)
       (let-try (value (value-after tokens index))
         (ok (with-option parsed token value))))
      ((flag? token) (ok (with-switch parsed token)))
      (else (ok (with-positional parsed token))))))

(defn positional (parsed index)
  (if (< index (len (:positionals parsed)))
    (some (clone (at (:positionals parsed) index)))
    none))

(defn rest-positionals (parsed)
  (loop (index 1
         words (vec))
    (match (positional parsed index)
      ((some word) (recur (inc index) (appended words word)))
      (none words))))

(defn value-of (parsed name)
  (last-value (ref (values-of parsed name))))

(type values-of
  (fn ((ref parsed-arguments) (ref str))
    (vec string)))

(defn values-of (parsed name)
  (-> (iter (:options parsed))
      (filter (fn (option) (= (key-of option) name)))
      (map (fn (option) (clone (value-in option))))
      collect))

(type switch?
  (fn ((ref parsed-arguments) (ref str))
    bool))

(defn switch? (parsed name)
  (any? (iter (:switches parsed))
    (fn (held) (= held name))))

(defn with-option (parsed name value)
  (let (options (clone (:options parsed)))
    (push! (mut options)
           (pair (clone name) value))
    (assoc parsed :options options)))

(defn with-switch (parsed name)
  (let (switches (clone (:switches parsed)))
    (push! (mut switches) (clone name))
    (assoc parsed :switches switches)))

(defn with-positional (parsed token)
  (let (positionals (clone (:positionals parsed)))
    (push! (mut positionals) (clone token))
    (assoc parsed :positionals positionals)))

(defn flag? (token) (starts-with? token "--"))

(type value-after
  (fn ((ref (vec string)) usize)
    (result string string)))

(defn value-after (tokens index)
  (match (get tokens (inc index))
    ((some value) (ok (clone value)))
    (none (err (str (at tokens index) " expects a value")))))

(type key-of
  (fn ((ref (pair string string)))
    (ref string)))

(defn key-of (option)
  (let-match ((pair key _) option) key))

(type value-in
  (fn ((ref (pair string string)))
    (ref string)))

(defn value-in (option)
  (let-match ((pair _ value) option) value))

(defn last-value (values)
  (-> values last (map-some clone)))
