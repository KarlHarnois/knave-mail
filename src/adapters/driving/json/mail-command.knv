(use adapters/driving/json/arguments account-argument
                                     draft-argument
                                     flag-argument
                                     page-token-argument
                                     text-argument
                                     thread-argument
                                     thread-ids-argument
                                     thread-query-argument)

(use adapters/json/value json-value optional-string-field)
(use domain/freshness freshness)
(use domain/label-commands label-change-named)
(use domain/labels label-change)

(use domain/mail ->message-ref draft message-ref
                 thread-query thread-ref)

(use domain/mail-error mail-error)
(use domain/reply draft-kind)

(export ->mail-call json->mail-command mail-call
        mail-command worker-listing?)

(defenum mail-command
  list-accounts
  (list-labels :account string)
  (list-threads :account string
                :query thread-query
                :freshness freshness)
  (list-page :account string
             :query thread-query
             :page-token (option string))
  (archive-older :account string :before string)
  (open-thread thread-ref)
  (draft :message message-ref :kind draft-kind)
  (send :account string :draft draft)
  (sync :account string)
  (relabel :account string
           :thread-ids (vec string)
           :change label-change))

(defstruct mail-call
  :id json-value
  :name string
  :command mail-command)

(defn worker-listing? (command)
  (match command
    ((list-page _ _ _) true)
    ((archive-older _ _) true)
    ((list-threads _ query freshness)
     (gmail-listing? query freshness))
    (_ false)))

(defn gmail-listing? (query freshness)
  (or (not (empty? (:query query)))
      (fresh? freshness)))

(defn fresh? (freshness)
  (match freshness (fresh true) (cached false)))

(type json->mail-command
  (fn ((ref str) (ref json-value))
    (result mail-command mail-error)))

(defn json->mail-command (name arguments)
  (match name
    ("accounts" (ok mail-command/list-accounts))
    ("labels"
     (ok (mail-command/list-labels :account (try (account-argument
                                                   arguments)))))
    ("threads" (threads-command arguments))
    ("thread-page" (page-command arguments))
    ("archive-older" (archive-command arguments))
    ("thread"
     (ok (mail-command/open-thread (try (thread-argument arguments)))))
    ("reply-draft"
     (draft-command arguments (try (reply-kind arguments))))
    ("forward-draft"
     (draft-command arguments draft-kind/forward))
    ("send"
     (ok (mail-command/send :account (try (account-argument arguments))
                            :draft (try (draft-argument arguments)))))
    ("sync"
     (ok (mail-command/sync :account (try (account-argument arguments)))))
    (_ (relabel-command name arguments))))

(defn threads-command (arguments)
  (ok (mail-command/list-threads :account (try (account-argument arguments))
                                 :query (try (thread-query-argument arguments))
                                 :freshness (try (asked-freshness arguments)))))

(defn asked-freshness (arguments)
  (map-ok (flag-argument arguments "fresh")
    (fn (fresh) (if fresh freshness/fresh freshness/cached))))

(defn page-command (arguments)
  (ok (mail-command/list-page :account (try (account-argument arguments))
                              :query (try (thread-query-argument arguments))
                              :page-token (page-token-argument arguments))))

(defn archive-command (arguments)
  (ok (mail-command/archive-older :account (try (account-argument arguments))
                                  :before (try (gmail-date-argument
                                                 arguments)))))

(defn gmail-date-argument (arguments)
  (let (written (try (text-argument arguments "before")))
    (ok-or (gmail-date (as-str written))
           (mail-error/usage (str "expected a date like 2026/10/01 in `before`, not "
                                  written)))))

(def gmail-date
  (rust "native::dates::gmail_date({0})"
    (fn ((ref str)) (option string))))

(defn draft-command (arguments kind)
  (ok (mail-command/draft
        :message (->message-ref :account (try (account-argument arguments))
                                :message-id (try (text-argument arguments
                                                                "messageId")))
        :kind kind)))

(defn reply-kind (arguments)
  (map-ok (flag-argument arguments "all")
    (fn (everyone)
      (if everyone draft-kind/reply-all draft-kind/reply))))

(defn relabel-command (name arguments)
  (let (change (try (change-named name)))
    (ok (mail-command/relabel :account (try (account-argument arguments))
                              :thread-ids (try (thread-ids-argument arguments))
                              :change change))))

(defn change-named (name)
  (ok-or (label-change-named name)
         (mail-error/usage (str "unknown command `" name "`"))))
