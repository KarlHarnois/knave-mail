(use adapters/json/value json-value parse-json string-field)
(use domain/mail-error error-kind error-message mail-error)
(use domain/results ok->option)

(export failure-event failure-reply null-id
        request-arguments request-command request-id
        success-reply sync-progress-event synced-event)

(type request-command
  (fn ((ref str)) (option string)))

(defn request-command (request-text)
  (match (parse-json request-text)
    ((ok request)
     (ok->option (string-field (ref request) "command")))
    ((err _) none)))

(type failure-reply
  (fn ((ref json-value) (ref mail-error))
    string))

(defn failure-reply (id failure)
  (error-reply id
               (error-kind failure)
               (error-message failure)))

(type failure-event
  (fn ((ref str) (ref mail-error)) string))

(defn failure-event (account failure)
  (sync-failed-event account
                     (error-kind failure)
                     (error-message failure)))

(def request-id
  (rust "{0}.get(\"id\").cloned().unwrap_or(serde_json::Value::Null)"
    (fn ((ref json-value)) json-value)))

(def null-id
  (rust "serde_json::Value::Null" (fn () json-value)))

(def request-arguments
  (rust "{0}.get(\"args\").cloned().unwrap_or_else(|| serde_json::json!({{}}))"
    (fn ((ref json-value)) json-value)))

(def success-reply
  (rust "serde_json::json!({{\"id\": {0}, \"ok\": {1}}}).to_string()"
    (fn ((ref json-value) (ref json-value))
      string)))

(def error-reply
  (rust "serde_json::json!({{\"id\": {0}, \"error\": {{\"kind\": {1}, \"message\": {2}}}}}).to_string()"
    (fn ((ref json-value) (ref str) (ref str))
      string)))

(def synced-event
  (rust "serde_json::json!({{\"event\": \"synced\", \"account\": {0}}}).to_string()"
    (fn ((ref str)) string)))

(def sync-progress-event
  (rust "serde_json::json!({{\"event\": \"sync-progress\", \"account\": {0}}}).to_string()"
    (fn ((ref str)) string)))

(def sync-failed-event
  (rust "serde_json::json!({{\"event\": \"sync-failed\", \"account\": {0}, \"error\": {{\"kind\": {1}, \"message\": {2}}}}}).to_string()"
    (fn ((ref str) (ref str) (ref str))
      string)))
