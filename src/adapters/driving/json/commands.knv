(use app/mail-app mail-app)
(use app/client/mail-labeler relabel-threads!)
(use domain/label-commands label-change-named)
(use adapters/driving/json/listing-command threads-listed!)

(use adapters/driving/json/arguments account-argument
                                     draft-argument
                                     flag-argument
                                     text-argument
                                     thread-argument
                                     thread-ids-argument)

(use adapters/driving/json/mail-json accounts-json
                                     draft-json labels-json
                                     summaries-json
                                     thread-json)

(use adapters/driving/json/envelope failure-reply null-id
                                    request-arguments
                                    request-id
                                    success-reply)

(use adapters/driving/json/page-command thread-page-command!)
(use adapters/driving/json/archive-command archive-older-command!)

(use adapters/json/value empty-object json-value parse-json
                         string-field)

(use domain/mail-error mail-error)
(use app/client/account-book list-accounts!)
(use app/client/mail-reader list-labels! open-thread!)
(use app/client/mail-writer draft! send-draft!)
(use domain/mail ->message-ref)
(use domain/reply draft-kind)
(use app/client/mail-syncer sync-account!)

(export answer! run-command!)

(type answer!
  (fn ((mut mail-app) (ref str)) string))

(defn answer! (client request-text)
  (match (parse-json request-text)
    ((ok request) (answer-parsed! client (ref request)))
    ((err problem)
     (failure-reply (ref (null-id))
                    (ref (mail-error/usage problem))))))

(type answer-parsed!
  (fn ((mut mail-app) (ref json-value))
    string))

(defn answer-parsed! (client request)
  (let (id (request-id request)
        outcome (match (string-field request "command")
                  ((ok command)
                   (run-command! client
                                 (ref command)
                                 (ref (request-arguments request))))
                  ((err problem) (err (mail-error/usage problem)))))
    (match outcome
      ((ok value) (success-reply (ref id) (ref value)))
      ((err failure) (failure-reply (ref id) (ref failure))))))

(type run-command!
  (fn ((mut mail-app)
       (ref str)
       (ref json-value))
    (result json-value mail-error)))

(defn run-command! (client command arguments)
  (match command
    ("accounts"
     (ok (accounts-json (ref (try (list-accounts! client))))))
    ("labels"
     (let (account (try (account-argument arguments))
           labels (try (list-labels! client (ref account))))
       (ok (labels-json (ref labels)))))
    ("threads" (threads-listed! client arguments))
    ("thread-page" (thread-page-command! client arguments))
    ("archive-older" (archive-older-command! client arguments))
    ("thread"
     (let (wanted (try (thread-argument arguments))
           opened (try (open-thread! client (ref wanted))))
       (ok (thread-json (ref opened)))))
    ("reply-draft"
     (draft-command! client arguments (reply-kind arguments)))
    ("forward-draft"
     (draft-command! client arguments draft-kind/forward))
    ("send"
     (do
       (try (send-draft! client
                         (ref (try (account-argument arguments)))
                         (ref (try (draft-argument arguments)))))
       (ok (empty-object))))
    ("sync"
     (do
       (try (sync-account! client
                           (ref (try (account-argument arguments)))))
       (ok (empty-object))))
    (_ (relabel-command! client command arguments))))

(type draft-command!
  (fn ((mut mail-app) (ref json-value) draft-kind)
    (result json-value mail-error)))

(defn draft-command! (client arguments kind)
  (let (message (->message-ref :account (try (account-argument arguments))
                               :message-id (try (text-argument arguments
                                                               "messageId"))))
    (ok (draft-json (ref (try (draft! client (ref message) kind)))))))

(defn reply-kind (arguments)
  (match (flag-argument arguments "all")
    ((ok true) draft-kind/reply-all)
    (_ draft-kind/reply)))

(type relabel-command!
  (fn ((mut mail-app)
       (ref str)
       (ref json-value))
    (result json-value mail-error)))

(defn relabel-command! (client command arguments)
  (let (change (try (change-named command)))
    (try (relabel-threads! client
                           (ref (try (account-argument arguments)))
                           (ref (try (thread-ids-argument arguments)))
                           (ref change)))
    (ok (empty-object))))

(defn change-named (command)
  (ok-or (label-change-named command)
         (mail-error/usage (str "unknown command `" command "`"))))
