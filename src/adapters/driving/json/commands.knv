(use adapters/driving/json/envelope failure-reply null-id
                                    request-arguments
                                    request-id
                                    success-reply)

(use adapters/driving/json/mail-command ->mail-call
                                        json->mail-command
                                        mail-call
                                        mail-command)

(use adapters/driving/json/mail-json accounts-json
                                     archived-json
                                     draft-json labels-json
                                     summaries-json
                                     summary-page-json
                                     thread-json)

(use adapters/json/value empty-object json-value parse-json
                         string-field)

(use app/client/account-book list-accounts!)

(use app/client/mail-labeler archive-older!
                             relabel-threads!)

(use app/client/mail-reader list-labels! list-thread-page!
                            list-threads! open-thread!)

(use app/client/mail-syncer sync-account!)
(use app/client/mail-writer draft! send-draft!)
(use app/mail-app mail-app)
(use domain/mail-error mail-error)

(export answer! json->mail-call reply-for run-command!)

(type answer!
  (fn ((mut mail-app) (ref str)) string))

(defn answer! (app request-text)
  (match (parse-json request-text)
    ((ok request) (answer-request! app (ref request)))
    ((err problem)
     (failure-reply (ref (null-id))
                    (ref (mail-error/usage problem))))))

(type answer-request!
  (fn ((mut mail-app) (ref json-value))
    string))

(defn answer-request! (app request)
  (match (json->mail-call request)
    ((ok call)
     (reply-for (ref call)
                (run-command! app (ref (:command call)))))
    ((err failure)
     (failure-reply (ref (request-id request))
                    (ref failure)))))

(type json->mail-call
  (fn ((ref json-value))
    (result mail-call mail-error)))

(defn json->mail-call (request)
  (let (name (try (text-error->usage-error (string-field request "command"))))
    (ok (->mail-call :id (request-id request)
                     :command (try (json->mail-command (as-str (ref name))
                                                       (ref (request-arguments
                                                              request))))
                     :name name))))

(defn text-error->usage-error (outcome)
  (map-err outcome
    (fn (problem) (mail-error/usage problem))))

(type reply-for
  (fn ((ref mail-call) (result json-value mail-error))
    string))

(defn reply-for (call outcome)
  (match outcome
    ((ok value) (success-reply (ref (:id call)) (ref value)))
    ((err failure)
     (failure-reply (ref (:id call))
                    (ref failure)))))

(type run-command!
  (fn ((mut mail-app) (ref mail-command))
    (result json-value mail-error)))

(defn run-command! (app command)
  (match command
    (list-accounts (ok (accounts-json (ref (try (list-accounts! app))))))
    ((list-labels account)
     (ok (labels-json (ref (try (list-labels! app account))))))
    ((list-threads account query freshness)
     (ok (summaries-json
           (ref (try (list-threads! app account query (clone freshness)))))))
    ((list-page account query page-token)
     (ok (summary-page-json
           (ref (try (list-thread-page! app account query page-token))))))
    ((archive-older account before)
     (ok (archived-json (try (archive-older! app account before)))))
    ((open-thread wanted)
     (ok (thread-json (ref (try (open-thread! app wanted))))))
    ((draft message kind)
     (ok (draft-json (ref (try (draft! app message (clone kind)))))))
    ((send account written)
     (done-after (send-draft! app account written)))
    ((sync account) (done-after (sync-account! app account)))
    ((relabel account thread-ids change)
     (done-after (relabel-threads! app account thread-ids change)))))

(defn done-after (outcome)
  (map-ok outcome (fn (_) (empty-object))))
