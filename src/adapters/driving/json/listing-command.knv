(use domain/freshness freshness)

(use adapters/driving/json/arguments account-argument
                                     thread-query-argument)

(use adapters/driving/json/mail-json summaries-json)
(use adapters/json/value bool-field json-value)
(use domain/mail-error mail-error)
(use ports/driving/mail-reader list-threads! mail-reader)

(export threads-listed!)

(type threads-listed!
  (where ((client mail-reader))
    (fn ((mut client) (ref json-value))
      (result json-value mail-error))))

(defn threads-listed! (client arguments)
  (let (account (try (account-argument arguments))
        query (try (thread-query-argument arguments)))
    (ok (summaries-json (ref (try (list-threads! client
                                                 (ref account)
                                                 (ref query)
                                                 (asked-freshness
                                                   arguments))))))))

(defn asked-freshness (arguments)
  (match (bool-field arguments "fresh")
    ((ok true) freshness/fresh)
    (_ freshness/cached)))
