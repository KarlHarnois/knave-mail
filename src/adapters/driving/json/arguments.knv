(use domain/label-scope text->label-scope)

(use adapters/json/value bool-field json-value number-field
                         object-field optional-string-field
                         string-field string-list-field)

(use domain/mail ->draft ->thread-query ->thread-ref draft
                 thread-query)

(use domain/mail-error mail-error)

(export account-argument draft-argument flag-argument
        page-token-argument text-argument
        text-error->usage-error thread-argument
        thread-ids-argument thread-query-argument)

(defn text-argument (arguments name)
  (text-error->usage-error (string-field arguments name)))

(type flag-argument
  (fn ((ref json-value) (ref str))
    (result bool mail-error)))

(defn flag-argument (arguments name)
  (text-error->usage-error (optional-bool-field arguments name)))

(def optional-bool-field
  (rust "{{ let {!name} = {1}; match {0}.get({!name}) {{ None => Ok(false), Some({!value}) => {!value}.as_bool().ok_or_else(|| format!(\"expected a boolean in `{{}}`\", {!name})) }} }}"
    (fn ((ref json-value) (ref str))
      (result bool string))))

(defn account-argument (arguments)
  (text-argument arguments "account"))

(defn thread-argument (arguments)
  (ok (->thread-ref :account (try (account-argument arguments))
                    :thread-id (try (text-argument arguments "threadId")))))

(defn thread-ids-argument (arguments)
  (text-error->usage-error (string-list-field arguments "threadIds")))

(defn thread-query-argument (arguments)
  (ok (->thread-query :scope (text->label-scope (as-str (ref (try (text-argument
                                                                    arguments
                                                                    "label")))))
                      :query (try (text-argument arguments "query"))
                      :limit (try (text-error->usage-error
                                    (number-field arguments "limit"))))))

(defn draft-argument (arguments)
  (let (written (try (text-error->usage-error (object-field arguments
                                                            "draft"))))
    (ok (->draft :to (try (text-error->usage-error
                            (string-list-field (ref written) "to")))
                 :cc (try (text-error->usage-error
                            (string-list-field (ref written) "cc")))
                 :subject (try (text-argument (ref written) "subject"))
                 :body (try (text-argument (ref written) "body"))
                 :reply-to (optional-string-field (ref written) "replyTo")))))

(defn text-error->usage-error (outcome)
  (map-err outcome
    (fn (problem) (mail-error/usage problem))))

(type page-token-argument
  (fn ((ref json-value)) (option string)))

(defn page-token-argument (arguments)
  (match (optional-string-field arguments "pageToken")
    ((some text) (non-empty-token text))
    (none none)))

(defn non-empty-token (text)
  (if (empty? text) none (some text)))
