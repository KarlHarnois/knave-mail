(use adapters/driving/json/envelope success-reply)

(use adapters/driving/webview/window close-window
                                     reply-outbox send-reply
                                     zoom-window)

(use adapters/driving/webview/window-request e2e-outcome)
(use adapters/json/value empty-object json-value)

(export finish-e2e zoom-to)

(def smallest-zoom 0.5)

(def largest-zoom 3.0)

(defn finish-e2e (outcome outbox)
  (close-window outbox (exit-code-of outcome)))

(defn exit-code-of (outcome)
  (match outcome (passed 0) (failed 1)))

(type zoom-to
  (fn ((ref json-value) f64 (ref reply-outbox))
    unit))

(defn zoom-to (id level outbox)
  (zoom-window outbox
               (max smallest-zoom (min largest-zoom level)))
  (send-reply outbox
              (success-reply id (ref (empty-object)))))
