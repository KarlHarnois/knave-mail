(use adapters/driving/json/envelope request-arguments
                                    request-id
                                    success-reply)

(use adapters/json/value bool-field empty-object json-value
                         string-field)

(use adapters/driving/webview/window close-window
                                     reply-outbox send-reply
                                     zoom-window)

(export empty-object finish-e2e report-e2e-line zoom-to)

(type report-e2e-line
  (fn ((ref json-value)) unit))

(defn report-e2e-line (request)
  (match (string-field (ref (request-arguments request)) "line")
    ((ok line) (println line))
    ((err problem) (eprintln problem))))

(type finish-e2e
  (fn ((ref json-value) (ref reply-outbox))
    unit))

(defn finish-e2e (request outbox)
  (close-window outbox
                (match (bool-field (ref (request-arguments request)) "passed")
                  ((ok true) 0)
                  (_ 1))))

(type zoom-to
  (fn ((ref json-value) (ref reply-outbox))
    unit))

(defn zoom-to (request outbox)
  (zoom-window outbox
               (zoom-level (ref (request-arguments request))))
  (send-reply outbox
              (success-reply (ref (request-id request))
                             (ref (empty-object)))))

(def smallest-zoom 0.5)

(def largest-zoom 3.0)

(type zoom-level
  (fn ((ref json-value)) f64))

(defn zoom-level (arguments)
  (max smallest-zoom
       (min largest-zoom (requested-zoom arguments))))

(def requested-zoom
  (rust "{0}.get(\"level\").and_then(serde_json::Value::as_f64).unwrap_or(1.0)"
    (fn ((ref json-value)) f64)))
