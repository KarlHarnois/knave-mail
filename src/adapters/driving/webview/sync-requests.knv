(use adapters/driving/json/core-event core-event
                                      core-event->json-text)

(use domain/mail-error mail-error)

(export sync-event)

(defn sync-event (outcome account)
  (match outcome
    ((ok _)
     (core-event->json-text (ref (core-event/synced (str account)))))
    ((err failure)
     (core-event->json-text (ref (core-event/sync-failed :account (str account)
                                                         :failure failure))))))
