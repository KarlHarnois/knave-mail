(use adapters/driving/webview/theme/theme-declaration theme-declaration
                                                      theme-entry->declaration)

(use adapters/driving/webview/theme/theme-entries read-theme-entries)

(use adapters/driving/webview/theme/theme-values color-names
                                                 color-scheme
                                                 dark-mail
                                                 theme-mode)

(use domain/collections present)

(export ->themed theme-css themed)

(defstruct themed
  :css string
  :warnings (vec string))

(defn theme-css (text)
  (match (read-theme-entries text)
    ((ok entries) (declared-css (ref entries)))
    ((err problem)
     (->themed (str "")
               (vec (str "theme.knv: " problem))))))

(defn declared-css (entries)
  (let (declared (-> (iter entries) (map theme-entry->declaration) collect)
        declarations (-> (iter declared) (map written-css) present collect)
        warnings (-> (iter declared) (map theme-warning) present collect))
    (->themed (root-rule (ref declarations)) warnings)))

(defn written-css (declared)
  (match declared
    ((ok declaration) (some (declaration->css declaration)))
    ((err _) none)))

(defn theme-warning (declared)
  (match declared
    ((ok _) none)
    ((err problem) (some (str "theme.knv: " problem)))))

(defn declaration->css (declaration)
  (match declaration
    ((font family) (str "--theme-font: \"" family "\""))
    ((message-font family)
     (str "--theme-message-font: \"" family "\""))
    ((font-size size) (str "--font-size: " size "px"))
    ((dark-mail setting)
     (str "--dark-mail: " (dark-mail-name setting)))
    ((mode chosen) (mode-declarations chosen))
    ((color scheme name value)
     (str "--" (scheme-name scheme) "-" name ": " value))))

(defn dark-mail-name (setting)
  (match setting (auto "auto") (off "off")))

(defn scheme-name (scheme)
  (match scheme (light "light") (dark "dark")))

(defn mode-declarations (mode)
  (match mode
    (system (str "color-scheme: light dark"))
    ((fixed scheme)
     (fixed-scheme-declarations (scheme-name scheme)))))

(defn fixed-scheme-declarations (scheme)
  (str "color-scheme: " scheme ";\n  "
       (join (ref (-> (iter color-names)
                      (map (fn (name)
                             (str "--" name ": var(--" scheme "-" name ")")))
                      collect))
             ";\n  ")))

(def root-rule
  (rust "if {0}.is_empty() {{ String::new() }} else {{ format!(\":root {{{{\\n  {{}};\\n}}}}\\n\", {0}.join(\";\\n  \")) }}"
    (fn ((ref (vec string))) string)))
