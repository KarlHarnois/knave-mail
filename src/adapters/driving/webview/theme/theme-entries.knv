(use adapters/driving/webview/keymap/sexp-tokens sexp-tokens)

(export read-theme-entries theme-entry)

(defstruct theme-entry
  :section string
  :key string
  :value string)

(defn read-theme-entries (text)
  (entries-in (ref (sexp-tokens text))))

(def entries-in
  (rust "native::theme::theme_entries({0}).map(|{!entries}| {!entries}.into_iter().map(|{!entry}| ThemeEntry {{ section: {!entry}.section, key: {!entry}.key, value: {!entry}.value }}).collect())"
    (fn ((ref (vec string)))
      (result (vec theme-entry) string))))
