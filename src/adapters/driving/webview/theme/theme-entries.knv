(use adapters/driving/webview/keymap/sexp-tokens sexp-tokens)

(export read-theme-entries theme-entry)

(defstruct theme-entry
  :section string
  :key string
  :value string)

(defn read-theme-entries (text)
  (entries-in (ref (sexp-tokens text))))

(def entries-in
  (rust "{{ let mut {!entries} = Vec::<ThemeEntry>::new(); let mut {!section} = String::from(\"theme\"); let mut {!depth} = 0; let mut {!index} = 0; let mut {!problem} = None; while {!index} < {0}.len() {{ let {!token} = &{0}[{!index}]; if {!token} == \"(\" {{ {!depth} += 1; {!index} += 1; if let Some({!head}) = {0}.get({!index}) {{ if {!depth} == 2 {{ {!section} = {!head}.clone(); }} else if {!depth} == 1 && {!head} != \"theme\" {{ {!problem} = Some(format!(\"the file must start with (theme ...), not ({{}} ...)\", {!head})); }} {!index} += 1; }} }} else if {!token} == \")\" {{ {!depth} -= 1; if {!depth} == 1 {{ {!section} = String::from(\"theme\"); }} {!index} += 1; }} else if let Some({!key}) = {!token}.strip_prefix(':') {{ match {0}.get({!index} + 1) {{ Some({!value}) if {!value} != \"(\" && {!value} != \")\" => {{ {!entries}.push(ThemeEntry {{ section: {!section}.clone(), key: {!key}.to_string(), value: {!value}.trim_start_matches('\"').to_string() }}); {!index} += 2; }} _ => {{ {!problem} = Some(format!(\":{{}} has no value\", {!key})); {!index} += 1; }} }} }} else {{ {!problem} = Some(format!(\"unexpected `{{}}`; write :key value pairs\", {!token})); {!index} += 1; }} }} if {!depth} != 0 {{ {!problem} = Some(String::from(\"the parentheses do not balance\")); }} match {!problem} {{ Some({!message}) => Err({!message}), None => Ok({!entries}) }} }}"
    (fn ((ref (vec string)))
      (result (vec theme-entry) string))))
