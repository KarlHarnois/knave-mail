(export next-request open-window reply-outbox request-inbox
        send-reply send-window-command window-command)

(defenum window-command
  (exit int)
  (zoom f64))

(deftype request-inbox
  (rust "std::sync::mpsc::Receiver<String>"))

(deftype reply-outbox
  (rust "tao::event_loop::EventLoopProxy<String>"))

(def next-request
  (rust "{0}.recv().ok()"
    (fn ((ref request-inbox))
      (option string))))

(def send-reply
  (rust "drop({0}.send_event({1}))"
    (fn ((ref reply-outbox) string) unit)))

(def open-window
  (rust "native::window::open_window({0}, {1}, {2}, {3}, {4})"
    (fn ((ref str)
         (ref str)
         (ref str)
         (fn ((ref str)) (option string))
         (fn-once (request-inbox reply-outbox) unit))
      unit)))

(type send-window-command
  (fn ((ref reply-outbox) window-command) unit))

(defn send-window-command (outbox command)
  (send-reply outbox
              (str "\u{1}" (window-command->text command))))

(defn window-command->text (command)
  (match command
    ((exit code) (str "exit " code))
    ((zoom level) (str "zoom " level))))
