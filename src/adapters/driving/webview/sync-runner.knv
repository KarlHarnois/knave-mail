(use adapters/driving/webview/window reply-outbox)

(use composition/background-sync background-sync
                                 start-background-sync!)

(export start-sync! sync-runner)

(defenum sync-runner
  inline
  (background background-sync))

(type start-sync!
  (fn ((ref sync-runner)
       (ref str)
       (ref reply-outbox))
    bool))

(defn start-sync! (runner account outbox)
  (match runner
    (inline false)
    ((background held)
     (do (start-background-sync! held account outbox) true))))
