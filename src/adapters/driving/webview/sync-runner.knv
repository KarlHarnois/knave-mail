(use adapters/driving/webview/window reply-outbox)

(export ->inline-sync inline-sync run-in-background sync-runner)

(deftrait sync-runner
  (start-sync! (fn ((mut self) (ref str) (ref reply-outbox)) bool)))

(defstruct inline-sync
  :started i64)

(impl sync-runner inline-sync
  (start-sync! (runner account outbox) false))

(def run-in-background
  (rust "{{ let {!outbox} = {0}.clone(); let {!job} = {1}; std::thread::spawn(move || drop({!outbox}.send_event({!job}()))); }}"
    (fn ((ref reply-outbox) (fn-once () string)) unit)))
