(use adapters/driven/threaded-queue submission-sender)
(use adapters/driving/webview/window reply-outbox)
(use composition/background-sync start-background-sync!)

(export start-sync! sync-runner)

(defenum sync-runner
  inline
  (background submission-sender))

(type start-sync!
  (fn ((ref sync-runner)
       (ref str)
       (ref reply-outbox))
    bool))

(defn start-sync! (runner account outbox)
  (match runner
    (inline false)
    ((background executor)
     (do (start-background-sync! executor account outbox) true))))
