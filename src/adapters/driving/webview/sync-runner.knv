(use adapters/driving/webview/window reply-outbox)
(use composition/background-sync start-background-sync!)
(use composition/worker-wiring worker-wiring)

(export start-sync! sync-runner sync-start)

(defenum sync-start
  started-in-background
  run-here)

(defenum sync-runner
  inline
  (background worker-wiring))

(defn start-sync! (runner account outbox)
  (match runner
    (inline sync-start/run-here)
    ((background held)
     (start-background-sync! held account outbox)
     sync-start/started-in-background)))
