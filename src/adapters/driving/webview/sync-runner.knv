(use adapters/driving/webview/window reply-outbox)

(export ->inline-sync inline-sync run-in-background
        sync-runner)

(deftrait sync-runner
  (start-sync!
    (fn ((mut self)
         (ref str)
         (ref reply-outbox))
      bool)))

(defstruct inline-sync)

(impl sync-runner inline-sync
  (start-sync! (_runner _account _outbox) false))

(def run-in-background
  (rust "{{ let {!outbox} = {0}.clone(); let {!job} = {1}; std::thread::spawn(move || {{ let {!last} = {!job}(&{!outbox}); drop({!outbox}.send_event({!last})); }}); }}"
    (fn ((ref reply-outbox)
         (fn-once ((ref reply-outbox)) string))
      unit)))
