(use adapters/driving/json/commands json->mail-call)

(use adapters/driving/json/envelope null-id
                                    request-arguments
                                    request-id)

(use adapters/driving/json/mail-command mail-call)

(use adapters/json/value bool-field json-value parse-json
                         string-field)

(use domain/log-entry ->log-entry log-area log-entry
                      log-level text->log-level)

(use domain/mail-error mail-error)
(use domain/results ok->option)

(export e2e-outcome text->window-request window-request)

(defenum e2e-outcome
  passed
  failed)

(defenum window-request
  (sync-account :id json-value :account string)
  (e2e-report string)
  (e2e-problem string)
  (e2e-finish e2e-outcome)
  (zoom :id json-value :level f64)
  (frontend-log log-entry)
  (open-link string)
  (mail mail-call)
  (refused :id json-value :failure mail-error))

(type text->window-request
  (fn ((ref str)) window-request))

(defn text->window-request (text)
  (match (parse-json text)
    ((ok request) (json->window-request (ref request)))
    ((err problem)
     (window-request/refused :id (null-id)
                             :failure (mail-error/usage problem)))))

(type json->window-request
  (fn ((ref json-value)) window-request))

(defn json->window-request (request)
  (match (parsed-request request (ref (request-arguments request)))
    ((ok parsed) parsed)
    ((err failure)
     (window-request/refused :id (request-id request)
                             :failure failure))))

(type parsed-request
  (fn ((ref json-value) (ref json-value))
    (result window-request mail-error)))

(defn parsed-request (request arguments)
  (match (unwrap-or (ok->option (string-field request "command"))
                    (str ""))
    ("sync"
     (ok (window-request/sync-account
           :id (request-id request)
           :account (try (usage-field (string-field arguments "account")
                                      "sync needs an account")))))
    ("e2e-report" (ok (e2e-line arguments)))
    ("e2e-finish"
     (ok (window-request/e2e-finish (try (e2e-outcome-of arguments)))))
    ("zoom"
     (ok (window-request/zoom :id (request-id request)
                              :level (try (requested-zoom arguments)))))
    ("log"
     (ok (window-request/frontend-log (try (frontend-entry arguments)))))
    ("open-link"
     (ok (window-request/open-link (try (link-url arguments)))))
    (_ (map-ok (json->mail-call request)
         (fn (call) (window-request/mail call))))))

(defn e2e-line (arguments)
  (match (string-field arguments "line")
    ((ok line) (window-request/e2e-report line))
    ((err problem) (window-request/e2e-problem problem))))

(type e2e-outcome-of
  (fn ((ref json-value))
    (result e2e-outcome mail-error)))

(defn e2e-outcome-of (arguments)
  (map-ok (usage-field (bool-field arguments "passed")
                       "e2e-finish needs passed")
          passed->e2e-outcome))

(defn passed->e2e-outcome (passed)
  (if passed e2e-outcome/passed e2e-outcome/failed))

(type requested-zoom
  (fn ((ref json-value))
    (result f64 mail-error)))

(defn requested-zoom (arguments)
  (ok-or (zoom-level arguments)
         (mail-error/usage (str "zoom needs a numeric level"))))

(def zoom-level
  (rust "{0}.get(\"level\").and_then(serde_json::Value::as_f64)"
    (fn ((ref json-value)) (option f64))))

(type frontend-entry
  (fn ((ref json-value))
    (result log-entry mail-error)))

(defn frontend-entry (arguments)
  (let-try (name (usage-field (string-field arguments "level")
                              "log needs a level")
            message (usage-field (string-field arguments "message")
                                 "log needs a message"))
    (ok (->log-entry (try (named-level (as-str name)))
                     log-area/frontend message))))

(type named-level
  (fn ((ref str))
    (result log-level mail-error)))

(defn named-level (name)
  (ok-or (text->log-level name)
         (mail-error/usage (str "unknown log level `" name "`"))))

(type link-url
  (fn ((ref json-value))
    (result string mail-error)))

(defn link-url (arguments)
  (let (url (try (usage-field (string-field arguments "url")
                              "open-link needs a url")))
    (if (empty? url)
      (err (mail-error/usage (str "open-link needs a url")))
      (ok url))))

(defn usage-field (outcome problem)
  (map-err outcome
    (fn (_)
      (mail-error/usage (str problem)))))
