(use domain/log-entry log-area)
(use adapters/driving/json/commands reply-for run-command!)
(use adapters/driving/json/envelope failure-reply)
(use adapters/driving/json/mail-command mail-call)
(use adapters/json/value json-value)

(use adapters/driving/webview/listing-runner call-inbox
                                             deliver-reply!
                                             next-call
                                             reply-sink)

(use adapters/clock clock-milliseconds)
(use app/client/account-book list-accounts!)
(use app/mail-app mail-app)
(use domain/mail-error error-kind error-message mail-error)
(use domain/results unwrap-ok-or)
(use ports/driven/event-log event-log log-debug log-warn)

(export answer-listings! answered-and-logged!
        refuse-listings!)

(defn answer-listings! (app log inbox sink)
  (log-debug log log-area/window
             (str "listing worker ready for "
                  (len (unwrap-ok-or (list-accounts! app) (vec)))
                  " accounts"))
  (answer-queued-listings! app log inbox sink))

(defn answer-queued-listings! (app log inbox sink)
  (match (next-call inbox)
    ((some call)
     (deliver-reply! sink
                     (answered-and-logged! app log (ref call)))
     (recur app log inbox sink))
    (none (do))))

(defn refuse-listings! (failure inbox sink)
  (match (next-call inbox)
    ((some call)
     (deliver-reply! sink
                     (failure-reply (ref (:id call)) failure))
     (recur failure inbox sink))
    (none (do))))

(type answered-and-logged!
  (fn ((mut mail-app)
       (ref event-log)
       (ref mail-call))
    string))

(defn answered-and-logged! (app log call)
  (let (started (clock-milliseconds)
        outcome (run-command! app (ref (:command call)))
        elapsed (- (clock-milliseconds) started))
    (log-answer log call (ref outcome) elapsed)
    (reply-for call outcome)))

(type log-answer
  (fn ((ref event-log)
       (ref mail-call)
       (ref (result json-value mail-error))
       u64)
    unit))

(defn log-answer (log call outcome elapsed)
  (match outcome
    ((ok _)
     (log-debug log log-area/window
                (str (:name call) " " elapsed "ms")))
    ((err failure)
     (log-warn log log-area/window
               (str (:name call)
                    " failed after " elapsed "ms: "
                    (error-kind failure)
                    ": "
                    (error-message failure))))))
