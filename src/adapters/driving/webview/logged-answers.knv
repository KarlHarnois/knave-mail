(use domain/log-entry ->log-entry log-area log-entry
                      log-level)

(use adapters/driving/json/commands reply-for run-command!)
(use adapters/driving/json/envelope failure-reply)
(use adapters/driving/json/mail-command mail-call)
(use adapters/json/value json-value)

(use adapters/driving/webview/listing-runner call-inbox
                                             deliver-reply!
                                             next-call
                                             reply-sink)

(use ports/driven/clock clock now-milliseconds)
(use app/client/account-book list-accounts!)
(use app/mail-app mail-app)
(use domain/mail-error error-kind error-message mail-error)
(use domain/results unwrap-ok-or)

(use ports/driven/event-log event-log log-debug record!
                            share-log)

(export answer-listings! answered-and-logged!
        refuse-listings!)

(type answer-listings!
  (fn ((mut mail-app)
       (ref call-inbox)
       (ref reply-sink))
    unit))

(defn answer-listings! (app inbox sink)
  (let (accounts (len (unwrap-ok-or (list-accounts! app) (vec))))
    (log-debug (ref (:log app))
               log-area/window
               (str "listing worker ready for " accounts " accounts")))
  (answer-queued-listings! app inbox sink))

(type answer-queued-listings!
  (fn ((mut mail-app)
       (ref call-inbox)
       (ref reply-sink))
    unit))

(defn answer-queued-listings! (app inbox sink)
  (match (next-call inbox)
    ((some call)
     (let (log (share-log (ref (:log app))))
       (deliver-reply! sink
                       (answered-and-logged! app (ref log) (ref call))))
     (recur app inbox sink))
    (none (do))))

(defn refuse-listings! (failure inbox sink)
  (match (next-call inbox)
    ((some call)
     (deliver-reply! sink
                     (failure-reply (ref (:id call)) failure))
     (recur failure inbox sink))
    (none (do))))

(type answered-and-logged!
  (fn ((mut mail-app)
       (ref event-log)
       (ref mail-call))
    string))

(defn answered-and-logged! (app log call)
  (let (started (now-milliseconds (ref clock/system))
        outcome (run-command! app (ref (:command call)))
        elapsed (- (now-milliseconds (ref clock/system)) started))
    (record! log
             (ref (answer-entry call (ref outcome) elapsed)))
    (reply-for call outcome)))

(type answer-entry
  (fn ((ref mail-call)
       (ref (result json-value mail-error))
       int)
    log-entry))

(defn answer-entry (call outcome elapsed)
  (match outcome
    ((ok _)
     (->log-entry log-level/debug log-area/window
                  (str (:name call) " " elapsed "ms")))
    ((err failure)
     (->log-entry log-level/warn log-area/window
                  (str (:name call)
                       " failed after " elapsed "ms: "
                       (error-kind failure)
                       ": "
                       (error-message failure))))))
