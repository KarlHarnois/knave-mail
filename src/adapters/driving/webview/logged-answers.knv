(use adapters/driving/webview/window-client answer-request!
                                            window-client)

(use adapters/driving/webview/listing-runner deliver-reply!
                                             reply-sink)

(use adapters/driving/webview/request-log clock-milliseconds
                                          reply-error)

(use adapters/driving/webview/window next-request
                                     request-inbox)

(use adapters/driving/json/envelope failure-reply null-id
                                    request-id)

(use adapters/json/value parse-json string-field)
(use domain/mail-error mail-error)
(use domain/results unwrap-ok-or)
(use ports/driven/event-log event-log log-debug log-warn)
(use ports/driving/account-book account-book list-accounts!)

(export answer-listings! answered-and-logged!
        refuse-listings!)

(def unnamed-request "request")

(defn answer-listings! (client log inbox sink)
  (log-debug log "window"
             (str "listing worker ready for "
                  (len (unwrap-ok-or (list-accounts! client) (vec)))
                  " accounts"))
  (answer-queued-listings! client log inbox sink))

(defn answer-queued-listings! (client log inbox sink)
  (match (next-request inbox)
    ((some request)
     (deliver-reply! sink
                     (answered-and-logged! client log
                                           (ref request)
                                           (ref (command-of (as-str request)))))
     (recur client log inbox sink))
    (none (do))))

(defn refuse-listings! (failure inbox sink)
  (match (next-request inbox)
    ((some request)
     (deliver-reply! sink
                     (failure-reply (ref (id-of (as-str request)))
                                    failure))
     (recur failure inbox sink))
    (none (do))))

(defn id-of (request-text)
  (match (parse-json request-text)
    ((ok request) (request-id (ref request)))
    ((err _) (null-id))))

(defn command-of (request-text)
  (match (parse-json request-text)
    ((ok request)
     (unwrap-ok-or (string-field (ref request) "command")
                   (str unnamed-request)))
    ((err _) (str unnamed-request))))

(type answered-and-logged!
  (where ((client window-client))
    (fn ((mut client)
         (ref (box event-log))
         (ref str)
         (ref str))
      string)))

(defn answered-and-logged! (client log request-text command)
  (let (started (clock-milliseconds)
        reply (answer-request! client request-text)
        elapsed (- (clock-milliseconds) started))
    (match (reply-error (ref reply))
      ((some problem)
       (log-warn log "window"
                 (str command " failed after " elapsed "ms: " problem)))
      (none (log-debug log "window" (str command " " elapsed "ms"))))
    reply))
