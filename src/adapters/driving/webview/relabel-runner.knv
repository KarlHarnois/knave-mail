(use adapters/driving/webview/window reply-outbox
                                     send-reply)

(use adapters/driving/json/envelope request-arguments)
(use adapters/json/value bool-field json-value string-field)
(use domain/label-commands label-change-named)

(export ->inline-relabel ->outbox-sink inline-relabel
        outbox-sink relabel-runner reply-sink
        worker-request?)

(deftrait relabel-runner
  (hand-off! (fn ((mut self) (ref str)) bool)))

(deftrait reply-sink
  (deliver-reply! (fn ((ref self) string) unit)))

(defstruct inline-relabel
  :handed-off i64)

(impl relabel-runner inline-relabel
  (hand-off! (runner request-text) false))

(defstruct outbox-sink
  :outbox reply-outbox)

(impl reply-sink outbox-sink
  (deliver-reply! (sink reply)
                  (send-reply (ref (:outbox sink)) reply)))

(defn worker-request? (command request)
  (or (relabel-command? command)
      (= command "thread-page")
      (and (= command "threads")
           (gmail-listing? (ref (request-arguments request))))))

(defn gmail-listing? (arguments)
  (or (match (string-field arguments "query")
        ((ok query) (not (empty? query)))
        (_ false))
      (match (bool-field arguments "fresh")
        ((ok fresh) fresh)
        (_ false))))

(defn relabel-command? (command)
  (match (label-change-named command)
    ((some _) true)
    (none false)))
