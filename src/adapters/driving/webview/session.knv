(use app/mail-app mail-app)

(use adapters/driving/webview/window-client answer-request!
                                            sync-mail!
                                            waiting-changes-of)

(use adapters/driving/json/envelope queue-event
                                    request-arguments
                                    request-id
                                    success-reply)

(use adapters/json/value json-value parse-json string-field)
(use adapters/driving/webview/logged-answers answered-and-logged!)

(use adapters/driving/webview/change-delivery change-delivery
                                              changes-queued!)

(use adapters/driving/webview/listing-runner hand-off!
                                             listing-request?
                                             listing-runner)

(use domain/label-commands label-command?)

(use adapters/driving/webview/sync-requests missing-account-reply
                                            sync-event)

(use adapters/driving/webview/sync-runner start-sync!
                                          sync-runner)

(use adapters/driving/webview/window next-request
                                     reply-outbox
                                     request-inbox
                                     send-reply)

(use adapters/driving/webview/window-commands empty-object
                                              finish-e2e
                                              report-e2e-line
                                              zoom-to)

(use adapters/driving/webview/link-requests open-requested-link!)
(use adapters/driving/webview/request-log record-frontend-entry!)
(use ports/driven/event-log event-log)
(use ports/driven/link-opener link-opener)

(export serve-requests!)

(defn serve-requests! (client runner lister deliverer log opener inbox outbox)
  (match (next-request inbox)
    ((some request)
     (handle-request! client runner lister deliverer log
                      opener
                      (ref request)
                      outbox)
     (recur client runner lister deliverer log opener inbox
            outbox))
    (none (do))))

(type handle-request!
  (where ((runner sync-runner)
          (lister listing-runner)
          (deliverer change-delivery))
    (fn ((mut mail-app)
         (mut runner)
         (mut lister)
         (mut deliverer)
         (ref (box event-log))
         (ref (box link-opener))
         (ref str)
         (ref reply-outbox))
      unit)))

(defn handle-request! (client runner lister deliverer log
                              opener request-text outbox)
  (match (parse-json request-text)
    ((ok request)
     (match (string-field (ref request) "command")
       ((ok "sync")
        (start-requested-sync! client runner (ref request) outbox))
       ((ok "e2e-report") (report-e2e-line (ref request)))
       ((ok "e2e-finish") (finish-e2e (ref request) outbox))
       ((ok "zoom") (zoom-to (ref request) outbox))
       ((ok "log") (record-frontend-entry! log (ref request)))
       ((ok "open-link")
        (open-requested-link! opener log (ref request)))
       ((ok command)
        (if (label-command? (as-str command))
          (answer-relabel! client deliverer log request-text
                           (ref command)
                           (ref request)
                           outbox)
          (when (not (and (listing-request? (ref command) (ref request))
                          (hand-off! lister request-text)))
            (send-reply
              outbox
              (answered-and-logged! client log request-text (ref command))))))
       (_ (send-reply outbox (answer-request! client request-text)))))
    ((err _)
     (send-reply outbox (answer-request! client request-text)))))

(type answer-relabel!
  (where ((deliverer change-delivery))
    (fn ((mut mail-app)
         (mut deliverer)
         (ref (box event-log))
         (ref str)
         (ref str)
         (ref json-value)
         (ref reply-outbox))
      unit)))

(defn answer-relabel! (client deliverer log request-text command request outbox)
  (send-reply outbox
              (answered-and-logged! client log request-text command))
  (changes-queued! deliverer)
  (match (string-field (ref (request-arguments request)) "account")
    ((ok account)
     (send-reply outbox
                 (queue-event (ref account)
                              (waiting-changes-of client (ref account)))))
    ((err _) (do))))

(type start-requested-sync!
  (where ((runner sync-runner))
    (fn ((mut mail-app)
         (mut runner)
         (ref json-value)
         (ref reply-outbox))
      unit)))

(defn start-requested-sync! (client runner request outbox)
  (match (string-field (ref (request-arguments request)) "account")
    ((ok account)
     (send-reply outbox
                 (success-reply (ref (request-id request))
                                (ref (empty-object))))
     (when (not (start-sync! runner (ref account) outbox))
       (send-reply outbox
                   (sync-event (sync-mail! client (ref account))
                               (ref account)))))
    ((err _)
     (send-reply outbox (missing-account-reply request)))))
