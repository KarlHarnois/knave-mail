(use adapters/driving/webview/change-delivery change-delivery)

(use adapters/driving/webview/command-answers answer-relabel!
                                              start-requested-sync!)

(use adapters/driving/webview/link-requests open-requested-link!)

(use adapters/driving/webview/listing-runner hand-off!
                                             listing-request?
                                             listing-runner)

(use adapters/driving/webview/logged-answers answered-and-logged!)
(use adapters/driving/webview/request-log record-frontend-entry!)
(use adapters/driving/webview/sync-runner sync-runner)

(use adapters/driving/webview/window next-request
                                     reply-outbox
                                     request-inbox
                                     send-reply)

(use adapters/driving/webview/window-client answer-request!)

(use adapters/driving/webview/window-commands finish-e2e
                                              report-e2e-line
                                              zoom-to)

(use adapters/json/value json-value parse-json string-field)
(use app/mail-app mail-app)
(use domain/label-commands label-command?)
(use ports/driven/event-log event-log)
(use ports/driven/link-opener link-opener)

(export ->window-workers serve-requests! window-workers)

(defstruct window-workers
  :sync sync-runner
  :listing listing-runner
  :delivery change-delivery
  :opener link-opener)

(type serve-requests!
  (fn ((mut mail-app)
       (ref window-workers)
       (ref (box event-log))
       (ref request-inbox)
       (ref reply-outbox))
    unit))

(defn serve-requests! (app workers log inbox outbox)
  (match (next-request inbox)
    ((some request)
     (handle-request! app workers log (ref request) outbox)
     (recur app workers log inbox outbox))
    (none (do))))

(type handle-request!
  (fn ((mut mail-app)
       (ref window-workers)
       (ref (box event-log))
       (ref str)
       (ref reply-outbox))
    unit))

(defn handle-request! (app workers log request-text outbox)
  (match (parse-json request-text)
    ((ok request)
     (handle-command! app workers log request-text
                      (ref request)
                      outbox))
    ((err _)
     (send-reply outbox (answer-request! app request-text)))))

(type handle-command!
  (fn ((mut mail-app)
       (ref window-workers)
       (ref (box event-log))
       (ref str)
       (ref json-value)
       (ref reply-outbox))
    unit))

(defn handle-command! (app workers log request-text request outbox)
  (match (string-field request "command")
    ((ok "sync")
     (start-requested-sync! app
                            (ref (:sync workers))
                            request outbox))
    ((ok "e2e-report") (report-e2e-line request))
    ((ok "e2e-finish") (finish-e2e request outbox))
    ((ok "zoom") (zoom-to request outbox))
    ((ok "log") (record-frontend-entry! log request))
    ((ok "open-link")
     (open-requested-link! (ref (:opener workers)) log request))
    ((ok command)
     (answer-command! app workers log request-text
                      (ref command)
                      request outbox))
    (_ (send-reply outbox (answer-request! app request-text)))))

(type answer-command!
  (fn ((mut mail-app)
       (ref window-workers)
       (ref (box event-log))
       (ref str)
       (ref string)
       (ref json-value)
       (ref reply-outbox))
    unit))

(defn answer-command! (app workers log request-text command request outbox)
  (cond
    ((label-command? (as-str command))
     (answer-relabel! app
                      (ref (:delivery workers))
                      log request-text
                      (as-str command)
                      request outbox))
    ((and (listing-request? command request)
          (hand-off! (ref (:listing workers)) request-text))
     (do))
    (else (send-reply outbox
                      (answered-and-logged! app log request-text command)))))
