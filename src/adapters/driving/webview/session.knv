(use adapters/driving/json/commands answer!)

(use adapters/driving/json/envelope request-arguments
                                    request-id
                                    success-reply)

(use adapters/driving/json/value json-value parse-json
                                 string-field)

(use adapters/driving/webview/logged-answers answered-and-logged!)

(use adapters/driving/webview/relabel-runner hand-off!
                                             relabel-runner
                                             worker-request?)

(use adapters/driving/webview/sync-requests sync-event)

(use adapters/driving/webview/sync-runner start-sync!
                                          sync-runner)

(use adapters/driving/webview/window next-request
                                     reply-outbox
                                     request-inbox
                                     send-reply)

(use adapters/driving/webview/window-commands empty-object
                                              finish-e2e
                                              report-e2e-line
                                              zoom-to)

(use adapters/driving/webview/request-log record-frontend-entry!)
(use ports/driven/event-log event-log)
(use ports/driving/mail-client mail-client sync-account!)

(export serve-requests!)

(type serve-requests!
  (where ((client mail-client)
          (runner sync-runner)
          (relabeler relabel-runner))
    (fn ((mut client)
         (mut runner)
         (mut relabeler)
         (ref (box event-log))
         (ref request-inbox)
         (ref reply-outbox))
      unit)))

(defn serve-requests! (client runner relabeler log inbox outbox)
  (match (next-request inbox)
    ((some request)
     (handle-request! client runner relabeler log
                      (ref request)
                      outbox)
     (recur client runner relabeler log inbox outbox))
    (none (do))))

(type handle-request!
  (where ((client mail-client)
          (runner sync-runner)
          (relabeler relabel-runner))
    (fn ((mut client)
         (mut runner)
         (mut relabeler)
         (ref (box event-log))
         (ref str)
         (ref reply-outbox))
      unit)))

(defn handle-request! (client runner relabeler log request-text outbox)
  (match (parse-json request-text)
    ((ok request)
     (match (string-field (ref request) "command")
       ((ok "sync")
        (start-requested-sync! client runner (ref request) outbox))
       ((ok "e2e-report") (report-e2e-line (ref request)))
       ((ok "e2e-finish") (finish-e2e (ref request) outbox))
       ((ok "zoom") (zoom-to (ref request) outbox))
       ((ok "log") (record-frontend-entry! log (ref request)))
       ((ok command)
        (when (not (and (worker-request? (ref command) (ref request))
                        (hand-off! relabeler request-text)))
          (send-reply
            outbox
            (answered-and-logged! client log request-text (ref command)))))
       (_ (send-reply outbox (answer! client request-text)))))
    ((err _) (send-reply outbox (answer! client request-text)))))

(type start-requested-sync!
  (where ((client mail-client) (runner sync-runner))
    (fn ((mut client)
         (mut runner)
         (ref json-value)
         (ref reply-outbox))
      unit)))

(defn start-requested-sync! (client runner request outbox)
  (match (string-field (ref (request-arguments request)) "account")
    ((ok account)
     (send-reply outbox
                 (success-reply (ref (request-id request))
                                (ref (empty-object))))
     (when (not (start-sync! runner (ref account) outbox))
       (send-reply outbox
                   (sync-event (sync-account! client (ref account))
                               (ref account)))))
    ((err _)
     (send-reply outbox
                 (answer! client "{\"command\":\"sync\"}")))))
