(use adapters/driving/json/envelope failure-reply)

(use adapters/driving/json/mail-command mail-call
                                        mail-command
                                        worker-listing?)

(use adapters/driving/webview/change-delivery change-delivery)

(use adapters/driving/webview/command-answers answer-relabel!
                                              start-requested-sync!)

(use adapters/driving/webview/link-requests open-requested-link!)

(use adapters/driving/webview/listing-runner hand-off
                                             hand-off!
                                             listing-runner)

(use adapters/driving/webview/logged-answers answered-and-logged!)
(use adapters/driving/webview/sync-runner sync-runner)

(use adapters/driving/webview/window next-request
                                     reply-outbox
                                     request-inbox
                                     send-reply)

(use adapters/driving/webview/window-commands finish-e2e
                                              zoom-to)

(use adapters/driving/webview/window-request e2e-outcome
                                             text->window-request
                                             window-request)

(use app/mail-app mail-app)
(use ports/driven/event-log event-log record!)
(use ports/driven/link-opener link-opener)

(export ->window-workers serve-requests! window-workers)

(defstruct window-workers
  :sync sync-runner
  :listing listing-runner
  :delivery change-delivery
  :opener link-opener)

(defn serve-requests! (app workers log inbox outbox)
  (match (next-request inbox)
    ((some request)
     (handle-request! app workers log (ref request) outbox)
     (recur app workers log inbox outbox))
    (none (do))))

(type handle-request!
  (fn ((mut mail-app)
       (ref window-workers)
       (ref event-log)
       (ref str)
       (ref reply-outbox))
    unit))

(defn handle-request! (app workers log request-text outbox)
  (match (text->window-request request-text)
    ((sync-account id account)
     (start-requested-sync! app
                            (ref (:sync workers))
                            (ref id)
                            (ref account)
                            outbox))
    ((e2e-report line) (println line))
    ((e2e-problem problem) (eprintln problem))
    ((e2e-finish outcome) (finish-e2e outcome outbox))
    ((zoom id level) (zoom-to (ref id) level outbox))
    ((frontend-log entry) (record! log (ref entry)))
    ((open-link url)
     (open-requested-link! (ref (:opener workers))
                           log
                           (ref url)))
    ((mail call) (answer-mail! app workers log call outbox))
    ((refused id failure)
     (send-reply outbox
                 (failure-reply (ref id) (ref failure))))))

(type answer-mail!
  (fn ((mut mail-app)
       (ref window-workers)
       (ref event-log)
       mail-call
       (ref reply-outbox))
    unit))

(defn answer-mail! (app workers log call outbox)
  (match (:command call)
    ((relabel account _ _)
     (answer-relabel! app
                      (ref (:delivery workers))
                      log
                      (ref call)
                      (as-str account)
                      outbox))
    (_ (answer-here-or-hand-off! app workers log call outbox))))

(type answer-here-or-hand-off!
  (fn ((mut mail-app)
       (ref window-workers)
       (ref event-log)
       mail-call
       (ref reply-outbox))
    unit))

(defn answer-here-or-hand-off! (app workers log call outbox)
  (match (hand-off! (ref (:listing workers)) call)
    (handed (do))
    ((kept held)
     (send-reply outbox
                 (answered-and-logged! app log (ref held))))))
