(use adapters/driving/json/commands answer!)

(use adapters/driving/json/envelope failure-event null-id
                                    request-arguments
                                    request-id success-reply
                                    synced-event)

(use adapters/driving/json/value json-value parse-json
                                 string-field)

(use adapters/driving/webview/sync-runner start-sync!
                                          sync-runner)

(use adapters/driving/webview/window next-request
                                     reply-outbox
                                     request-inbox
                                     send-reply)

(use adapters/driving/webview/window-commands empty-object
                                              finish-e2e
                                              report-e2e-line
                                              zoom-to)

(use adapters/driving/webview/request-log clock-milliseconds
                                          record-frontend-entry!
                                          reply-error)

(use domain/mail-error mail-error)
(use ports/driven/event-log event-log log-debug log-warn)
(use ports/driving/mail-client mail-client sync-account!)

(export serve-requests! sync-event)

(type serve-requests!
  (where ((client mail-client) (runner sync-runner))
    (fn ((mut client)
         (mut runner)
         (ref (box event-log))
         (ref request-inbox)
         (ref reply-outbox))
      unit)))

(defn serve-requests! (client runner log inbox outbox)
  (match (next-request inbox)
    ((some request)
     (handle-request! client runner log (ref request) outbox)
     (recur client runner log inbox outbox))
    (none (do))))

(type handle-request!
  (where ((client mail-client) (runner sync-runner))
    (fn ((mut client)
         (mut runner)
         (ref (box event-log))
         (ref str)
         (ref reply-outbox))
      unit)))

(defn handle-request! (client runner log request-text outbox)
  (match (parse-json request-text)
    ((ok request)
     (match (string-field (ref request) "command")
       ((ok "sync")
        (start-requested-sync! client runner (ref request) outbox))
       ((ok "e2e-report") (report-e2e-line (ref request)))
       ((ok "e2e-finish") (finish-e2e (ref request) outbox))
       ((ok "zoom") (zoom-to (ref request) outbox))
       ((ok "log") (record-frontend-entry! log (ref request)))
       ((ok command)
        (send-reply
          outbox
          (answered-and-logged! client log request-text (ref command))))
       (_ (send-reply outbox (answer! client request-text)))))
    ((err _) (send-reply outbox (answer! client request-text)))))

(type start-requested-sync!
  (where ((client mail-client) (runner sync-runner))
    (fn ((mut client)
         (mut runner)
         (ref json-value)
         (ref reply-outbox))
      unit)))

(defn start-requested-sync! (client runner request outbox)
  (match (string-field (ref (request-arguments request)) "account")
    ((ok account)
     (send-reply outbox
                 (success-reply (ref (request-id request))
                                (ref (empty-object))))
     (when (not (start-sync! runner (ref account) outbox))
       (send-reply outbox
                   (sync-event (sync-account! client (ref account))
                               (ref account)))))
    ((err _)
     (send-reply outbox
                 (answer! client "{\"command\":\"sync\"}")))))

(type sync-event
  (fn ((result unit mail-error) (ref str))
    string))

(defn sync-event (outcome account)
  (match outcome
    ((ok _) (synced-event account))
    ((err failure) (failure-event account (ref failure)))))

(type answered-and-logged!
  (where ((client mail-client))
    (fn ((mut client)
         (ref (box event-log))
         (ref str)
         (ref str))
      string)))

(defn answered-and-logged! (client log request-text command)
  (let (started (clock-milliseconds)
        reply (answer! client request-text)
        elapsed (- (clock-milliseconds) started))
    (match (reply-error (ref reply))
      ((some problem)
       (log-warn log "window"
                 (str command " failed after " elapsed "ms: " problem)))
      (none (log-debug log "window" (str command " " elapsed "ms"))))
    reply))
