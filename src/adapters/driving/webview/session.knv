(use adapters/driving/json/commands answer!)

(use adapters/driving/json/envelope failure-event null-id
                                    request-arguments
                                    request-id success-reply
                                    synced-event)

(use adapters/driving/json/value bool-field json-value
                                 parse-json string-field)

(use adapters/driving/webview/sync-runner start-sync!
                                          sync-runner)

(use adapters/driving/webview/window close-window
                                     next-request
                                     reply-outbox
                                     request-inbox
                                     send-reply)

(use domain/mail-error mail-error)
(use ports/driving/mail-client mail-client sync-account!)

(export serve-requests! sync-event)

(type serve-requests!
  (where ((client mail-client) (runner sync-runner))
    (fn ((mut client)
         (mut runner)
         (ref request-inbox)
         (ref reply-outbox))
      unit)))

(defn serve-requests! (client runner inbox outbox)
  (match (next-request inbox)
    ((some request)
     (handle-request! client runner (ref request) outbox)
     (recur client runner inbox outbox))
    (none (do))))

(type handle-request!
  (where ((client mail-client) (runner sync-runner))
    (fn ((mut client)
         (mut runner)
         (ref str)
         (ref reply-outbox))
      unit)))

(defn handle-request! (client runner request-text outbox)
  (match (parse-json request-text)
    ((ok request)
     (match (string-field (ref request) "command")
       ((ok "sync")
        (start-requested-sync! client runner (ref request) outbox))
       ((ok "e2e-report") (report-e2e-line (ref request)))
       ((ok "e2e-finish") (finish-e2e (ref request) outbox))
       (_ (send-reply outbox (answer! client request-text)))))
    ((err _) (send-reply outbox (answer! client request-text)))))

(type start-requested-sync!
  (where ((client mail-client) (runner sync-runner))
    (fn ((mut client)
         (mut runner)
         (ref json-value)
         (ref reply-outbox))
      unit)))

(defn start-requested-sync! (client runner request outbox)
  (match (string-field (ref (request-arguments request)) "account")
    ((ok account)
     (send-reply outbox
                 (success-reply (ref (request-id request))
                                (ref (empty-object))))
     (when (not (start-sync! runner (ref account) outbox))
       (send-reply outbox
                   (sync-event (sync-account! client (ref account))
                               (ref account)))))
    ((err _)
     (send-reply outbox
                 (answer! client "{\"command\":\"sync\"}")))))

(type sync-event
  (fn ((result unit mail-error) (ref str))
    string))

(defn sync-event (outcome account)
  (match outcome
    ((ok _) (synced-event account))
    ((err failure) (failure-event account (ref failure)))))

(type report-e2e-line
  (fn ((ref json-value)) unit))

(defn report-e2e-line (request)
  (match (string-field (ref (request-arguments request)) "line")
    ((ok line) (println line))
    ((err problem) (eprintln problem))))

(type finish-e2e
  (fn ((ref json-value) (ref reply-outbox))
    unit))

(defn finish-e2e (request outbox)
  (close-window outbox
                (match (bool-field (ref (request-arguments request)) "passed")
                  ((ok true) 0)
                  (_ 1))))

(def empty-object
  (rust "serde_json::json!({{}})" (fn () json-value)))
