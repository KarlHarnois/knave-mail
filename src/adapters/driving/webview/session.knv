(use adapters/driving/json/envelope failure-reply)

(use adapters/driving/json/mail-command mail-call
                                        mail-command
                                        worker-listing?)

(use adapters/driving/webview/window-client send-waiting-changes!)
(use adapters/driving/webview/window-session window-session)

(use adapters/driving/webview/command-answers answer-relabel!
                                              start-requested-sync!)

(use adapters/driving/webview/link-requests open-requested-link!)

(use adapters/driving/webview/listing-runner hand-off
                                             hand-off!)

(use adapters/driving/webview/logged-answers answered-and-logged!)

(use adapters/driving/webview/window next-request
                                     reply-outbox
                                     request-inbox
                                     send-reply)

(use adapters/driving/webview/window-commands finish-e2e
                                              zoom-to)

(use adapters/driving/webview/window-request e2e-outcome
                                             text->window-request
                                             window-request)

(use app/mail-app mail-app)
(use ports/driven/event-log event-log record!)

(export serve-requests!)

(type serve-requests!
  (fn ((mut mail-app)
       (ref window-session)
       (ref request-inbox))
    unit))

(defn serve-requests! (app session inbox)
  (match (next-request inbox)
    ((some request)
     (handle-request! app session (ref request))
     (recur app session inbox))
    (none (do))))

(type handle-request!
  (fn ((mut mail-app)
       (ref window-session)
       (ref str))
    unit))

(defn handle-request! (app session request-text)
  (let (outbox (ref (:outbox session))
        log (ref (:log session)))
    (match (text->window-request request-text)
      ((sync-account call)
       (start-requested-sync! app session (ref call)))
      ((e2e-report line) (println line))
      ((e2e-problem problem) (eprintln problem))
      ((e2e-finish outcome) (finish-e2e outcome outbox))
      ((zoom id level) (zoom-to (ref id) level outbox))
      ((frontend-log entry) (record! log (ref entry)))
      ((open-link url)
       (open-requested-link! (ref (:opener (:workers session)))
                             log
                             (ref url)))
      ((mail call) (answer-mail! app session call))
      ((refused id failure)
       (send-reply outbox
                   (failure-reply (ref id) (ref failure)))))))

(type answer-mail!
  (fn ((mut mail-app) (ref window-session) mail-call)
    unit))

(defn answer-mail! (app session call)
  (match (:command call)
    ((relabel request)
     (answer-relabel! app session (ref call))
     (send-waiting-changes! app
                            (ref (:outbox session))
                            (as-str (:account request))))
    (_ (answer-here-or-hand-off! app session call))))

(type answer-here-or-hand-off!
  (fn ((mut mail-app) (ref window-session) mail-call)
    unit))

(defn answer-here-or-hand-off! (app session call)
  (match (hand-off! (ref (:listing (:workers session)))
                    call)
    (handed (do))
    ((kept held)
     (send-reply (ref (:outbox session))
                 (answered-and-logged! app
                                       (ref (:log session))
                                       (ref held))))))
