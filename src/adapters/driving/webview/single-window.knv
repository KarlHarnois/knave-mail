(use adapters/driving/webview/window reply-outbox)

(export claimed-window forward-launches! socket-path-for
        window-claim window-socket)

(deftype window-socket
  (rust "std::os::unix::net::UnixListener"))

(defenum window-claim
  (claimed window-socket)
  another-window-open
  unguarded)

(defn claimed-window (cache-path)
  (let (path (socket-path-for cache-path))
    (if (asked-open-window-forward? (as-str path))
      window-claim/another-window-open
      (match (bound-socket (as-str path))
        ((some socket) (window-claim/claimed socket))
        (none window-claim/unguarded)))))

(def socket-path-for
  (rust "native::single_window::socket_path_for({0})"
    (fn ((ref str)) string)))

(def asked-open-window-forward?
  (rust "std::os::unix::net::UnixStream::connect({0}).and_then(|mut {!stream}| {{ use std::io::Write; {!stream}.write_all(b\"focus\\n\") }}).is_ok()"
    (fn ((ref str)) bool)))

(def bound-socket
  (rust "{{ let _ = std::fs::remove_file({0}); std::os::unix::net::UnixListener::bind({0}).ok() }}"
    (fn ((ref str)) (option window-socket))))

(def forward-launches!
  (rust "native::single_window::forward_launches({0}, {1})"
    (fn (window-socket (ref reply-outbox)) unit)))
