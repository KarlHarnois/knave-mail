(use adapters/driving/json/commands answer!)
(use adapters/driving/json/envelope request-arguments)
(use adapters/json/value json-value string-field)
(use domain/results unwrap-ok-or)
(use domain/log-entry ->log-entry log-level)
(use ports/driven/event-log event-log record!)
(use adapters/clock clock-milliseconds)

(export clock-milliseconds record-frontend-entry!
        reply-error)

(type record-frontend-entry!
  (fn ((ref event-log) (ref json-value))
    unit))

(defn record-frontend-entry! (log request)
  (let (arguments (request-arguments request))
    (record! log
             (ref (->log-entry
                    (level-named (ref (unwrap-ok-or
                                        (string-field (ref arguments) "level")
                                        (str "info"))))
                    (str "frontend")
                    (unwrap-ok-or (string-field (ref arguments) "message")
                                  (str "")))))))

(defn level-named (name)
  (match name
    ("error" log-level/error)
    ("warn" log-level/warn)
    ("debug" log-level/debug)
    (_ log-level/info)))

(def reply-error
  (rust "serde_json::from_str::<serde_json::Value>(&{0}).ok().and_then(|{!reply}| {!reply}.get(\"error\").map(|{!error}| format!(\"{{}}: {{}}\", {!error}.get(\"kind\").and_then(|{!kind}| {!kind}.as_str()).unwrap_or(\"unknown\"), {!error}.get(\"message\").and_then(|{!message}| {!message}.as_str()).unwrap_or(\"\"))))"
    (fn ((ref str)) (option string))))
