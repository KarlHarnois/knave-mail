(use domain/web-link web-link-host)
(use ports/driven/event-log event-log log-info log-warn)
(use ports/driven/link-opener link-opener open-link!)

(export open-requested-link!)

(def area "window")

(type open-requested-link!
  (fn ((ref link-opener)
       (ref event-log)
       (ref str))
    unit))

(defn open-requested-link! (opener log url)
  (match (web-link-host url)
    ((some host)
     (do
       (open-link! opener url)
       (log-info log area (str "opened link to " host))))
    (none (log-warn log area
                    (str "refused to open a link that is not http or https")))))
