(export sexp-tokens string-token? token-text)

(def sexp-tokens
  (rust "{{ let mut {!tokens} = Vec::<String>::new(); let mut {!chars} = {0}.chars().peekable(); while let Some({!c}) = {!chars}.next() {{ match {!c} {{ '(' | ')' => {!tokens}.push({!c}.to_string()), ';' => {{ for {!n} in {!chars}.by_ref() {{ if {!n} == '\\n' {{ break; }} }} }} '\"' => {{ let mut {!s} = String::from(\"\\\"\"); for {!n} in {!chars}.by_ref() {{ if {!n} == '\"' {{ break; }} {!s}.push({!n}); }} {!tokens}.push({!s}); }} {!w} if {!w}.is_whitespace() => {{}} {!other} => {{ let mut {!atom} = {!other}.to_string(); while let Some(&{!n}) = {!chars}.peek() {{ if {!n}.is_whitespace() || {!n} == '(' || {!n} == ')' {{ break; }} {!atom}.push({!n}); {!chars}.next(); }} {!tokens}.push({!atom}); }} }} }} {!tokens} }}"
    (fn ((ref str)) (vec string))))

(def string-token?
  (rust "{0}.starts_with('\"')"
    (fn ((ref str)) bool)))

(def token-text
  (rust "{0}.trim_start_matches('\"').to_string()"
    (fn ((ref str)) string)))
