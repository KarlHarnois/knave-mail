(use adapters/driving/webview/keymap/sexp-tokens sexp-tokens
                                                 string-token?
                                                 token-text)

(use domain/collections appended)

(export ->keymap-entry ->keymapped keymap-entry keymap-file
        keymap-mode keymap-mode->name keymapped)

(defenum keymap-mode
  normal
  insert
  visual)

(def keymap-modes
  (vec keymap-mode/normal keymap-mode/insert
       keymap-mode/visual))

(def entry-width 5)

(defstruct keymap-entry
  :mode keymap-mode
  :keys string
  :action string)

(defstruct keymapped
  :entries (vec keymap-entry)
  :warnings (vec string))

(type keymap-file
  (fn ((ref str)) keymapped))

(defn keymap-file (text)
  (let (tokens (sexp-tokens text))
    (if (wrapped-in-keymap? (ref tokens))
      (read-entries (ref tokens)
                    2
                    (vec)
                    (vec))
      (->keymapped (vec)
                   (vec (str "keymap.knv: the file must be one (keymap ...) form"))))))

(defn read-entries (tokens index entries warnings)
  (if (>= (inc index) (len tokens))
    (->keymapped entries warnings)
    (read-entry tokens index entries warnings)))

(defn read-entry (tokens index entries warnings)
  (match (entry-at tokens index)
    ((ok entry)
     (read-entries tokens
                   (+ index entry-width)
                   (appended entries entry)
                   warnings))
    ((err problem)
     (read-entries tokens
                   (next-entry tokens index)
                   entries
                   (appended warnings (str "keymap.knv: " problem))))))

(defn entry-at (tokens index)
  (let (opening (token-at tokens index)
        mode (token-at tokens (inc index))
        keys (token-at tokens (+ index 2))
        action (token-at tokens (+ index 3))
        closing (token-at tokens (+ index 4)))
    (cond
      ((not (and (= opening "(") (= closing ")")))
       (err (str "write each entry as (mode \"keys\" \"action\")")))
      ((not (and (string-token? (ref keys))
                 (string-token? (ref action))))
       (err (str "quote the keys and the action of the " mode " entry")))
      ((empty? (token-text (ref keys)))
       (err (str "the keys of the " mode " entry are empty")))
      (else (map-ok (text->keymap-mode (as-str mode))
              (fn (parsed)
                (->keymap-entry parsed
                                (token-text (ref keys))
                                (token-text (ref action)))))))))

(type text->keymap-mode
  (fn ((ref str))
    (result keymap-mode string)))

(defn text->keymap-mode (text)
  (ok-or (-> (iter keymap-modes)
             (find (fn (mode)
                     (= (keymap-mode->name mode) text)))
             (map-some (fn (mode) (deref mode))))
         (str "unknown mode " text "; use normal, insert or visual")))

(type keymap-mode->name
  (fn ((ref keymap-mode)) (ref str)))

(defn keymap-mode->name (mode)
  (match mode
    (normal "normal")
    (insert "insert")
    (visual "visual")))

(defn wrapped-in-keymap? (tokens)
  (and (>= (len tokens) 3)
       (= (at tokens 0) "(")
       (= (at tokens 1) "keymap")
       (closed? tokens)
       (balanced? tokens)))

(type closed?
  (fn ((ref (vec string))) bool))

(defn closed? (tokens)
  (match (last tokens)
    ((some token) (= token ")"))
    (none false)))

(defn balanced? (tokens)
  (= (occurrences tokens "(") (occurrences tokens ")")))

(type occurrences
  (fn ((ref (vec string)) (ref str))
    usize))

(defn occurrences (tokens wanted)
  (-> (iter tokens)
      (filter (fn (token) (= (deref token) wanted)))
      count))

(defn token-at (tokens index)
  (match (get tokens index)
    ((some token) (clone token))
    (none (str ""))))

(type next-entry
  (fn ((ref (vec string)) usize) usize))

(defn next-entry (tokens index)
  (loop (position (inc index))
    (cond
      ((>= position (len tokens)) (len tokens))
      ((= (at tokens position) "(") position)
      (else (recur (inc position))))))
