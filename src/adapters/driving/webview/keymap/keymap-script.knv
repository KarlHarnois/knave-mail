(use adapters/driving/webview/keymap/keymap-file keymap-entry
                                                 keymap-mode->name)

(export keymap-script)

(type keymap-script
  (fn ((ref (vec keymap-entry))) string))

(defn keymap-script (entries)
  (str "window.knaveKeymap = ["
       (join (-> (iter entries)
                 (map (fn (entry)
                        (entry-json (keymap-mode->name (ref (:mode entry)))
                                    (as-str (:keys entry))
                                    (as-str (:action entry)))))
                 collect)
             ",")
       "];\n"))

(def entry-json
  (rust "serde_json::json!({{\"mode\": {0}, \"keys\": {1}, \"action\": {2}}}).to_string()"
    (fn ((ref str) (ref str) (ref str))
      string)))
