(use adapters/driving/json/envelope queue-event
                                    success-reply)

(use adapters/driving/json/mail-command mail-call)

(use adapters/driving/webview/change-delivery change-delivery
                                              changes-queued!)

(use adapters/driving/webview/logged-answers answered-and-logged!)
(use adapters/driving/webview/sync-requests sync-event)

(use adapters/driving/webview/sync-runner start-sync!
                                          sync-runner)

(use adapters/driving/webview/window reply-outbox
                                     send-reply)

(use adapters/driving/webview/window-client sync-mail!
                                            waiting-changes-of)

(use adapters/json/value empty-object json-value)
(use app/mail-app mail-app)
(use ports/driven/event-log event-log)

(export answer-relabel! start-requested-sync!)

(type answer-relabel!
  (fn ((mut mail-app)
       (ref change-delivery)
       (ref event-log)
       (ref mail-call)
       (ref str)
       (ref reply-outbox))
    unit))

(defn answer-relabel! (app delivery log call account outbox)
  (send-reply outbox (answered-and-logged! app log call))
  (changes-queued! delivery)
  (send-reply outbox
              (queue-event account (waiting-changes-of app account))))

(type start-requested-sync!
  (fn ((mut mail-app)
       (ref sync-runner)
       (ref json-value)
       (ref str)
       (ref reply-outbox))
    unit))

(defn start-requested-sync! (app runner id account outbox)
  (send-reply outbox
              (success-reply id (ref (empty-object))))
  (when (not (start-sync! runner account outbox))
    (send-reply outbox
                (sync-event (sync-mail! app account) account))))
