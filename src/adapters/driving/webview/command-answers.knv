(use adapters/driving/json/envelope success-reply)
(use adapters/driving/json/mail-command mail-call)
(use adapters/driving/webview/change-delivery changes-queued!)
(use adapters/driving/webview/logged-answers answered-and-logged!)
(use adapters/driving/webview/sync-requests sync-event)

(use adapters/driving/webview/sync-runner start-sync!
                                          sync-start)

(use adapters/driving/webview/window reply-outbox
                                     send-reply)

(use adapters/driving/webview/window-client sync-mail!)
(use adapters/driving/webview/window-request sync-call)
(use adapters/driving/webview/window-session window-session)
(use adapters/json/value empty-object)
(use app/mail-app mail-app)

(export answer-relabel! start-requested-sync!)

(type answer-relabel!
  (fn ((mut mail-app)
       (ref window-session)
       (ref mail-call))
    unit))

(defn answer-relabel! (app session call)
  (send-reply (ref (:outbox session))
              (answered-and-logged! app (ref (:log session)) call))
  (changes-queued! (ref (:delivery (:workers session)))))

(type start-requested-sync!
  (fn ((mut mail-app)
       (ref window-session)
       (ref sync-call))
    unit))

(defn start-requested-sync! (app session call)
  (let (outbox (ref (:outbox session))
        account (as-str (:account call)))
    (send-reply outbox
                (success-reply (ref (:id call))
                               (ref (empty-object))))
    (match (start-sync! (ref (:sync (:workers session)))
                        account outbox)
      (started-in-background (do))
      (run-here (send-reply outbox
                            (sync-event (sync-mail! app account) account))))))
