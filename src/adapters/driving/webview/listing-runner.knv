(use adapters/driving/webview/window reply-outbox
                                     send-reply)

(use adapters/driving/json/envelope request-arguments)
(use adapters/json/value bool-field json-value string-field)

(export ->inline-listing ->outbox-sink inline-listing
        listing-request? listing-runner outbox-sink
        reply-sink)

(deftrait listing-runner
  (hand-off!
    (fn ((mut self) (ref str)) bool)))

(deftrait reply-sink
  (deliver-reply!
    (fn ((ref self) string) unit)))

(defstruct inline-listing)

(impl listing-runner inline-listing
  (hand-off! (_runner _request-text) false))

(defstruct outbox-sink
  :outbox reply-outbox)

(impl reply-sink outbox-sink
  (deliver-reply! (sink reply)
    (send-reply (ref (:outbox sink)) reply)))

(defn listing-request? (command request)
  (or (= command "thread-page")
      (= command "archive-older")
      (and (= command "threads")
           (gmail-listing? (ref (request-arguments request))))))

(defn gmail-listing? (arguments)
  (or (match (string-field arguments "query")
        ((ok query) (not (empty? query)))
        (_ false))
      (match (bool-field arguments "fresh")
        ((ok fresh) fresh)
        (_ false))))
