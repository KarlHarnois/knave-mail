(use adapters/driving/webview/window reply-outbox
                                     send-reply)

(use adapters/driving/json/envelope request-arguments)
(use adapters/json/value bool-field json-value string-field)
(use adapters/driven/memory/shared shared with-shared!)

(export deliver-reply! hand-off! listing-queue
        listing-request? listing-runner reply-sink)

(deftype listing-queue
  (rust "std::sync::mpsc::Sender<String>"))

(defenum listing-runner
  inline
  (background listing-queue))

(defn hand-off! (runner request-text)
  (match runner
    (inline false)
    ((background queue) (enqueue! queue request-text))))

(def enqueue!
  (rust "{0}.send({1}.to_string()).is_ok()"
    (fn ((ref listing-queue) (ref str))
      bool)))

(defenum reply-sink
  (outbox reply-outbox)
  (collected (shared (vec string))))

(type deliver-reply!
  (fn ((ref reply-sink) string) unit))

(defn deliver-reply! (sink reply)
  (match sink
    ((outbox outbox) (send-reply outbox reply))
    ((collected replies)
     (with-shared! replies
       (fn (held) (push! held reply))))))

(defn listing-request? (command request)
  (or (= command "thread-page")
      (= command "archive-older")
      (and (= command "threads")
           (gmail-listing? (ref (request-arguments request))))))

(defn gmail-listing? (arguments)
  (or (match (string-field arguments "query")
        ((ok query) (not (empty? query)))
        (_ false))
      (match (bool-field arguments "fresh")
        ((ok fresh) fresh)
        (_ false))))
