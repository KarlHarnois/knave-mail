(use adapters/driven/gmail/http http-agent http-get
                                http-post-form)

(use adapters/driven/google-oauth/consent-browser consent-browser
                                                  open-url!)

(use adapters/driven/google-oauth/loopback bind-loopback
                                           loopback-port)

(use adapters/driven/google-oauth/redirect redirect-answer
                                           reply-to-browser!
                                           wait-for-redirect)

(use adapters/driven/google-oauth/pkce new-pkce-pair
                                       new-state pkce-pair)

(use adapters/driven/google-oauth/token-reply body->granted-tokens
                                              body->profile-email
                                              text-error->auth-error
                                              text-error->network-error)

(use adapters/driven/google-oauth/oauth-settings consent-url
                                                 oauth-settings)

(use domain/mail ->account account)
(use domain/mail-error mail-error)
(use ports/driven/authorizer authorizer)
(use ports/driven/credentials credentials save-token!)

(export ->google-authorizer google-authorizer)

(defstruct google-authorizer
  :agent http-agent
  :settings oauth-settings
  :credentials (box credentials)
  :browser (box consent-browser))

(impl authorizer google-authorizer
  (authorize! (granting) (consented-account! granting)))

(type consented-account!
  (fn ((mut google-authorizer))
    (result account mail-error)))

(defn consented-account! (granting)
  (let (listener (try (text-error->auth-error (bind-loopback)))
        request (consent-request-on (ref listener))
        url (consent-url (ref (:settings granting))
                         (ref (:redirect-uri request))
                         (ref (:pkce request))
                         (ref (:state request))))
    (try (open-url! (mut (:browser granting))
                    (ref url)))
    (let (wait (:sign-in-wait-milliseconds (:settings granting))
          redirect (try (text-error->auth-error
                          (wait-for-redirect (ref listener) wait)))
          outcome (answered-account! granting
                                     (ref (:answer redirect))
                                     (ref request)))
      (reply-to-browser! redirect outcome))))

(defn consent-request-on (listener)
  (->consent-request :redirect-uri (str "http://127.0.0.1:"
                                        (loopback-port listener))
                     :pkce (new-pkce-pair)
                     :state (new-state)))

(defstruct consent-request
  :redirect-uri string
  :pkce pkce-pair
  :state string)

(type answered-account!
  (fn ((mut google-authorizer)
       (ref redirect-answer)
       (ref consent-request))
    (result account mail-error)))

(defn answered-account! (granting answer request)
  (match answer
    ((granted code state)
     (granted-account! granting code state request))
    ((refused reason)
     (err (mail-error/auth-required (str "Google refused consent: " reason))))
    (not-a-redirect (err (mail-error/auth-required (str "the browser sent no sign-in answer"))))))

(type granted-account!
  (fn ((mut google-authorizer)
       (ref string)
       (ref string)
       (ref consent-request))
    (result account mail-error)))

(defn granted-account! (granting code state request)
  (if (= state (:state request))
    (exchange-code! granting
                    (as-str code)
                    (ref (:redirect-uri request))
                    (ref (:pkce request)))
    (err (mail-error/auth-required (str "the sign-in answer did not match this request")))))

(type exchange-code!
  (fn ((mut google-authorizer)
       (ref str)
       (ref str)
       (ref pkce-pair))
    (result account mail-error)))

(defn exchange-code! (granting code redirect-uri pkce)
  (let (settings (ref (:settings granting))
        form (vec (pair (str "grant_type") (str "authorization_code"))
                  (pair (str "code") (str code))
                  (pair (str "client_id")
                        (clone (:client-id settings)))
                  (pair (str "client_secret")
                        (clone (:client-secret settings)))
                  (pair (str "redirect_uri") (str redirect-uri))
                  (pair (str "code_verifier")
                        (clone (:verifier pkce))))
        reply (try (text-error->network-error (http-post-form
                                                (ref (:agent granting))
                                                (ref (:token-url settings))
                                                (ref form))))
        tokens (try (body->granted-tokens (as-str (:body reply))))
        email (try (profile-email granting (as-str (:access-token tokens)))))
    (try (save-token! (mut (:credentials granting))
                      (ref email)
                      (ref (:refresh-token tokens))))
    (ok (->account email))))

(type profile-email
  (fn ((ref google-authorizer) (ref str))
    (result string mail-error)))

(defn profile-email (granting access-token)
  (let (url (str (:api-base (:settings granting))
                 "/gmail/v1/users/me/profile")
        reply (try (text-error->network-error (http-get (ref (:agent granting))
                                                        (ref url)
                                                        access-token))))
    (body->profile-email (as-str (:body reply)))))
