(export query-field)

(defn query-field (target name)
  (let (escaped (raw-query-field target name))
    (percent-decoded (ref escaped))))

(def raw-query-field
  (rust "{0}.split_once('?').map(|(_, {!query})| {!query}).unwrap_or(\"\").split('&').filter_map(|{!pair}| {!pair}.split_once('=')).find(|({!key}, _)| *{!key} == {1}).map(|(_, {!value})| {!value}.replace('+', \" \")).unwrap_or_default()"
    (fn ((ref str) (ref str)) string)))

(def percent-decoded
  (rust "native::text::percent_decoded({0})"
    (fn ((ref str)) string)))
