(export answer-browser! bind-loopback browser-connection
        deadline-after loopback-listener loopback-port
        next-connection request-target sign-in-deadline)

(deftype loopback-listener (rust "std::net::TcpListener"))

(deftype browser-connection (rust "std::net::TcpStream"))

(deftype sign-in-deadline (rust "std::time::Instant"))

(def bind-loopback
  (rust "std::net::TcpListener::bind(\"127.0.0.1:0\").and_then(|{!listener}| {!listener}.set_nonblocking(true).map(|_| {!listener})).map_err(|{!error}| {!error}.to_string())"
    (fn () (result loopback-listener string))))

(def loopback-port
  (rust "{0}.local_addr().map(|{!address}| {!address}.port()).unwrap_or(0)"
    (fn ((ref loopback-listener)) u16)))

(def deadline-after
  (rust "std::time::Instant::now() + std::time::Duration::from_millis({0})"
    (fn (u64) sign-in-deadline)))

(def next-connection
  (rust "loop {{ match {0}.accept() {{ Ok(({!stream}, _)) => break {!stream}.set_nonblocking(false).and_then(|_| {!stream}.set_read_timeout(Some(std::time::Duration::from_secs(10)))).map(|_| {!stream}).map_err(|{!error}| {!error}.to_string()), Err({!error}) if {!error}.kind() != std::io::ErrorKind::WouldBlock => break Err({!error}.to_string()), Err(_) if std::time::Instant::now() >= *{1} => break Err(String::from(\"the browser did not answer in time\")), Err(_) => std::thread::sleep(std::time::Duration::from_millis(20)) }} }}"
    (fn ((ref loopback-listener) (ref sign-in-deadline))
      (result browser-connection string))))

(def request-target
  (rust "{{ use std::io::BufRead; let mut {!line} = String::new(); let _ = std::io::BufReader::new(&*{0}).read_line(&mut {!line}); {!line}.split_whitespace().nth(1).unwrap_or(\"\").to_string() }}"
    (fn ((ref browser-connection)) string)))

(def answer-browser!
  (rust "{{ use std::io::Write; let mut {!stream}: &std::net::TcpStream = {0}; let {!page} = {2}; let _ = write!({!stream}, \"HTTP/1.1 {{}}\\r\\nContent-Type: text/html; charset=utf-8\\r\\nContent-Length: {{}}\\r\\nConnection: close\\r\\n\\r\\n{{}}\", {1}, {!page}.len(), {!page}); let _ = {!stream}.shutdown(std::net::Shutdown::Both); }}"
    (fn ((ref browser-connection)
         (ref str)
         (ref str))
      unit)))
