(use domain/timestamp milliseconds->utc-timestamp)
(use ports/driven/clock clock now-milliseconds share-clock)
(use domain/level-spec allows? level-spec)

(use domain/log-entry log-area->name log-entry log-level
                      log-level->name)

(export file-log open-file-log share-file-log
        written-to-file!)

(def rotate-above-bytes 5000000)

(def kept-old-files 3)

(defstruct file-log
  :path string
  :levels level-spec
  :clock clock)

(type open-file-log
  (fn ((ref str) level-spec clock) file-log))

(defn open-file-log (path levels chosen)
  (rotate-when-large path rotate-above-bytes kept-old-files)
  (->file-log :path (str path) :levels levels :clock chosen))

(type share-file-log
  (fn ((ref file-log)) file-log))

(defn share-file-log (log)
  (->file-log :path (clone (:path log))
              :levels (clone (:levels log))
              :clock (share-clock (ref (:clock log)))))

(type written-to-file!
  (fn ((ref file-log) (ref log-entry))
    unit))

(defn written-to-file! (log entry)
  (when (allows? (ref (:levels log)) entry)
    (append-line (ref (:path log))
                 (ref (log-line entry
                                (now-milliseconds (ref (:clock log))))))))

(defn log-line (entry now)
  (str (milliseconds->utc-timestamp now)
       " "
       (padded (level-name (ref (:level entry)))
               5)
       " "
       (padded (str (log-area->name (ref (:area entry))))
               8)
       " "
       (one-line (ref (:message entry)))
       "\n"))

(type level-name
  (fn ((ref log-level)) string))

(defn level-name (level)
  (upper-case (log-level->name level)))

(defn padded (text width)
  (for-each (range (-> (as-str (ref text)) chars count)
                   width)
            (fn (_) (push! text (char " "))))
  text)

(def one-line
  (rust "{0}.replace('\\n', \"\\\\n\").replace('\\r', \"\")"
    (fn ((ref str)) string)))

(def append-line
  (rust "{{ use std::io::Write; let _ = std::fs::OpenOptions::new().create(true).append(true).open({0}).and_then(|mut {!file}| {!file}.write_all({1}.as_bytes())); }}"
    (fn ((ref str) (ref str)) unit)))

(def rotate-when-large
  (rust "native::file_log::rotate_when_large({0}, {1}, {2})"
    (fn ((ref str) u64 u64) unit)))
