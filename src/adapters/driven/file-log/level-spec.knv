(use domain/collections first-present present)
(use ports/driven/event-log log-entry severity)

(export ->level-spec allows? level-spec parse-level-spec)

(def info-severity 2)

(defstruct level-spec
  :default u8
  :areas (vec (pair string u8)))

(defn parse-level-spec (text)
  (->level-spec :default (default-severity text info-severity)
                :areas (area-severities text)))

(defn allows? (spec entry)
  (<= (severity (ref (:level entry)))
      (threshold-for spec (ref (:area entry)))))

(defn threshold-for (spec area)
  (-> (iter (:areas spec))
      (find (fn (entry)
              (let-match ((pair name _) entry)
                (= name area))))
      (map-some (fn (entry)
                  (let-match ((pair _ threshold) entry)
                    (deref threshold))))
      (unwrap-or (:default spec))))

(defn default-severity (text fallback)
  (-> (split text ",")
      (map severity-named)
      first-present
      (unwrap-or fallback)))

(defn area-severities (text)
  (-> (split text ",") (map area-severity) present collect))

(defn area-severity (part)
  (let (sides (collect (split part "=")))
    (if (= (len sides) 2)
      (map-some (severity-named (deref (at sides 1)))
        (fn (threshold)
          (pair (str (trim (deref (at sides 0))))
                threshold)))
      none)))

(defn severity-named (name)
  (match (as-str (ref (lower-case (trim name))))
    ("error" (some 0))
    ("warn" (some 1))
    ("info" (some 2))
    ("debug" (some 3))
    (_ none)))
