(use domain/mail-error mail-error)
(use ports/driven/credentials credentials)

(export ->file-credentials file-credentials)

(defstruct file-credentials
  :path string)

(impl credentials file-credentials
  (load-token (kept account)
              (as-auth-error (token-in-file (as-str (:path kept)) account)))
  (save-token! (kept account token)
               (as-auth-error (write-token-to-file (as-str (:path kept))
                                                   account
                                                   (some (str token)))))
  (forget-token! (kept account)
                 (as-auth-error
                   (write-token-to-file (as-str (:path kept)) account none))))

(type as-auth-error
  (where (value)
    (fn ((result value string))
      (result value mail-error))))

(defn as-auth-error (outcome)
  (map-err outcome
    (fn (problem)
      (mail-error/auth-required (str "credentials file: " problem)))))

(deftype token-map
  (rust "serde_json::Map<String, serde_json::Value>"))

(defn token-in-file (path account)
  (map-ok (tokens-in-file path)
    (fn (tokens)
      (token-for (ref tokens) account))))

(defn write-token-to-file (path account token)
  (let (tokens (try (tokens-in-file path)))
    (write-privately path
                     (ref (with-token tokens account token)))))

(def tokens-in-file
  (rust "match std::fs::read_to_string({0}) {{ Ok({!text}) => serde_json::from_str::<serde_json::Map<String, serde_json::Value>>(&{!text}).map_err(|{!error}| format!(\"cannot read {{}}: {{}}\", {0}, {!error})), Err({!error}) if {!error}.kind() == std::io::ErrorKind::NotFound => Ok(serde_json::Map::new()), Err({!error}) => Err({!error}.to_string()) }}"
    (fn ((ref str))
      (result token-map string))))

(def token-for
  (rust "{0}.get({1}).and_then(|{!token}| {!token}.as_str()).map(str::to_string)"
    (fn ((ref token-map) (ref str))
      (option string))))

(def with-token
  (rust "{{ let mut {!tokens} = {0}; match {2} {{ Some({!token}) => {{ {!tokens}.insert({1}.to_string(), serde_json::Value::String({!token})); }} None => {{ {!tokens}.remove({1}); }} }} {!tokens} }}"
    (fn (token-map (ref str) (option string))
      token-map)))

(def write-privately
  (rust "{{ use std::io::Write; let {!temporary} = format!(\"{{}}.tmp\", {0}); let mut {!options} = std::fs::OpenOptions::new(); {!options}.write(true).create(true).truncate(true); #[cfg(unix)] {{ use std::os::unix::fs::OpenOptionsExt; {!options}.mode(0o600); }} let {!written} = {!options}.open(&{!temporary}).and_then(|mut {!file}| {!file}.write_all(serde_json::Value::Object({1}.clone()).to_string().as_bytes()).and_then(|_| {!file}.sync_all())).and_then(|_| std::fs::rename(&{!temporary}, {0})); if {!written}.is_err() {{ let _ = std::fs::remove_file(&{!temporary}); }} {!written}.map_err(|{!error}| {!error}.to_string()) }}"
    (fn ((ref str) (ref token-map))
      (result unit string))))
