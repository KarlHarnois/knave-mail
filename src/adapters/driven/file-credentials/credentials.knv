(use domain/mail-error mail-error)
(use ports/driven/credentials credentials)

(export ->file-credentials file-credentials)

(defstruct file-credentials
  :path string)

(impl credentials file-credentials
  (load-token (kept account)
    (as-auth-error (token-in-file (ref (:path kept)) account)))
  (save-token! (kept account token)
    (as-auth-error (write-token-to-file (ref (:path kept)) account (some (str token)))))
  (forget-token! (kept account)
    (as-auth-error (write-token-to-file (ref (:path kept)) account none))))

(type as-auth-error (where (value) (fn ((result value string)) (result value mail-error))))

(defn as-auth-error (outcome)
  (map-err outcome (fn (problem) (mail-error/auth-required (str "credentials file: " problem)))))

(def token-in-file
  (rust "match std::fs::read_to_string({0}) {{ Ok({!text}) => serde_json::from_str::<serde_json::Map<String, serde_json::Value>>(&{!text}).map(|{!tokens}| {!tokens}.get({1}).and_then(|{!token}| {!token}.as_str()).map(str::to_string)).map_err(|{!error}| {!error}.to_string()), Err({!error}) if {!error}.kind() == std::io::ErrorKind::NotFound => Ok(None), Err({!error}) => Err({!error}.to_string()) }}"
    (fn ((ref str) (ref str)) (result (option string) string))))

(def write-token-to-file
  (rust "{{ let mut {!tokens} = std::fs::read_to_string({0}).ok().and_then(|{!text}| serde_json::from_str::<serde_json::Map<String, serde_json::Value>>(&{!text}).ok()).unwrap_or_default(); match {2} {{ Some({!token}) => {{ {!tokens}.insert({1}.to_string(), serde_json::Value::String({!token})); }} None => {{ {!tokens}.remove({1}); }} }} std::fs::write({0}, serde_json::Value::Object({!tokens}).to_string()).map_err(|{!error}| {!error}.to_string()) }}"
    (fn ((ref str) (ref str) (option string)) (result unit string))))
