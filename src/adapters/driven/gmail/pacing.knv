(use domain/log-entry log-area)
(use adapters/driven/gmail/quota pace-at slowed-at!)
(use ports/driven/clock now-milliseconds)
(use adapters/driven/gmail/session-state gmail-session)
(use ports/driven/event-log log-info)

(export slowed-down!)

(type slowed-down!
  (fn ((mut gmail-session)) unit))

(defn slowed-down! (session)
  (let (now (now-milliseconds (ref (:clock session))))
    (slowed-at! (mut (:quota session)) now)
    (log-info (ref (:log session))
              log-area/gmail
              (str "Gmail is rate limiting this account; pacing at "
                   (pace-at (ref (:quota session)) now)
                   " units per second"))))
