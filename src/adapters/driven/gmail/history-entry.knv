(use adapters/driven/gmail/fields listed-labels
                                  required-text
                                  text-error->internal-error)

(use adapters/json/value array-field json-value
                         object-field)

(use domain/collections appended-once collect-ok
                        concatenated)

(use domain/history ->mail-changes ->message-relabel
                    mail-changes message-relabel)

(use domain/labels ->label-change)
(use domain/mail-error mail-error)

(export entries->mail-changes history-entry
        json->history-entry)

(defstruct history-entry
  :downloads (vec string)
  :relabels (vec message-relabel))

(defenum label-record
  labels-added
  labels-removed)

(type json->history-entry
  (fn ((ref json-value))
    (result history-entry mail-error)))

(defn json->history-entry (entry)
  (ok (->history-entry :downloads (try (downloaded-threads entry))
                       :relabels (concatenated (try (relabels-in entry
                                                                 label-record/labels-added))
                                               (try (relabels-in entry
                                                                 label-record/labels-removed))))))

(type entries->mail-changes
  (fn ((ref (vec history-entry)) string)
    mail-changes))

(defn entries->mail-changes (entries history-id)
  (->mail-changes :refetch (reduce (iter entries) (vec) with-downloads)
                  :relabels (reduce (iter entries) (vec) with-relabels)
                  :history-id history-id))

(type with-downloads
  (fn ((vec string) (ref history-entry))
    (vec string)))

(defn with-downloads (found entry)
  (reduce (iter (:downloads entry)) found
    (fn (threads thread-id)
      (appended-once threads (clone thread-id)))))

(type with-relabels
  (fn ((vec message-relabel) (ref history-entry))
    (vec message-relabel)))

(defn with-relabels (found entry)
  (concatenated found (clone (:relabels entry))))

(type downloaded-threads
  (fn ((ref json-value))
    (result (vec string) mail-error)))

(defn downloaded-threads (entry)
  (ok (concatenated (try (thread-ids-in entry "messagesAdded"))
                    (try (thread-ids-in entry "messagesDeleted")))))

(type thread-ids-in
  (fn ((ref json-value) (ref str))
    (result (vec string) mail-error)))

(defn thread-ids-in (entry record)
  (-> (array-field entry record)
      iter
      (map (fn (item) (json->thread-id item)))
      collect-ok))

(type relabels-in
  (fn ((ref json-value) label-record)
    (result (vec message-relabel) mail-error)))

(defn relabels-in (entry record)
  (-> (array-field entry (record-name record))
      iter
      (map (fn (item) (json->message-relabel item record)))
      collect-ok))

(defn record-name (record)
  (match record
    (labels-added "labelsAdded")
    (labels-removed "labelsRemoved")))

(defn record-change (record labels)
  (match record
    (labels-added (->label-change :added labels :removed (vec)))
    (labels-removed (->label-change :added (vec) :removed labels))))

(type json->message-relabel
  (fn ((ref json-value) label-record)
    (result message-relabel mail-error)))

(defn json->message-relabel (item record)
  (let (message (try (message-of item))
        labels (listed-labels item))
    (ok (->message-relabel :thread-id (try (required-text (ref message)
                                                          "threadId"))
                           :message-id (try (required-text (ref message) "id"))
                           :change (record-change record labels)))))

(type json->thread-id
  (fn ((ref json-value))
    (result string mail-error)))

(defn json->thread-id (item)
  (required-text (ref (try (message-of item)))
                 "threadId"))

(defn message-of (item)
  (text-error->internal-error (object-field item "message")))
