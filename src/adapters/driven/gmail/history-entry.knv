(use adapters/json/value array-field empty-object json-value
                         object-field optional-string-field
                         string-list-field)

(use domain/collections appended appended-once)

(use domain/history ->mail-changes ->message-relabel
                    mail-changes message-relabel)

(use domain/labels ->label-change)
(use domain/results unwrap-ok-or)

(export with-entry)

(def downloaded-records
  (vec "messagesAdded" "messagesDeleted"))

(defn with-entry (changes entry)
  (->mail-changes :refetch (reduce (iter (downloaded-threads (ref entry)))
                                   (clone (:refetch changes))
                                   (fn (found thread-id)
                                     (appended-once found (clone thread-id))))
                  :relabels (reduce (iter (entry-relabels (ref entry)))
                                    (clone (:relabels changes))
                                    (fn (found relabel)
                                      (appended found (clone relabel))))
                  :history-id (str "")))

(defn downloaded-threads (entry)
  (reduce (iter downloaded-records) (vec)
    (fn (found record)
      (reduce (array-field entry record) found
        (fn (threads item)
          (with-thread-of threads (ref (message-of item))))))))

(defn entry-relabels (entry)
  (reduce (array-field entry "labelsRemoved")
          (reduce (array-field entry "labelsAdded") (vec)
            (fn (found item)
              (with-relabel found
                            (relabel-of item (labels-of item) (vec)))))
          (fn (found item)
            (with-relabel found
                          (relabel-of item (vec) (labels-of item))))))

(defn with-relabel (found relabel)
  (match relabel
    ((some made) (appended found made))
    (none found)))

(defn relabel-of (item added removed)
  (let (message (message-of item))
    (match (optional-string-field (ref message) "threadId")
      ((some thread-id)
       (some (->message-relabel :thread-id thread-id
                                :message-id (message-id-of (ref message))
                                :change (->label-change :added added
                                                        :removed removed))))
      (none none))))

(defn message-of (item)
  (unwrap-ok-or (object-field item "message") (empty-object)))

(defn message-id-of (message)
  (unwrap-or (optional-string-field message "id") (str "")))

(defn labels-of (item)
  (unwrap-ok-or (string-list-field item "labelIds") (vec)))

(defn with-thread-of (found message)
  (match (optional-string-field message "threadId")
    ((some thread-id) (appended-once found thread-id))
    (none found)))
