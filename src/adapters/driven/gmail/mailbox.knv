(use adapters/driven/gmail/summary-codec summary-from
                                         thread-labels)

(use adapters/driven/gmail/codec label-from label-ids
                                 message-ids raw->message
                                 sent-thread-id)

(use adapters/driven/gmail/codec thread-ids)

(use adapters/driven/gmail/requests batch-modify-body
                                    batch-modify-path
                                    label-path labels-path
                                    message-page-path
                                    message-path modify-body
                                    modify-path send-body
                                    send-path
                                    thread-list-path
                                    thread-metadata-path
                                    thread-page-path
                                    thread-path)

(use adapters/driven/gmail/history fetched-changes!
                                   fetched-history-id!)

(use adapters/driven/gmail/session api-get! api-get-all!
                                   api-post!)

(use adapters/driven/gmail/session-state gmail-session)
(use adapters/driven/gmail/message-page message-page-from)

(use domain/mail ->thread ->thread-page message thread
                 thread-page thread-query thread-summary)

(use adapters/json/value optional-string-field)
(use domain/mail-error mail-error)
(use ports/driven/mailbox mailbox)

(export ->gmail-mailbox gmail-mailbox)

(defstruct gmail-mailbox
  :session gmail-session)

(impl mailbox gmail-mailbox
  (fetch-labels! (box)
    (let (listed (try (api-get! (mut (:session box))
                                (ref (labels-path))))
          paths (-> (iter (label-ids (ref listed)))
                    (map (fn (id) (label-path id)))
                    collect)
          details (try (api-get-all! (mut (:session box))
                                     (ref paths))))
      (ok (-> (iter details)
              (map (fn (detail) (label-from detail)))
              collect))))

  (fetch-threads! (box query)
    (let (ids (try (listed-thread-ids! (mut (:session box)) query)))
      (summaries-of! (mut (:session box))
                     (ref ids))))

  (fetch-thread-ids! (box query)
    (listed-thread-ids! (mut (:session box)) query))

  (fetch-thread-page! (box query page-token)
    (listed-thread-page! (mut (:session box)) query page-token))

  (fetch-message-page! (box query page-token)
    (ok (message-page-from
          (ref (try (api-get! (mut (:session box))
                              (ref (message-page-path query page-token))))))))

  (fetch-summaries! (box ids)
    (summaries-of! (mut (:session box)) ids))

  (fetch-thread! (box thread-id)
    (fetched-thread! (mut (:session box)) thread-id))

  (fetch-history-id! (box)
    (fetched-history-id! (mut (:session box))))

  (fetch-changes! (box since)
    (fetched-changes! (mut (:session box)) since))

  (deliver! (box sent)
    (ok (sent-thread-id (ref (try (api-post! (mut (:session box))
                                             (ref (send-path))
                                             (ref (send-body sent))))))))

  (relabel! (box thread-id change)
    (do
      (try (api-post! (mut (:session box))
                      (ref (modify-path thread-id))
                      (ref (modify-body change))))
      (ok (do))))

  (relabel-messages! (box message-ids change)
    (do
      (try (api-post! (mut (:session box))
                      (ref (batch-modify-path))
                      (ref (batch-modify-body message-ids change))))
      (ok (do)))))

(defn listed-thread-ids! (session query)
  (ok (thread-ids (ref (try (api-get! session
                                      (ref (thread-list-path query))))))))

(defn listed-thread-page! (session query page-token)
  (let (listed (try (api-get! session
                              (ref (thread-page-path query page-token)))))
    (ok (->thread-page :ids (thread-ids (ref listed))
                       :next-token (next-page-token (ref listed))))))

(defn next-page-token (listed)
  (unwrap-or (optional-string-field listed "nextPageToken")
             (str "")))

(type summaries-of!
  (fn ((mut gmail-session) (ref (vec string)))
    (result (vec thread-summary) mail-error)))

(defn summaries-of! (session ids)
  (let (paths (-> (iter ids)
                  (map (fn (id) (thread-metadata-path id)))
                  collect)
        threads (try (api-get-all! session (ref paths))))
    (ok (-> (iter threads)
            (map (fn (found) (summary-from found)))
            collect))))

(defn fetched-thread! (session thread-id)
  (let (minimal (try (api-get! session (ref (thread-path thread-id))))
        paths (-> (iter (message-ids (ref minimal)))
                  (map (fn (id) (message-path id)))
                  collect)
        raws (try (api-get-all! session (ref paths)))
        messages (-> (iter raws)
                     (map (fn (raw) (raw->message raw thread-id)))
                     collect))
    (ok (->thread :id (str thread-id)
                  :subject (first-subject (ref messages))
                  :labels (thread-labels (ref minimal))
                  :messages messages))))

(type first-subject
  (fn ((ref (vec message))) string))

(defn first-subject (messages)
  (match (first messages)
    ((some message) (clone (:subject message)))
    (none (str ""))))
