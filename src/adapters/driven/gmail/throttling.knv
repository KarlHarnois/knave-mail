(use adapters/driven/gmail/http-reply http-reply)
(use domain/mail-error ->throttling throttling)

(export http-reply->throttling retry-wait-in)

(def retry-marker "Retry after ")

(def per-minute-marker "per minute")

(def milliseconds-per-minute 60000)

(def past-the-minute-milliseconds 500)

(def rate-limit-notice
  "Gmail is rate limiting this account")

(type http-reply->throttling
  (fn ((ref http-reply) int) throttling))

(defn http-reply->throttling (reply now)
  (let (gmail-message (clone (:message (:refusal reply))))
    (->throttling :message (notice-with (ref gmail-message))
                  :retry-after-milliseconds (asked-wait (:retry-after reply)
                                                        now
                                                        (as-str
                                                          gmail-message)))))

(defn notice-with (gmail-message)
  (if (empty? gmail-message)
    (str rate-limit-notice)
    (str rate-limit-notice ": " gmail-message)))

(defn asked-wait (header-wait now gmail-message)
  (match header-wait
    ((some milliseconds) milliseconds)
    (none (unwrap-or (retry-wait-in gmail-message now) 0))))

(defn retry-wait-in (gmail-message now)
  (match (utc-milliseconds-after gmail-message retry-marker)
    ((some retry-at) (some (max 0 (- retry-at now))))
    (none (per-minute-wait gmail-message now))))

(defn per-minute-wait (gmail-message now)
  (if (contains? gmail-message per-minute-marker)
    (some (until-next-minute now))
    none))

(defn until-next-minute (now)
  (+ (- milliseconds-per-minute
        (rem now milliseconds-per-minute))
     past-the-minute-milliseconds))

(def utc-milliseconds-after
  (rust "native::dates::utc_milliseconds_after({0}, {1})"
    (fn ((ref str) (ref str)) (option int))))
