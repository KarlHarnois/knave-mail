(use adapters/driven/gmail/http-method http-method)
(use domain/collections concatenated)
(use adapters/driven/gmail/http batch-size http-get-all)

(use adapters/driven/gmail/http-reply http-reply
                                      rate-limited?)

(use adapters/driven/gmail/pacing slowed-down!)
(use adapters/driven/gmail/quota take-units!)
(use adapters/driven/gmail/quota-costs units-for)

(use adapters/driven/gmail/session-state api-url
                                         gmail-session)

(export fetched-all!)

(type fetched-all!
  (fn ((mut gmail-session)
       (ref (vec string))
       (ref str))
    (vec (result http-reply string))))

(defn fetched-all! (session paths token)
  (reduce (iter (chunks-of paths batch-size)) (vec)
    (fn (replies chunk)
      (take-units! (mut (:quota session))
                   (units-of-gets chunk)
                   (ref (:clock session)))
      (let (fetched (http-get-all (ref (:agent session))
                                  (ref (-> (iter chunk)
                                           (map (fn (path)
                                                  (api-url session path)))
                                           collect))
                                  token))
        (when (any-rate-limited? (ref fetched))
          (slowed-down! session))
        (concatenated replies fetched)))))

(defn units-of-gets (paths)
  (reduce (iter paths) 0
    (fn (total path)
      (+ total (units-for http-method/get (as-str path))))))

(defn any-rate-limited? (outcomes)
  (any? (iter outcomes)
    (fn (outcome)
      (match outcome
        ((ok reply) (rate-limited? reply))
        (_ false)))))

(def chunks-of
  (rust "{0}.chunks({1}).map(<[String]>::to_vec).collect::<Vec<Vec<String>>>()"
    (fn ((ref (vec string)) usize)
      (vec (vec string)))))
