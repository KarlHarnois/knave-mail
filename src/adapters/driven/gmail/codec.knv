(use adapters/json/value array-field json-value number-field
                         optional-string-field
                         string-list-field)

(use domain/collections appended appended-once)
(use domain/results ok->option)

(use domain/mail ->label ->message ->thread-summary label
                 message thread-summary)

(export label-from label-ids message-from-raw message-ids
        sent-thread-id summary-from thread-ids
        thread-labels)

(defstruct summary-parts
  :id string
  :subject string
  :participants string
  :snippet string
  :date i64
  :labels (vec string)
  :message-count i64)

(defstruct message-parts
  :from string
  :to (vec string)
  :cc (vec string)
  :subject string
  :date i64
  :text string
  :html (option string)
  :header-id string
  :references string)

(defn label-from (details)
  (->label :id (text-at details "id")
           :name (text-at details "name")
           :unread (number-at details "threadsUnread")))

(defn summary-from (thread)
  (let (parts (summary-parts-of thread))
    (->thread-summary :id (clone (:id parts))
                      :subject (clone (:subject parts))
                      :participants (clone (:participants parts))
                      :snippet (clone (:snippet parts))
                      :date (:date parts)
                      :labels (clone (:labels parts))
                      :message-count (:message-count parts))))

(defn message-from-raw (raw-message thread-id)
  (let (parts (message-parts-of raw-message))
    (->message :id (text-at raw-message "id")
               :thread-id (str thread-id)
               :from (clone (:from parts))
               :to (clone (:to parts))
               :cc (clone (:cc parts))
               :subject (clone (:subject parts))
               :date (:date parts)
               :text (clone (:text parts))
               :html (clone (:html parts))
               :header-id (clone (:header-id parts))
               :references (clone (:references parts)))))

(defn label-ids (reply) (ids-in reply "labels"))

(defn thread-ids (reply) (ids-in reply "threads"))

(defn message-ids (thread) (ids-in thread "messages"))

(defn ids-in (reply list-name)
  (reduce (array-field reply list-name) (vec)
    (fn (ids entry)
      (match (optional-string-field entry "id")
        ((some id) (appended ids id))
        (none ids)))))

(defn thread-labels (thread)
  (reduce (array-field thread "messages") (vec)
    (fn (labels message)
      (reduce (labels-on message) labels
        (fn (found label)
          (appended-once found (clone label)))))))

(defn labels-on (message)
  (unwrap-or (ok->option (string-list-field message "labelIds"))
             (vec)))

(defn sent-thread-id (reply) (text-at reply "threadId"))

(defn text-at (details key)
  (unwrap-or (optional-string-field details key) (str "")))

(defn number-at (details key)
  (match (number-field details key)
    ((ok number) number)
    ((err _) 0)))

(def summary-parts-of
  (rust "{{ let {!thread} = {0}; let {!messages} = {!thread}.get(\"messages\").and_then(|{!m}| {!m}.as_array()).cloned().unwrap_or_default(); let {!header} = |{!message}: &serde_json::Value, {!name}: &str| {!message}.pointer(\"/payload/headers\").and_then(|{!h}| {!h}.as_array()).and_then(|{!h}| {!h}.iter().find(|{!entry}| {!entry}.get(\"name\").and_then(|{!n}| {!n}.as_str()).map(|{!n}| {!n}.eq_ignore_ascii_case({!name})).unwrap_or(false))).and_then(|{!entry}| {!entry}.get(\"value\")).and_then(|{!v}| {!v}.as_str()).unwrap_or_default().to_string(); let {!senders} = {!messages}.iter().map(|{!message}| {{ let {!from} = {!header}({!message}, \"From\"); let {!name} = {!from}.split('<').next().unwrap_or(\"\").trim().trim_matches('\"').to_string(); if {!name}.is_empty() {{ {!from}.trim_matches(|{!c}| {!c} == '<' || {!c} == '>').to_string() }} else {{ {!name} }} }}).fold(Vec::<String>::new(), |mut {!all}, {!name}| {{ if !{!all}.contains(&{!name}) {{ {!all}.push({!name}); }} {!all} }}).join(\", \"); let {!last} = {!messages}.last().cloned().unwrap_or_default(); let {!snippet} = {!last}.get(\"snippet\").and_then(|{!s}| {!s}.as_str()).unwrap_or_default().replace(\"&#39;\", \"'\").replace(\"&quot;\", \"\\\"\").replace(\"&amp;\", \"&\").replace(\"&lt;\", \"<\").replace(\"&gt;\", \">\"); let {!date} = {!last}.get(\"internalDate\").and_then(|{!d}| {!d}.as_str()).and_then(|{!d}| {!d}.parse::<i64>().ok()).unwrap_or(0); let {!labels} = {!messages}.iter().flat_map(|{!message}| {!message}.get(\"labelIds\").and_then(|{!ids}| {!ids}.as_array()).cloned().unwrap_or_default()).filter_map(|{!id}| {!id}.as_str().map(str::to_string)).fold(Vec::<String>::new(), |mut {!all}, {!id}| {{ if !{!all}.contains(&{!id}) {{ {!all}.push({!id}); }} {!all} }}); SummaryParts {{ id: {!thread}.get(\"id\").and_then(|{!i}| {!i}.as_str()).unwrap_or_default().to_string(), subject: {!messages}.first().map(|{!first}| {!header}({!first}, \"Subject\")).unwrap_or_default(), participants: {!senders}, snippet: {!snippet}, date: {!date}, labels: {!labels}, message_count: {!messages}.len() as i64 }} }}"
    (fn ((ref json-value)) summary-parts)))

(def message-parts-of
  (rust "{{ use base64::Engine; let {!raw} = {0}.get(\"raw\").and_then(|{!r}| {!r}.as_str()).unwrap_or_default(); let {!bytes} = base64::engine::GeneralPurpose::new(&base64::alphabet::URL_SAFE, base64::engine::GeneralPurposeConfig::new().with_decode_padding_mode(base64::engine::DecodePaddingMode::Indifferent)).decode({!raw}.trim()).unwrap_or_default(); let {!date} = {0}.get(\"internalDate\").and_then(|{!d}| {!d}.as_str()).and_then(|{!d}| {!d}.parse::<i64>().ok()).unwrap_or(0); match mail_parser::MessageParser::default().parse(&{!bytes}) {{ Some({!parsed}) => {{ let {!addresses} = |{!list}: Option<&mail_parser::Address>| {!list}.map(|{!list}| {!list}.iter().map(|{!mailbox}| match ({!mailbox}.name.as_deref(), {!mailbox}.address.as_deref()) {{ (Some({!name}), Some({!address})) => format!(\"{{}} <{{}}>\", {!name}, {!address}), (None, Some({!address})) => {!address}.to_string(), (Some({!name}), None) => {!name}.to_string(), (None, None) => String::new() }}).collect::<Vec<_>>()).unwrap_or_default(); let {!has_html} = {!parsed}.html_part(0).map(|{!part}| {!part}.is_text_html()).unwrap_or(false); MessageParts {{ from: {!addresses}({!parsed}.from()).into_iter().next().unwrap_or_default(), to: {!addresses}({!parsed}.to()), cc: {!addresses}({!parsed}.cc()), subject: {!parsed}.subject().unwrap_or_default().to_string(), date: {!date}, text: {!parsed}.body_text(0).map(|{!t}| {!t}.replace(\"\\r\\n\", \"\\n\")).unwrap_or_default(), html: if {!has_html} {{ {!parsed}.body_html(0).map(|{!h}| {!h}.into_owned()) }} else {{ None }}, header_id: {!parsed}.message_id().map(|{!id}| format!(\"<{{}}>\", {!id})).unwrap_or_default(), references: {!parsed}.references().as_text_list().map(|{!list}| {!list}.iter().map(|{!id}| format!(\"<{{}}>\", {!id})).collect::<Vec<_>>().join(\" \")).or_else(|| {!parsed}.references().as_text().map(|{!id}| format!(\"<{{}}>\", {!id}))).unwrap_or_default() }} }} None => MessageParts {{ from: String::new(), to: Vec::new(), cc: Vec::new(), subject: String::new(), date: {!date}, text: String::new(), html: None, header_id: String::new(), references: String::new() }} }} }}"
    (fn ((ref json-value)) message-parts)))
