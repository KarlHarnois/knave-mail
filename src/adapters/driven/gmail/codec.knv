(use adapters/driven/gmail/fields ids-of required-number
                                  required-text)

(use adapters/json/value json-value)
(use domain/mail ->label ->message label message)
(use domain/mail-error mail-error)

(export json->label json->message label-ids message-ids
        sent-thread-id thread-ids)

(defstruct message-parts
  :from string
  :to (vec string)
  :cc (vec string)
  :subject string
  :date int
  :text string
  :html (option string)
  :header-id string
  :references string)

(type json->label
  (fn ((ref json-value))
    (result label mail-error)))

(defn json->label (details)
  (ok (->label :id (try (required-text details "id"))
               :name (try (required-text details "name"))
               :unread (try (required-number details "threadsUnread"))
               :total (try (required-number details "threadsTotal")))))

(type json->message
  (fn ((ref json-value) (ref str))
    (result message mail-error)))

(defn json->message (raw-message thread-id)
  (let (parts (message-parts-of raw-message))
    (ok (->message :id (try (required-text raw-message "id"))
                   :thread-id (str thread-id)
                   :from (clone (:from parts))
                   :to (clone (:to parts))
                   :cc (clone (:cc parts))
                   :subject (clone (:subject parts))
                   :date (:date parts)
                   :text (clone (:text parts))
                   :html (clone (:html parts))
                   :header-id (clone (:header-id parts))
                   :references (clone (:references parts))))))

(defn label-ids (reply) (ids-of reply "labels"))

(defn thread-ids (reply) (ids-of reply "threads"))

(defn message-ids (thread) (ids-of thread "messages"))

(defn sent-thread-id (reply)
  (required-text reply "threadId"))

(def message-parts-of
  (rust "{{ let {!parsed} = native::gmail_message::parsed_message({0}); MessageParts {{ from: {!parsed}.from, to: {!parsed}.to, cc: {!parsed}.cc, subject: {!parsed}.subject, date: {!parsed}.date, text: {!parsed}.text, html: {!parsed}.html, header_id: {!parsed}.header_id, references: {!parsed}.references }} }}"
    (fn ((ref json-value)) message-parts)))
