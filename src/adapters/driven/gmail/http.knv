(use adapters/driven/gmail/http-reply http-reply
                                      rate-limited?)

(export agent-with-timeouts http-agent http-get http-get-all
        http-post-form http-post-json new-agent)

(deftype http-agent (rust "ureq::Agent"))

(deftype http-response
  (rust "ureq::http::Response<ureq::Body>"))

(def connect-timeout-milliseconds 10000)

(def stall-timeout-milliseconds 30000)

(defn new-agent ()
  (agent-with-timeouts connect-timeout-milliseconds
                       stall-timeout-milliseconds))

(def agent-with-timeouts
  (rust "ureq::Agent::from(ureq::Agent::config_builder().http_status_as_error(false).timeout_connect(Some(std::time::Duration::from_millis({0}))).timeout_per_read(Some(std::time::Duration::from_millis({1}))).timeout_per_write(Some(std::time::Duration::from_millis({1}))).build())"
    (fn (u64 u64) http-agent)))

(type http-get
  (fn ((ref http-agent) (ref str) (ref str))
    (result http-reply string)))

(defn http-get (agent url token)
  (first-reply (get-response agent url token)))

(def get-response
  (rust "{0}.get({1}).header(\"Authorization\", &format!(\"Bearer {{}}\", {2})).call().map_err(|{!error}| {!error}.to_string())"
    (fn ((ref http-agent) (ref str) (ref str))
      (result http-response string))))

(defn first-reply (outcome)
  (then-ok outcome
    (fn (response) (reply-from response 0))))

(def reply-from
  (rust "{{ let mut {!response} = {0}; let {!status} = {!response}.status().as_u16(); {!response}.body_mut().with_config().limit(64 * 1024 * 1024).read_to_string().map(|{!body}| crate::adapters::driven::gmail::http_reply::HttpReply {{ status: {!status}, body: {!body}, retries: {1} }}).map_err(|{!error}| format!(\"the answer was cut short: {{}}\", {!error})) }}"
    (fn (http-response u32) (result http-reply string))))

(def batch-size 8)

(def most-retries 6)

(defn http-get-all (agent urls token pause spacing)
  (in-paced-batches urls batch-size spacing
    (fn (url)
      (get-with-retries agent (as-str url) token pause 0))))

(defn get-with-retries (agent url token pause attempt)
  (let (outcome (then-ok (get-response agent url token)
                  (fn (response) (reply-from response attempt))))
    (if (retry? (ref outcome) attempt)
      (do
        (sleep-milliseconds (doubled pause attempt))
        (recur agent url token pause (+ attempt 1)))
      outcome)))

(defn retry? (outcome attempt)
  (match outcome
    ((ok reply)
     (and (rate-limited? reply) (< attempt most-retries)))
    ((err _) false)))

(defn doubled (milliseconds times)
  (if (= times 0)
    milliseconds
    (recur (* milliseconds 2) (- times 1))))

(def sleep-milliseconds
  (rust "std::thread::sleep(std::time::Duration::from_millis({0}))"
    (fn (u64) unit)))

(def in-paced-batches
  (rust "{{ let ({!urls}, {!size}, {!spacing}, {!fetch}) = ({0}, {1}, {2}, &{3}); let mut {!replies} = Vec::with_capacity({!urls}.len()); for {!batch} in {!urls}.chunks({!size}) {{ let {!started} = std::time::Instant::now(); std::thread::scope(|{!scope}| {{ let {!handles}: Vec<_> = {!batch}.iter().map(|{!url}| {!scope}.spawn(move || {!fetch}({!url}))).collect(); for {!handle} in {!handles} {{ {!replies}.push({!handle}.join().unwrap_or_else(|_| Err(String::from(\"a request thread panicked\")))); }} }}); if let Some({!rest}) = std::time::Duration::from_millis({!spacing} * {!batch}.len() as u64).checked_sub({!started}.elapsed()) {{ std::thread::sleep({!rest}); }} }} {!replies} }}"
    (fn ((ref (vec string))
         usize u64
         (fn ((ref string))
           (result http-reply string)))
      (vec (result http-reply string)))))

(type http-post-json
  (fn ((ref http-agent)
       (ref str)
       (ref str)
       (ref str))
    (result http-reply string)))

(defn http-post-json (agent url token body)
  (first-reply (post-json-response agent url token body)))

(def post-json-response
  (rust "{0}.post({1}).header(\"Authorization\", &format!(\"Bearer {{}}\", {2})).header(\"Content-Type\", \"application/json\").send({3}).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref http-agent)
         (ref str)
         (ref str)
         (ref str))
      (result http-response string))))

(type http-post-form
  (fn ((ref http-agent)
       (ref str)
       (ref (vec (pair string string))))
    (result http-reply string)))

(defn http-post-form (agent url form)
  (first-reply (post-form-response agent url form)))

(def post-form-response
  (rust "{0}.post({1}).send_form({2}.iter().map(|({!key}, {!value})| ({!key}.as_str(), {!value}.as_str()))).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref http-agent)
         (ref str)
         (ref (vec (pair string string))))
      (result http-response string))))
