(use adapters/driven/gmail/http-reply body->refusal
                                      http-reply)

(export ->json-post agent-with-timeouts batch-size
        http-agent http-get http-get-all http-post-form
        http-post-json json-post new-agent)

(deftype http-agent (rust "ureq::Agent"))

(deftype http-response
  (rust "ureq::http::Response<ureq::Body>"))

(def connect-timeout-milliseconds 10000)

(def stall-timeout-milliseconds 30000)

(defn new-agent ()
  (agent-with-timeouts connect-timeout-milliseconds
                       stall-timeout-milliseconds))

(def agent-with-timeouts
  (rust "ureq::Agent::from(ureq::Agent::config_builder().http_status_as_error(false).timeout_connect(Some(std::time::Duration::from_millis({0}))).timeout_per_read(Some(std::time::Duration::from_millis({1}))).timeout_per_write(Some(std::time::Duration::from_millis({1}))).build())"
    (fn (u64 u64) http-agent)))

(type http-get
  (fn ((ref http-agent) (ref str) (ref str))
    (result http-reply string)))

(defn http-get (agent url token)
  (first-reply (get-response agent url token)))

(def get-response
  (rust "{0}.get({1}).header(\"Authorization\", &format!(\"Bearer {{}}\", {2})).call().map_err(|{!error}| {!error}.to_string())"
    (fn ((ref http-agent) (ref str) (ref str))
      (result http-response string))))

(defn first-reply (outcome)
  (then-ok outcome response->http-reply))

(defn response->http-reply (response)
  (map-ok (raw-reply-from response)
    (fn (reply)
      (let (refusal (body->refusal (as-str (:body reply))))
        (assoc reply :refusal refusal)))))

(def raw-reply-from
  (rust "native::http_reply::reply_from({0}).map(|{!reply}| crate::adapters::driven::gmail::http_reply::HttpReply {{ status: {!reply}.status, body: {!reply}.body, retry_after: {!reply}.retry_after, refusal: crate::adapters::driven::gmail::http_reply::GmailRefusal {{ message: String::new(), reasons: Vec::new() }} }})"
    (fn (http-response) (result http-reply string))))

(def batch-size 8)

(defn http-get-all (agent urls token)
  (in-batches urls batch-size
    (fn (url)
      (http-get agent (as-str url) token))))

(def in-batches
  (rust "native::batches::in_batches({0}, {1}, {2})"
    (fn ((ref (vec string))
         usize
         (fn ((ref string))
           (result http-reply string)))
      (vec (result http-reply string)))))

(defstruct json-post
  :url string
  :token string
  :body string)

(type http-post-json
  (fn ((ref http-agent) (ref json-post))
    (result http-reply string)))

(defn http-post-json (agent post)
  (first-reply (post-json-response agent post)))

(def post-json-response
  (rust "{0}.post(&{1}.url).header(\"Authorization\", &format!(\"Bearer {{}}\", {1}.token)).header(\"Content-Type\", \"application/json\").send(&{1}.body).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref http-agent) (ref json-post))
      (result http-response string))))

(type http-post-form
  (fn ((ref http-agent)
       (ref str)
       (ref (vec (pair string string))))
    (result http-reply string)))

(defn http-post-form (agent url form)
  (first-reply (post-form-response agent url form)))

(def post-form-response
  (rust "{0}.post({1}).send_form({2}.iter().map(|({!key}, {!value})| ({!key}.as_str(), {!value}.as_str()))).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref http-agent)
         (ref str)
         (ref (vec (pair string string))))
      (result http-response string))))
