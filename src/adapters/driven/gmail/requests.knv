(use domain/labels label-change)
(use domain/mail outgoing reply-link thread-query)
(use domain/outgoing reply-link-of)
(use domain/label-scope label-scope->label)
(use adapters/url url-encoded)

(export batch-modify-body batch-modify-path label-path
        labels-path message-page-path message-path
        modify-body modify-path page-token-part send-body
        send-path thread-list-path thread-metadata-path
        thread-page-path thread-path users-me)

(def users-me "/gmail/v1/users/me")

(defn labels-path () (str users-me "/labels"))

(type label-path
  (fn ((ref str)) string))

(defn label-path (label-id)
  (str users-me "/labels/" (url-encoded label-id)))

(defn thread-list-path (query)
  (str users-me "/threads?maxResults="
       (:limit query)
       (label-filter (ref (:scope query)))
       (if (empty? (:query query))
         (str "")
         (str "&q=" (url-encoded (:query query))))))

(defn label-filter (scope)
  (match (label-scope->label scope)
    ((some label) (str "&labelIds=" (url-encoded (ref label))))
    (none (str ""))))

(defn message-page-path (query page-token)
  (str users-me "/messages?maxResults="
       (:limit query)
       (label-filter (ref (:scope query)))
       (str "&q=" (url-encoded (:query query)))
       (page-token-part page-token)))

(defn thread-page-path (query page-token)
  (str (thread-list-path query) (page-token-part page-token)))

(type page-token-part
  (fn ((ref (option string))) string))

(defn page-token-part (page-token)
  (match page-token
    ((some token)
     (str "&pageToken=" (url-encoded (as-str token))))
    (none (str ""))))

(type thread-metadata-path
  (fn ((ref str)) string))

(defn thread-metadata-path (thread-id)
  (str users-me "/threads/"
       (url-encoded thread-id)
       "?format=metadata&metadataHeaders=From&metadataHeaders=Subject"))

(defn thread-path (thread-id)
  (str users-me "/threads/"
       (url-encoded thread-id)
       "?format=minimal"))

(type message-path
  (fn ((ref str)) string))

(defn message-path (message-id)
  (str users-me "/messages/"
       (url-encoded message-id)
       "?format=raw"))

(defn modify-path (thread-id)
  (str users-me "/threads/" (url-encoded thread-id) "/modify"))

(defn batch-modify-path ()
  (str users-me "/messages/batchModify"))

(def batch-modify-body
  (rust "serde_json::json!({{\"ids\": {0}, \"addLabelIds\": {1}.added, \"removeLabelIds\": {1}.removed}}).to_string()"
    (fn ((ref (vec string)) (ref label-change))
      string)))

(defn send-path () (str users-me "/messages/send"))

(def modify-body
  (rust "serde_json::json!({{\"addLabelIds\": {0}.added, \"removeLabelIds\": {0}.removed}}).to_string()"
    (fn ((ref label-change)) string)))

(defn send-body (sent)
  (encoded-send-body sent
                     (ref (reply-link-of sent))
                     (ref (new-message-id (ref (:from sent))))))

(def new-message-id
  (rust "{{ let {!domain} = {0}.rsplit_once('@').map(|(_, {!host})| {!host}.trim_end_matches('>').trim()).unwrap_or(\"localhost\"); format!(\"{{:016x}}{{:016x}}@{{}}\", rand::random::<u64>(), rand::random::<u64>(), {!domain}) }}"
    (fn ((ref str)) string)))

(def encoded-send-body
  (rust "{{ let {!sent} = {0}; native::gmail_send::encoded_send_body(&native::gmail_send::OutgoingMail {{ from: &{!sent}.from, to: &{!sent}.to, cc: &{!sent}.cc, subject: &{!sent}.subject, body: &{!sent}.body, thread_id: {1}.as_ref().map(|{!link}| {!link}.thread_id.as_str()), in_reply_to: {1}.as_ref().map(|{!link}| {!link}.in_reply_to.as_str()), references: {1}.as_ref().map_or(\"\", |{!link}| {!link}.references.as_str()) }}, {2}) }}"
    (fn ((ref outgoing)
         (ref (option reply-link))
         (ref str))
      string)))
