(use adapters/driven/gmail/http http-agent http-get-all
                                http-post-form
                                http-post-json http-reply
                                reply-body reply-status)

(use adapters/driving/json/value json-value parse-json
                                 string-field)

(use adapters/driven/gmail/replies as-internal checked
                                   collect-results
                                   into-replies sent)

(use domain/mail-error mail-error)

(export ->gmail-endpoints ->gmail-session api-get!
        api-get-all! api-post! gmail-endpoints
        gmail-session)

(def unauthorized 401)

(defstruct gmail-endpoints
  :api-base string
  :token-url string
  :client-id string
  :client-secret string
  :rate-limit-pause-milliseconds u64
  :request-spacing-milliseconds u64)

(defstruct gmail-session
  :agent http-agent
  :endpoints gmail-endpoints
  :refresh-token string
  :access-token (option string))

(type api-get!
  (fn ((mut gmail-session) (ref str))
    (result json-value mail-error)))

(defn api-get! (session path)
  (let (url (api-url session path)
        first-reply (try (get-one! session (ref url))))
    (if (= (reply-status (ref first-reply)) unauthorized)
      (do
        (try (refresh! session))
        (checked (try (get-one! session (ref url)))))
      (checked first-reply))))

(type get-one!
  (fn ((mut gmail-session) (ref str))
    (result http-reply mail-error)))

(defn get-one! (session url)
  (let (token (try (access-token! session)))
    (sent (first-outcome (http-get-all (ref (:agent session))
                                       (ref (vec (str url)))
                                       (ref token)
                                       (:rate-limit-pause-milliseconds (:endpoints
                                                                         session))
                                       (:request-spacing-milliseconds (:endpoints
                                                                        session)))))))

(def first-outcome
  (rust "{0}.into_iter().next().unwrap_or_else(|| Err(String::from(\"no reply\")))"
    (fn ((vec (result http-reply string)))
      (result http-reply string))))

(type api-get-all!
  (fn ((mut gmail-session) (ref (vec string)))
    (result (vec json-value) mail-error)))

(defn api-get-all! (session paths)
  (let (token (try (access-token! session))
        urls (collect (map (iter paths)
                        (fn (path) (api-url session path))))
        replies (http-get-all
                  (ref (:agent session))
                  (ref urls)
                  (ref token)
                  (:rate-limit-pause-milliseconds (:endpoints session))
                  (:request-spacing-milliseconds (:endpoints session))))
    (collect-results (collect (map (into-replies replies)
                                (fn (outcome)
                                  (checked (try (sent outcome)))))))))

(type api-post!
  (fn ((mut gmail-session)
       (ref str)
       (ref str))
    (result json-value mail-error)))

(defn api-post! (session path body)
  (let (url (api-url session path)
        first-reply (try (sent (http-post-json (ref (:agent session))
                                               (ref url)
                                               (ref (try (access-token!
                                                           session)))
                                               body))))
    (if (= (reply-status (ref first-reply)) unauthorized)
      (do
        (try (refresh! session))
        (checked (try (sent (http-post-json (ref (:agent session))
                                            (ref url)
                                            (ref (try (access-token! session)))
                                            body)))))
      (checked first-reply))))

(type access-token!
  (fn ((mut gmail-session))
    (result string mail-error)))

(defn access-token! (session)
  (match (ref (:access-token session))
    ((some token) (ok (clone token)))
    (none (do (try (refresh! session)) (access-token! session)))))

(type refresh!
  (fn ((mut gmail-session))
    (result unit mail-error)))

(defn refresh! (session)
  (let (endpoints (ref (:endpoints session))
        form (vec (pair (str "grant_type") (str "refresh_token"))
                  (pair (str "client_id")
                        (clone (:client-id endpoints)))
                  (pair (str "client_secret")
                        (clone (:client-secret endpoints)))
                  (pair (str "refresh_token")
                        (clone (:refresh-token session))))
        reply (try (sent (http-post-form (ref (:agent session))
                                         (ref (:token-url endpoints))
                                         (ref form)))))
    (if (= (reply-status (ref reply)) 200)
      (let (body (try (as-internal (parse-json (ref (reply-body (ref
                                                                  reply)))))))
        (set! (:access-token session)
              (some (try (as-internal (string-field (ref body)
                                                    "access_token")))))
        (ok (do)))
      (err (mail-error/auth-required (str "Google refused the saved sign-in; run `knave-mail accounts add` again"))))))

(type api-url
  (fn ((ref gmail-session) (ref str))
    string))

(defn api-url (session path)
  (str (:api-base (:endpoints session)) path))
