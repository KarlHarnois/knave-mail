(use adapters/driven/gmail/http http-get-all http-post-json
                                http-reply)

(use adapters/driven/gmail/replies checked collect-results
                                   into-replies sent)

(use adapters/driven/gmail/request-log clock-milliseconds
                                       log-outcome!)

(use adapters/driven/gmail/session-state gmail-session)
(use adapters/driven/gmail/tokens access-token! refresh!)
(use adapters/json/value json-value)
(use domain/mail-error mail-error)

(export api-get! api-get-all! api-post!)

(def unauthorized 401)

(type api-get!
  (fn ((mut gmail-session) (ref str))
    (result json-value mail-error)))

(defn api-get! (session path)
  (let (first-reply (try (get-one! session path)))
    (if (= (:status first-reply) unauthorized)
      (do
        (try (refresh! session))
        (checked (try (get-one! session path))))
      (checked first-reply))))

(type get-one!
  (fn ((mut gmail-session) (ref str))
    (result http-reply mail-error)))

(defn get-one! (session path)
  (let (token (try (access-token! session))
        started (clock-milliseconds)
        outcome (only-outcome (fetched-all session
                                           (ref (vec (str path)))
                                           (ref token))))
    (log-outcome! (ref (:log session))
                  "GET" path
                  (ref outcome)
                  started)
    (sent outcome)))

(type api-get-all!
  (fn ((mut gmail-session) (ref (vec string)))
    (result (vec json-value) mail-error)))

(defn api-get-all! (session paths)
  (let (token (try (access-token! session))
        started (clock-milliseconds)
        replies (fetched-all session paths (ref token)))
    (for-each (enumerate (iter replies))
      (fn (numbered)
        (let-match ((pair index outcome) numbered)
          (log-outcome! (ref (:log session))
                        "GET"
                        (at paths index)
                        outcome started))))
    (collect-results (collect (map (into-replies replies)
                                (fn (outcome)
                                  (checked (try (sent outcome)))))))))

(type fetched-all
  (fn ((ref gmail-session)
       (ref (vec string))
       (ref str))
    (vec (result http-reply string))))

(defn fetched-all (session paths token)
  (let (endpoints (ref (:endpoints session)))
    (http-get-all (ref (:agent session))
                  (ref (collect (map (iter paths)
                                  (fn (path) (api-url session path)))))
                  token
                  (:rate-limit-pause-milliseconds endpoints)
                  (:request-spacing-milliseconds endpoints))))

(type api-post!
  (fn ((mut gmail-session)
       (ref str)
       (ref str))
    (result json-value mail-error)))

(defn api-post! (session path body)
  (let (first-reply (try (post-one! session path body)))
    (if (= (:status first-reply) unauthorized)
      (do
        (try (refresh! session))
        (checked (try (post-one! session path body))))
      (checked first-reply))))

(type post-one!
  (fn ((mut gmail-session)
       (ref str)
       (ref str))
    (result http-reply mail-error)))

(defn post-one! (session path body)
  (let (token (try (access-token! session))
        started (clock-milliseconds)
        outcome (http-post-json (ref (:agent session))
                                (ref (api-url session path))
                                (ref token)
                                body))
    (log-outcome! (ref (:log session))
                  "POST" path
                  (ref outcome)
                  started)
    (sent outcome)))

(type only-outcome
  (fn ((vec (result http-reply string)))
    (result http-reply string)))

(defn only-outcome (replies)
  (local remaining replies)
  (unwrap-or (pop! (mut remaining))
             (err (str "no reply"))))

(type api-url
  (fn ((ref gmail-session) (ref str))
    string))

(defn api-url (session path)
  (str (:api-base (:endpoints session)) path))
