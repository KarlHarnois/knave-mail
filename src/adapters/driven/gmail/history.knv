(use adapters/driven/gmail/session api-get!)
(use adapters/driven/gmail/session-state gmail-session)
(use adapters/driven/gmail/history-entry with-entry)

(use adapters/json/value array-field json-value
                         optional-string-field)

(use domain/history ->mail-changes mail-changes)
(use domain/mail-error mail-error)
(use ports/driven/event-log log-info)

(export fetched-changes! fetched-history-id!)

(def users-me "/gmail/v1/users/me")

(def history-page-size 500)

(def history-types
  "&historyTypes=messageAdded&historyTypes=messageDeleted&historyTypes=labelAdded&historyTypes=labelRemoved")

(defn fetched-history-id! (session)
  (ok (history-id-of (ref (try (api-get! session
                                         (ref (str users-me "/profile"))))))))

(defn fetched-changes! (session since)
  (collected-pages! session since
                    (str "")
                    (->mail-changes :refetch (vec)
                                    :relabels (vec)
                                    :history-id (str ""))))

(type collected-pages!
  (fn ((mut gmail-session) (ref str) string mail-changes)
    (result mail-changes mail-error)))

(defn collected-pages! (session since page-token found)
  (let (page (try (api-get! session
                            (ref (history-path since (ref page-token)))))
        so-far (reduce (array-field (ref page) "history") found with-entry))
    (log-info (ref (:log session))
              "gmail"
              (str "history since " since ": " (history-shape (ref page))))
    (match (optional-string-field (ref page) "nextPageToken")
      ((some token) (recur session since token so-far))
      (none (ok (assoc so-far :history-id (history-id-of (ref page))))))))

(defn history-path (since page-token)
  (str users-me "/history?startHistoryId=" since
       "&maxResults=" history-page-size
       (if (empty? page-token)
         (str "")
         (str "&pageToken=" page-token))
       history-types))

(def history-shape
  (rust "{{ let {!records} = {0}[\"history\"].as_array().cloned().unwrap_or_default(); let {!typed} = |{!record}: &serde_json::Value| [\"messagesAdded\", \"messagesDeleted\", \"labelsAdded\", \"labelsRemoved\"].iter().flat_map(|{!kind}| {!record}[*{!kind}].as_array().cloned().unwrap_or_default()).filter_map(|{!item}| {!item}[\"message\"][\"id\"].as_str().map(str::to_string)).collect::<std::collections::HashSet<_>>(); let {!count} = |{!kind}: &str| {!records}.iter().map(|{!record}| {!record}[{!kind}].as_array().map_or(0, Vec::len)).sum::<usize>(); let {!untyped} = {!records}.iter().map(|{!record}| {{ let {!known} = {!typed}({!record}); {!record}[\"messages\"].as_array().map_or(0, |{!messages}| {!messages}.iter().filter(|{!message}| !{!known}.contains({!message}[\"id\"].as_str().unwrap_or(\"\"))).count()) }}).sum::<usize>(); format!(\"{{}} records, {{}} messages added, {{}} deleted, {{}} labels added, {{}} labels removed, {{}} message changes without a type\", {!records}.len(), {!count}(\"messagesAdded\"), {!count}(\"messagesDeleted\"), {!count}(\"labelsAdded\"), {!count}(\"labelsRemoved\"), {!untyped}) }}"
    (fn ((ref json-value)) string)))

(def history-id-of
  (rust "{0}.get(\"historyId\").map(|{!value}| {!value}.as_str().map(str::to_string).unwrap_or_else(|| {!value}.to_string())).unwrap_or_default()"
    (fn ((ref json-value)) string)))
