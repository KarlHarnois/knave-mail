(use domain/log-entry log-area)
(use adapters/driven/gmail/session api-get!)
(use adapters/driven/gmail/session-state gmail-session)
(use adapters/driven/gmail/fields required-text)

(use adapters/driven/gmail/requests page-token-part
                                    users-me)

(use adapters/driven/gmail/history-entry entries->mail-changes
                                         history-entry
                                         json->history-entry)

(use adapters/json/value array-field json-value
                         optional-string-field)

(use domain/collections collect-ok concatenated)
(use domain/history mail-changes)
(use domain/mail-error error-message mail-error not-found?)
(use ports/driven/event-log log-info)

(export fetched-changes! fetched-history-id!)

(def history-page-size 500)

(def history-types
  "&historyTypes=messageAdded&historyTypes=messageDeleted&historyTypes=labelAdded&historyTypes=labelRemoved")

(defn fetched-history-id! (session)
  (json->history-id (ref (try (api-get! session
                                        (ref (str users-me "/profile")))))))

(defstruct history-paging
  :since string
  :page-token (option string)
  :found (vec history-entry))

(defn fetched-changes! (session since)
  (collected-pages! session
                    (->history-paging :since (str since)
                                      :page-token none
                                      :found (vec))))

(type collected-pages!
  (fn ((mut gmail-session) history-paging)
    (result mail-changes mail-error)))

(defn collected-pages! (session paging)
  (let (since (as-str (:since paging))
        page (try (map-err (api-get! session
                                     (ref (history-path since
                                                        (ref (:page-token
                                                               paging)))))
                           not-found->history-expired))
        entries (try (-> (array-field (ref page) "history")
                         iter
                         (map (fn (entry) (json->history-entry entry)))
                         collect-ok))
        so-far (concatenated (clone (:found paging)) entries))
    (log-info (ref (:log session))
              log-area/gmail
              (str "history since " since ": " (history-shape (ref page))))
    (match (optional-string-field (ref page) "nextPageToken")
      ((some token)
       (recur session
              (->history-paging :since (str since)
                                :page-token (some token)
                                :found so-far)))
      (none (ok (entries->mail-changes (ref so-far)
                                       (try (json->history-id (ref page)))))))))

(defn not-found->history-expired (failure)
  (if (not-found? (ref failure))
    (mail-error/history-expired (str (error-message (ref failure))))
    failure))

(defn history-path (since page-token)
  (str users-me "/history?startHistoryId=" since
       "&maxResults=" history-page-size
       (page-token-part page-token)
       history-types))

(def history-shape
  (rust "native::gmail_history::history_shape({0})"
    (fn ((ref json-value)) string)))

(defn json->history-id (reply)
  (required-text reply "historyId"))
