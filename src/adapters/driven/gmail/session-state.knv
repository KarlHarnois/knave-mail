(use adapters/driven/gmail/http http-agent)
(use ports/driven/event-log event-log)

(export ->gmail-endpoints ->gmail-session gmail-endpoints
        gmail-session)

(defstruct gmail-endpoints
  :api-base string
  :token-url string
  :client-id string
  :client-secret string
  :rate-limit-pause-milliseconds u64
  :request-spacing-milliseconds u64)

(defstruct gmail-session
  :agent http-agent
  :endpoints gmail-endpoints
  :refresh-token string
  :access-token (option string)
  :log (box event-log))
