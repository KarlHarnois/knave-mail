(use adapters/driven/gmail/http http-agent)
(use adapters/driven/gmail/quota quota-bucket)
(use ports/driven/clock clock)
(use ports/driven/event-log event-log)

(export ->gmail-endpoints ->gmail-session api-url
        gmail-endpoints gmail-session)

(defstruct gmail-endpoints
  :api-base string
  :token-url string
  :client-id string
  :client-secret string
  :quota-units-per-second int)

(defstruct gmail-session
  :agent http-agent
  :endpoints gmail-endpoints
  :refresh-token string
  :access-token (option string)
  :quota quota-bucket
  :clock clock
  :log event-log)

(type api-url
  (fn ((ref gmail-session) (ref str))
    string))

(defn api-url (session path)
  (str (:api-base (:endpoints session)) path))
