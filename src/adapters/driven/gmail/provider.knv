(use adapters/driven/gmail/http new-agent)
(use adapters/driven/gmail/mailbox ->gmail-mailbox)
(use adapters/driven/gmail/quota full-bucket)

(use adapters/driven/gmail/session-state ->gmail-session
                                         gmail-endpoints
                                         gmail-session)

(use domain/mail-error mail-error)
(use ports/driven/credentials credentials load-token)
(use ports/driven/event-log event-log share-log)
(use ports/driven/mailbox mailbox)
(use ports/driven/mailbox-provider mailbox-provider)

(export ->gmail-provider gmail-provider)

(defstruct gmail-provider
  :endpoints gmail-endpoints
  :credentials credentials
  :log event-log)

(impl mailbox-provider gmail-provider
  (connect-mailbox! (provider email)
    (match (try (load-token (ref (:credentials provider)) email))
      ((some refresh-token)
       (ok (the (box mailbox)
                (box (->gmail-mailbox (session-for provider refresh-token))))))
      (none (err (mail-error/auth-required (str "no saved sign-in for "
                                                email
                                                "; run `knave-mail accounts add`")))))))

(type session-for
  (fn ((ref gmail-provider) string) gmail-session))

(defn session-for (provider refresh-token)
  (->gmail-session :agent (new-agent)
                   :endpoints (clone (:endpoints provider))
                   :refresh-token refresh-token
                   :access-token none
                   :quota (full-bucket (:quota-units-per-second (:endpoints
                                                                  provider)))
                   :log (share-log (ref (:log provider)))))
