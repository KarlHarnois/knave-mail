(use domain/log-entry log-area)
(use adapters/driven/gmail/http http-post-form)
(use adapters/driven/gmail/fields text-error->internal-error)
(use adapters/driven/gmail/replies sent)
(use adapters/driven/gmail/session-state gmail-session)
(use adapters/json/value parse-json string-field)
(use domain/mail-error mail-error)
(use ports/driven/event-log log-info log-warn)

(export access-token! refresh!)

(type access-token!
  (fn ((mut gmail-session))
    (result string mail-error)))

(defn access-token! (session)
  (match (ref (:access-token session))
    ((some token) (ok (clone token)))
    (none (do (try (refresh! session)) (access-token! session)))))

(type refresh!
  (fn ((mut gmail-session))
    (result unit mail-error)))

(defn refresh! (session)
  (let (endpoints (ref (:endpoints session))
        form (vec (pair (str "grant_type") (str "refresh_token"))
                  (pair (str "client_id")
                        (clone (:client-id endpoints)))
                  (pair (str "client_secret")
                        (clone (:client-secret endpoints)))
                  (pair (str "refresh_token")
                        (clone (:refresh-token session))))
        reply (try (sent (http-post-form (ref (:agent session))
                                         (ref (:token-url endpoints))
                                         (ref form)))))
    (if (= (:status reply) 200)
      (keep-access-token! session (ref (:body reply)))
      (failed-refresh (ref (:log session))
                      (ref reply)))))

(type keep-access-token!
  (fn ((mut gmail-session) (ref str))
    (result unit mail-error)))

(defn keep-access-token! (session body)
  (let (fields (try (text-error->internal-error (parse-json body))))
    (set! (:access-token session)
          (some (try (text-error->internal-error
                       (string-field (ref fields) "access_token")))))
    (log-info (ref (:log session))
              log-area/gmail
              (str "refreshed the access token"))
    (ok (do))))

(defn failed-refresh (log reply)
  (let (status (:status reply))
    (log-warn log log-area/gmail
              (str "Google's token endpoint answered " status))
    (cond
      ((or (= status 400) (= status 401))
       (err (mail-error/auth-required (str "Google refused the saved sign-in; run `knave-mail accounts add` again"))))
      ((or (= status 429) (>= status 500))
       (err (mail-error/network (str "Google's sign-in service is unavailable ("
                                     status
                                     "); try again later"))))
      (else (err (mail-error/internal (str "Google's token endpoint answered "
                                           status)))))))
