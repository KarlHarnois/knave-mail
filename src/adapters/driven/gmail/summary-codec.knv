(use adapters/driven/gmail/fields ids-of listed-labels
                                  optional-text
                                  required-text
                                  text-error->internal-error)

(use adapters/json/value array-field empty-object json-value
                         object-field)

(use domain/collections appended-once as-count)
(use domain/mail ->thread-summary thread-summary)
(use domain/mail-error mail-error)
(use domain/results unwrap-ok-or)
(use domain/text replaced trimmed-of)

(export json->summary thread-labels)

(defn json->summary (thread)
  (let (messages (array-field thread "messages"))
    (ok (->thread-summary :id (try (required-text thread "id"))
                          :subject (subject-of (ref messages))
                          :participants (join (ref (senders (ref messages)))
                                              ", ")
                          :snippet (snippet-of (ref messages))
                          :date (try (date-of (ref messages)))
                          :labels (thread-labels thread)
                          :message-count (as-count (len messages))
                          :message-ids (try (ids-of thread "messages"))))))

(defn subject-of (messages)
  (match (first messages)
    ((some earliest) (header-of earliest "Subject"))
    (none (str ""))))

(defn snippet-of (messages)
  (match (last messages)
    ((some latest) (unescaped (optional-text latest "snippet")))
    (none (str ""))))

(defn date-of (messages)
  (match (last messages)
    ((some latest) (internal-date latest))
    (none (ok 0))))

(defn senders (messages)
  (reduce (iter messages) (vec)
    (fn (names message)
      (appended-once names
                     (sender-name (as-str (header-of message "From")))))))

(defn sender-name (from)
  (let (name (-> (split from "<")
                 (find (fn (_) true))
                 (unwrap-or "")
                 trim
                 (trimmed-of "\"")))
    (if (empty? name) (trimmed-of from "<>") name)))

(defn header-of (message name)
  (match (find (array-field (ref (payload-of message)) "headers")
           (fn (entry)
             (= (lower-case (as-str (optional-text entry "name")))
                (lower-case name))))
    ((some entry) (optional-text entry "value"))
    (none (str ""))))

(defn payload-of (message)
  (unwrap-ok-or (object-field message "payload")
                (empty-object)))

(defstruct html-entity
  :escaped (ref str)
  :character (ref str))

(def snippet-entities
  (vec (->html-entity :escaped "&#39;" :character "'")
       (->html-entity :escaped "&quot;" :character "\"")
       (->html-entity :escaped "&amp;" :character "&")
       (->html-entity :escaped "&lt;" :character "<")
       (->html-entity :escaped "&gt;" :character ">")))

(defn unescaped (snippet)
  (reduce (iter snippet-entities) snippet
    (fn (text entity)
      (replaced text (:escaped entity) (:character entity)))))

(type internal-date
  (fn ((ref json-value))
    (result int mail-error)))

(defn internal-date (message)
  (let (text (try (required-text message "internalDate")))
    (text-error->internal-error (map-err (parse (as-str text))
                                  (fn (problem)
                                    (str "internalDate: " problem))))))

(defn thread-labels (thread)
  (reduce (array-field thread "messages") (vec)
    (fn (labels message)
      (reduce (listed-labels message) labels
        (fn (found label)
          (appended-once found (clone label)))))))
