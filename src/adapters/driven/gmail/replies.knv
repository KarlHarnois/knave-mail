(use adapters/driven/gmail/http http-reply rate-limited?)
(use adapters/driving/json/value json-value parse-json)
(use domain/mail-error mail-error)

(export as-internal checked collect-results into-replies
        sent)

(type checked
  (fn (http-reply) (result json-value mail-error)))

(defn checked (reply)
  (let (status (:status reply)
        body (clone (:body reply)))
    (cond
      ((and (>= status 200) (< status 300))
       (as-internal (parse-json (ref (non-empty-json body)))))
      ((rate-limited? (ref reply))
       (err (mail-error/network (str "Gmail's rate limit is still reached after retrying; sync again in a minute"))))
      ((= status 404)
       (err (mail-error/not-found (str "Gmail has no such item: " body))))
      ((or (= status 401) (= status 403))
       (err (mail-error/auth-required (str "Gmail refused access: " body))))
      ((or (= status 429) (>= status 500))
       (err (mail-error/network (str "Gmail is unavailable (" status ")"))))
      (else (err (mail-error/internal
                   (str "Gmail answered " status ": " body)))))))

(type sent
  (fn ((result http-reply string))
    (result http-reply mail-error)))

(defn sent (outcome)
  (map-err outcome
    (fn (problem)
      (mail-error/network (str "cannot reach Google: " problem)))))

(type as-internal
  (where (value)
    (fn ((result value string))
      (result value mail-error))))

(defn as-internal (outcome)
  (map-err outcome
    (fn (problem)
      (mail-error/internal (str "unexpected Gmail answer: " problem)))))

(type non-empty-json (fn (string) string))

(defn non-empty-json (body)
  (if (empty? (trim (as-str body)))
    (str "{}")
    body))

(def into-replies
  (rust "{0}.into_iter()"
    (fn ((vec (result http-reply string)))
      (iterator (result http-reply string)))))

(def collect-results
  (rust "{0}.into_iter().collect::<Result<Vec<_>, _>>()"
    (fn ((vec (result json-value mail-error)))
      (result (vec json-value) mail-error))))
