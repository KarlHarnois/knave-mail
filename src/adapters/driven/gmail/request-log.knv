(use adapters/driven/gmail/http-method http-method
                                       http-method->name)

(use adapters/driven/gmail/http-reply http-reply)
(use ports/driven/event-log event-log log-debug log-warn)
(use adapters/clock clock-milliseconds)

(export clock-milliseconds log-outcome!)

(def area "gmail")

(defn log-outcome! (log method path outcome started)
  (let (shown (str (http-method->name method) " " (without-query path)))
    (match outcome
      ((ok reply)
       (log-debug log area
                  (str shown " "
                       (:status reply)
                       " "
                       (- (clock-milliseconds) started)
                       "ms")))
      ((err problem)
       (log-warn log area (str shown " failed: " problem))))))

(defn without-query (path)
  (let (parts (collect (split path "?")))
    (str (at parts 0))))
