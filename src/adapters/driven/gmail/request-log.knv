(use domain/log-entry log-area)

(use adapters/driven/gmail/http-method http-method
                                       http-method->name)

(use adapters/driven/gmail/http-reply http-reply)
(use ports/driven/event-log event-log log-debug log-warn)

(export log-outcome!)

(defn log-outcome! (log method path outcome elapsed)
  (let (shown (str (http-method->name method) " " (without-query path)))
    (match outcome
      ((ok reply)
       (log-debug log log-area/gmail
                  (str shown " " (:status reply) " " elapsed "ms")))
      ((err problem)
       (log-warn log log-area/gmail
                 (str shown " failed: " problem))))))

(defn without-query (path)
  (let (parts (collect (split path "?")))
    (str (at parts 0))))
