(use adapters/driven/gmail/http http-reply reply-retries
                                reply-status)

(use ports/driven/event-log event-log log-debug log-warn)

(export clock-milliseconds log-outcome!)

(def area "gmail")

(type log-outcome!
  (fn ((ref (box event-log))
       (ref str)
       (ref str)
       (ref (result http-reply string))
       u64)
    unit))

(defn log-outcome! (log method path outcome started)
  (let (shown (str method " " (without-query path)))
    (match outcome
      ((ok reply)
       (do
         (when (> (reply-retries reply) 0)
           (log-warn log area
                     (str shown
                          " hit the rate limit, retried "
                          (reply-retries reply)
                          " times")))
         (log-debug log area
                    (str shown " "
                         (reply-status reply)
                         " "
                         (- (clock-milliseconds) started)
                         "ms"))))
      ((err problem)
       (log-warn log area (str shown " failed: " problem))))))

(type without-query
  (fn ((ref str)) string))

(defn without-query (path)
  (let (parts (collect (split path "?")))
    (str (at parts 0))))

(def clock-milliseconds
  (rust "std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|{!elapsed}| {!elapsed}.as_millis() as u64).unwrap_or(0)"
    (fn () u64)))
