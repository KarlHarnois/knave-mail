(use adapters/driven/gmail/http-method http-method)
(use ports/driven/clock clock now-milliseconds pause!)

(export ->quota-bucket full-bucket pace-at quota-bucket
        slowed-at! take-units! units-for)

(def slowest-pace 10)

(def recovered-share-per-minute 10)

(def milliseconds-per-minute 60000)

(def throttle-window-milliseconds 60000)

(defstruct quota-bucket
  :ceiling int
  :slowed-to int
  :slowed-at int
  :throttled-at (option int)
  :available int
  :refilled-at int)

(type full-bucket (fn (int int) quota-bucket))

(defn full-bucket (units-per-second now)
  (do
    (->quota-bucket :ceiling units-per-second
                    :slowed-to units-per-second
                    :slowed-at now
                    :throttled-at none
                    :available units-per-second
                    :refilled-at now)))

(type pace-at
  (fn ((ref quota-bucket) int) int))

(defn pace-at (bucket now)
  (min (:ceiling bucket)
       (+ (:slowed-to bucket)
          (/ (* (- now (:slowed-at bucket))
                (/ (:ceiling bucket) recovered-share-per-minute))
             milliseconds-per-minute))))

(type slowed-at!
  (fn ((mut quota-bucket) int) unit))

(defn slowed-at! (bucket now)
  (unless (throttled-within-window? bucket now)
    (set! (:slowed-to bucket)
          (max slowest-pace (/ (pace-at bucket now) 2)))
    (set! (:slowed-at bucket) now)
    (set! (:throttled-at bucket) (some now)))
  (set! (:available bucket) 0)
  (set! (:refilled-at bucket) now))

(type throttled-within-window?
  (fn ((ref quota-bucket) int) bool))

(defn throttled-within-window? (bucket now)
  (match (:throttled-at bucket)
    ((some throttled)
     (< (- now throttled) throttle-window-milliseconds))
    (none false)))

(type take-units!
  (fn ((mut quota-bucket) int (ref clock))
    unit))

(defn take-units! (bucket units chosen)
  (refill! bucket (now-milliseconds chosen))
  (when (< (:available bucket) units)
    (pause! chosen
            (milliseconds-until bucket units (now-milliseconds chosen)))
    (refill! bucket (now-milliseconds chosen)))
  (set! (:available bucket)
        (- (:available bucket) units)))

(type refill!
  (fn ((mut quota-bucket) int) unit))

(defn refill! (bucket now)
  (let (pace (pace-at bucket now)
        earned (/ (* (- now (:refilled-at bucket)) pace)
                  1000))
    (when (pos? earned)
      (set! (:available bucket)
            (min pace (+ (:available bucket) earned)))
      (set! (:refilled-at bucket) now))))

(type milliseconds-until
  (fn ((ref quota-bucket) int int) int))

(defn milliseconds-until (bucket units now)
  (inc (/ (* (- units (:available bucket)) 1000)
          (pace-at bucket now))))

(type units-for
  (fn (http-method (ref str)) int))

(defn units-for (method path)
  (cond
    ((ends-with? path "/messages/send") 100)
    ((ends-with? path "/batchModify") 50)
    ((ends-with? path "/modify") 10)
    ((= method http-method/post) 10)
    ((contains? path "/threads") 10)
    ((contains? path "/messages") 5)
    ((contains? path "/history") 2)
    (else 1)))

(def ends-with?
  (rust "{0}.ends_with({1})"
    (fn ((ref str) (ref str)) bool)))
