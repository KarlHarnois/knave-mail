(export ->quota-bucket current-pace full-bucket pace-at
        quota-bucket slowed! slowed-at! take-units!
        units-for)

(def slowest-pace 10)

(def recovered-share-per-minute 10)

(def milliseconds-per-minute 60000)

(defstruct quota-bucket
  :ceiling int
  :slowed-to int
  :slowed-at int
  :available int
  :refilled-at int)

(defn full-bucket (units-per-second)
  (let (now (wall-milliseconds))
    (->quota-bucket :ceiling units-per-second
                    :slowed-to units-per-second
                    :slowed-at now
                    :available units-per-second
                    :refilled-at now)))

(type pace-at
  (fn ((ref quota-bucket) int) int))

(defn pace-at (bucket now)
  (min (:ceiling bucket)
       (+ (:slowed-to bucket)
          (/ (* (- now (:slowed-at bucket))
                (/ (:ceiling bucket) recovered-share-per-minute))
             milliseconds-per-minute))))

(defn current-pace (bucket)
  (pace-at bucket (wall-milliseconds)))

(defn slowed! (bucket)
  (slowed-at! bucket (wall-milliseconds)))

(type slowed-at!
  (fn ((mut quota-bucket) int) unit))

(defn slowed-at! (bucket now)
  (set! (:slowed-to bucket)
        (max slowest-pace (/ (pace-at bucket now) 2)))
  (set! (:slowed-at bucket) now)
  (set! (:available bucket) 0)
  (set! (:refilled-at bucket) now))

(defn take-units! (bucket units)
  (refill! bucket)
  (when (< (:available bucket) units)
    (sleep-for (milliseconds-until bucket units))
    (refill! bucket))
  (set! (:available bucket)
        (- (:available bucket) units)))

(type refill!
  (fn ((mut quota-bucket)) unit))

(defn refill! (bucket)
  (let (now (wall-milliseconds)
        pace (pace-at bucket now)
        earned (/ (* (- now (:refilled-at bucket)) pace)
                  1000))
    (when (> earned 0)
      (set! (:available bucket)
            (min pace (+ (:available bucket) earned)))
      (set! (:refilled-at bucket) now))))

(type milliseconds-until
  (fn ((ref quota-bucket) int) int))

(defn milliseconds-until (bucket units)
  (+ 1
     (/ (* (- units (:available bucket)) 1000)
        (current-pace bucket))))

(type units-for
  (fn ((ref str) (ref str)) int))

(defn units-for (method path)
  (cond
    ((ends-with? path "/messages/send") 100)
    ((ends-with? path "/modify") 10)
    ((= method "POST") 10)
    ((contains? path "/threads") 10)
    ((contains? path "/messages") 5)
    ((contains? path "/history") 2)
    (else 1)))

(def ends-with?
  (rust "{0}.ends_with({1})"
    (fn ((ref str) (ref str)) bool)))

(def wall-milliseconds
  (rust "std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|{!elapsed}| {!elapsed}.as_millis() as i64).unwrap_or(0)"
    (fn () int)))

(def sleep-for
  (rust "std::thread::sleep(std::time::Duration::from_millis({0}.max(0) as u64))"
    (fn (int) unit)))
