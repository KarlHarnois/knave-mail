(use adapters/driven/sqlite/accounts erase-account
                                     read-accounts
                                     read-labels
                                     write-account
                                     write-labels)

(use adapters/driven/sqlite/checkpoints read-checkpoint
                                        write-checkpoint)

(use adapters/driven/sqlite/connection open-database
                                       sqlite-connection)

(use adapters/driven/sqlite/summaries load-summaries
                                      load-summaries-with-ids
                                      relabel-summary
                                      save-summaries
                                      summary-labels)

(use adapters/driven/sqlite/threads erase-thread
                                    read-message read-thread
                                    relabel-thread
                                    write-thread)

(use domain/labels apply-label-change label-change)
(use domain/mail-error mail-error)
(use ports/driven/store store)

(export open-sqlite-store sqlite-store)

(defstruct sqlite-store
  :connection sqlite-connection)

(defn open-sqlite-store (path)
  (ok (->sqlite-store (try (open-database path)))))

(impl store sqlite-store
  (load-accounts (kept)
                 (read-accounts (ref (:connection kept))))
  (save-account! (kept added)
                 (write-account (ref (:connection kept)) added))
  (forget-account! (kept email)
                   (erase-account (ref (:connection kept)) email))
  (load-labels (kept email)
               (read-labels (ref (:connection kept)) email))
  (save-labels! (kept email labels)
                (write-labels (ref (:connection kept)) email labels))
  (load-threads (kept email query)
                (load-summaries (ref (:connection kept)) email query))
  (save-threads! (kept email summaries)
                 (save-summaries (ref (:connection kept)) email summaries))
  (load-summaries-of (kept email ids)
                     (load-summaries-with-ids (ref (:connection kept))
                                              email ids))
  (load-thread (kept email thread-id)
               (read-thread (ref (:connection kept)) email thread-id))
  (load-message (kept email message-id)
                (read-message (ref (:connection kept)) email message-id))
  (save-thread! (kept email saved)
                (write-thread (ref (:connection kept)) email saved))
  (forget-thread! (kept email thread-id)
                  (erase-thread (ref (:connection kept)) email thread-id))
  (load-checkpoint (kept email)
                   (read-checkpoint (ref (:connection kept)) email))
  (save-checkpoint! (kept email history-id)
                    (write-checkpoint (ref (:connection kept))
                                      email history-id))
  (relabel-stored! (kept email thread-id change)
                   (relabel-everywhere (ref (:connection kept))
                                       email thread-id
                                       change)))

(defn relabel-everywhere (connection email thread-id change)
  (match (try (read-thread connection email thread-id))
    ((some stored)
     (try (relabel-thread connection email thread-id
                          (apply-label-change (ref (:labels stored)) change))))
    (none (do)))
  (match (try (summary-labels connection email thread-id))
    ((some labels)
     (relabel-summary connection email thread-id
                      (apply-label-change (ref labels) change)))
    (none (ok (do)))))
