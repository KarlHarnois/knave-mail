(use adapters/driven/sqlite/accounts erase-account
                                     read-accounts
                                     read-labels
                                     write-account
                                     write-labels)

(use adapters/driven/sqlite/checkpoints read-checkpoint
                                        write-checkpoint)

(use adapters/driven/sqlite/connection open-database
                                       sqlite-connection)

(use adapters/driven/sqlite/summaries read-summaries
                                      read-summaries-with-ids
                                      read-summary-labels
                                      relabel-summary
                                      write-summaries)

(use adapters/driven/sqlite/threads erase-thread
                                    read-message read-thread
                                    relabel-thread
                                    write-thread)

(use domain/labels apply-label-change label-change)
(use domain/mail-error mail-error)
(use ports/driven/store store)

(export open-sqlite-store sqlite-store)

(defstruct sqlite-store
  :connection sqlite-connection)

(defn open-sqlite-store (path)
  (ok (->sqlite-store (try (open-database path)))))

(impl store sqlite-store
  (load-accounts (cache)
    (read-accounts (ref (:connection cache))))

  (save-account! (cache added)
    (write-account (ref (:connection cache)) added))

  (forget-account! (cache email)
    (erase-account (ref (:connection cache)) email))

  (load-labels (cache email)
    (read-labels (ref (:connection cache)) email))

  (save-labels! (cache email labels)
    (write-labels (ref (:connection cache)) email labels))

  (load-threads (cache email query)
    (read-summaries (ref (:connection cache)) email query))

  (save-threads! (cache email summaries)
    (write-summaries (ref (:connection cache)) email summaries))

  (load-summaries-of (cache email ids)
    (read-summaries-with-ids (ref (:connection cache))
                             email ids))

  (load-thread (cache email thread-id)
    (read-thread (ref (:connection cache)) email thread-id))

  (load-message (cache email message-id)
    (read-message (ref (:connection cache)) email message-id))

  (save-thread! (cache email saved)
    (write-thread (ref (:connection cache)) email saved))

  (forget-thread! (cache email thread-id)
    (erase-thread (ref (:connection cache)) email thread-id))

  (load-checkpoint (cache email)
    (read-checkpoint (ref (:connection cache)) email))

  (save-checkpoint! (cache email history-id)
    (write-checkpoint (ref (:connection cache))
                      email history-id))

  (relabel-stored! (cache email thread-id change)
    (relabel-everywhere (ref (:connection cache))
                        email thread-id change)))

(defn relabel-everywhere (connection email thread-id change)
  (match (try (read-thread connection email thread-id))
    ((some stored)
     (try (relabel-thread connection email thread-id
                          (apply-label-change (ref (:labels stored)) change))))
    (none (do)))
  (match (try (read-summary-labels connection email thread-id))
    ((some labels)
     (relabel-summary connection email thread-id
                      (apply-label-change (ref labels) change)))
    (none (ok (do)))))
