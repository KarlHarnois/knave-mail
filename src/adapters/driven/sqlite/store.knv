(use adapters/driven/sqlite/accounts erase-account
                                     read-accounts
                                     read-labels
                                     write-account
                                     write-labels)

(use adapters/driven/sqlite/checkpoints read-checkpoint
                                        write-checkpoint)

(use adapters/driven/sqlite/downloads erase-download
                                      insert-downloads
                                      read-downloads)

(use adapters/driven/sqlite/connection open-database
                                       sqlite-connection)

(use adapters/driven/sqlite/message-counts read-message-counts)

(use adapters/driven/sqlite/queued count-queued erase-queued
                                   read-all-queued)

(use adapters/driven/sqlite/relabeling queued-together
                                       reapply-queued
                                       relabel-everywhere
                                       reverted)

(use adapters/driven/sqlite/summaries read-summaries
                                      read-summaries-with-ids
                                      write-summaries)

(use adapters/driven/sqlite/threads erase-thread
                                    read-message read-thread
                                    write-thread)

(use domain/labels label-change)
(use domain/mail-error mail-error)
(use ports/driven/store store)

(export open-sqlite-store sqlite-store)

(defstruct sqlite-store
  :connection sqlite-connection)

(defn open-sqlite-store (path)
  (ok (->sqlite-store (try (open-database path)))))

(impl store sqlite-store
  (load-accounts (cache)
    (read-accounts (ref (:connection cache))))

  (save-account! (cache added)
    (write-account (ref (:connection cache)) added))

  (forget-account! (cache email)
    (erase-account (ref (:connection cache)) email))

  (load-labels (cache email)
    (read-labels (ref (:connection cache)) email))

  (save-labels! (cache email labels)
    (write-labels (ref (:connection cache)) email labels))

  (load-threads (cache email query)
    (read-summaries (ref (:connection cache)) email query))

  (save-threads! (cache email summaries)
    (try (write-summaries (ref (:connection cache)) email summaries))
    (reapply-queued (ref (:connection cache)) email))

  (load-summaries-of (cache email ids)
    (read-summaries-with-ids (ref (:connection cache))
                             email ids))

  (load-message-counts (cache email ids)
    (read-message-counts (ref (:connection cache)) email ids))

  (load-thread (cache wanted)
    (read-thread (ref (:connection cache))
                 (as-str (:account wanted))
                 (as-str (:thread-id wanted))))

  (load-message (cache wanted)
    (read-message (ref (:connection cache))
                  (as-str (:account wanted))
                  (as-str (:message-id wanted))))

  (save-thread! (cache email saved)
    (try (write-thread (ref (:connection cache)) email saved))
    (reapply-queued (ref (:connection cache)) email))

  (forget-thread! (cache forgotten)
    (erase-thread (ref (:connection cache))
                  (as-str (:account forgotten))
                  (as-str (:thread-id forgotten))))

  (load-checkpoint (cache email)
    (read-checkpoint (ref (:connection cache)) email))

  (save-checkpoint! (cache email history-id)
    (write-checkpoint (ref (:connection cache))
                      email history-id))

  (save-pending-downloads! (cache email thread-ids)
    (insert-downloads (ref (:connection cache))
                      email thread-ids))

  (load-pending-downloads (cache email)
    (read-downloads (ref (:connection cache)) email))

  (forget-pending-download! (cache email thread-id)
    (erase-download (ref (:connection cache)) email thread-id))

  (relabel-stored! (cache relabeled change)
    (relabel-everywhere (ref (:connection cache))
                        relabeled change))

  (queue-relabels! (cache request)
    (queued-together (ref (:connection cache)) request))

  (load-queued (cache)
    (read-all-queued (ref (:connection cache))))

  (forget-queued! (cache id)
    (erase-queued (ref (:connection cache)) id))

  (revert-queued! (cache queued)
    (reverted (ref (:connection cache)) queued))

  (queued-count (cache email)
    (count-queued (ref (:connection cache)) email)))
