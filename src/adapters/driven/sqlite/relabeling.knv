(use domain/mail ->thread-ref thread-ref)
(use adapters/driven/sqlite/connection sqlite-connection)

(use adapters/driven/sqlite/queued begin! commit!
                                   erase-queued
                                   insert-queued
                                   read-queued-of rollback!)

(use adapters/driven/sqlite/summaries read-summary-labels
                                      relabel-summary)

(use adapters/driven/sqlite/thread-labels relabel-thread)
(use adapters/driven/sqlite/threads read-thread)
(use domain/collections try-for-each)

(use domain/labels apply-label-change label-change
                   reversed-change)

(use domain/mail-error mail-error)
(use domain/queued-relabel ->queued-relabel queued-relabel)

(export queued-together reapply-queued relabel-everywhere
        reverted)

(defn queued-together (connection email thread-ids change)
  (try (begin! connection))
  (match (queued-each connection email thread-ids change)
    ((ok rows) (do (try (commit! connection)) (ok rows)))
    ((err failure)
     (do
       (try (rollback! connection))
       (err failure)))))

(defn queued-each (connection email thread-ids change)
  (local rows (vec))
  (try (try-for-each (iter thread-ids)
         (fn (thread-id)
           (let (thread (->thread-ref :account (str email)
                                      :thread-id (clone thread-id)))
             (try (relabel-everywhere connection (ref thread) change))
             (push! rows
                    (->queued-relabel
                      :id (try (insert-queued connection (ref thread) change))
                      :account (str email)
                      :thread-id (clone thread-id)
                      :change (clone change))))
           (ok (do)))))
  (ok rows))

(defn reverted (connection queued)
  (try (begin! connection))
  (match (reverted-in-place connection queued)
    ((ok _) (commit! connection))
    ((err failure)
     (do
       (try (rollback! connection))
       (err failure)))))

(type reverted-in-place
  (fn ((ref sqlite-connection) (ref queued-relabel))
    (result unit mail-error)))

(defn reverted-in-place (connection queued)
  (try (relabel-everywhere connection
                           (ref (->thread-ref :account (clone (:account queued))
                                              :thread-id (clone (:thread-id
                                                                  queued))))
                           (ref (reversed-change (ref (:change queued))))))
  (erase-queued connection (:id queued)))

(defn reapply-queued (connection email)
  (try-for-each (iter (try (read-queued-of connection email)))
    (fn (row)
      (relabel-everywhere connection
                          (ref (->thread-ref :account (str email)
                                             :thread-id (clone (:thread-id
                                                                 row))))
                          (ref (:change row))))))

(type relabel-everywhere
  (fn ((ref sqlite-connection)
       (ref thread-ref)
       (ref label-change))
    (result unit mail-error)))

(defn relabel-everywhere (connection thread change)
  (let (account (as-str (:account thread))
        thread-id (as-str (:thread-id thread)))
    (match (try (read-thread connection account thread-id))
      ((some stored)
       (try (relabel-thread connection thread
                            (apply-label-change (ref (:labels stored))
                                                change))))
      (none (do)))
    (match (try (read-summary-labels connection account thread-id))
      ((some labels)
       (relabel-summary connection thread
                        (apply-label-change (ref labels) change)))
      (none (ok (do))))))
