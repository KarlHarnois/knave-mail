(use adapters/driven/sqlite/connection sqlite-connection)
(use adapters/driven/sqlite/rows as-internal)
(use domain/labels label-change)

(use domain/mail ->thread-summary thread-query
                 thread-summary)

(use domain/mail-error mail-error)

(export load-summaries load-summaries-with-ids
        relabel-summary save-summaries summary-labels)

(defstruct summary-row
  :id string
  :subject string
  :participants string
  :snippet string
  :date i64
  :labels (vec string)
  :message-count i64)

(type load-summaries
  (fn ((ref sqlite-connection)
       (ref str)
       (ref thread-query))
    (result (vec thread-summary) mail-error)))

(defn load-summaries (connection account query)
  (let (rows (try (as-internal (summary-rows connection
                                             account
                                             (:label query)
                                             (:limit query)))))
    (ok (collect (map (iter rows)
                   (fn (row) (summary-from row)))))))

(type load-summaries-with-ids
  (fn ((ref sqlite-connection)
       (ref str)
       (ref (vec string)))
    (result (vec thread-summary) mail-error)))

(defn load-summaries-with-ids (connection account ids)
  (let (rows (try (as-internal (summary-rows-with-ids connection account ids))))
    (ok (collect (map (iter rows)
                   (fn (row) (summary-from row)))))))

(def summary-rows-with-ids
  (rust "{0}.prepare_cached(\"SELECT id, subject, participants, snippet, date, labels, message_count FROM summaries WHERE account = ?1 AND id IN (SELECT value FROM json_each(?2))\").and_then(|mut {!statement}| {!statement}.query_map(rusqlite::params![{1}, serde_json::to_string({2}).unwrap_or_default()], |{!row}| Ok(SummaryRow {{ id: {!row}.get(0)?, subject: {!row}.get(1)?, participants: {!row}.get(2)?, snippet: {!row}.get(3)?, date: {!row}.get(4)?, labels: serde_json::from_str::<Vec<String>>(&{!row}.get::<_, String>(5)?).unwrap_or_default(), message_count: {!row}.get(6)? }})).and_then(|{!rows}| {!rows}.collect::<rusqlite::Result<Vec<_>>>())).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref sqlite-connection)
         (ref str)
         (ref (vec string)))
      (result (vec summary-row) string))))

(type summary-from
  (fn ((ref summary-row)) thread-summary))

(defn summary-from (row)
  (->thread-summary :id (clone (:id row))
                    :subject (clone (:subject row))
                    :participants (clone (:participants row))
                    :snippet (clone (:snippet row))
                    :date (:date row)
                    :labels (clone (:labels row))
                    :message-count (:message-count row)))

(type save-summaries
  (fn ((ref sqlite-connection)
       (ref str)
       (ref (vec thread-summary)))
    (result unit mail-error)))

(defn save-summaries (connection account summaries)
  (try (as-internal (upsert-summaries connection account summaries)))
  (as-internal (align-thread-labels connection account summaries)))

(type relabel-summary
  (fn ((ref sqlite-connection)
       (ref str)
       (ref str)
       (vec string))
    (result unit mail-error)))

(defn relabel-summary (connection account thread-id labels)
  (as-internal (update-summary-labels connection account thread-id labels)))

(type summary-labels
  (fn ((ref sqlite-connection)
       (ref str)
       (ref str))
    (result (option (vec string)) mail-error)))

(defn summary-labels (connection account thread-id)
  (as-internal (stored-summary-labels connection account thread-id)))

(def stored-summary-labels
  (rust "{{ use rusqlite::OptionalExtension; {0}.query_row(\"SELECT labels FROM summaries WHERE account = ?1 AND id = ?2\", [{1}, {2}], |{!row}| {!row}.get::<_, String>(0)).optional().map(|{!found}| {!found}.map(|{!text}| serde_json::from_str::<Vec<String>>(&{!text}).unwrap_or_default())).map_err(|{!error}| {!error}.to_string()) }}"
    (fn ((ref sqlite-connection)
         (ref str)
         (ref str))
      (result (option (vec string)) string))))

(def summary-rows
  (rust "{0}.prepare_cached(\"SELECT id, subject, participants, snippet, date, labels, message_count FROM summaries WHERE account = ?1 AND (?2 = 'ALL' OR EXISTS (SELECT 1 FROM json_each(summaries.labels) WHERE value = ?2)) ORDER BY date DESC LIMIT ?3\").and_then(|mut {!statement}| {!statement}.query_map(rusqlite::params![{1}, {2}, {3}], |{!row}| Ok(SummaryRow {{ id: {!row}.get(0)?, subject: {!row}.get(1)?, participants: {!row}.get(2)?, snippet: {!row}.get(3)?, date: {!row}.get(4)?, labels: serde_json::from_str::<Vec<String>>(&{!row}.get::<_, String>(5)?).unwrap_or_default(), message_count: {!row}.get(6)? }})).and_then(|{!rows}| {!rows}.collect::<rusqlite::Result<Vec<_>>>())).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref sqlite-connection)
         (ref str)
         (ref str)
         i64)
      (result (vec summary-row) string))))

(def upsert-summaries
  (rust "{0}.prepare_cached(\"INSERT OR REPLACE INTO summaries (account, id, subject, participants, snippet, date, labels, message_count) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)\").and_then(|mut {!statement}| {2}.iter().try_for_each(|{!summary}| {!statement}.execute(rusqlite::params![{1}, {!summary}.id, {!summary}.subject, {!summary}.participants, {!summary}.snippet, {!summary}.date, serde_json::to_string(&{!summary}.labels).unwrap_or_default(), {!summary}.message_count]).map(|_| ()))).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref sqlite-connection)
         (ref str)
         (ref (vec thread-summary)))
      (result unit string))))

(def update-summary-labels
  (rust "{0}.execute(\"UPDATE summaries SET labels = ?3 WHERE account = ?1 AND id = ?2\", rusqlite::params![{1}, {2}, serde_json::to_string(&{3}).unwrap_or_default()]).map(|_| ()).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref sqlite-connection)
         (ref str)
         (ref str)
         (vec string))
      (result unit string))))

(def align-thread-labels
  (rust "{0}.prepare_cached(\"UPDATE threads SET labels = ?3 WHERE account = ?1 AND id = ?2\").and_then(|mut {!statement}| {2}.iter().try_for_each(|{!summary}| {!statement}.execute(rusqlite::params![{1}, {!summary}.id, serde_json::to_string(&{!summary}.labels).unwrap_or_default()]).map(|_| ()))).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref sqlite-connection)
         (ref str)
         (ref (vec thread-summary)))
      (result unit string))))
