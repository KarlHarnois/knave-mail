(use domain/label-scope label-scope->label)
(use adapters/driven/sqlite/connection sqlite-connection)
(use adapters/driven/sqlite/rows text-error->internal-error)
(use adapters/driven/sqlite/threads set-thread-labels)
(use domain/labels label-change)

(use domain/mail ->thread-summary thread-query thread-ref
                 thread-summary)

(use domain/mail-error mail-error)

(export read-summaries read-summaries-with-ids
        read-summary-labels relabel-summary write-summaries)

(defstruct summary-row
  :id string
  :subject string
  :participants string
  :snippet string
  :date int
  :labels (vec string)
  :message-count int
  :message-ids (vec string))

(def select-summaries-with-ids
  "SELECT id, subject, participants, snippet, date, labels, message_count, message_ids FROM summaries WHERE account = ?1 AND id IN (SELECT value FROM json_each(?2))")

(def select-summary-labels
  "SELECT labels FROM summaries WHERE account = ?1 AND id = ?2")

(def select-summaries-in-label
  "SELECT id, subject, participants, snippet, date, labels, message_count, message_ids FROM summaries WHERE account = ?1 AND ((?2 IS NULL AND NOT EXISTS (SELECT 1 FROM json_each(summaries.labels) WHERE value IN ('SPAM', 'TRASH'))) OR EXISTS (SELECT 1 FROM json_each(summaries.labels) WHERE value = ?2)) ORDER BY date DESC LIMIT ?3")

(def upsert-summary
  "INSERT OR REPLACE INTO summaries (account, id, subject, participants, snippet, date, labels, message_count, message_ids) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8, ?9)")

(def set-summary-labels
  "UPDATE summaries SET labels = ?3 WHERE account = ?1 AND id = ?2")

(defn read-summaries (connection account query)
  (let (rows (try (text-error->internal-error
                    (summary-rows connection account
                                  (ref (label-scope->label (ref (:scope
                                                                  query))))
                                  (:limit query)
                                  select-summaries-in-label))))
    (ok (-> (iter rows)
            (map (fn (row) (summary-row->summary row)))
            collect))))

(defn read-summaries-with-ids (connection account ids)
  (let (rows (try (text-error->internal-error (summary-rows-with-ids
                                                connection
                                                account ids
                                                select-summaries-with-ids))))
    (ok (-> (iter rows)
            (map (fn (row) (summary-row->summary row)))
            collect))))

(def summary-rows-with-ids
  (rust "{0}.prepare_cached({3}).and_then(|mut {!statement}| {!statement}.query_map(rusqlite::params![{1}, serde_json::to_string({2}).unwrap_or_default()], |{!row}| Ok(SummaryRow {{ id: {!row}.get(0)?, subject: {!row}.get(1)?, participants: {!row}.get(2)?, snippet: {!row}.get(3)?, date: {!row}.get(4)?, labels: serde_json::from_str::<Vec<String>>(&{!row}.get::<_, String>(5)?).map_err(|{!bad}| rusqlite::Error::FromSqlConversionFailure(5, rusqlite::types::Type::Text, Box::new({!bad})))?, message_count: {!row}.get(6)?, message_ids: serde_json::from_str::<Vec<String>>(&{!row}.get::<_, String>(7)?).map_err(|{!bad}| rusqlite::Error::FromSqlConversionFailure(7, rusqlite::types::Type::Text, Box::new({!bad})))? }})).and_then(|{!rows}| {!rows}.collect::<rusqlite::Result<Vec<_>>>())).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref sqlite-connection)
         (ref str)
         (ref (vec string))
         (ref str))
      (result (vec summary-row) string))))

(type summary-row->summary
  (fn ((ref summary-row)) thread-summary))

(defn summary-row->summary (row)
  (->thread-summary :id (clone (:id row))
                    :subject (clone (:subject row))
                    :participants (clone (:participants row))
                    :snippet (clone (:snippet row))
                    :date (:date row)
                    :labels (clone (:labels row))
                    :message-count (:message-count row)
                    :message-ids (clone (:message-ids row))))

(defn write-summaries (connection account summaries)
  (try (text-error->internal-error
         (upsert-summaries connection account summaries
                           upsert-summary)))
  (text-error->internal-error (align-thread-labels
                                connection account summaries
                                set-thread-labels)))

(type relabel-summary
  (fn ((ref sqlite-connection)
       (ref thread-ref)
       (vec string))
    (result unit mail-error)))

(defn relabel-summary (connection thread labels)
  (text-error->internal-error (update-summary-labels
                                connection
                                (as-str (:account thread))
                                (as-str (:thread-id thread))
                                labels set-summary-labels)))

(defn read-summary-labels (connection account thread-id)
  (text-error->internal-error (stored-summary-labels
                                connection account thread-id
                                select-summary-labels)))

(def stored-summary-labels
  (rust "{{ use rusqlite::OptionalExtension; {0}.query_row({3}, [{1}, {2}], |{!row}| {!row}.get::<_, String>(0)).optional().map_err(|{!error}| {!error}.to_string()).and_then(|{!found}| {!found}.map(|{!text}| serde_json::from_str::<Vec<String>>(&{!text}).map_err(|{!bad}| {!bad}.to_string())).transpose()) }}"
    (fn ((ref sqlite-connection)
         (ref str)
         (ref str)
         (ref str))
      (result (option (vec string)) string))))

(def summary-rows
  (rust "{0}.prepare_cached({4}).and_then(|mut {!statement}| {!statement}.query_map(rusqlite::params![{1}, {2}, {3}], |{!row}| Ok(SummaryRow {{ id: {!row}.get(0)?, subject: {!row}.get(1)?, participants: {!row}.get(2)?, snippet: {!row}.get(3)?, date: {!row}.get(4)?, labels: serde_json::from_str::<Vec<String>>(&{!row}.get::<_, String>(5)?).map_err(|{!bad}| rusqlite::Error::FromSqlConversionFailure(5, rusqlite::types::Type::Text, Box::new({!bad})))?, message_count: {!row}.get(6)?, message_ids: serde_json::from_str::<Vec<String>>(&{!row}.get::<_, String>(7)?).map_err(|{!bad}| rusqlite::Error::FromSqlConversionFailure(7, rusqlite::types::Type::Text, Box::new({!bad})))? }})).and_then(|{!rows}| {!rows}.collect::<rusqlite::Result<Vec<_>>>())).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref sqlite-connection)
         (ref str)
         (ref (option string))
         int
         (ref str))
      (result (vec summary-row) string))))

(def upsert-summaries
  (rust "{0}.prepare_cached({3}).and_then(|mut {!statement}| {2}.iter().try_for_each(|{!summary}| {!statement}.execute(rusqlite::params![{1}, {!summary}.id, {!summary}.subject, {!summary}.participants, {!summary}.snippet, {!summary}.date, serde_json::to_string(&{!summary}.labels).unwrap_or_default(), {!summary}.message_count, serde_json::to_string(&{!summary}.message_ids).unwrap_or_default()]).map(|_| ()))).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref sqlite-connection)
         (ref str)
         (ref (vec thread-summary))
         (ref str))
      (result unit string))))

(def update-summary-labels
  (rust "{0}.execute({4}, rusqlite::params![{1}, {2}, serde_json::to_string(&{3}).unwrap_or_default()]).map(|_| ()).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref sqlite-connection)
         (ref str)
         (ref str)
         (vec string)
         (ref str))
      (result unit string))))

(def align-thread-labels
  (rust "{0}.prepare_cached({3}).and_then(|mut {!statement}| {2}.iter().try_for_each(|{!summary}| {!statement}.execute(rusqlite::params![{1}, {!summary}.id, serde_json::to_string(&{!summary}.labels).unwrap_or_default()]).map(|_| ()))).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref sqlite-connection)
         (ref str)
         (ref (vec thread-summary))
         (ref str))
      (result unit string))))
