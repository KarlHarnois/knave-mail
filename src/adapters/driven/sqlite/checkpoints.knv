(use adapters/driven/sqlite/connection sqlite-connection)
(use adapters/driven/sqlite/rows text-error->internal-error)
(use adapters/driven/sqlite/statements execute-all)
(use domain/mail-error mail-error)

(export read-checkpoint write-checkpoint)

(def select-checkpoint
  "SELECT history_id FROM checkpoints WHERE account = ?1")

(def upsert-checkpoint
  "INSERT INTO checkpoints (account, history_id) VALUES (?1, ?2) ON CONFLICT (account) DO UPDATE SET history_id = excluded.history_id")

(defn read-checkpoint (connection account)
  (text-error->internal-error
    (checkpoint-row connection select-checkpoint account)))

(defn write-checkpoint (connection account history-id)
  (text-error->internal-error (execute-all connection
                                           (ref (vec upsert-checkpoint))
                                           (ref (vec account history-id)))))

(def checkpoint-row
  (rust "{{ use rusqlite::OptionalExtension; {0}.query_row({1}, [{2}], |{!row}| {!row}.get::<_, String>(0)).optional().map_err(|{!error}| {!error}.to_string()) }}"
    (fn ((ref sqlite-connection)
         (ref str)
         (ref str))
      (result (option string) string))))
