(use adapters/driven/sqlite/connection sqlite-connection)
(use adapters/driven/sqlite/rows as-internal)
(use domain/mail ->account ->label account label)
(use domain/mail-error mail-error)

(export erase-account read-accounts read-labels
        write-account write-labels)

(deftype label-row (rust "(String, String, i64)"))

(type read-accounts
  (fn ((ref sqlite-connection))
    (result (vec account) mail-error)))

(defn read-accounts (connection)
  (let (emails (try (as-internal (account-emails connection))))
    (ok (collect (map (iter emails)
                   (fn (email) (->account (clone email))))))))

(type write-account
  (fn ((ref sqlite-connection) (ref account))
    (result unit mail-error)))

(defn write-account (connection saved)
  (as-internal (insert-account connection (ref (:email saved)))))

(type erase-account
  (fn ((ref sqlite-connection) (ref str))
    (result unit mail-error)))

(defn erase-account (connection email)
  (as-internal (delete-account connection email)))

(type read-labels
  (fn ((ref sqlite-connection) (ref str))
    (result (vec label) mail-error)))

(defn read-labels (connection account)
  (let (rows (try (as-internal (label-rows connection account))))
    (ok (collect (map (iter rows)
                   (fn (row)
                     (->label (label-id row)
                              (label-name row)
                              (label-unread row))))))))

(type write-labels
  (fn ((ref sqlite-connection)
       (ref str)
       (ref (vec label)))
    (result unit mail-error)))

(defn write-labels (connection account labels)
  (as-internal (replace-labels connection account labels)))

(def account-emails
  (rust "{0}.prepare_cached(\"SELECT email FROM accounts ORDER BY rowid\").and_then(|mut {!statement}| {!statement}.query_map([], |{!row}| {!row}.get::<_, String>(0)).and_then(|{!rows}| {!rows}.collect::<rusqlite::Result<Vec<_>>>())).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref sqlite-connection))
      (result (vec string) string))))

(def insert-account
  (rust "{0}.execute(\"INSERT OR IGNORE INTO accounts (email) VALUES (?1)\", [{1}]).map(|_| ()).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref sqlite-connection) (ref str))
      (result unit string))))

(def delete-account
  (rust "[\"accounts WHERE email\", \"labels WHERE account\", \"summaries WHERE account\", \"threads WHERE account\", \"messages WHERE account\"].iter().try_for_each(|{!table}| {0}.execute(&format!(\"DELETE FROM {{}} = ?1\", {!table}), [{1}]).map(|_| ())).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref sqlite-connection) (ref str))
      (result unit string))))

(def label-rows
  (rust "{0}.prepare_cached(\"SELECT id, name, unread FROM labels WHERE account = ?1 ORDER BY name\").and_then(|mut {!statement}| {!statement}.query_map([{1}], |{!row}| Ok(({!row}.get(0)?, {!row}.get(1)?, {!row}.get(2)?))).and_then(|{!rows}| {!rows}.collect::<rusqlite::Result<Vec<_>>>())).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref sqlite-connection) (ref str))
      (result (vec label-row) string))))

(def replace-labels
  (rust "{0}.unchecked_transaction().and_then(|{!transaction}| {{ {!transaction}.execute(\"DELETE FROM labels WHERE account = ?1\", [{1}])?; for {!label} in {2}.iter() {{ {!transaction}.execute(\"INSERT INTO labels (account, id, name, unread) VALUES (?1, ?2, ?3, ?4)\", rusqlite::params![{1}, {!label}.id, {!label}.name, {!label}.unread])?; }} {!transaction}.commit() }}).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref sqlite-connection)
         (ref str)
         (ref (vec label)))
      (result unit string))))

(def label-id
  (rust "{0}.0.clone()"
    (fn ((ref label-row)) string)))

(def label-name
  (rust "{0}.1.clone()"
    (fn ((ref label-row)) string)))

(def label-unread
  (rust "{0}.2"
    (fn ((ref label-row)) i64)))
