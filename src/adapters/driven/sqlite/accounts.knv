(use adapters/driven/sqlite/connection sqlite-connection)
(use adapters/driven/sqlite/rows as-internal)
(use adapters/driven/sqlite/statements execute-all)
(use domain/mail ->account ->label account label)
(use domain/mail-error mail-error)

(export erase-account read-accounts read-labels
        write-account write-labels)

(defstruct label-row
  :id string
  :name string
  :unread int
  :total int)

(def select-emails
  "SELECT email FROM accounts ORDER BY rowid")

(def insert-account
  "INSERT OR IGNORE INTO accounts (email) VALUES (?1)")

(def account-erasures
  (vec "DELETE FROM accounts WHERE email = ?1"
       "DELETE FROM labels WHERE account = ?1"
       "DELETE FROM summaries WHERE account = ?1"
       "DELETE FROM threads WHERE account = ?1"
       "DELETE FROM messages WHERE account = ?1"
       "DELETE FROM checkpoints WHERE account = ?1"
       "DELETE FROM pending_downloads WHERE account = ?1"))

(def select-labels
  "SELECT id, name, unread, total FROM labels WHERE account = ?1 ORDER BY name")

(def delete-labels "DELETE FROM labels WHERE account = ?1")

(def insert-label
  "INSERT INTO labels (account, id, name, unread, total) VALUES (?1, ?2, ?3, ?4, ?5)")

(defn read-accounts (connection)
  (let (emails (try (as-internal (account-emails connection select-emails))))
    (ok (-> (iter emails)
            (map (fn (email) (->account (clone email))))
            collect))))

(defn write-account (connection saved)
  (as-internal (execute-all connection
                            (ref (vec insert-account))
                            (ref (vec (as-str (:email saved)))))))

(defn erase-account (connection email)
  (as-internal (execute-all connection
                            (ref account-erasures)
                            (ref (vec email)))))

(defn read-labels (connection account)
  (let (rows (try (as-internal (label-rows connection select-labels account))))
    (ok (-> (iter rows)
            (map (fn (row)
                   (->label (clone (:id row))
                            (clone (:name row))
                            (:unread row)
                            (:total row))))
            collect))))

(defn write-labels (connection account labels)
  (as-internal (replace-labels connection delete-labels
                               insert-label account
                               labels)))

(def account-emails
  (rust "{0}.prepare_cached({1}).and_then(|mut {!statement}| {!statement}.query_map([], |{!row}| {!row}.get::<_, String>(0)).and_then(|{!rows}| {!rows}.collect::<rusqlite::Result<Vec<_>>>())).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref sqlite-connection) (ref str))
      (result (vec string) string))))

(def label-rows
  (rust "{0}.prepare_cached({1}).and_then(|mut {!statement}| {!statement}.query_map([{2}], |{!row}| Ok(LabelRow {{ id: {!row}.get(0)?, name: {!row}.get(1)?, unread: {!row}.get(2)?, total: {!row}.get(3)? }})).and_then(|{!rows}| {!rows}.collect::<rusqlite::Result<Vec<_>>>())).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref sqlite-connection)
         (ref str)
         (ref str))
      (result (vec label-row) string))))

(def replace-labels
  (rust "{0}.unchecked_transaction().and_then(|{!transaction}| {{ {!transaction}.execute({1}, [{3}])?; for {!label} in {4}.iter() {{ {!transaction}.execute({2}, rusqlite::params![{3}, {!label}.id, {!label}.name, {!label}.unread, {!label}.total])?; }} {!transaction}.commit() }}).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref sqlite-connection)
         (ref str)
         (ref str)
         (ref str)
         (ref (vec label)))
      (result unit string))))
