(use domain/mail-error mail-error)
(use ports/driven/credentials credentials)

(export ->keyring-credentials keyring-credentials)

(defstruct keyring-credentials
  :service string)

(impl credentials keyring-credentials
  (load-token (vault account)
    (text-error->auth-error (keyring-password (ref (:service vault)) account)))

  (save-token! (vault account token)
    (text-error->auth-error
      (set-keyring-password (ref (:service vault)) account token)))

  (forget-token! (vault account)
    (text-error->auth-error (delete-keyring-password (ref (:service vault))
                                                     account))))

(defn text-error->auth-error (outcome)
  (map-err outcome
    (fn (problem)
      (mail-error/auth-required (str "keyring: " problem)))))

(def keyring-password
  (rust "keyring::Entry::new({0}, {1}).and_then(|{!entry}| match {!entry}.get_password() {{ Ok({!token}) => Ok(Some({!token})), Err(keyring::Error::NoEntry) => Ok(None), Err({!error}) => Err({!error}) }}).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref str) (ref str))
      (result (option string) string))))

(def set-keyring-password
  (rust "keyring::Entry::new({0}, {1}).and_then(|{!entry}| {!entry}.set_password({2})).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref str) (ref str) (ref str))
      (result unit string))))

(def delete-keyring-password
  (rust "keyring::Entry::new({0}, {1}).and_then(|{!entry}| match {!entry}.delete_credential() {{ Err(keyring::Error::NoEntry) => Ok(()), {!other} => {!other} }}).map_err(|{!error}| {!error}.to_string())"
    (fn ((ref str) (ref str))
      (result unit string))))
