(use domain/mail-error mail-error)

(use domain/operation operation-kind operation-result
                      priority)

(use ports/driven/operation-queue operation-queue)

(export ->threaded-queue answer! reply-sender share-sender
        submission submission-sender threaded-operations
        threaded-queue)

(deftype submission-sender
  (rust "std::sync::mpsc::Sender<crate::adapters::driven::threaded_queue::Submission>"))

(deftype reply-sender
  (rust "std::sync::mpsc::Sender<Result<crate::domain::operation::OperationResult, crate::domain::mail_error::MailError>>"))

(defstruct submission
  :account string
  :kind operation-kind
  :priority priority
  :reply reply-sender)

(defstruct threaded-queue
  :sender submission-sender)

(impl operation-queue threaded-queue
  (submit! (queue account kind rank)
    (match (sent-and-awaited (ref (:sender queue)) account kind rank)
      ((some outcome) outcome)
      (none (err (mail-error/internal (str "the Gmail worker stopped")))))))

(type threaded-operations
  (fn ((ref submission-sender))
    (box operation-queue)))

(defn threaded-operations (executor)
  (the (box operation-queue)
       (box (->threaded-queue :sender (share-sender executor)))))

(def sent-and-awaited
  (rust "{{ let ({!reply}, {!answer}) = std::sync::mpsc::channel(); {0}.send(crate::adapters::driven::threaded_queue::Submission {{ account: {1}.to_string(), kind: {2}, priority: {3}, reply: {!reply} }}).ok().and_then(|_| {!answer}.recv().ok()) }}"
    (fn ((ref submission-sender) (ref str) operation-kind priority)
      (option (result operation-result mail-error)))))

(def share-sender
  (rust "{0}.clone()"
    (fn ((ref submission-sender)) submission-sender)))

(def answer!
  (rust "drop({0}.send({1}))"
    (fn ((ref reply-sender) (result operation-result mail-error))
      unit)))
