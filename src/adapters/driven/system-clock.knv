(use ports/driven/clock clock)

(export ->system-clock system-clock)

(defstruct system-clock)

(impl clock system-clock
  (now-milliseconds (_system) (wall-milliseconds))

  (pause! (_system milliseconds) (sleep-for milliseconds)))

(def wall-milliseconds
  (rust "std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|{!elapsed}| {!elapsed}.as_millis() as i64).unwrap_or(0)"
    (fn () int)))

(def sleep-for
  (rust "std::thread::sleep(std::time::Duration::from_millis({0}.max(0) as u64))"
    (fn (int) unit)))
