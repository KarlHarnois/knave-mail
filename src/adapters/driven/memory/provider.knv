(use adapters/driven/memory/mailbox ->memory-mailbox)
(use adapters/driven/memory/remote-mail remote-mail)
(use adapters/driven/memory/shared handle shared)
(use domain/mail-error mail-error)
(use ports/driven/mailbox mailbox)

(export ->memory-provider memory-mailbox-for
        memory-provider)

(defstruct memory-provider
  :emails (vec string)
  :remotes (vec (shared remote-mail)))

(type memory-mailbox-for
  (fn ((ref memory-provider) (ref str))
    (result (box mailbox) mail-error)))

(defn memory-mailbox-for (provider email)
  (match (email-position (ref (:emails provider)) email)
    ((some index)
     (ok (the (box mailbox)
              (box (->memory-mailbox (handle (at (:remotes provider)
                                                 index)))))))
    (none (err (mail-error/auth-required (str "no account " email))))))

(defn email-position (emails email)
  (-> (iter emails)
      enumerate
      (find (fn (numbered)
              (let-match ((pair _ candidate) numbered)
                (= (as-str candidate) email))))
      (map-some (fn (numbered)
                  (let-match ((pair index _) numbered) index)))))
