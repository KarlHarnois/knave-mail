(use adapters/driven/memory/remote-mail remote-mail)
(use adapters/driven/memory/remote-queries labelled?)
(use domain/collections appended-once)
(use domain/label-scope label-of)
(use domain/labels in-all-mail?)

(use domain/mail ->message-page message-page thread
                 thread-query)

(export messages-matching)

(type messages-matching
  (fn ((ref remote-mail) (ref thread-query))
    message-page))

(defn messages-matching (remote query)
  (let (cutoff (before-cutoff (as-str (:query query)))
        label (label-of (ref (:scope query))))
    (-> (iter (:threads remote))
        (filter (fn (held) (in-label? held (ref label))))
        (reduce (->message-page :message-ids (vec)
                                :thread-ids (vec)
                                :next-token none)
                (fn (page held) (with-older-messages page held cutoff))))))

(type in-label?
  (fn ((ref thread) (ref (option string)))
    bool))

(defn in-label? (held label)
  (match label
    ((some name) (labelled? held (as-str name)))
    (none (in-all-mail? (ref (:labels held))))))

(type with-older-messages
  (fn (message-page (ref thread) (option int))
    message-page))

(defn with-older-messages (page held cutoff)
  (-> (iter (:messages held))
      (filter (fn (message)
                (match cutoff
                  ((some before) (< (:date message) before))
                  (none true))))
      (reduce page
        (fn (found message)
          (->message-page :message-ids (appended-once (clone (:message-ids
                                                               found))
                                                      (clone (:id message)))
                          :thread-ids (appended-once (clone (:thread-ids found))
                                                     (clone (:id held)))
                          :next-token none)))))

(def before-cutoff
  (rust "native::dates::before_cutoff({0})"
    (fn ((ref str)) (option int))))
