(use adapters/driven/memory/shared handle share shared
                                   with-shared!)

(use ports/driven/event-log event-log log-entry)

(export ->memory-log logged-lines memory-log new-memory-log
        same-log)

(defstruct memory-log
  :entries (shared (vec log-entry)))

(type new-memory-log (fn () memory-log))

(defn new-memory-log ()
  (->memory-log (share (vec))))

(impl event-log memory-log
  (record! (kept entry)
           (with-shared! (ref (:entries kept))
             (fn (entries)
               (push! entries (clone entry)))))
  (share-log (kept)
             (the (box event-log)
                  (box (same-log kept)))))

(type same-log
  (fn ((ref memory-log)) memory-log))

(defn same-log (kept)
  (->memory-log (handle (ref (:entries kept)))))

(type logged-lines
  (fn ((ref memory-log)) (vec string)))

(defn logged-lines (kept)
  (with-shared! (ref (:entries kept))
    (fn (entries) (entry-lines entries))))

(def entry-lines
  (rust "{0}.iter().map(|{!entry}| format!(\"{{}} {{}}\", {!entry}.area, {!entry}.message)).collect::<Vec<_>>()"
    (fn ((mut (vec log-entry)))
      (vec string))))
