(use adapters/driven/memory/shared handle share shared
                                   with-shared!)

(use ports/driven/event-log event-log log-entry)

(export ->memory-log logged-lines memory-log new-memory-log
        same-log)

(defstruct memory-log
  :entries (shared (vec log-entry)))

(defn new-memory-log ()
  (->memory-log (share (vec))))

(impl event-log memory-log
  (record! (log entry)
    (with-shared! (ref (:entries log))
      (fn (entries)
        (push! entries (clone entry)))))

  (share-log (log)
    (the (box event-log)
         (box (same-log log)))))

(type same-log
  (fn ((ref memory-log)) memory-log))

(defn same-log (log)
  (->memory-log (handle (ref (:entries log)))))

(type logged-lines
  (fn ((ref memory-log)) (vec string)))

(defn logged-lines (log)
  (with-shared! (ref (:entries log))
    (fn (entries) (entry-lines entries))))

(type entry-lines
  (fn ((ref (vec log-entry)))
    (vec string)))

(defn entry-lines (entries)
  (-> (iter entries)
      (map (fn (entry)
             (str (:area entry) " " (:message entry))))
      collect))
