(export ->stored-checkpoint checkpoint-of
        replace-checkpoint! stored-checkpoint)

(defstruct stored-checkpoint
  :owner string
  :history-id string)

(type checkpoint-of
  (fn ((ref (vec stored-checkpoint))
       (ref str))
    (option string)))

(defn checkpoint-of (checkpoints email)
  (-> (iter checkpoints)
      (find (fn (checkpoint)
              (= (:owner checkpoint) email)))
      (map-some (fn (checkpoint)
                  (clone (:history-id checkpoint))))))

(defn replace-checkpoint! (checkpoints email history-id)
  (set! checkpoints (checkpoints-without checkpoints email))
  (push! checkpoints
         (->stored-checkpoint :owner (str email)
                              :history-id (str history-id))))

(type checkpoints-without
  (fn ((ref (vec stored-checkpoint))
       (ref str))
    (vec stored-checkpoint)))

(defn checkpoints-without (checkpoints email)
  (-> (iter checkpoints)
      (filter (fn (checkpoint)
                (not= (:owner checkpoint) email)))
      (map (fn (checkpoint) (clone checkpoint)))
      collect))
