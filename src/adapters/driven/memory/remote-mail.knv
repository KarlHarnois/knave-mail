(use ports/driven/clock clock pause!)

(use adapters/driven/memory/remote-operation remote-operation
                                             remote-operation->name)

(use domain/outgoing reply-link-of)
(use adapters/driven/memory/remote-change remote-change)
(use domain/mail ->message message outgoing thread)
(use domain/mail-error ->throttling mail-error)

(export ->remote-mail ->sent-stamp always-failing fail-when!
        failing-plan guard! outgoing->message plan-failure!
        remote-mail throttling-plan)

(defenum failure-count
  always
  (times int))

(defenum failure-kind
  network
  (throttled int))

(defstruct failure-plan
  :target remote-operation
  :count failure-count
  :kind failure-kind)

(defstruct remote-mail
  :threads (vec thread)
  :sent (vec outgoing)
  :latency-milliseconds int
  :clock clock
  :failures (option failure-plan)
  :next-id int
  :history-id int
  :history-floor int
  :changes (vec remote-change))

(type guard!
  (fn ((mut remote-mail) remote-operation)
    (result unit mail-error)))

(defn guard! (remote operation)
  (when (pos? (:latency-milliseconds remote))
    (pause! (ref (:clock remote))
            (:latency-milliseconds remote)))
  (match (planned-failure (ref (:failures remote)) operation)
    ((some plan)
     (set! (:failures remote)
           (after-failure (clone plan)))
     (err (simulated-failure (ref (:kind plan)) operation)))
    (none (ok (do)))))

(type planned-failure
  (fn ((ref (option failure-plan)) remote-operation)
    (option failure-plan)))

(defn planned-failure (failures operation)
  (match failures
    ((some plan) (plan-for-operation plan operation))
    (none none)))

(defn plan-for-operation (plan operation)
  (if (= (:target plan) operation)
    (some (clone plan))
    none))

(defn after-failure (plan)
  (match (:count plan)
    (always (some plan))
    ((times 1) none)
    ((times left)
     (some (assoc plan :count (failure-count/times (dec left)))))))

(type simulated-failure
  (fn ((ref failure-kind) remote-operation) mail-error))

(defn simulated-failure (kind operation)
  (match kind
    ((throttled delay)
     (mail-error/throttled (->throttling
                             :message (str "simulated throttling of "
                                           (remote-operation->name (ref operation)))
                             :retry-after-milliseconds (deref delay))))
    (network (mail-error/network (str "simulated failure of "
                                      (remote-operation->name (ref
                                                                operation)))))))

(defn always-failing (operation)
  (->failure-plan :target operation
                  :count failure-count/always
                  :kind failure-kind/network))

(type fail-when!
  (fn ((mut remote-mail) (option remote-operation))
    unit))

(defn fail-when! (remote operation)
  (set! (:failures remote)
        (map-some operation always-failing)))

(type plan-failure!
  (fn ((mut remote-mail) failure-plan) unit))

(defn plan-failure! (remote plan)
  (set! (:failures remote) (some plan)))

(type failing-plan (fn (remote-operation int) failure-plan))

(defn failing-plan (operation times)
  (->failure-plan :target operation
                  :count (failure-count/times times)
                  :kind failure-kind/network))

(type throttling-plan
  (fn (remote-operation int int) failure-plan))

(defn throttling-plan (operation times delay)
  (->failure-plan :target operation
                  :count (failure-count/times times)
                  :kind (failure-kind/throttled delay)))

(defstruct sent-stamp
  :message-id string
  :thread-id string
  :date int)

(type outgoing->message
  (fn ((ref outgoing) (ref sent-stamp))
    message))

(defn outgoing->message (sent stamp)
  (->message :id (clone (:message-id stamp))
             :thread-id (clone (:thread-id stamp))
             :from (clone (:from sent))
             :to (clone (:to sent))
             :cc (clone (:cc sent))
             :subject (clone (:subject sent))
             :date (:date stamp)
             :text (clone (:body sent))
             :html none
             :header-id (str "<" (:message-id stamp) "@knave-mail.memory>")
             :references (match (reply-link-of sent)
                           ((some link) (clone (:references link)))
                           (none (str "")))))
