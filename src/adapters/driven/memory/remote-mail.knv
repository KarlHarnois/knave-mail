(use adapters/driven/memory/remote-change remote-change)
(use domain/mail ->message message outgoing thread)
(use domain/mail-error ->throttling mail-error)

(export ->remote-mail fail-times! fail-when! guard!
        remote-mail sent-from throttle-times!)

(defstruct remote-mail
  :threads (vec thread)
  :sent (vec outgoing)
  :latency-milliseconds u64
  :failing (option string)
  :failures-left (option i64)
  :throttle-delay (option i64)
  :next-id i64
  :history-id i64
  :history-floor i64
  :changes (vec remote-change))

(type guard!
  (fn ((mut remote-mail) (ref str))
    (result unit mail-error)))

(defn guard! (remote operation)
  (sleep-milliseconds (:latency-milliseconds remote))
  (if (failing? remote operation)
    (let (failure (simulated-failure remote operation))
      (count-failure! remote)
      (err failure))
    (ok (do))))

(type simulated-failure
  (fn ((ref remote-mail) (ref str))
    mail-error))

(defn simulated-failure (remote operation)
  (match (:throttle-delay remote)
    ((some delay)
     (mail-error/throttled (->throttling
                             :message (str "simulated throttling of " operation)
                             :retry-after-milliseconds delay)))
    (none (mail-error/network (str "simulated failure of " operation)))))

(type count-failure!
  (fn ((mut remote-mail)) unit))

(defn count-failure! (remote)
  (match (:failures-left remote)
    ((some 1) (fail-when! remote none))
    ((some left)
     (set! (:failures-left remote)
           (some (- left 1))))
    (none (do))))

(type fail-when!
  (fn ((mut remote-mail) (option string))
    unit))

(defn fail-when! (remote operation)
  (set! (:failing remote) operation)
  (set! (:failures-left remote) none)
  (set! (:throttle-delay remote) none))

(type fail-times!
  (fn ((mut remote-mail) (ref str) i64)
    unit))

(defn fail-times! (remote operation times)
  (set! (:failing remote)
        (some (str operation)))
  (set! (:failures-left remote) (some times)))

(type throttle-times!
  (fn ((mut remote-mail) (ref str) i64 i64)
    unit))

(defn throttle-times! (remote operation times delay)
  (fail-times! remote operation times)
  (set! (:throttle-delay remote) (some delay)))

(type failing?
  (fn ((ref remote-mail) (ref str)) bool))

(defn failing? (remote operation)
  (match (ref (:failing remote))
    ((some failing) (= failing operation))
    (none false)))

(type sent-from
  (fn ((ref outgoing) (ref str) (ref str) i64)
    message))

(defn sent-from (sent message-id thread-id date)
  (->message :id (str message-id)
             :thread-id (str thread-id)
             :from (clone (:from sent))
             :to (clone (:to sent))
             :cc (clone (:cc sent))
             :subject (clone (:subject sent))
             :date date
             :text (clone (:body sent))
             :html none
             :header-id (str "<" message-id "@knave-mail.memory>")
             :references (clone (:references sent))))

(def sleep-milliseconds
  (rust "std::thread::sleep(std::time::Duration::from_millis({0}))"
    (fn (u64) unit)))
