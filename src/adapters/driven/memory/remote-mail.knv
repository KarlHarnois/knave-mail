(use domain/outgoing reply-link-of)
(use adapters/driven/memory/remote-change remote-change)
(use domain/mail ->message message outgoing thread)
(use domain/mail-error ->throttling mail-error)

(export ->remote-mail always-failing fail-times! fail-when!
        guard! remote-mail sent-from throttle-times!)

(defenum failure-count
  always
  (times int))

(defenum failure-kind
  network
  (throttled int))

(defstruct failure-plan
  :target string
  :count failure-count
  :kind failure-kind)

(defstruct remote-mail
  :threads (vec thread)
  :sent (vec outgoing)
  :latency-milliseconds u64
  :failures (option failure-plan)
  :next-id int
  :history-id int
  :history-floor int
  :changes (vec remote-change))

(type guard!
  (fn ((mut remote-mail) (ref str))
    (result unit mail-error)))

(defn guard! (remote operation)
  (sleep-milliseconds (:latency-milliseconds remote))
  (match (planned-failure (ref (:failures remote)) operation)
    ((some plan)
     (set! (:failures remote)
           (after-failure (clone plan)))
     (err (simulated-failure (ref (:kind plan)) operation)))
    (none (ok (do)))))

(type planned-failure
  (fn ((ref (option failure-plan)) (ref str))
    (option failure-plan)))

(defn planned-failure (failures operation)
  (match failures
    ((some plan) (plan-for-operation plan operation))
    (none none)))

(type plan-for-operation
  (fn ((ref failure-plan) (ref str))
    (option failure-plan)))

(defn plan-for-operation (plan operation)
  (if (= (:target plan) operation)
    (some (clone plan))
    none))

(type after-failure
  (fn (failure-plan) (option failure-plan)))

(defn after-failure (plan)
  (match (:count plan)
    (always (some plan))
    ((times 1) none)
    ((times left)
     (some (assoc plan :count (failure-count/times (dec left)))))))

(type simulated-failure
  (fn ((ref failure-kind) (ref str))
    mail-error))

(defn simulated-failure (kind operation)
  (match kind
    ((throttled delay)
     (mail-error/throttled (->throttling
                             :message (str "simulated throttling of " operation)
                             :retry-after-milliseconds (deref delay))))
    (network (mail-error/network (str "simulated failure of " operation)))))

(type always-failing (fn (string) failure-plan))

(defn always-failing (operation)
  (->failure-plan :target operation
                  :count failure-count/always
                  :kind failure-kind/network))

(type fail-when!
  (fn ((mut remote-mail) (option string))
    unit))

(defn fail-when! (remote operation)
  (set! (:failures remote)
        (map-some operation always-failing)))

(type fail-times!
  (fn ((mut remote-mail) (ref str) int)
    unit))

(defn fail-times! (remote operation times)
  (set! (:failures remote)
        (some (->failure-plan :target (str operation)
                              :count (failure-count/times times)
                              :kind failure-kind/network))))

(type throttle-times!
  (fn ((mut remote-mail) (ref str) int int)
    unit))

(defn throttle-times! (remote operation times delay)
  (set! (:failures remote)
        (some (->failure-plan :target (str operation)
                              :count (failure-count/times times)
                              :kind (failure-kind/throttled delay)))))

(type sent-from
  (fn ((ref outgoing) (ref str) (ref str) int)
    message))

(defn sent-from (sent message-id thread-id date)
  (->message :id (str message-id)
             :thread-id (str thread-id)
             :from (clone (:from sent))
             :to (clone (:to sent))
             :cc (clone (:cc sent))
             :subject (clone (:subject sent))
             :date date
             :text (clone (:body sent))
             :html none
             :header-id (str "<" message-id "@knave-mail.memory>")
             :references (match (reply-link-of sent)
                           ((some link) (clone (:references link)))
                           (none (str "")))))

(def sleep-milliseconds
  (rust "std::thread::sleep(std::time::Duration::from_millis({0}))"
    (fn (u64) unit)))
