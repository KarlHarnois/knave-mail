(use domain/mail ->mail-changes ->message mail-changes
                 message outgoing thread)

(use domain/mail-error mail-error)

(export ->remote-mail changes-since expire-history!
        fail-when! guard record-change! remote-mail
        sent-from)

(defstruct remote-mail
  :threads (vec thread)
  :sent (vec outgoing)
  :latency-milliseconds u64
  :failing (option string)
  :next-id i64
  :history-id i64
  :history-floor i64
  :changes (vec (pair i64 string)))

(type expire-history!
  (fn ((mut remote-mail)) unit))

(defn expire-history! (remote)
  (set! (:history-floor remote) (:history-id remote))
  (set! (:changes remote) (vec)))

(type record-change!
  (fn ((mut remote-mail) (ref str)) unit))

(defn record-change! (remote thread-id)
  (set! (:history-id remote)
        (+ (:history-id remote) 1))
  (push! (mut (:changes remote))
         (pair (:history-id remote) (str thread-id))))

(type changes-since
  (fn ((ref remote-mail) (ref str))
    (result mail-changes mail-error)))

(defn changes-since (remote since)
  (match (parsed-history-id since)
    ((some start)
     (if (< start (:history-floor remote))
       (err (mail-error/not-found (str "history " since " has expired")))
       (ok (->mail-changes :thread-ids (threads-changed-after remote start)
                           :history-id (str (:history-id remote))))))
    (none (err (mail-error/not-found (str "no history from " since))))))

(def parsed-history-id
  (rust "{0}.parse::<i64>().ok()"
    (fn ((ref str)) (option i64))))

(def threads-changed-after
  (rust "{0}.changes.iter().filter(|({!id}, _)| *{!id} > {1}).fold(Vec::<String>::new(), |mut {!ids}, (_, {!thread})| {{ if !{!ids}.contains({!thread}) {{ {!ids}.push({!thread}.clone()); }} {!ids} }})"
    (fn ((ref remote-mail) i64)
      (vec string))))

(type guard
  (fn ((ref remote-mail) (ref str))
    (result unit mail-error)))

(defn guard (remote operation)
  (sleep-milliseconds (:latency-milliseconds remote))
  (if (failing? remote operation)
    (err (mail-error/network (str "simulated failure of " operation)))
    (ok (do))))

(type fail-when!
  (fn ((mut remote-mail) (option string))
    unit))

(defn fail-when! (remote operation)
  (set! (:failing remote) operation))

(type failing?
  (fn ((ref remote-mail) (ref str)) bool))

(defn failing? (remote operation)
  (match (ref (:failing remote))
    ((some failing) (= failing operation))
    (none false)))

(type sent-from
  (fn ((ref outgoing) (ref str) (ref str) i64)
    message))

(defn sent-from (sent message-id thread-id date)
  (->message :id (str message-id)
             :thread-id (str thread-id)
             :from (clone (:from sent))
             :to (clone (:to sent))
             :cc (clone (:cc sent))
             :subject (clone (:subject sent))
             :date date
             :text (clone (:body sent))
             :html none
             :header-id (str "<" message-id "@knave-mail.memory>")
             :references (clone (:references sent))))

(def sleep-milliseconds
  (rust "std::thread::sleep(std::time::Duration::from_millis({0}))"
    (fn (u64) unit)))
