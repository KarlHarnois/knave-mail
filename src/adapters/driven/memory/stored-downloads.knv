(use domain/collections appended)

(export ->pending-download downloads-of pending-download
        with-downloads without-download)

(defstruct pending-download
  :owner string
  :thread-id string)

(type with-downloads
  (fn ((vec pending-download)
       (ref str)
       (ref (vec string)))
    (vec pending-download)))

(defn with-downloads (pending email thread-ids)
  (reduce (iter thread-ids) pending
    (fn (found thread-id)
      (if (any? (iter found)
            (fn (row)
              (download-of? row email (as-str thread-id))))
        found
        (appended found
                  (->pending-download :owner (str email)
                                      :thread-id (clone thread-id)))))))

(type downloads-of
  (fn ((ref (vec pending-download)) (ref str))
    (vec string)))

(defn downloads-of (pending email)
  (let (oldest-first (-> (iter pending)
                         (filter (fn (row) (= (:owner row) email)))
                         (map (fn (row) (clone (:thread-id row))))
                         collect))
    (-> (reverse oldest-first)
        (map (fn (thread-id) (clone thread-id)))
        collect)))

(type without-download
  (fn ((ref (vec pending-download))
       (ref str)
       (ref str))
    (vec pending-download)))

(defn without-download (pending email thread-id)
  (-> (iter pending)
      (filter (fn (row)
                (not (download-of? row email thread-id))))
      (map (fn (row) (clone row)))
      collect))

(type download-of?
  (fn ((ref pending-download)
       (ref str)
       (ref str))
    bool))

(defn download-of? (row email thread-id)
  (and (= (:owner row) email)
       (= (:thread-id row) thread-id)))
