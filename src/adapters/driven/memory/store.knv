(use adapters/driven/memory/stored message-in
                                   other-summaries
                                   other-threads
                                   replace-summaries!
                                   replace-thread!
                                   stored-summary
                                   stored-thread
                                   summaries-of
                                   summaries-with-ids
                                   thread-in)

(use adapters/driven/memory/stored-labels align-thread-labels!
                                          labels-in
                                          relabel-everywhere!
                                          replace-labels!
                                          stored-labels)

(use domain/mail account)
(use domain/summary newest-first)
(use ports/driven/store store)

(export ->memory-store empty-memory-store memory-store)

(defstruct memory-store
  :accounts (vec account)
  :labels (vec stored-labels)
  :summaries (vec stored-summary)
  :threads (vec stored-thread)
  :checkpoints (vec (pair string string)))

(defn empty-memory-store ()
  (->memory-store (vec)
                  (vec)
                  (vec)
                  (vec)
                  (vec)))

(impl store memory-store
  (load-accounts (cache)
    (ok (clone (:accounts cache))))

  (save-account! (cache added)
    (ok (when (not (account-kept? (ref (:accounts cache))
                                  (ref (:email added))))
          (push! (mut (:accounts cache))
                 (clone added)))))

  (forget-account! (cache email)
    (ok (set! (:accounts cache)
              (accounts-without (ref (:accounts cache)) email))))

  (load-labels (cache email)
    (ok (labels-in (ref (:labels cache)) email)))

  (save-labels! (cache email labels)
    (ok (replace-labels! (mut (:labels cache)) email labels)))

  (load-threads (cache email query)
    (ok (newest-first (summaries-of (ref (:summaries cache)) email query)
                      query)))

  (save-threads! (cache email summaries)
    (replace-summaries! (mut (:summaries cache))
                        email summaries)
    (ok (align-thread-labels! (mut (:threads cache))
                              email summaries)))

  (load-summaries-of (cache email ids)
    (ok (summaries-with-ids (ref (:summaries cache)) email ids)))

  (load-thread (cache email thread-id)
    (ok (thread-in (ref (:threads cache)) email thread-id)))

  (load-message (cache email message-id)
    (ok (message-in (ref (:threads cache)) email message-id)))

  (save-thread! (cache email saved)
    (ok (replace-thread! (mut (:threads cache)) email saved)))

  (forget-thread! (cache email thread-id)
    (set! (:summaries cache)
          (other-summaries (ref (:summaries cache)) email thread-id))
    (ok (set! (:threads cache)
              (other-threads (ref (:threads cache)) email thread-id))))

  (load-checkpoint (cache email)
    (ok (checkpoint-of (ref (:checkpoints cache)) email)))

  (save-checkpoint! (cache email history-id)
    (ok (replace-checkpoint! (mut (:checkpoints cache))
                             email history-id)))

  (relabel-stored! (cache email thread-id change)
    (ok (relabel-everywhere! (mut (:summaries cache))
                             (mut (:threads cache))
                             email thread-id change))))

(defn checkpoint-of (checkpoints email)
  (map-some (find (iter checkpoints)
              (fn (checkpoint) (checkpoint-of? checkpoint email)))
            (fn (checkpoint)
              (let-match ((pair _ history-id) checkpoint)
                (clone history-id)))))

(defn replace-checkpoint! (checkpoints email history-id)
  (set! checkpoints (checkpoints-without checkpoints email))
  (push! checkpoints
         (pair (str email) (str history-id))))

(type checkpoints-without
  (fn ((ref (vec (pair string string)))
       (ref str))
    (vec (pair string string))))

(defn checkpoints-without (checkpoints email)
  (collect (map (filter (iter checkpoints)
                  (fn (checkpoint)
                    (not (checkpoint-of? checkpoint email))))
                (fn (checkpoint) (clone checkpoint)))))

(type checkpoint-of?
  (fn ((ref (pair string string)) (ref str))
    bool))

(defn checkpoint-of? (checkpoint email)
  (let-match ((pair account _) checkpoint)
    (= account email)))

(defn account-kept? (accounts email)
  (any? (iter accounts)
    (fn (account)
      (= (:email account) email))))

(type accounts-without
  (fn ((ref (vec account)) (ref str))
    (vec account)))

(defn accounts-without (accounts email)
  (collect (map (filter (iter accounts)
                  (fn (account)
                    (not= (:email account) email)))
                (fn (account) (clone account)))))
