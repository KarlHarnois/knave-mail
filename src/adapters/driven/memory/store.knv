(use adapters/driven/memory/stored message-in
                                   other-summaries
                                   other-threads
                                   replace-summaries!
                                   replace-thread!
                                   stored-summary
                                   stored-thread
                                   summaries-of
                                   summaries-with-ids
                                   thread-in)

(use adapters/driven/memory/stored-labels align-thread-labels!
                                          labels-in
                                          reapply-queued!
                                          relabel-everywhere!
                                          replace-labels!
                                          stored-labels)

(use adapters/driven/memory/stored-accounts account-kept?
                                            accounts-without)

(use adapters/driven/memory/stored-checkpoints checkpoint-of
                                               replace-checkpoint!)

(use adapters/driven/memory/stored-queue count-queued
                                         without-queued)

(use domain/labels reversed-change)
(use adapters/driven/memory/memory-store memory-store)
(use domain/queued-relabel ->queued-relabel queued-relabel)
(use domain/summary newest-first)
(use ports/driven/store store)

(impl store memory-store
  (load-accounts (cache)
    (ok (clone (:accounts cache))))

  (save-account! (cache added)
    (ok (when (not (account-kept? (ref (:accounts cache))
                                  (ref (:email added))))
          (push! (mut (:accounts cache))
                 (clone added)))))

  (forget-account! (cache email)
    (ok (set! (:accounts cache)
              (accounts-without (ref (:accounts cache)) email))))

  (load-labels (cache email)
    (ok (labels-in (ref (:labels cache)) email)))

  (save-labels! (cache email labels)
    (ok (replace-labels! (mut (:labels cache)) email labels)))

  (load-threads (cache email query)
    (ok (newest-first (summaries-of (ref (:summaries cache)) email query)
                      query)))

  (save-threads! (cache email summaries)
    (replace-summaries! (mut (:summaries cache))
                        email summaries)
    (align-thread-labels! (mut (:threads cache))
                          email summaries)
    (ok (reapply-queued! (mut (:summaries cache))
                         (mut (:threads cache))
                         (ref (:queued cache))
                         email)))

  (load-summaries-of (cache email ids)
    (ok (summaries-with-ids (ref (:summaries cache)) email ids)))

  (load-thread (cache wanted)
    (ok (thread-in (ref (:threads cache))
                   (as-str (:account wanted))
                   (as-str (:thread-id wanted)))))

  (load-message (cache wanted)
    (ok (message-in (ref (:threads cache))
                    (as-str (:account wanted))
                    (as-str (:message-id wanted)))))

  (save-thread! (cache email saved)
    (replace-thread! (mut (:threads cache)) email saved)
    (ok (reapply-queued! (mut (:summaries cache))
                         (mut (:threads cache))
                         (ref (:queued cache))
                         email)))

  (forget-thread! (cache forgotten)
    (let (email (as-str (:account forgotten))
          thread-id (as-str (:thread-id forgotten)))
      (set! (:summaries cache)
            (other-summaries (ref (:summaries cache)) email thread-id))
      (ok (set! (:threads cache)
                (other-threads (ref (:threads cache)) email thread-id)))))

  (load-checkpoint (cache email)
    (ok (checkpoint-of (ref (:checkpoints cache)) email)))

  (save-checkpoint! (cache email history-id)
    (ok (replace-checkpoint! (mut (:checkpoints cache))
                             email history-id)))

  (relabel-stored! (cache relabeled change)
    (ok (relabel-everywhere! (mut (:summaries cache))
                             (mut (:threads cache))
                             (as-str (:account relabeled))
                             (as-str (:thread-id relabeled))
                             change)))

  (queue-relabels! (cache email thread-ids change)
    (local added (vec))
    (for-each (iter thread-ids)
      (fn (thread-id)
        (relabel-everywhere! (mut (:summaries cache))
                             (mut (:threads cache))
                             email
                             (as-str thread-id)
                             change)
        (push! added
               (->queued-relabel :id (:next-queued-id cache)
                                 :account (str email)
                                 :thread-id (clone thread-id)
                                 :change (clone change)))
        (set! (:next-queued-id cache)
              (+ (:next-queued-id cache) 1))))
    (for-each (iter added)
      (fn (row)
        (push! (mut (:queued cache))
               (clone row))))
    (ok added))

  (load-queued (cache)
    (ok (clone (:queued cache))))

  (forget-queued! (cache id)
    (ok (set! (:queued cache)
              (without-queued (ref (:queued cache)) id))))

  (revert-queued! (cache queued)
    (relabel-everywhere! (mut (:summaries cache))
                         (mut (:threads cache))
                         (as-str (:account queued))
                         (as-str (:thread-id queued))
                         (ref (reversed-change (ref (:change queued)))))
    (ok (set! (:queued cache)
              (without-queued (ref (:queued cache))
                              (:id queued)))))

  (queued-count (cache email)
    (ok (count-queued (ref (:queued cache)) email))))
