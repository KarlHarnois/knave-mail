(use adapters/driven/memory/memory-store memory-store)
(use adapters/driven/memory/cache-relabels relabel-everywhere!)
(use domain/mail ->thread-ref)
(use adapters/driven/memory/stored-queue without-queued)
(use domain/labels label-change reversed-change)

(use domain/queued-relabel ->queued-relabel queued-relabel
                           relabel-request)

(export queued-each! reverted-queued!)

(type queued-each!
  (fn ((mut memory-store) (ref relabel-request))
    (vec queued-relabel)))

(defn queued-each! (cache request)
  (local added (vec))
  (for-each (iter (:thread-ids request))
    (fn (thread-id)
      (relabel-everywhere! cache
                           (ref (->thread-ref :account (clone (:account
                                                                request))
                                              :thread-id (clone thread-id)))
                           (ref (:change request)))
      (push! added
             (->queued-relabel :id (:next-queued-id cache)
                               :account (clone (:account request))
                               :thread-id (clone thread-id)
                               :change (clone (:change request))))
      (set! (:next-queued-id cache)
            (inc (:next-queued-id cache)))))
  (for-each (iter added)
    (fn (row)
      (push! (mut (:queued cache))
             (clone row))))
  added)

(type reverted-queued!
  (fn ((mut memory-store) (ref queued-relabel))
    unit))

(defn reverted-queued! (cache queued)
  (relabel-everywhere! cache
                       (ref (->thread-ref :account (clone (:account queued))
                                          :thread-id (clone (:thread-id
                                                              queued))))
                       (ref (reversed-change (ref (:change queued)))))
  (set! (:queued cache)
        (without-queued (ref (:queued cache))
                        (:id queued))))
