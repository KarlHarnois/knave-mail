(use adapters/driven/memory/shared handle share shared
                                   with-shared!)

(export ->memory-clock memory-clock memory-now memory-pause!
        new-memory-clock pauses-of same-clock)

(defstruct clock-state
  :now int
  :pauses (vec int))

(defstruct memory-clock
  :state (shared clock-state))

(type memory-now
  (fn ((ref memory-clock)) int))

(defn memory-now (fake)
  (with-shared! (ref (:state fake))
    (fn (state) (:now state))))

(type memory-pause!
  (fn ((ref memory-clock) int) unit))

(defn memory-pause! (fake milliseconds)
  (with-shared! (ref (:state fake))
    (fn (state)
      (set! (:now state)
            (+ (:now state) milliseconds))
      (push! (mut (:pauses state)) milliseconds))))

(defn new-memory-clock ()
  (->memory-clock :state (share (->clock-state :now 0 :pauses (vec)))))

(type same-clock
  (fn ((ref memory-clock)) memory-clock))

(defn same-clock (fake)
  (->memory-clock :state (handle (ref (:state fake)))))

(type pauses-of
  (fn ((ref memory-clock)) (vec int)))

(defn pauses-of (fake)
  (with-shared! (ref (:state fake))
    (fn (state) (clone (:pauses state)))))
