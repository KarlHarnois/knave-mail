(use adapters/driven/memory/stored stored-summary
                                   stored-thread)

(use adapters/driven/memory/stored-checkpoints stored-checkpoint)
(use adapters/driven/memory/stored-downloads pending-download)
(use adapters/driven/memory/stored-labels stored-labels)
(use domain/mail account)
(use domain/queued-relabel queued-relabel)

(export ->memory-store empty-memory-store memory-store)

(defstruct memory-store
  :accounts (vec account)
  :labels (vec stored-labels)
  :summaries (vec stored-summary)
  :threads (vec stored-thread)
  :checkpoints (vec stored-checkpoint)
  :pending-downloads (vec pending-download)
  :queued (vec queued-relabel)
  :next-queued-id int)

(defn empty-memory-store ()
  (->memory-store (vec)
                  (vec)
                  (vec)
                  (vec)
                  (vec)
                  (vec)
                  (vec)
                  1))
