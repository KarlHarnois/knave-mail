(use adapters/driven/memory/stored ->stored-summary
                                   ->stored-thread
                                   stored-summary
                                   stored-thread
                                   summary-entry?
                                   thread-entry?)

(use domain/labels label-change)

(use domain/mail ->thread-ref label thread thread-ref
                 thread-summary)

(use domain/relabel relabeled-summary relabeled-thread)

(export ->stored-labels align-thread-labels! labels-in
        relabel-summaries! relabel-threads! replace-labels!
        stored-labels)

(defstruct stored-labels
  :account string
  :labels (vec label))

(type labels-in
  (fn ((ref (vec stored-labels)) (ref str))
    (vec label)))

(defn labels-in (stored email)
  (-> (iter stored)
      (find (fn (entry) (= (:account entry) email)))
      (map-some (fn (entry) (clone (:labels entry))))
      (unwrap-or (vec))))

(defn replace-labels! (stored email labels)
  (set! stored (other-accounts stored email))
  (push! stored
         (->stored-labels (str email) (clone labels))))

(type other-accounts
  (fn ((ref (vec stored-labels)) (ref str))
    (vec stored-labels)))

(defn other-accounts (stored email)
  (-> (iter stored)
      (filter (fn (entry)
                (not= (:account entry) email)))
      (map (fn (entry) (clone entry)))
      collect))

(type relabel-summaries!
  (fn ((mut (slice stored-summary))
       (ref thread-ref)
       (ref label-change))
    unit))

(defn relabel-summaries! (summaries thread change)
  (for-each (range 0 (len summaries))
    (fn (index)
      (let (entry (at summaries index))
        (when (summary-entry? entry
                              (as-str (:account thread))
                              (as-str (:thread-id thread)))
          (set! (at summaries index)
                (->stored-summary (clone (:account entry))
                                  (relabeled-summary (ref (:summary entry))
                                                     change))))))))

(type relabel-threads!
  (fn ((mut (slice stored-thread))
       (ref thread-ref)
       (ref label-change))
    unit))

(defn relabel-threads! (threads thread change)
  (update-threads! threads thread
    (fn (held) (relabeled-thread held change))))

(type align-thread-labels!
  (fn ((mut (vec stored-thread))
       (ref str)
       (ref (vec thread-summary)))
    unit))

(defn align-thread-labels! (threads email summaries)
  (for-each (iter summaries)
    (fn (summary)
      (update-threads! threads
                       (ref (->thread-ref :account (str email)
                                          :thread-id (clone (:id summary))))
                       (fn (held)
                         (assoc (clone held)
                                :labels (clone (:labels summary))))))))

(type update-threads!
  (fn ((mut (slice stored-thread))
       (ref thread-ref)
       (fn ((ref thread)) thread))
    unit))

(defn update-threads! (threads thread updated)
  (for-each (range 0 (len threads))
    (fn (index)
      (let (entry (at threads index))
        (when (thread-entry? entry
                             (as-str (:account thread))
                             (as-str (:thread-id thread)))
          (set! (at threads index)
                (->stored-thread (clone (:account entry))
                                 (updated (ref (:thread entry))))))))))
