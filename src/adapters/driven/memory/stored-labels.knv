(use adapters/driven/memory/stored ->stored-summary
                                   ->stored-thread
                                   stored-summary
                                   stored-thread
                                   summary-entry?
                                   thread-entry?)

(use domain/labels label-change)
(use domain/mail label thread thread-summary)
(use adapters/driven/memory/stored-queue queued-changes-of)
(use domain/relabel relabeled-summary relabeled-thread)

(export ->stored-labels align-thread-labels! labels-in
        reapply-queued! relabel-everywhere! replace-labels!
        stored-labels)

(defstruct stored-labels
  :account string
  :labels (vec label))

(type labels-in
  (fn ((ref (vec stored-labels)) (ref str))
    (vec label)))

(defn labels-in (stored email)
  (unwrap-or (map-some (find (iter stored)
                         (fn (entry) (= (:account entry) email)))
                       (fn (entry) (clone (:labels entry))))
             (vec)))

(defn replace-labels! (stored email labels)
  (set! stored (other-accounts stored email))
  (push! stored
         (->stored-labels (str email) (clone labels))))

(type other-accounts
  (fn ((ref (vec stored-labels)) (ref str))
    (vec stored-labels)))

(defn other-accounts (stored email)
  (collect (map (filter (iter stored)
                  (fn (entry)
                    (not= (:account entry) email)))
                (fn (entry) (clone entry)))))

(defn relabel-everywhere! (summaries threads email thread-id change)
  (relabel-summaries! summaries email thread-id change)
  (relabel-threads! threads email thread-id change))

(defn reapply-queued! (summaries threads queued email)
  (for-each (iter (queued-changes-of queued email))
    (fn (entry)
      (let-match ((pair thread-id change) entry)
        (relabel-summaries! summaries email
                            (as-str thread-id)
                            change)
        (relabel-threads! threads email (as-str thread-id) change)))))

(defn relabel-summaries! (summaries email thread-id change)
  (for-each (range 0 (len summaries))
    (fn (index)
      (let (entry (at summaries index))
        (when (summary-entry? entry email thread-id)
          (set! (at summaries index)
                (->stored-summary (clone (:account entry))
                                  (relabeled-summary (ref (:summary entry))
                                                     change))))))))

(defn relabel-threads! (threads email thread-id change)
  (update-threads! threads email thread-id
    (fn (held) (relabeled-thread held change))))

(type align-thread-labels!
  (fn ((mut (vec stored-thread))
       (ref str)
       (ref (vec thread-summary)))
    unit))

(defn align-thread-labels! (threads email summaries)
  (for-each (iter summaries)
    (fn (summary)
      (update-threads! threads email (ref (:id summary))
        (fn (held)
          (assoc (clone held)
                 :labels (clone (:labels summary))))))))

(type update-threads!
  (fn ((mut (slice stored-thread))
       (ref str)
       (ref str)
       (fn ((ref thread)) thread))
    unit))

(defn update-threads! (threads email thread-id updated)
  (for-each (range 0 (len threads))
    (fn (index)
      (let (entry (at threads index))
        (when (thread-entry? entry email thread-id)
          (set! (at threads index)
                (->stored-thread (clone (:account entry))
                                 (updated (ref (:thread entry))))))))))
