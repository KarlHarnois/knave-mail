(use adapters/driven/memory/remote-mail changes-since guard
                                        record-change!
                                        remote-mail
                                        sent-from)

(use adapters/driven/memory/remote-queries labelled?
                                           labels-of
                                           matching-page
                                           matching-summaries
                                           summaries-with-ids
                                           thread-position)

(use adapters/driven/memory/shared shared with-shared!)
(use domain/labels label-change)
(use domain/mail ->thread message outgoing thread)
(use domain/mail-error mail-error)
(use domain/relabel relabeled-thread)
(use ports/driven/mailbox mailbox)

(export ->memory-mailbox memory-mailbox)

(defstruct memory-mailbox
  :remote (shared remote-mail))

(impl mailbox memory-mailbox
  (fetch-labels! (box)
                 (with-shared! (ref (:remote box))
                   (fn (remote)
                     (try (guard remote "fetch-labels"))
                     (ok (labels-of remote)))))
  (fetch-threads! (box query)
                  (with-shared! (ref (:remote box))
                    (fn (remote)
                      (try (guard remote "fetch-threads"))
                      (ok (matching-summaries remote query)))))
  (list-thread-ids! (box query)
                    (with-shared! (ref (:remote box))
                      (fn (remote)
                        (try (guard remote "list-thread-ids"))
                        (ok (collect
                              (map (iter (matching-summaries remote query))
                                (fn (summary) (clone (:id summary)))))))))
  (list-thread-page! (box query page-token)
                     (with-shared! (ref (:remote box))
                       (fn (remote)
                         (try (guard remote "list-thread-ids"))
                         (ok (matching-page remote query page-token)))))
  (fetch-summaries! (box ids)
                    (with-shared! (ref (:remote box))
                      (fn (remote)
                        (try (guard remote "fetch-summaries"))
                        (ok (summaries-with-ids remote ids)))))
  (fetch-thread! (box thread-id)
                 (with-shared! (ref (:remote box))
                   (fn (remote)
                     (try (guard remote "fetch-thread"))
                     (ok (clone (at (:threads remote)
                                    (try (found-thread remote thread-id))))))))
  (fetch-history-id! (box)
                     (with-shared! (ref (:remote box))
                       (fn (remote)
                         (try (guard remote "fetch-history-id"))
                         (ok (str (:history-id remote))))))
  (fetch-changes! (box since)
                  (with-shared! (ref (:remote box))
                    (fn (remote)
                      (try (guard remote "fetch-changes"))
                      (changes-since remote since))))
  (deliver! (box sent)
            (with-shared! (ref (:remote box))
              (fn (remote)
                (try (guard remote "deliver"))
                (ok (record-delivery! remote sent)))))
  (relabel! (box thread-id change)
            (with-shared! (ref (:remote box))
              (fn (remote)
                (try (guard remote "relabel"))
                (let (index (try (found-thread remote thread-id))
                      changed (relabeled-thread (at (:threads remote) index)
                                                change))
                  (set! (at (:threads remote) index) changed)
                  (ok (record-change! remote thread-id)))))))

(type found-thread
  (fn ((ref remote-mail) (ref str))
    (result usize mail-error)))

(defn found-thread (remote thread-id)
  (ok-or (thread-position remote thread-id)
         (mail-error/not-found (str "no thread " thread-id))))

(type record-delivery!
  (fn ((mut remote-mail) (ref outgoing))
    string))

(defn record-delivery! (remote sent)
  (let (number (:next-id remote)
        message-id (str "sent-" number)
        thread-id (match (ref (:thread-id sent))
                    ((some existing) (clone existing))
                    (none (str "thread-" message-id)))
        message (sent-from sent
                           (ref message-id)
                           (ref thread-id)
                           (now-milliseconds)))
    (set! (:next-id remote) (+ number 1))
    (push! (mut (:sent remote))
           (clone sent))
    (record-change! remote (ref thread-id))
    (match (thread-position remote (ref thread-id))
      ((some index) (append-sent-message! remote index message))
      (none (push! (mut (:threads remote))
                   (->thread :id (clone thread-id)
                             :subject (clone (:subject sent))
                             :labels (vec (str "SENT"))
                             :messages (vec message)))))
    thread-id))

(type append-sent-message!
  (fn ((mut remote-mail) usize message) unit))

(defn append-sent-message! (remote index sent)
  (set! (at (:threads remote) index)
        (with-sent-message (at (:threads remote) index) sent)))

(type with-sent-message
  (fn ((ref thread) message) thread))

(defn with-sent-message (held sent)
  (local updated (clone held))
  (push! (mut (:messages updated)) sent)
  (unless (labelled? held "SENT")
    (push! (mut (:labels updated))
           (str "SENT")))
  updated)

(def now-milliseconds
  (rust "std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|{!elapsed}| {!elapsed}.as_millis() as i64).unwrap_or(0)"
    (fn () i64)))
