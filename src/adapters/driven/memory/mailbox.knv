(use adapters/driven/memory/remote-operation remote-operation)
(use adapters/driven/memory/remote-delivery record-delivery!)
(use adapters/driven/memory/remote-history changes-since)

(use adapters/driven/memory/remote-relabels found-thread
                                            messages-relabeled!
                                            relabeled-remotely!)

(use adapters/driven/memory/remote-mail guard! remote-mail)
(use adapters/driven/memory/remote-pages matching-page)

(use adapters/driven/memory/remote-queries labels-of
                                           matching-summaries
                                           summaries-with-ids)

(use adapters/driven/memory/remote-messages messages-matching)
(use adapters/driven/memory/shared shared with-shared!)
(use domain/labels label-change label-id system-label)
(use domain/mail ->thread message outgoing thread)
(use domain/mail-error mail-error)
(use ports/driven/mailbox mailbox)

(export ->memory-mailbox memory-mailbox)

(defstruct memory-mailbox
  :remote (shared remote-mail))

(impl mailbox memory-mailbox
  (fetch-labels! (box)
    (with-shared! (ref (:remote box))
      (fn (remote)
        (try (guard! remote remote-operation/fetch-labels))
        (ok (labels-of remote)))))

  (fetch-threads! (box query)
    (with-shared! (ref (:remote box))
      (fn (remote)
        (try (guard! remote remote-operation/fetch-threads))
        (ok (matching-summaries remote query)))))

  (fetch-thread-ids! (box query)
    (with-shared! (ref (:remote box))
      (fn (remote)
        (try (guard! remote remote-operation/list-thread-ids))
        (ok (-> (iter (matching-summaries remote query))
                (map (fn (summary) (clone (:id summary))))
                collect)))))

  (fetch-thread-page! (box query page-token)
    (with-shared! (ref (:remote box))
      (fn (remote)
        (try (guard! remote remote-operation/list-thread-ids))
        (ok (matching-page remote query page-token)))))

  (fetch-message-page! (box query _page-token)
    (with-shared! (ref (:remote box))
      (fn (remote)
        (try (guard! remote remote-operation/list-thread-ids))
        (ok (messages-matching remote query)))))

  (fetch-summaries! (box ids)
    (with-shared! (ref (:remote box))
      (fn (remote)
        (try (guard! remote remote-operation/fetch-summaries))
        (ok (summaries-with-ids remote ids)))))

  (fetch-thread! (box thread-id)
    (with-shared! (ref (:remote box))
      (fn (remote)
        (try (guard! remote remote-operation/fetch-thread))
        (ok (clone (at (:threads remote)
                       (try (found-thread remote thread-id))))))))

  (fetch-history-id! (box)
    (with-shared! (ref (:remote box))
      (fn (remote)
        (try (guard! remote remote-operation/fetch-history-id))
        (ok (str (:history-id remote))))))

  (fetch-changes! (box since)
    (with-shared! (ref (:remote box))
      (fn (remote)
        (try (guard! remote remote-operation/fetch-changes))
        (changes-since remote since))))

  (deliver! (box sent)
    (with-shared! (ref (:remote box))
      (fn (remote)
        (try (guard! remote remote-operation/deliver))
        (ok (record-delivery! remote sent)))))

  (relabel! (box thread-id change)
    (with-shared! (ref (:remote box))
      (fn (remote)
        (try (guard! remote remote-operation/relabel))
        (relabeled-remotely! remote thread-id change))))

  (relabel-messages! (box message-ids change)
    (with-shared! (ref (:remote box))
      (fn (remote)
        (try (guard! remote remote-operation/relabel))
        (messages-relabeled! remote message-ids change)))))
