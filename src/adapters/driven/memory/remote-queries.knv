(use adapters/driven/memory/remote-mail remote-mail)

(use domain/mail ->label label thread thread-query
                 thread-summary)

(use domain/summary in-label? newest-first summarize)

(export labels-of matching-summaries summaries-with-ids
        thread-position)

(type labels-of
  (fn ((ref remote-mail)) (vec label)))

(defn labels-of (remote)
  (collect (map (iter (distinct-labels (ref (:threads remote))))
             (fn (name) (label-named remote name)))))

(type label-named
  (fn ((ref remote-mail) (ref string))
    label))

(defn label-named (remote name)
  (->label :id (clone name)
           :name (clone name)
           :unread (unread-count (ref (:threads remote)) name)))

(type matching-summaries
  (fn ((ref remote-mail) (ref thread-query))
    (vec thread-summary)))

(defn matching-summaries (remote query)
  (let (summaries (collect (map (filter (iter (:threads remote))
                                  (fn (candidate)
                                    (mentions? candidate (:query query))))
                                (fn (matched) (summarize matched))))
        labelled (collect (filter (into-iter summaries)
                            (fn (summary)
                              (in-label? summary (:label query))))))
    (newest-first labelled query)))

(type summaries-with-ids
  (fn ((ref remote-mail) (ref (vec string)))
    (vec thread-summary)))

(defn summaries-with-ids (remote ids)
  (collect (map (filter (iter (:threads remote))
                  (fn (candidate)
                    (any? (iter ids)
                      (fn (id) (= id (:id candidate))))))
                (fn (matched) (summarize matched)))))

(def into-iter
  (rust "{0}.into_iter()"
    (fn ((vec thread-summary))
      (iterator thread-summary))))

(type thread-position
  (fn ((ref remote-mail) (ref str))
    (option usize)))

(defn thread-position (remote thread-id)
  (map-some (find (enumerate (iter (:threads remote)))
              (fn (numbered)
                (let-match ((pair _ candidate) numbered)
                  (= (:id candidate) thread-id))))
            (fn (numbered)
              (let-match ((pair index _) numbered) index))))

(type distinct-labels
  (fn ((ref (vec thread))) (vec string)))

(defn distinct-labels (threads)
  (local names (vec))
  (for-each (iter threads)
    (fn (held)
      (for-each (iter (:labels held))
        (fn (name) (push! names (clone name))))))
  (sort! names)
  (dedup! names)
  names)

(type unread-count
  (fn ((ref (vec thread)) (ref string))
    i64))

(defn unread-count (threads name)
  (reduce (iter threads) 0
    (fn (unread held)
      (if (unread-in? held (as-str name))
        (+ unread 1)
        unread))))

(type unread-in?
  (fn ((ref thread) (ref str)) bool))

(defn unread-in? (held name)
  (and (labelled? held name) (labelled? held "UNREAD")))

(type labelled?
  (fn ((ref thread) (ref str)) bool))

(defn labelled? (held name)
  (any? (iter (:labels held))
    (fn (label) (= label name))))

(def mentions?
  (rust "{{ let {!wanted} = {1}.to_lowercase(); {!wanted}.is_empty() || {0}.subject.to_lowercase().contains(&{!wanted}) || {0}.messages.iter().any(|{!message}| {!message}.from.to_lowercase().contains(&{!wanted}) || {!message}.text.to_lowercase().contains(&{!wanted})) }}"
    (fn ((ref thread) (ref str)) bool)))
