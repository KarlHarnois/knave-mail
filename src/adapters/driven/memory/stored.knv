(use domain/mail message thread thread-query thread-summary)
(use domain/summary in-label?)

(export ->stored-summary ->stored-thread message-in
        replace-summaries! replace-thread! stored-summary
        stored-thread summaries-of summaries-with-ids
        thread-in)

(defstruct stored-summary
  :account string
  :summary thread-summary)

(defstruct stored-thread
  :account string
  :thread thread)

(type summaries-of
  (fn ((ref (vec stored-summary))
       (ref str)
       (ref thread-query))
    (vec thread-summary)))

(defn summaries-of (stored email query)
  (collect (map (filter (iter stored)
                  (fn (entry)
                    (and (= (:account entry) email)
                         (in-label? (ref (:summary entry))
                                    (:label query)))))
                (fn (entry) (clone (:summary entry))))))

(type replace-summaries!
  (fn ((mut (vec stored-summary))
       (ref str)
       (ref (vec thread-summary)))
    unit))

(defn replace-summaries! (stored email summaries)
  (for-each (iter summaries)
    (fn (summary)
      (retain-other-summaries! stored email (ref (:id summary)))
      (push! stored
             (->stored-summary (str email) (clone summary))))))

(type replace-thread!
  (fn ((mut (vec stored-thread))
       (ref str)
       (ref thread))
    unit))

(defn replace-thread! (stored email saved)
  (retain-other-threads! stored email (ref (:id saved)))
  (push! stored
         (->stored-thread (str email) (clone saved))))

(def retain-other-summaries!
  (rust "{0}.retain(|{!entry}| !({!entry}.account == *{1} && {!entry}.summary.id == *{2}))"
    (fn ((mut (vec stored-summary))
         (ref str)
         (ref str))
      unit)))

(def retain-other-threads!
  (rust "{0}.retain(|{!entry}| !({!entry}.account == *{1} && {!entry}.thread.id == *{2}))"
    (fn ((mut (vec stored-thread))
         (ref str)
         (ref str))
      unit)))

(def summaries-with-ids
  (rust "{0}.iter().filter(|{!entry}| {!entry}.account == *{1} && {2}.contains(&{!entry}.summary.id)).map(|{!entry}| {!entry}.summary.clone()).collect::<Vec<_>>()"
    (fn ((ref (vec stored-summary))
         (ref str)
         (ref (vec string)))
      (vec thread-summary))))

(def thread-in
  (rust "{0}.iter().find(|{!entry}| {!entry}.account == *{1} && {!entry}.thread.id == *{2}).map(|{!entry}| {!entry}.thread.clone())"
    (fn ((ref (vec stored-thread))
         (ref str)
         (ref str))
      (option thread))))

(def message-in
  (rust "{0}.iter().filter(|{!entry}| {!entry}.account == *{1}).flat_map(|{!entry}| {!entry}.thread.messages.iter()).find(|{!message}| {!message}.id == *{2}).cloned()"
    (fn ((ref (vec stored-thread))
         (ref str)
         (ref str))
      (option message))))
