(use domain/mail message thread thread-query thread-summary)
(use domain/summary in-scope?)

(export ->stored-summary ->stored-thread message-in
        other-summaries other-threads replace-summaries!
        replace-thread! stored-summary stored-thread
        summaries-of summaries-with-ids summary-entry?
        thread-entry? thread-in)

(defstruct stored-summary
  :account string
  :summary thread-summary)

(defstruct stored-thread
  :account string
  :thread thread)

(type summaries-of
  (fn ((ref (vec stored-summary))
       (ref str)
       (ref thread-query))
    (vec thread-summary)))

(defn summaries-of (stored email query)
  (-> (iter stored)
      (filter (fn (entry)
                (and (= (:account entry) email)
                     (in-scope? (ref (:summary entry))
                                (ref (:scope query))))))
      (map (fn (entry) (clone (:summary entry))))
      collect))

(type replace-summaries!
  (fn ((mut (vec stored-summary))
       (ref str)
       (ref (vec thread-summary)))
    unit))

(defn replace-summaries! (stored email summaries)
  (for-each (iter summaries)
    (fn (summary)
      (set! stored
            (other-summaries stored email (ref (:id summary))))
      (push! stored
             (->stored-summary (str email) (clone summary))))))

(type replace-thread!
  (fn ((mut (vec stored-thread))
       (ref str)
       (ref thread))
    unit))

(defn replace-thread! (stored email saved)
  (set! stored
        (other-threads stored email (ref (:id saved))))
  (push! stored
         (->stored-thread (str email) (clone saved))))

(type other-summaries
  (fn ((ref (vec stored-summary))
       (ref str)
       (ref str))
    (vec stored-summary)))

(defn other-summaries (stored email thread-id)
  (-> (iter stored)
      (filter (fn (entry)
                (not (summary-entry? entry email thread-id))))
      (map (fn (entry) (clone entry)))
      collect))

(type other-threads
  (fn ((ref (vec stored-thread))
       (ref str)
       (ref str))
    (vec stored-thread)))

(defn other-threads (stored email thread-id)
  (-> (iter stored)
      (filter (fn (entry)
                (not (thread-entry? entry email thread-id))))
      (map (fn (entry) (clone entry)))
      collect))

(type summary-entry?
  (fn ((ref stored-summary)
       (ref str)
       (ref str))
    bool))

(defn summary-entry? (entry email thread-id)
  (and (= (:account entry) email)
       (= (:id (:summary entry)) thread-id)))

(type thread-entry?
  (fn ((ref stored-thread)
       (ref str)
       (ref str))
    bool))

(defn thread-entry? (entry email thread-id)
  (and (= (:account entry) email)
       (= (:id (:thread entry)) thread-id)))

(type summaries-with-ids
  (fn ((ref (vec stored-summary))
       (ref str)
       (ref (vec string)))
    (vec thread-summary)))

(defn summaries-with-ids (stored email ids)
  (-> (iter stored)
      (filter (fn (entry)
                (and (= (:account entry) email)
                     (any? (iter ids)
                       (fn (id) (= id (:id (:summary entry))))))))
      (map (fn (entry) (clone (:summary entry))))
      collect))

(defn thread-in (stored email thread-id)
  (-> (iter stored)
      (find (fn (entry) (thread-entry? entry email thread-id)))
      (map-some (fn (entry) (clone (:thread entry))))))

(type message-in
  (fn ((ref (vec stored-thread))
       (ref str)
       (ref str))
    (option message)))

(defn message-in (stored email message-id)
  (-> (iter stored)
      (filter (fn (entry) (= (:account entry) email)))
      (map (fn (entry)
             (message-with-id (ref (:thread entry)) message-id)))
      (find some?)
      (then-some (fn (found) found))))

(type message-with-id
  (fn ((ref thread) (ref str))
    (option message)))

(defn message-with-id (held message-id)
  (-> (iter (:messages held))
      (find (fn (candidate)
              (= (:id candidate) message-id)))
      (map-some (fn (found) (clone found)))))
