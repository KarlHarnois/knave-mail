(use domain/mail account)

(export account-kept? accounts-without)

(defn account-kept? (accounts email)
  (any? (iter accounts)
    (fn (account)
      (= (:email account) email))))

(type accounts-without
  (fn ((ref (vec account)) (ref str))
    (vec account)))

(defn accounts-without (accounts email)
  (-> (iter accounts)
      (filter (fn (account)
                (not= (:email account) email)))
      (map (fn (account) (clone account)))
      collect))
