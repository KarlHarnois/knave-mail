(use adapters/driven/memory/remote-change ->remote-change
                                          change-kind
                                          remote-change)

(use adapters/driven/memory/remote-mail remote-mail)
(use domain/collections appended appended-once)

(use domain/history ->mail-changes ->message-relabel
                    mail-changes)

(use domain/labels label-change)
(use domain/mail-error mail-error)

(export changes-since expire-history! record-change!
        record-relabel!)

(type expire-history!
  (fn ((mut remote-mail)) unit))

(defn expire-history! (remote)
  (set! (:history-floor remote) (:history-id remote))
  (set! (:changes remote) (vec)))

(type record-change!
  (fn ((mut remote-mail) (ref str)) unit))

(defn record-change! (remote thread-id)
  (recorded! remote thread-id change-kind/refetch))

(type record-relabel!
  (fn ((mut remote-mail)
       (ref str)
       (ref label-change))
    unit))

(defn record-relabel! (remote thread-id change)
  (recorded! remote thread-id
             (change-kind/relabel (clone change))))

(type recorded!
  (fn ((mut remote-mail) (ref str) change-kind)
    unit))

(defn recorded! (remote thread-id kind)
  (set! (:history-id remote)
        (inc (:history-id remote)))
  (push! (mut (:changes remote))
         (->remote-change :at (:history-id remote)
                          :thread-id (str thread-id)
                          :kind kind)))

(type changes-since
  (fn ((ref remote-mail) (ref str))
    (result mail-changes mail-error)))

(defn changes-since (remote since)
  (match (the (result int parse-int-error) (parse since))
    ((ok start) (changes-from remote since start))
    ((err _)
     (err (mail-error/history-expired (str "no history from " since))))))

(type changes-from
  (fn ((ref remote-mail) (ref str) int)
    (result mail-changes mail-error)))

(defn changes-from (remote since start)
  (if (< start (:history-floor remote))
    (err (mail-error/history-expired (str "history " since " has expired")))
    (ok (->mail-changes :refetch (refetched-after remote start)
                        :relabels (relabels-after remote start)
                        :history-id (str (:history-id remote))))))

(defn changes-after (remote start)
  (-> (iter (:changes remote))
      (filter (fn (change) (> (:at change) start)))
      (map (fn (change) (clone change)))
      collect))

(defn refetched-after (remote start)
  (-> (iter (changes-after remote start))
      (filter (fn (change)
                (refetch? (ref (:kind change)))))
      (reduce (vec)
        (fn (found change)
          (appended-once found (clone (:thread-id change)))))))

(defn relabels-after (remote start)
  (reduce (iter (changes-after remote start)) (vec)
    (fn (found change)
      (match (ref (:kind change))
        ((relabel relabel)
         (with-message-relabels found remote
                                (as-str (:thread-id change))
                                relabel))
        (refetch found)))))

(defn refetch? (kind)
  (match kind
    (refetch true)
    ((relabel _) false)))

(defn with-message-relabels (found remote thread-id relabel)
  (reduce (message-ids-of remote thread-id) found
    (fn (relabels message-id)
      (appended relabels
                (->message-relabel :thread-id (str thread-id)
                                   :message-id (clone message-id)
                                   :change (clone relabel))))))

(type message-ids-of
  (fn ((ref remote-mail) (ref str))
    (vec string)))

(defn message-ids-of (remote thread-id)
  (-> (iter (:threads remote))
      (filter (fn (thread) (= (:id thread) thread-id)))
      (reduce (vec)
        (fn (ids thread)
          (reduce (iter (:messages thread)) ids
            (fn (found message)
              (appended found (clone (:id message)))))))))
