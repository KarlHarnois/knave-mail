(use domain/mail account)
(use domain/mail-error mail-error)

(export ->memory-authorizer granted-account!
        memory-authorizer)

(defstruct memory-authorizer
  :granted (vec account))

(type granted-account!
  (fn ((mut memory-authorizer))
    (result account mail-error)))

(defn granted-account! (granting)
  (ok-or (pop! (mut (:granted granting)))
         (mail-error/auth-required (str "consent was not granted"))))
