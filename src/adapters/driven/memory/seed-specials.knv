(use domain/labels label-id system-label)
(use domain/mail ->message ->thread message thread)

(export html-newsletter long-thread unicode-thread)

(defn html-newsletter (account date)
  (single-message-thread (->message :id (str "m-newsletter")
                                    :thread-id (str "newsletter")
                                    :from (str "The Weekly Byte <news@example.com>")
                                    :to (vec (str account))
                                    :cc (vec)
                                    :subject (str "This week in compilers")
                                    :date (- date 60000)
                                    :text (str "This week in compilers\n\nRead about tail calls, register allocation and more.\nhttps://example.com/issue/42")
                                    :html (some (str "<html><head><style>body{font-family:Georgia,serif;background:#fdf6e3;color:#333}h1{color:#b58900}.card{border:1px solid #ddd;padding:12px;margin:8px 0}</style></head><body><h1>This week in compilers</h1><img src=\"https://example.com/banner.png\" alt=\"banner\" width=\"600\"><div class=\"card\"><h2>Tail calls</h2><p>Why your Lisp needs them.</p><a href=\"https://example.com/tail-calls\">Read more</a></div><div class=\"card\"><h2>Register allocation</h2><p>Graph colouring, explained.</p></div><table><tr><td>Left</td><td>Right</td></tr></table></body></html>"))
                                    :header-id (str "<newsletter@example.com>")
                                    :references (str ""))
                         (vec (label-id system-label/inbox)
                              (label-id system-label/unread))))

(defn unicode-thread (account date)
  (single-message-thread (->message :id (str "m-unicode")
                                    :thread-id (str "unicode")
                                    :from (str
                                            "Yūki Matsumoto <yuki@example.jp>")
                                    :to (vec (str account))
                                    :cc (vec)
                                    :subject (str "Unicode: 日本語, العربية, émojis 🎉")
                                    :date (- date 120000)
                                    :text (str "こんにちは！\nمرحبا بالعالم — this line is right to left.\nCafé, naïve, Ångström, 🎉🚀\n")
                                    :html none
                                    :header-id (str "<unicode@example.jp>")
                                    :references (str ""))
                         (vec (label-id system-label/inbox)
                              (label-id system-label/starred))))

(defn long-thread (account date)
  (->thread :id (str "long")
            :subject (str "Re: The never-ending design thread")
            :labels (vec (label-id system-label/inbox))
            :messages (-> (range 0 12)
                          (map (fn (index)
                                 (long-thread-message account date index)))
                          collect)))

(defn long-thread-message (account date index)
  (->message :id (str "m-long-" index)
             :thread-id (str "long")
             :from (str (if (even? index)
                          "Alan Turing <alan@example.com>"
                          "Edsger Dijkstra <edsger@example.com>"))
             :to (vec (str account))
             :cc (vec)
             :subject (str "Re: The never-ending design thread")
             :date (+ (- date 86400000) (* index 600000))
             :text (str "Reply number " index
                        ".\n\nI still think we should use a tree.")
             :html none
             :header-id (str "<long-" index "@example.com>")
             :references (str "")))

(type single-message-thread
  (fn (message (vec string)) thread))

(defn single-message-thread (only labels)
  (->thread :id (clone (:thread-id only))
            :subject (clone (:subject only))
            :labels labels
            :messages (vec only)))
