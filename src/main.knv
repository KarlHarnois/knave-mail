(use adapters/driving/cli/arguments parse-arguments)
(use adapters/driving/cli/command cli-command-word?)
(use composition/launch launch-cli launch-window)
(use composition/settings settings-from)

(defn main ()
  (let (arguments (command-line-args)
        parsed (parse-arguments (ref arguments))
        chosen (settings-from (ref arguments)))
    (if (cli-command-word? (ref parsed))
      (launch-cli chosen parsed)
      (launch-window chosen))))
