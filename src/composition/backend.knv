(export backend text->backend)

(defenum backend
  gmail
  memory)

(type text->backend
  (fn ((ref str)) (result backend string)))

(defn text->backend (text)
  (match text
    ("gmail" (ok backend/gmail))
    ("memory" (ok backend/memory))
    (_ (err (str "--backend expects gmail or memory, not `" text "`")))))
