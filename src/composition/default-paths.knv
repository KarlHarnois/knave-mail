(export config-file default-cache-path default-log-path)

(def default-cache-path
  (rust "std::env::var(\"XDG_DATA_HOME\").map(std::path::PathBuf::from).or_else(|_| std::env::var(\"HOME\").map(|{!home}| std::path::Path::new(&{!home}).join(\".local/share\"))).unwrap_or_else(|_| std::path::PathBuf::from(\".\")).join(\"knave-mail/cache.sqlite3\").to_string_lossy().into_owned()"
    (fn () string)))

(def default-log-path
  (rust "std::env::var(\"XDG_STATE_HOME\").map(std::path::PathBuf::from).or_else(|_| std::env::var(\"HOME\").map(|{!home}| std::path::Path::new(&{!home}).join(\".local/state\"))).unwrap_or_else(|_| std::path::PathBuf::from(\".\")).join(\"knave-mail/knave-mail.log\").to_string_lossy().into_owned()"
    (fn () string)))

(def config-file
  (rust "std::env::var(\"XDG_CONFIG_HOME\").map(std::path::PathBuf::from).or_else(|_| std::env::var(\"HOME\").map(|{!home}| std::path::Path::new(&{!home}).join(\".config\"))).unwrap_or_else(|_| std::path::PathBuf::from(\".\")).join(\"knave-mail\").join({0}).to_string_lossy().into_owned()"
    (fn ((ref str)) string)))
