(use adapters/driving/cli/arguments parsed-arguments
                                    value-of)

(use composition/default-paths config-file
                               default-cache-path
                               default-log-path)

(use adapters/driven/memory/remote-operation remote-operation
                                             text->remote-operation)

(use composition/backend backend text->backend)
(use composition/tuning tuning tuning-for)
(use domain/level-spec level-spec text->level-spec)

(export ->google-client ->settings arguments->settings
        google-client missing-client-message settings)

(defstruct google-client
  :id string
  :secret string)

(defstruct settings
  :backend backend
  :tuning tuning
  :latency-milliseconds int
  :failing (option remote-operation)
  :e2e-script-path (option string)
  :cache-path string
  :credentials-file (option string)
  :google-client (option google-client)
  :api-base string
  :token-url string
  :auth-url string
  :browser string
  :theme-path string
  :keymap-path string
  :log-path string
  :log-levels level-spec
  :start-account (option string))

(def missing-client-message
  "set KNAVE_MAIL_CLIENT_ID and KNAVE_MAIL_CLIENT_SECRET to your Google OAuth client, or pass --backend memory")

(defn arguments->settings (parsed)
  (let-try (chosen-backend (text->backend (as-str (or-default (setting
                                                                parsed
                                                                "--backend"
                                                                "KNAVE_MAIL_BACKEND")
                                                              "gmail"))))
    (settings-with parsed chosen-backend)))

(defn settings-with (parsed chosen-backend)
  (ok
    (->settings
      :tuning (tuning-for (ref chosen-backend))
      :backend chosen-backend
      :latency-milliseconds (try (text->latency (as-str (or-default (setting
                                                                      parsed
                                                                      "--latency"
                                                                      "KNAVE_MAIL_LATENCY")
                                                                    "0"))))
      :failing (try (failing-operation
                      (setting parsed "--fail" "KNAVE_MAIL_FAIL")))
      :e2e-script-path (setting parsed "--e2e-script" "KNAVE_MAIL_E2E_SCRIPT")
      :cache-path (unwrap-or (setting parsed "--cache" "KNAVE_MAIL_CACHE")
                             (default-cache-path))
      :credentials-file (setting parsed "--credentials-file"
                                 "KNAVE_MAIL_CREDENTIALS_FILE")
      :google-client (chosen-client parsed)
      :api-base (or-default (setting parsed
                                     "--gmail-base-url"
                                     "KNAVE_MAIL_GMAIL_BASE_URL")
                            "https://gmail.googleapis.com")
      :token-url (or-default (setting parsed "--token-url"
                                      "KNAVE_MAIL_TOKEN_URL")
                             "https://oauth2.googleapis.com/token")
      :auth-url (or-default (setting parsed "--auth-url" "KNAVE_MAIL_AUTH_URL")
                            "https://accounts.google.com/o/oauth2/v2/auth")
      :browser (or-default (setting parsed "--browser" "KNAVE_MAIL_BROWSER")
                           "xdg-open")
      :theme-path (unwrap-or (setting parsed "--theme" "KNAVE_MAIL_THEME")
                             (config-file "theme.knv"))
      :keymap-path (unwrap-or (setting parsed "--keymap" "KNAVE_MAIL_KEYMAP")
                              (config-file "keymap.knv"))
      :log-path (unwrap-or (setting parsed "--log-file" "KNAVE_MAIL_LOG_FILE")
                           (default-log-path))
      :log-levels (try (text->level-spec (as-str (or-default (setting
                                                               parsed
                                                               "--log-level"
                                                               "KNAVE_MAIL_LOG")
                                                             "info"))))
      :start-account (setting parsed "--account" "KNAVE_MAIL_ACCOUNT"))))

(defn setting (parsed flag variable)
  (match (value-of parsed flag)
    ((some value) (some value))
    (none (environment-value variable))))

(defn or-default (value fallback)
  (unwrap-or value (str fallback)))

(defn chosen-client (parsed)
  (match (pair (setting parsed "--client-id" "KNAVE_MAIL_CLIENT_ID")
               (setting parsed "--client-secret"
                        "KNAVE_MAIL_CLIENT_SECRET"))
    ((pair (some id) (some secret))
     (some (->google-client :id id :secret secret)))
    (_ none)))

(defn failing-operation (text)
  (match text
    ((some name)
     (map-ok (text->remote-operation (as-str name)) some))
    (none (ok none))))

(defn text->latency (text)
  (map-err (parse text)
    (fn (_)
      (str "--latency expects milliseconds, not `" text "`"))))

(def environment-value
  (rust "std::env::var({0}).ok().filter(|{!value}| !{!value}.is_empty())"
    (fn ((ref str)) (option string))))
