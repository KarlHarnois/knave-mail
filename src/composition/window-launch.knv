(use ports/driven/link-opener link-opener)
(use composition/window-serving serve-window!)

(export launch-window)

(type launch-window (fn (settings string) unit))

(defn launch-window (chosen scenario)
  (match (:backend chosen)
    (memory (scripted-window chosen none scenario))
    (gmail (guarded-window chosen scenario))))

(defn guarded-window (chosen scenario)
  (match (claimed-window (as-str (:cache-path chosen)))
    ((claimed socket)
     (scripted-window chosen (some socket) scenario))
    (another-window-open (log-info (ref (chosen-log (ref chosen)))
                                   log-area/app
                                   (str "a window is already open, so it came forward instead")))
    (unguarded (scripted-window chosen none scenario))))

(type scripted-window
  (fn (settings (option window-socket) string) unit))

(defn scripted-window (chosen claim scenario)
  (let (keymap (keymap-startup (ref chosen))
        theme (theme-startup (ref chosen))
        script (str (:text keymap)
                    (start-account-script (ref (:start-account chosen)))
                    scenario)
        stylesheet (clone (:text theme)))
    (print-warnings (ref keymap))
    (print-warnings (ref theme))
    (open-window "knave-mail"
                 (ref script)
                 (ref stylesheet)
                 (fn (url) (link-request-for url))
                 (fn (inbox outbox)
                   (let (owned chosen
                         log (chosen-log (ref owned)))
                     (log-started (ref log) (ref owned) "window")
                     (match claim
                       ((some socket) (forward-launches! socket (ref outbox)))
                       (none (do)))
                     (serve-window! (ref owned)
                                    (ref log)
                                    (ref inbox)
                                    (ref outbox)))))))

(type print-warnings
  (fn ((ref loaded-file)) unit))

(defn print-warnings (loaded)
  (for-each (iter (:warnings loaded))
    (fn (warning) (eprintln warning))))
