(use adapters/driven/browser/system-browser ->system-browser)

(use adapters/driven/threaded-queue share-sender
                                    threaded-operations)

(use adapters/driving/webview/link-navigation link-request-for)
(use adapters/driving/webview/listing-runner listing-runner)

(use adapters/driving/webview/session ->window-workers
                                      serve-requests!)

(use adapters/driving/webview/start-account-script start-account-script)
(use adapters/driving/webview/sync-runner sync-runner)

(use adapters/driving/webview/window open-window
                                     reply-outbox
                                     request-inbox)

(use adapters/driving/webview/change-delivery change-delivery)

(use adapters/driving/webview/single-window claimed-window
                                            forward-launches!
                                            window-claim
                                            window-socket)

(use composition/background-listing start-background-listing)
(use composition/background-sync ->background-sync)
(use composition/delivery-worker start-delivery-worker)
(use composition/gmail-backend gmail-app)
(use composition/keymap-loader keymap-startup-script)
(use composition/launch fail-with memory-backend)
(use composition/logging chosen-log)
(use composition/memory-backend memory-app)
(use composition/operation-executor start-gmail-executor)
(use composition/settings e2e-script settings)
(use composition/startup-log log-started)
(use composition/theme-file theme-stylesheet)
(use app/mail-app delivery)
(use domain/operation priority)
(use ports/driven/event-log event-log log-info share-log)
(use ports/driven/link-opener link-opener)

(export launch-window)

(defn launch-window (chosen)
  (if (= (:backend chosen) memory-backend)
    (opened-window chosen none)
    (guarded-window chosen)))

(defn guarded-window (chosen)
  (match (claimed-window (as-str (:cache-path chosen)))
    ((claimed socket) (opened-window chosen (some socket)))
    (another-window-open (log-info (ref (chosen-log (ref chosen)))
                                   "app"
                                   (str "a window is already open, so it came forward instead")))
    (unguarded (opened-window chosen none))))

(type opened-window
  (fn (settings (option window-socket)) unit))

(defn opened-window (chosen claim)
  (match (e2e-script (ref chosen))
    ((ok scenario) (scripted-window chosen claim scenario))
    ((err problem) (eprintln problem) (exit 1))))

(defn scripted-window (chosen claim scenario)
  (let (script (str (keymap-startup-script (ref chosen))
                    (start-account-script (ref (:start-account chosen)))
                    scenario)
        stylesheet (theme-stylesheet (ref chosen)))
    (open-window "knave-mail"
                 (ref script)
                 (ref stylesheet)
                 (fn (url) (link-request-for url))
                 (fn (inbox outbox)
                   (let (owned chosen
                         log (chosen-log (ref owned)))
                     (log-started (ref log) (ref owned) "window")
                     (match claim
                       ((some socket) (forward-launches! socket (ref outbox)))
                       (none (do)))
                     (if (= (:backend owned) memory-backend)
                       (serve-memory-window! (ref owned)
                                             (ref log)
                                             (ref inbox)
                                             (ref outbox))
                       (serve-gmail-window! (ref owned)
                                            (ref log)
                                            (ref inbox)
                                            (ref outbox))))))))

(defn serve-memory-window! (chosen log inbox outbox)
  (local running (memory-app chosen (share-log log)))
  (serve-requests! (mut running)
                   (ref (->window-workers :sync sync-runner/inline
                                          :listing listing-runner/inline
                                          :delivery change-delivery/inline
                                          :opener (browser-of chosen)))
                   log inbox outbox))

(defn serve-gmail-window! (chosen log inbox outbox)
  (let (executor (start-gmail-executor (clone chosen)))
    (match (gmail-app chosen
                      (share-log log)
                      (threaded-operations (ref executor))
                      priority/interactive
                      delivery/deliver-later)
      ((ok app)
       (do
         (local running app)
         (serve-requests!
           (mut running)
           (ref
             (->window-workers
               :sync (sync-runner/background (->background-sync
                                               :executor (share-sender (ref executor))
                                               :settings (clone chosen)))
               :listing (start-background-listing outbox (ref executor) chosen)
               :delivery (start-delivery-worker outbox (ref executor) chosen)
               :opener (browser-of chosen)))
           log inbox outbox)))
      ((err failure) (fail-with (ref failure))))))

(type browser-of
  (fn ((ref settings)) link-opener))

(defn browser-of (chosen)
  (link-opener/system (->system-browser (clone (:browser chosen)))))
