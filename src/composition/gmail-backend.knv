(use adapters/driven/file-credentials/credentials ->file-credentials)
(use adapters/driven/gmail/http new-agent)
(use adapters/driven/gmail/provider ->gmail-provider)

(use adapters/driven/gmail/session-state ->gmail-endpoints
                                         gmail-endpoints)

(use adapters/driven/google-oauth/authorizer ->google-authorizer)
(use adapters/driven/google-oauth/oauth-settings ->oauth-settings)
(use adapters/driven/browser/system-browser ->system-browser)
(use adapters/driven/keyring/credentials ->keyring-credentials)
(use adapters/driven/sqlite/store open-sqlite-store)
(use ports/driven/clock clock)
(use app/mail-app delivery mail-app new-mail-app)
(use domain/operation priority)
(use app/operations/inline-queue ->inline-queue)
(use app/operations/runner new-runner)
(use ports/driven/event-log event-log share-log)
(use ports/driven/mailbox-provider mailbox-provider)
(use ports/driven/operation-queue operation-queue)

(use composition/settings google-client
                          missing-client-message settings)

(use domain/mail-error mail-error)
(use ports/driven/credentials credentials)

(export chosen-client gmail-app gmail-operations
        gmail-provider-for)

(defn gmail-app (chosen log operations rank delivery)
  (let-try (client (chosen-client chosen))
    (ok (new-mail-app (box (try (open-sqlite-store (ref (:cache-path chosen)))))
                      operations
                      (box (->google-authorizer
                             :agent (new-agent)
                             :settings (->oauth-settings
                                         :auth-url (clone (:auth-url chosen))
                                         :token-url (clone (:token-url chosen))
                                         :api-base (clone (:api-base chosen))
                                         :client-id (clone (:id client))
                                         :client-secret (clone (:secret client))
                                         :sign-in-wait-milliseconds (:sign-in-wait-milliseconds
                                                                      (:tuning chosen)))
                             :credentials (chosen-credentials chosen)
                             :browser (box (->system-browser (clone (:browser chosen))))))
                      log rank delivery
                      (clone (:limits (:tuning chosen)))))))

(defn gmail-provider-for (chosen client log)
  (the (box mailbox-provider)
       (box (->gmail-provider (endpoints chosen client)
                              (chosen-credentials chosen)
                              clock/system
                              (share-log log)))))

(defn gmail-operations (chosen client log)
  (the (box operation-queue)
       (box (->inline-queue
              :runner (new-runner (gmail-provider-for chosen client log)
                                  clock/system
                                  (share-log log))
              :patience (some (:cli-patience-milliseconds (:tuning chosen)))))))

(defn chosen-client (chosen)
  (ok-or (clone (:google-client chosen))
         (mail-error/usage (str missing-client-message))))

(type endpoints
  (fn ((ref settings) (ref google-client))
    gmail-endpoints))

(defn endpoints (chosen client)
  (->gmail-endpoints :api-base (clone (:api-base chosen))
                     :token-url (clone (:token-url chosen))
                     :client-id (clone (:id client))
                     :client-secret (clone (:secret client))
                     :quota-units-per-second (:quota-units-per-second (:tuning chosen))))

(type chosen-credentials
  (fn ((ref settings)) (box credentials)))

(defn chosen-credentials (chosen)
  (match (:credentials-file chosen)
    ((some path) (box (->file-credentials (clone path))))
    (none (box (->keyring-credentials (str "knave-mail"))))))
