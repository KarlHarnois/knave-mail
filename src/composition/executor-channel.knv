(use adapters/driven/threaded-queue submission
                                    submission-sender)

(use domain/mail-error mail-error)
(use domain/operation operation-result)
(use domain/operation-schedule scheduled)

(export answered-and-dropped next-arrival removed-at
        replaced-at spawn-executor submission-inbox)

(deftype submission-inbox
  (rust "std::sync::mpsc::Receiver<crate::adapters::driven::threaded_queue::Submission>"))

(def answered-and-dropped
  (rust "{{ let mut {!replies} = {0}; if let Some({!index}) = {!replies}.iter().position(|({!id}, _)| *{!id} == {1}) {{ let (_, {!asked}) = {!replies}.remove({!index}); drop({!asked}.reply.send({2})); }} {!replies} }}"
    (fn ((vec (pair i64 submission))
         i64
         (result operation-result mail-error))
      (vec (pair i64 submission)))))

(def removed-at
  (rust "{{ let mut {!all} = {0}; {!all}.remove({1}); {!all} }}"
    (fn ((vec scheduled) usize)
      (vec scheduled))))

(def replaced-at
  (rust "{{ let mut {!all} = {0}; {!all}[{1}] = {2}; {!all} }}"
    (fn ((vec scheduled) usize scheduled)
      (vec scheduled))))

(def next-arrival
  (rust "match {1} {{ Some({!wait}) => match {0}.recv_timeout(std::time::Duration::from_millis({!wait}.max(0) as u64)) {{ Ok({!arrived}) => Some(Some({!arrived})), Err(std::sync::mpsc::RecvTimeoutError::Timeout) => Some(None), Err(_) => None }}, None => {0}.recv().ok().map(Some) }}"
    (fn ((ref submission-inbox) (option i64))
      (option (option submission)))))

(def spawn-executor
  (rust "{{ let ({!sender}, {!inbox}) = std::sync::mpsc::channel(); let {!job} = {0}; std::thread::spawn(move || {!job}({!inbox})); {!sender} }}"
    (fn ((fn-once (submission-inbox) unit))
      submission-sender)))
