(use domain/log-entry log-area)

(use adapters/driven/threaded-queue share-sender
                                    submission-sender
                                    threaded-operations)

(use adapters/driving/webview/change-delivery change-delivery)
(use adapters/driving/webview/window reply-outbox)

(use composition/delivery-channel spawn-delivery wake!
                                  wake-inbox wake-sender
                                  woken?)

(use app/mail-app delivery mail-app)
(use composition/gmail-backend gmail-app)
(use composition/delivery-rounds delivered-all!)
(use composition/logging chosen-log)
(use composition/settings settings)
(use domain/mail-error error-message)
(use app/operations/batch-log log-batch-delivered!)
(use domain/operation priority)

(use ports/driven/event-log event-log log-info log-warn
                            share-log)

(export start-delivery-worker)

(defn start-delivery-worker (outbox executor chosen)
  (let (shared (share-sender executor)
        owned-settings (clone chosen))
    (change-delivery/background (spawn-delivery outbox
                                  (fn (wakeups replies)
                                    (let (moved-executor shared
                                          moved-settings owned-settings)
                                      (delivered-in-own-app (ref moved-settings)
                                                            wakeups
                                                            replies
                                                            (ref moved-executor))))))))

(defn delivered-in-own-app (chosen wakeups outbox executor)
  (let (log (chosen-log (ref chosen)))
    (match (gmail-app chosen
                      (share-log (ref log))
                      (threaded-operations executor)
                      priority/interactive
                      delivery/deliver-later)
      ((ok app)
       (do
         (local delivering app)
         (log-info (ref log)
                   log-area/delivery
                   (str "delivering queued changes"))
         (kept-delivering! (mut delivering)
                           (ref (->retry-schedule :wakeups wakeups
                                                  :every (:delivery-retry-milliseconds
                                                           (:tuning chosen))))
                           (ref outbox))))
      ((err failure)
       (log-warn (ref log)
                 log-area/delivery
                 (str "queued changes wait for the next start: "
                      (error-message (ref failure))))))))

(defstruct retry-schedule
  :wakeups wake-inbox
  :every u64)

(type kept-delivering!
  (fn ((mut mail-app)
       (ref retry-schedule)
       (ref reply-outbox))
    unit))

(defn kept-delivering! (app schedule outbox)
  (let (delivered (delivered-all! app outbox (vec)))
    (log-batch-delivered! (ref (:log app))
                          (ref delivered)))
  (when (woken? (ref (:wakeups schedule))
                (:every schedule))
    (recur app schedule outbox)))
