(use adapters/driving/webview/theme/theme-css theme-css)

(use composition/file-text ->loaded-file file-text
                           loaded-file)

(use composition/settings settings)

(export theme-startup)

(defn theme-startup (chosen)
  (match (file-text (ref (:theme-path chosen)))
    ((some text) (theme->loaded-file (as-str text)))
    (none (->loaded-file :text (str "") :warnings (vec)))))

(defn theme->loaded-file (text)
  (let (themed (theme-css text))
    (->loaded-file :text (clone (:css themed))
                   :warnings (clone (:warnings themed)))))
