(use adapters/driving/webview/theme/theme-css theme-css)
(use composition/file-text file-text)
(use composition/settings settings)

(export theme-stylesheet)

(defn theme-stylesheet (chosen)
  (match (file-text (ref (:theme-path chosen)))
    ((some text)
     (let (themed (theme-css (ref text)))
       (for-each (iter (:warnings themed))
         (fn (warning) (eprintln warning)))
       (clone (:css themed))))
    (none (str ""))))
