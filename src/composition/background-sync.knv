(use domain/log-entry log-area)

(use adapters/driving/json/core-event core-event
                                      core-event->json-text)

(use adapters/driving/webview/sync-requests sync-event)

(use adapters/driving/webview/window reply-outbox
                                     send-reply)

(use app/mail-app mail-app)
(use adapters/driven/threaded-queue threaded-operations)
(use composition/gmail-backend gmail-app)
(use app/mail-app delivery)
(use domain/operation priority)
(use composition/logging chosen-log)
(use domain/mail-error error-kind error-message mail-error)

(use ports/driven/event-log event-log log-info log-warn
                            share-log)

(use composition/worker-wiring share-wiring worker-wiring)
(use app/client/mail-syncer preview-account! sync-account!)
(use app/sync/syncing preview-outcome)
(use ports/driven/clock clock now-milliseconds)

(export start-background-sync!)

(defstruct sync-run
  :account string
  :started int)

(type start-background-sync!
  (fn ((ref worker-wiring)
       (ref str)
       (ref reply-outbox))
    unit))

(defn start-background-sync! (wiring account outbox)
  (let (owned-account (str account)
        owned-wiring (share-wiring wiring))
    (run-in-background outbox
      (fn (progress)
        (let (moved-account owned-account
              moved-wiring owned-wiring)
          (synced-in-own-app (ref moved-wiring)
                             (ref moved-account)
                             progress))))))

(def run-in-background
  (rust "{{ let {!outbox} = {0}.clone(); let {!job} = {1}; std::thread::spawn(move || {{ let {!last} = {!job}(&{!outbox}); drop({!outbox}.send_event({!last})); }}); }}"
    (fn ((ref reply-outbox)
         (fn-once ((ref reply-outbox)) string))
      unit)))

(type synced-in-own-app
  (fn ((ref worker-wiring)
       (ref string)
       (ref reply-outbox))
    string))

(defn synced-in-own-app (wiring account progress)
  (let (chosen (ref (:settings wiring))
        log (chosen-log chosen)
        run (->sync-run :account (clone account)
                        :started (now-milliseconds (ref clock/system)))
        outcome (match (gmail-app chosen
                                  (share-log (ref log))
                                  (threaded-operations (ref (:executor wiring)))
                                  priority/background
                                  delivery/deliver-later)
                  ((ok app)
                   (do
                     (local syncing app)
                     (previewed-then-synced! (mut syncing) (ref run) progress)))
                  ((err failure) (err failure))))
    (log-outcome (ref log)
                 (ref run)
                 (ref outcome))
    (sync-event outcome (as-str account))))

(type previewed-then-synced!
  (fn ((mut mail-app)
       (ref sync-run)
       (ref reply-outbox))
    (result unit mail-error)))

(defn previewed-then-synced! (app run progress)
  (let (account (as-str (:account run)))
    (log-info (ref (:log app))
              log-area/sync
              (str account ": background sync started"))
    (when (previewed? (preview-account! app account))
      (send-reply progress
                  (core-event->json-text (ref (core-event/sync-progress (str account)))))
      (log-info (ref (:log app))
                log-area/sync
                (str account ": preview shown after "
                     (- (now-milliseconds (ref clock/system))
                        (:started run))
                     "ms")))
    (sync-account! app account)))

(type log-outcome
  (fn ((ref event-log)
       (ref sync-run)
       (ref (result unit mail-error)))
    unit))

(defn log-outcome (log run outcome)
  (let (account (as-str (:account run))
        elapsed (- (now-milliseconds (ref clock/system))
                   (:started run)))
    (match outcome
      ((ok _)
       (log-info log log-area/sync
                 (str account ": sync finished after " elapsed "ms")))
      ((err failure)
       (log-warn log log-area/sync
                 (str account ": sync failed after " elapsed
                      "ms: "
                      (error-kind failure)
                      ": "
                      (error-message failure)))))))

(defn previewed? (outcome)
  (match outcome
    ((ok previewed) true)
    (_ false)))
