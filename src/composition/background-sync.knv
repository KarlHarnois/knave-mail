(use adapters/driving/json/envelope sync-progress-event)
(use adapters/driving/webview/sync-requests sync-event)

(use adapters/driving/webview/sync-runner run-in-background
                                          sync-runner)

(use adapters/driving/webview/window reply-outbox
                                     send-reply)

(use app/mail-app mail-app)

(use adapters/driven/threaded-queue share-sender
                                    submission-sender
                                    threaded-operations)

(use composition/gmail-backend gmail-app)
(use app/mail-app delivery)
(use domain/operation priority)
(use composition/logging chosen-log)
(use domain/mail-error error-kind error-message mail-error)

(use ports/driven/event-log event-log log-info log-warn
                            share-log)

(use composition/settings settings-from)
(use app/client/mail-syncer preview-account! sync-account!)
(use adapters/clock clock-milliseconds)

(export ->background-sync background-sync)

(defstruct background-sync
  :executor submission-sender)

(impl sync-runner background-sync
  (start-sync! (runner account outbox)
    (let (owned-account (str account)
          executor (share-sender (ref (:executor runner))))
      (run-in-background outbox
        (fn (progress)
          (let (moved-account owned-account
                moved-executor executor)
            (synced-in-own-app (ref moved-account)
                               progress
                               (ref moved-executor)))))
      true)))

(defn synced-in-own-app (account progress executor)
  (let (chosen (settings-from (ref (command-line-args)))
        log (chosen-log (ref chosen))
        started (clock-milliseconds)
        outcome (match (gmail-app (ref chosen)
                                  (share-log (ref log))
                                  (threaded-operations executor)
                                  priority/background
                                  delivery/deliver-later)
                  ((ok app)
                   (do
                     (local syncing app)
                     (previewed-then-synced! (mut syncing)
                                             account
                                             progress
                                             (ref log)
                                             started)))
                  ((err failure) (err failure))))
    (log-outcome (ref log) account (ref outcome) started)
    (sync-event outcome account)))

(defn previewed-then-synced! (app account progress log started)
  (log-info log "sync"
            (str account ": background sync started"))
  (when (previewed? (preview-account! app account))
    (send-reply progress (sync-progress-event account))
    (log-info log "sync"
              (str account ": preview shown after "
                   (- (clock-milliseconds) started)
                   "ms")))
  (sync-account! app account))

(defn log-outcome (log account outcome started)
  (let (elapsed (- (clock-milliseconds) started))
    (match outcome
      ((ok _)
       (log-info log "sync"
                 (str account ": sync finished after " elapsed "ms")))
      ((err failure)
       (log-warn log "sync"
                 (str account ": sync failed after " elapsed
                      "ms: "
                      (error-kind failure)
                      ": "
                      (error-message failure)))))))

(defn previewed? (outcome)
  (match outcome
    ((ok true) true)
    (_ false)))
