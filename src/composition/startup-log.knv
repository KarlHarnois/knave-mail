(use composition/settings backend settings)
(use ports/driven/event-log event-log log-info)
(use adapters/clock clock-milliseconds)

(export clock-milliseconds log-started trimmed)

(defn log-started (log chosen mode)
  (log-info log "app"
            (str "knave-mail "
                 (app-version)
                 " started: " mode ", backend "
                 (backend-name (:backend chosen))
                 ", cache "
                 (:cache-path chosen))))

(defn backend-name (chosen)
  (match chosen (gmail "gmail") (memory "memory")))

(defn trimmed (text)
  (str (trim (as-str text))))

(def app-version
  (rust "env!(\"CARGO_PKG_VERSION\").to_string()"
    (fn () string)))
