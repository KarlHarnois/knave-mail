(use composition/settings settings)
(use ports/driven/event-log event-log log-info)
(use adapters/clock clock-milliseconds)

(export clock-milliseconds log-started trimmed)

(type log-started
  (fn ((ref (box event-log))
       (ref settings)
       (ref str))
    unit))

(defn log-started (log chosen mode)
  (log-info log "app"
            (str "knave-mail "
                 (app-version)
                 " started: " mode ", backend "
                 (:backend chosen)
                 ", cache "
                 (:cache-path chosen))))

(type trimmed (fn (string) string))

(defn trimmed (text)
  (str (trim (as-str text))))

(def app-version
  (rust "env!(\"CARGO_PKG_VERSION\").to_string()"
    (fn () string)))
