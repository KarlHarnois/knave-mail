(use domain/log-entry log-area)

(use adapters/driving/cli/arguments parsed-arguments
                                    positional)

(use adapters/driving/cli/cli run-cli!)
(use adapters/driving/cli/command cli-command command-from)
(use adapters/driving/cli/exit-codes exit-code success-code)
(use adapters/driving/cli/help usage-text)

(use composition/gmail-backend chosen-client gmail-app
                               gmail-operations)

(use app/mail-app delivery)
(use domain/operation priority)
(use composition/memory-backend memory-app)
(use composition/logging chosen-log)
(use composition/backend backend)
(use composition/settings settings)
(use composition/startup-log log-started trimmed)
(use domain/mail-error error-message mail-error)
(use ports/driven/clock clock now-milliseconds)
(use ports/driven/event-log event-log log-info share-log)

(export chosen-app launch-cli)

(type launch-cli (fn (settings parsed-arguments) i32))

(defn launch-cli (chosen parsed)
  (if (help-asked? (ref parsed))
    (do (println (usage-text)) success-code)
    (run-cli-with-app chosen parsed)))

(defn help-asked? (parsed)
  (match (command-from parsed)
    ((ok help) true)
    (_ false)))

(defn run-cli-with-app (chosen parsed)
  (let (log (chosen-log (ref chosen))
        command (trimmed (str (unwrap-or (positional (ref parsed) 0)
                                         (str ""))
                              " "
                              (unwrap-or (positional (ref parsed) 1)
                                         (str ""))))
        started (now-milliseconds (ref clock/system)))
    (log-started (ref log)
                 (ref chosen)
                 (ref (str "cli " command)))
    (match (chosen-app (ref chosen)
                       (share-log (ref log)))
      ((ok app)
       (do
         (local running app)
         (let (code (run-cli! (mut running) (ref parsed)))
           (log-info (ref log)
                     log-area/app
                     (str "cli " command " exited with "
                          code " after "
                          (- (now-milliseconds (ref clock/system)) started)
                          "ms"))
           code)))
      ((err failure) (reported-failure (ref failure))))))

(defn chosen-app (chosen log)
  (match (:backend chosen)
    (memory (ok (memory-app chosen log)))
    (gmail (let-try (client (chosen-client chosen))
             (let (operations (gmail-operations chosen (ref client) (ref log)))
               (gmail-app chosen log operations
                          priority/interactive
                          delivery/deliver-now))))))

(defn reported-failure (failure)
  (eprintln (str "knave-mail: " (error-message failure)))
  (exit-code failure))
