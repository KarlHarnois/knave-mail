(use adapters/driving/cli/arguments parsed-arguments
                                    positional)

(use adapters/driving/cli/cli run-cli!)
(use adapters/driving/cli/command cli-command command-from)
(use adapters/driving/cli/exit-codes exit-code)
(use adapters/driving/cli/help usage-text)
(use adapters/driving/webview/session serve-requests!)
(use adapters/driving/webview/sync-runner ->inline-sync)
(use adapters/driving/webview/window open-window)
(use app/client)
(use app/mail-app mail-app)
(use adapters/driving/webview/relabel-runner ->inline-relabel)
(use composition/background-relabel start-background-relabel)
(use composition/background-sync ->background-sync)
(use composition/gmail-backend gmail-app)
(use composition/memory-backend memory-app)
(use composition/keymap-loader keymap-startup-script)
(use composition/logging chosen-log)

(use composition/startup-log clock-milliseconds log-started
                             trimmed)

(use composition/settings settings)
(use composition/theme-file theme-stylesheet)
(use domain/mail-error error-message mail-error)
(use ports/driven/event-log event-log log-info share-log)

(export launch-cli launch-window)

(def memory-backend "memory")

(type launch-cli (fn (settings parsed-arguments) unit))

(defn launch-cli (chosen parsed)
  (if (help-asked? (ref parsed))
    (println (usage-text))
    (run-cli-with-app chosen parsed)))

(type help-asked?
  (fn ((ref parsed-arguments)) bool))

(defn help-asked? (parsed)
  (match (command-from parsed)
    ((ok help) true)
    (_ false)))

(type run-cli-with-app
  (fn (settings parsed-arguments) unit))

(defn run-cli-with-app (chosen parsed)
  (let (log (chosen-log (ref chosen))
        command (trimmed (str (unwrap-or (positional (ref parsed) 0)
                                         (str ""))
                              " "
                              (unwrap-or (positional (ref parsed) 1)
                                         (str ""))))
        started (clock-milliseconds))
    (log-started (ref log)
                 (ref chosen)
                 (ref (str "cli " command)))
    (match (chosen-app (ref chosen)
                       (share-log (ref log)))
      ((ok app)
       (do
         (local running app)
         (let (code (run-cli! (mut running) (ref parsed)))
           (log-info (ref log)
                     "app"
                     (str "cli " command " exited with "
                          code " after "
                          (- (clock-milliseconds) started)
                          "ms"))
           (exit-with code))))
      ((err failure) (fail-with (ref failure))))))

(type launch-window (fn (settings) unit))

(defn launch-window (chosen)
  (let (script (str (keymap-startup-script (ref chosen))
                    (:e2e-script chosen))
        stylesheet (theme-stylesheet (ref chosen)))
    (open-window "knave-mail" (ref script) (ref stylesheet)
      (fn (inbox outbox)
        (let (owned chosen
              log (chosen-log (ref owned)))
          (log-started (ref log) (ref owned) "window")
          (match (chosen-app (ref owned)
                             (share-log (ref log)))
            ((ok app)
             (do
               (local running app)
               (if (= (:backend owned) memory-backend)
                 (do
                   (local runner (->inline-sync 0))
                   (local relabeler (->inline-relabel 0))
                   (serve-requests! (mut running)
                                    (mut runner)
                                    (mut relabeler)
                                    (ref log)
                                    (ref inbox)
                                    (ref outbox)))
                 (do
                   (local runner (->background-sync 0))
                   (local relabeler (start-background-relabel (ref outbox)))
                   (serve-requests! (mut running)
                                    (mut runner)
                                    (mut relabeler)
                                    (ref log)
                                    (ref inbox)
                                    (ref outbox))))))
            ((err failure) (fail-with (ref failure)))))))))

(type chosen-app
  (fn ((ref settings) (box event-log))
    (result mail-app mail-error)))

(defn chosen-app (chosen log)
  (if (= (:backend chosen) memory-backend)
    (ok (memory-app chosen log))
    (gmail-app chosen log)))

(type fail-with
  (fn ((ref mail-error)) unit))

(defn fail-with (failure)
  (eprintln (str "knave-mail: " (error-message failure)))
  (exit-with (exit-code failure)))

(def exit-with
  (rust "std::process::exit({0})" (fn (i32) unit)))
