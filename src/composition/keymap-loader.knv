(use adapters/driving/webview/keymap/keymap-file keymap-file)
(use adapters/driving/webview/keymap/keymap-script keymap-script)

(use composition/file-text ->loaded-file file-text
                           loaded-file)

(use composition/settings settings)

(export keymap-startup)

(defn keymap-startup (chosen)
  (match (file-text (ref (:keymap-path chosen)))
    ((some text) (keymap->loaded-file (as-str text)))
    (none (->loaded-file :text (str "") :warnings (vec)))))

(defn keymap->loaded-file (text)
  (let (mapped (keymap-file text))
    (->loaded-file :text (keymap-script (ref (:entries mapped)))
                   :warnings (clone (:warnings mapped)))))
