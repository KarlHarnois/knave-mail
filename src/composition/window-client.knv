(use adapters/driving/json/commands answer!)
(use adapters/driving/webview/window-client window-client)
(use app/mail-app mail-app)
(use app/client/mail-labeler)
(use domain/results unwrap-ok-or)
(use ports/driving/mail-labeler waiting-changes)
(use ports/driving/mail-syncer sync-account!)

(impl window-client mail-app
  (answer-request! (app request-text)
    (answer! app request-text))

  (sync-mail! (app account) (sync-account! app account))

  (waiting-changes-of (app account)
    (unwrap-ok-or (waiting-changes app account) 0)))
