(use app/client/mail-syncer)
(use adapters/driven/memory/authorizer ->memory-authorizer)
(use adapters/driven/memory/provider ->memory-provider)

(use adapters/driven/memory/remote-mail ->remote-mail
                                        remote-mail)

(use adapters/driven/memory/seed seed-accounts
                                 seeded-threads)

(use adapters/driven/memory/shared share shared)
(use adapters/driven/memory/store)

(use adapters/driven/memory/memory-store empty-memory-store
                                         memory-store)

(use adapters/driven/system-clock ->system-clock)
(use app/mail-app mail-app new-mail-app)
(use app/operations/inline-queue new-inline-queue)
(use app/mail-app delivery)
(use domain/operation priority)
(use ports/driven/event-log event-log share-log)
(use ports/driven/operation-queue operation-queue)
(use composition/settings settings)
(use domain/mail ->account)
(use ports/driven/store save-account!)
(use ports/driving/mail-syncer sync-account!)

(export memory-app)

(def first-account-thread-count 200)

(def other-account-thread-count 40)

(def sync-limit 500)

(defn memory-app (chosen log)
  (let (provider (->memory-provider (account-emails) (seeded-remotes chosen))
        operations (new-inline-queue (box provider)
                                     (box (->system-clock))
                                     (share-log (ref log))
                                     (some 0))
        app (new-mail-app (box (store-with-accounts))
                          (the (box operation-queue) (box operations))
                          (box (->memory-authorizer (vec)))
                          log priority/interactive
                          delivery/deliver-now sync-limit))
    (sync-every-account! (mut app))
    app))

(defn sync-every-account! (app)
  (for-each (iter seed-accounts)
    (fn (account)
      (when (err? (sync-account! app account))
        (eprintln (str "could not sync " account))))))

(defn store-with-accounts ()
  (let (store (empty-memory-store))
    (for-each (iter seed-accounts)
      (fn (email)
        (expect-ok (save-account! (mut store)
                                  (ref (->account (str email))))
                   "the memory store keeps every account")))
    store))

(defn account-emails ()
  (-> (iter seed-accounts)
      (map (fn (email) (str email)))
      collect))

(defn seeded-remotes (chosen)
  (-> (iter seed-accounts)
      enumerate
      (map (fn (numbered)
             (let-match ((pair position email) numbered)
               (seeded-remote chosen email position))))
      collect))

(type seeded-remote
  (fn ((ref settings) (ref str) usize)
    (shared remote-mail)))

(defn seeded-remote (chosen email position)
  (share (->remote-mail :threads (seeded-threads email (thread-count position))
                        :sent (vec)
                        :latency-milliseconds (:latency-milliseconds chosen)
                        :failing (clone (:failing chosen))
                        :failures-left none
                        :throttle-delay none
                        :next-id 1
                        :history-id 1
                        :history-floor 0
                        :changes (vec))))

(defn thread-count (position)
  (if (= position 0)
    first-account-thread-count other-account-thread-count))
