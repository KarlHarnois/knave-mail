(use adapters/driven/threaded-queue submission)
(use app/mailboxes ->mailboxes)

(use app/operations/runner ->operation-runner attempt-once!
                           new-operation! operation-runner)

(use composition/gmail-backend gmail-provider-for)
(use composition/logging chosen-log)
(use composition/settings google-client settings)
(use domain/attempt-outcome attempt-outcome)
(use domain/mail-error mail-error)
(use domain/operation operation-result)
(use domain/collections appended)

(use composition/executor-channel answered-and-dropped
                                  next-arrival removed-at
                                  replaced-at spawn-executor
                                  submission-inbox)

(use domain/operation-schedule ->scheduled next-ready
                               scheduled wait-until-due)

(use ports/driven/clock clock now-milliseconds)
(use ports/driven/event-log share-log)

(export start-gmail-executor)

(defn start-gmail-executor (chosen client)
  (spawn-executor (fn (inbox) (run-gmail-executor chosen client inbox))))

(type run-gmail-executor
  (fn (settings google-client submission-inbox) unit))

(defn run-gmail-executor (chosen client inbox)
  (let (log (chosen-log (ref chosen))
        runner (->operation-runner :mailboxes (->mailboxes (gmail-provider-for
                                                             (ref chosen)
                                                             (ref client)
                                                             (ref log))
                                                           (vec))
                                   :clock clock/system
                                   :log (share-log (ref log))))
    (local running runner)
    (executed! (mut running)
               (ref inbox)
               (->executor-state :waiting (vec) :replies (vec)))))

(defstruct executor-state
  :waiting (vec scheduled)
  :replies (vec (pair int submission)))

(type executed!
  (fn ((mut operation-runner)
       (ref submission-inbox)
       executor-state)
    unit))

(defn executed! (runner inbox state)
  (let (arrived (with-arrivals! runner inbox state))
    (match (executor-step! runner inbox arrived)
      ((some next) (recur runner inbox next))
      (none (do)))))

(type executor-step!
  (fn ((mut operation-runner)
       (ref submission-inbox)
       executor-state)
    (option executor-state)))

(defn executor-step! (runner inbox state)
  (match (next-ready (ref (:waiting state))
                     (now-milliseconds (ref (:clock runner))))
    ((some index) (some (attempted! runner state index)))
    (none (after-waiting! runner inbox state))))

(type after-waiting!
  (fn ((mut operation-runner)
       (ref submission-inbox)
       executor-state)
    (option executor-state)))

(defn after-waiting! (runner inbox state)
  (let (now (now-milliseconds (ref (:clock runner))))
    (match (next-arrival inbox
                         (wait-until-due (ref (:waiting state)) now))
      ((some (some arrival))
       (some (admitted! runner arrival state)))
      ((some none) (some state))
      (none none))))

(type with-arrivals!
  (fn ((mut operation-runner)
       (ref submission-inbox)
       executor-state)
    executor-state))

(defn with-arrivals! (runner inbox state)
  (match (next-arrival inbox (some 0))
    ((some (some arrival))
     (recur runner inbox (admitted! runner arrival state)))
    (_ state)))

(type admitted!
  (fn ((mut operation-runner) submission executor-state)
    executor-state))

(defn admitted! (runner arrival state)
  (let (queued (new-operation! runner (clone (:request arrival)))
        id (:id queued))
    (let-match ((pair waiting replies) (state-parts state))
      (->executor-state :waiting (appended waiting
                                           (->scheduled :operation queued
                                                        :attempt 1
                                                        :not-before 0))
                        :replies (appended replies (pair id arrival))))))

(type attempted!
  (fn ((mut operation-runner) executor-state usize)
    executor-state))

(defn attempted! (runner state index)
  (let (entry (clone (at (:waiting state) index)))
    (match (attempt-once! runner (ref entry))
      ((finished outcome) (answered state index (ok outcome)))
      ((failed failure) (answered state index (err failure)))
      ((retry plan)
       (let (retried (assoc entry
                            :attempt (inc (:attempt entry))
                            :not-before (+ (now-milliseconds (ref (:clock
                                                                    runner)))
                                           (:delay plan))))
         (let-match ((pair waiting replies) (state-parts state))
           (->executor-state :waiting (replaced-at waiting index retried)
                             :replies replies)))))))

(type answered
  (fn (executor-state usize (result operation-result mail-error))
    executor-state))

(defn answered (state index outcome)
  (let (id (:id (:operation (at (:waiting state) index))))
    (let-match ((pair waiting replies) (state-parts state))
      (->executor-state :waiting (removed-at waiting index)
                        :replies (answered-and-dropped replies id outcome)))))

(def state-parts
  (rust "({0}.waiting, {0}.replies)"
    (fn (executor-state)
      (pair (vec scheduled)
            (vec (pair int submission))))))
