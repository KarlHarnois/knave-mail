(use domain/log-entry log-area)

(use adapters/driving/webview/listing-runner call-inbox
                                             listing-queue
                                             listing-runner
                                             reply-sink)

(use adapters/driving/webview/logged-answers answer-listings!
                                             refuse-listings!)

(use adapters/driving/webview/window reply-outbox
                                     request-inbox)

(use adapters/driven/threaded-queue share-sender
                                    threaded-operations)

(use composition/gmail-backend gmail-app)
(use app/mail-app delivery)
(use domain/operation priority)
(use composition/logging chosen-log)
(use composition/settings settings)
(use domain/mail-error error-message)
(use ports/driven/event-log log-warn share-log)

(export start-background-listing)

(defn start-background-listing (outbox executor chosen)
  (let (shared (share-sender executor)
        owned-settings (clone chosen))
    (listing-runner/background (spawn-worker outbox
                                 (fn (inbox replies)
                                   (let (moved-executor shared
                                         moved-settings owned-settings)
                                     (list-in-own-app
                                       (ref moved-settings)
                                       inbox replies
                                       (ref moved-executor))))))))

(defn list-in-own-app (chosen inbox outbox executor)
  (let (log (chosen-log (ref chosen)))
    (match (gmail-app chosen
                      (share-log (ref log))
                      (threaded-operations executor)
                      priority/interactive
                      delivery/deliver-later)
      ((ok app)
       (do
         (local running app)
         (answer-listings! (mut running)
                           (ref log)
                           (ref inbox)
                           (ref (reply-sink/outbox outbox)))))
      ((err failure)
       (log-warn (ref log)
                 log-area/window
                 (str "the listing worker could not start, so it refuses Gmail listings: "
                      (error-message (ref failure))))
       (refuse-listings! (ref failure)
                         (ref inbox)
                         (ref (reply-sink/outbox outbox)))))))

(def spawn-worker
  (rust "{{ let ({!queue}, {!inbox}) = std::sync::mpsc::channel::<crate::adapters::driving::json::mail_command::MailCall>(); let {!outbox} = {0}.clone(); let {!job} = {1}; std::thread::spawn(move || {!job}({!inbox}, {!outbox})); {!queue} }}"
    (fn ((ref reply-outbox)
         (fn-once (call-inbox reply-outbox) unit))
      listing-queue)))
