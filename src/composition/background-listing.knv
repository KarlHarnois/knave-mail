(use adapters/driving/webview/listing-runner ->outbox-sink
                                             listing-runner)

(use adapters/driving/webview/logged-answers answer-listings!
                                             refuse-listings!)

(use adapters/driving/webview/window reply-outbox
                                     request-inbox)

(use adapters/driven/threaded-queue share-sender
                                    threaded-operations)

(use composition/gmail-backend gmail-app)
(use app/mail-app delivery)
(use domain/operation priority)
(use composition/logging chosen-log)
(use composition/settings settings-from)
(use domain/mail-error error-message)
(use ports/driven/event-log log-warn share-log)

(export background-listing start-background-listing)

(deftype listing-queue
  (rust "std::sync::mpsc::Sender<String>"))

(defstruct background-listing
  :queue listing-queue)

(impl listing-runner background-listing
  (hand-off! (runner request-text)
    (enqueue! (ref (:queue runner)) request-text)))

(defn start-background-listing (outbox executor)
  (let (shared (share-sender executor))
    (->background-listing
      (spawn-worker outbox
        (fn (inbox replies)
          (let (moved-executor shared)
            (list-in-own-app inbox replies (ref moved-executor))))))))

(defn list-in-own-app (inbox outbox executor)
  (let (chosen (settings-from (ref (command-line-args)))
        log (chosen-log (ref chosen)))
    (match (gmail-app (ref chosen)
                      (share-log (ref log))
                      (threaded-operations executor)
                      priority/interactive
                      delivery/deliver-later)
      ((ok app)
       (do
         (local running app)
         (answer-listings! (mut running)
                           (ref log)
                           (ref inbox)
                           (ref (->outbox-sink outbox)))))
      ((err failure)
       (log-warn (ref log)
                 "window"
                 (str "the listing worker could not start, so it refuses Gmail listings: "
                      (error-message (ref failure))))
       (refuse-listings! (ref failure)
                         (ref inbox)
                         (ref (->outbox-sink outbox)))))))

(def spawn-worker
  (rust "{{ let ({!queue}, {!inbox}) = std::sync::mpsc::channel::<String>(); let {!outbox} = {0}.clone(); let {!job} = {1}; std::thread::spawn(move || {!job}({!inbox}, {!outbox})); {!queue} }}"
    (fn ((ref reply-outbox)
         (fn-once (request-inbox reply-outbox) unit))
      listing-queue)))

(def enqueue!
  (rust "{0}.send({1}.to_string()).is_ok()"
    (fn ((ref listing-queue) (ref str))
      bool)))
