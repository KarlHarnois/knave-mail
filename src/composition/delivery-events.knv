(use adapters/driving/json/core-event core-event
                                      core-event->json-text)

(use adapters/driving/webview/window reply-outbox
                                     send-reply)

(use domain/mail-error error-kind error-message)
(use domain/queued-relabel refusal)

(export report-refusal!)

(type report-refusal!
  (fn ((ref reply-outbox) (ref refusal))
    unit))

(defn report-refusal! (outbox refused)
  (send-reply outbox
              (core-event->json-text
                (ref (core-event/relabel-refused
                       :account (clone (:account (:queued refused)))
                       :thread-id (clone (:thread-id (:queued refused)))
                       :failure (clone (:failure refused)))))))
