(use app/mail-app mail-app)

(use app/reading find-threads! listed-page! listed-threads!
                 read-thread!)

(use ports/driven/store load-labels)
(use ports/driving/mail-reader mail-reader)

(impl mail-reader mail-app
  (list-labels! (app account)
                (load-labels (ref (:store app)) account))
  (list-threads! (app account query)
                 (find-threads! app account query))
  (list-fresh-threads! (app account query)
                       (listed-threads! app account query))
  (list-thread-page! (app account query page-token)
                     (listed-page! app account query page-token))
  (open-thread! (app account thread-id)
                (read-thread! app account thread-id)))
