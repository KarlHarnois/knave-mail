(use domain/freshness freshness)
(use app/mail-app mail-app)
(use app/listing listed-page! listed-threads!)
(use app/reading find-threads! read-thread!)

(use domain/mail label summary-page thread thread-query
                 thread-ref thread-summary)

(use domain/mail-error mail-error)
(use ports/driven/store load-labels)

(export list-labels! list-thread-page! list-threads!
        open-thread!)

(type list-labels!
  (fn ((mut mail-app) (ref str))
    (result (vec label) mail-error)))

(defn list-labels! (app account)
  (load-labels (ref (:store app)) account))

(type list-threads!
  (fn ((mut mail-app)
       (ref str)
       (ref thread-query)
       freshness)
    (result (vec thread-summary) mail-error)))

(defn list-threads! (app account query from)
  (match from
    (cached (find-threads! app account query))
    (fresh (listed-threads! app account query))))

(type list-thread-page!
  (fn ((mut mail-app)
       (ref str)
       (ref thread-query)
       (ref (option string)))
    (result summary-page mail-error)))

(defn list-thread-page! (app account query page-token)
  (listed-page! app account query page-token))

(type open-thread!
  (fn ((mut mail-app) (ref thread-ref))
    (result thread mail-error)))

(defn open-thread! (app opened)
  (read-thread! app
                (ref (:account opened))
                (ref (:thread-id opened))))
