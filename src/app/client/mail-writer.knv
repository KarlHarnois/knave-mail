(use app/mail-app mail-app)
(use app/writing compose-draft send!)
(use domain/mail draft message-ref)
(use domain/mail-error mail-error)
(use domain/reply draft-kind)

(export draft! send-draft!)

(type draft!
  (fn ((mut mail-app) (ref message-ref) draft-kind)
    (result draft mail-error)))

(defn draft! (app message kind)
  (compose-draft app message kind))

(type send-draft!
  (fn ((mut mail-app) (ref str) (ref draft))
    (result unit mail-error)))

(defn send-draft! (app account written)
  (send! app account written))
