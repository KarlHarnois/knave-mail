(use app/mail-app mail-app)

(use app/writing compose-forward compose-reply
                 compose-reply-all send!)

(use ports/driving/mail-writer mail-writer)

(impl mail-writer mail-app
  (draft-reply! (app account message-id)
                (compose-reply app account message-id))
  (draft-reply-all! (app account message-id)
                    (compose-reply-all app account message-id))
  (draft-forward! (app account message-id)
                  (compose-forward app account message-id))
  (send-draft! (app account written)
               (send! app account written)))
