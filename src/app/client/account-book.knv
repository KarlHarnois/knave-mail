(use app/mail-app mail-app)
(use domain/mail account)
(use domain/mail-error mail-error)
(use ports/driven/authorizer authorize!)

(use ports/driven/store forget-account! load-accounts
                        save-account!)

(export add-account! list-accounts! remove-account!)

(type list-accounts!
  (fn ((mut mail-app))
    (result (vec account) mail-error)))

(defn list-accounts! (app)
  (load-accounts (ref (:store app))))

(type add-account!
  (fn ((mut mail-app))
    (result account mail-error)))

(defn add-account! (app)
  (let (authorized (try (authorize! (mut (:authorizer app)))))
    (try (save-account! (mut (:store app))
                        (ref authorized)))
    (ok authorized)))

(type remove-account!
  (fn ((mut mail-app) (ref str))
    (result unit mail-error)))

(defn remove-account! (app account)
  (forget-account! (mut (:store app)) account))
