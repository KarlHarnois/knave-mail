(use app/mail-app mail-app)
(use app/sync/syncing preview-sync! sync!)
(use domain/mail-error mail-error)

(export preview-account! sync-account!)

(type sync-account!
  (fn ((mut mail-app) (ref str))
    (result unit mail-error)))

(defn sync-account! (app account) (sync! app account))

(type preview-account!
  (fn ((mut mail-app) (ref str))
    (result bool mail-error)))

(defn preview-account! (app account)
  (preview-sync! app account))
