(use app/archiving-older archived-older!)
(use app/delivering deliver-next!)
(use app/mail-app mail-app)
(use app/writing relabel-each!)
(use domain/labels label-change)
(use domain/mail-error mail-error)
(use domain/queued-relabel delivery-step relabel-request)
(use ports/driven/store queued-count)

(export archive-older! deliver-next-change! relabel-threads!
        waiting-changes)

(type relabel-threads!
  (fn ((mut mail-app) (ref relabel-request))
    (result unit mail-error)))

(defn relabel-threads! (app request)
  (relabel-each! app request))

(defn deliver-next-change! (app) (deliver-next! app))

(type archive-older!
  (fn ((mut mail-app) (ref str) (ref str))
    (result int mail-error)))

(defn archive-older! (app account before)
  (archived-older! app account before))

(defn waiting-changes (app account)
  (queued-count (ref (:store app)) account))
