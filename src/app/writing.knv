(use app/activity-log log-sent-but-uncached!)
(use app/operations/batch-log log-batch-queued!)
(use app/delivering deliver-everything-now!)
(use app/mail-app delivery mail-app)
(use domain/labels label-change)
(use domain/mail ->message-ref draft message)
(use domain/outgoing new-outgoing reply-outgoing)
(use domain/reply draft-for draft-kind)
(use app/caching cache-thread!)
(use domain/mail-error mail-error)
(use app/operations/calls delivered!)
(use ports/driven/store load-message queue-relabels!)

(export compose-draft relabel-each! send!)

(type compose-draft
  (fn ((ref mail-app)
       (ref str)
       (ref str)
       draft-kind)
    (result draft mail-error)))

(defn compose-draft (app account message-id kind)
  (ok (draft-for kind
                 (ref (try (stored-message app account message-id)))
                 account)))

(type send!
  (fn ((mut mail-app) (ref str) (ref draft))
    (result unit mail-error)))

(defn send! (app account written)
  (let (outgoing (match (ref (:reply-to written))
                   ((some message-id)
                    (reply-outgoing
                      written account
                      (ref (try (stored-message app account message-id)))))
                   (none (new-outgoing written account)))
        thread-id (try (delivered! app account (ref outgoing))))
    (remember-sent! app account (ref thread-id))
    (ok (do))))

(type remember-sent!
  (fn ((mut mail-app) (ref str) (ref str))
    unit))

(defn remember-sent! (app account thread-id)
  (match (cache-thread! app account thread-id)
    ((err failure)
     (log-sent-but-uncached! (ref (:log app))
                             account thread-id
                             (ref failure)))
    (_ (do))))

(type relabel-each!
  (fn ((mut mail-app)
       (ref str)
       (ref (vec string))
       (ref label-change))
    (result unit mail-error)))

(defn relabel-each! (app account thread-ids change)
  (try (queue-relabels! (mut (:store app))
                        account thread-ids change))
  (log-batch-queued! (ref (:log app))
                     account "relabel" change thread-ids)
  (match (:delivery app)
    (deliver-now (deliver-everything-now! app))
    (deliver-later (ok (do)))))

(type stored-message
  (fn ((ref mail-app) (ref str) (ref str))
    (result message mail-error)))

(defn stored-message (app account message-id)
  (ok-or (try (load-message (ref (:store app))
                            (ref (->message-ref :account (str account)
                                                :message-id (str message-id)))))
         (mail-error/not-found (str "no message " message-id " in " account))))
