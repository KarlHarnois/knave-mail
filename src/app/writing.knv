(use domain/queued-relabel relabel-request)
(use app/thread-log log-sent-but-uncached!)
(use app/operations/batch-log log-batch-queued!)
(use app/delivering deliver-everything-now!)
(use app/mail-app delivery mail-app)
(use domain/labels label-change)

(use domain/mail ->message-ref ->thread-ref draft message
                 thread-ref)

(use domain/outgoing draft->outgoing)
(use domain/reply draft-for draft-kind)
(use app/caching cache-thread!)
(use domain/mail-error mail-error)
(use app/operations/calls delivered!)
(use ports/driven/store load-message queue-relabels!)

(export compose-draft relabel-each! send!)

(type compose-draft
  (fn ((ref mail-app)
       (ref str)
       (ref str)
       draft-kind)
    (result draft mail-error)))

(defn compose-draft (app account message-id kind)
  (ok (draft-for kind
                 (ref (try (stored-message app account message-id)))
                 account)))

(type send!
  (fn ((mut mail-app) (ref str) (ref draft))
    (result unit mail-error)))

(defn send! (app account written)
  (let (original (try (replied-message app account (ref (:reply-to written))))
        outgoing (draft->outgoing written account original)
        thread-id (try (delivered! app account (ref outgoing))))
    (remember-sent! app
                    (ref (->thread-ref :account (str account)
                                       :thread-id thread-id)))
    (ok (do))))

(type replied-message
  (fn ((ref mail-app)
       (ref str)
       (ref (option string)))
    (result (option message) mail-error)))

(defn replied-message (app account reply-to)
  (match reply-to
    ((some message-id)
     (map-ok (stored-message app account message-id) some))
    (none (ok none))))

(type remember-sent!
  (fn ((mut mail-app) (ref thread-ref))
    unit))

(defn remember-sent! (app thread)
  (match (cache-thread! app thread)
    ((err failure)
     (log-sent-but-uncached! (ref (:log app))
                             thread
                             (ref failure)))
    (_ (do))))

(type relabel-each!
  (fn ((mut mail-app) (ref relabel-request))
    (result unit mail-error)))

(defn relabel-each! (app request)
  (try (queue-relabels! (mut (:store app)) request))
  (log-batch-queued! (ref (:log app)) request)
  (match (:delivery app)
    (deliver-now (deliver-everything-now! app))
    (deliver-later (ok (do)))))

(defn stored-message (app account message-id)
  (ok-or (try (load-message (ref (:store app))
                            (ref (->message-ref :account (str account)
                                                :message-id (str message-id)))))
         (mail-error/not-found (str "no message " message-id " in " account))))
