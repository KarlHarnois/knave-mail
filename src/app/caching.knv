(use domain/collections option->vec)
(use app/activity-log log-gmail-relabel! log-new-thread!)
(use app/mail-app mail-app)
(use domain/cache-news cache-news cached-news)
(use domain/mail-error mail-error)
(use domain/mail thread thread-summary)
(use domain/summary summarize)
(use app/operations/calls fetched-thread!)

(use ports/driven/store load-summaries-of save-thread!
                        save-threads!)

(export cache-thread! cached-thread!)

(type cache-thread!
  (fn ((mut mail-app) (ref str) (ref str))
    (result unit mail-error)))

(defn cache-thread! (app account thread-id)
  (map-ok (cached-thread! app account thread-id)
    (fn (_) (do))))

(type cached-thread!
  (fn ((mut mail-app) (ref str) (ref str))
    (result thread mail-error)))

(defn cached-thread! (app account thread-id)
  (let (cached (try (load-summaries-of (ref (:store app))
                                       account
                                       (ref (vec (str thread-id)))))
        fetched (try (fetched-thread! app account thread-id)))
    (log-news! app account thread-id
               (cached-news (ref cached)
                            (ref (:labels fetched))))
    (try (save-thread! (mut (:store app))
                       account
                       (ref fetched)))
    (try (save-threads! (mut (:store app))
                        account
                        (ref (option->vec (summarize (ref fetched))))))
    (ok fetched)))

(type log-news!
  (fn ((ref mail-app)
       (ref str)
       (ref str)
       cache-news)
    unit))

(defn log-news! (app account thread-id news)
  (match news
    ((new-thread labels)
     (log-new-thread! (ref (:log app))
                      account thread-id
                      (ref labels)))
    ((relabeled change)
     (log-gmail-relabel! (ref (:log app))
                         account thread-id
                         (ref change)))
    (unchanged (do))))
