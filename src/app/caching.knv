(use domain/collections option->vec)
(use app/thread-log log-gmail-relabel! log-new-thread!)
(use app/mail-app mail-app)
(use domain/cache-news cache-news cached-news)
(use domain/mail-error mail-error)
(use domain/mail thread thread-ref thread-summary)
(use domain/summary summarize)
(use app/operations/calls fetched-thread!)

(use ports/driven/store load-summaries-of save-thread!
                        save-threads!)

(export cache-thread! cached-thread!)

(type cache-thread!
  (fn ((mut mail-app) (ref thread-ref))
    (result unit mail-error)))

(defn cache-thread! (app thread)
  (map-ok (cached-thread! app thread)
    (fn (_) (do))))

(type cached-thread!
  (fn ((mut mail-app) (ref thread-ref))
    (result thread mail-error)))

(defn cached-thread! (app thread)
  (let (account (as-str (:account thread))
        cached (try (load-summaries-of (ref (:store app))
                                       account
                                       (ref (vec (clone (:thread-id thread))))))
        fetched (try (fetched-thread! app account
                                      (as-str (:thread-id thread)))))
    (log-news! app thread
               (cached-news (ref cached)
                            (ref (:labels fetched))))
    (try (save-thread! (mut (:store app))
                       account
                       (ref fetched)))
    (try (save-threads! (mut (:store app))
                        account
                        (ref (option->vec (summarize (ref fetched))))))
    (ok fetched)))

(type log-news!
  (fn ((ref mail-app) (ref thread-ref) cache-news)
    unit))

(defn log-news! (app thread news)
  (match news
    ((new-thread labels)
     (log-new-thread! (ref (:log app))
                      thread
                      (ref labels)))
    ((relabeled change)
     (log-gmail-relabel! (ref (:log app))
                         thread
                         (ref change)))
    (unchanged (do))))
