(use app/mail-app mail-app)
(use app/operations/batch-log log-archived-older!)
(use app/operations/calls fetched-message-page!)
(use app/operations/relabel-calls delivered-batch!)

(use domain/collections appended-once as-count concatenated
                        in-chunks try-for-each)

(use domain/delivery-batch most-batched-messages)
(use domain/label-scope label-scope)
(use domain/labels archive-change label-id system-label)

(use domain/mail ->message-page ->thread-query ->thread-ref
                 message-page thread-query)

(use domain/mail-error mail-error)
(use domain/operation ->message-batch)
(use ports/driven/store relabel-stored!)

(export archived-older!)

(def message-page-size 500)

(type archived-older!
  (fn ((mut mail-app) (ref str) (ref str))
    (result int mail-error)))

(defn archived-older! (app account before)
  (let (found (try (all-messages! app account
                                  (ref (older-inbox-query before))
                                  (str "")
                                  (->message-page :message-ids (vec)
                                                  :thread-ids (vec)
                                                  :next-token (str ""))))
        chunks (in-chunks (ref (:message-ids found)) most-batched-messages))
    (try (try-for-each (iter chunks)
           (fn (chunk)
             (delivered-batch! app account
                               (->message-batch :message-ids (clone chunk)
                                                :thread-ids (vec)
                                                :change (archive-change))))))
    (try (try-for-each (iter (:thread-ids found))
           (fn (thread-id)
             (archived-in-cache! app account (as-str thread-id)))))
    (log-archived-older! (ref (:log app))
                         account before
                         (len (:thread-ids found))
                         (len (:message-ids found))
                         (len chunks))
    (ok (as-count (len (:thread-ids found))))))

(defn older-inbox-query (before)
  (->thread-query (label-scope/only (label-id system-label/inbox))
                  (str "before:" before)
                  message-page-size))

(type all-messages!
  (fn ((mut mail-app)
       (ref str)
       (ref thread-query)
       string message-page)
    (result message-page mail-error)))

(defn all-messages! (app account query page-token found)
  (let (page (try (fetched-message-page! app account query
                                         (as-str page-token)))
        merged (merged-pages found (ref page)))
    (if (empty? (:next-token page))
      (ok merged)
      (recur app account query (clone (:next-token page)) merged))))

(type merged-pages
  (fn (message-page (ref message-page)) message-page))

(defn merged-pages (found page)
  (->message-page :message-ids (concatenated (clone (:message-ids found))
                                             (clone (:message-ids page)))
                  :thread-ids (reduce (iter (:thread-ids page))
                                      (clone (:thread-ids found))
                                      (fn (ids thread-id)
                                        (appended-once ids (clone thread-id))))
                  :next-token (str "")))

(type archived-in-cache!
  (fn ((mut mail-app) (ref str) (ref str))
    (result unit mail-error)))

(defn archived-in-cache! (app account thread-id)
  (relabel-stored! (mut (:store app))
                   (ref (->thread-ref :account (str account)
                                      :thread-id (str thread-id)))
                   (ref (archive-change))))
