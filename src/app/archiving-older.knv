(use app/mail-app mail-app)

(use app/operations/batch-log log-archived-older!
                              log-kept-in-inbox!)

(use app/gmail-pages all-messages! all-thread-ids!)
(use app/operations/relabel-calls delivered-batch!)
(use domain/collections as-count in-chunks try-for-each)
(use domain/delivery-batch most-batched-messages)
(use domain/label-scope label-scope)
(use domain/labels archive-change label-id system-label)
(use domain/mail ->message-page ->thread-query ->thread-ref)
(use domain/mail-error mail-error)
(use domain/operation ->message-batch)
(use ports/driven/store relabel-stored!)

(export archived-older!)

(def message-page-size 500)

(type archived-older!
  (fn ((mut mail-app) (ref str) (ref str))
    (result int mail-error)))

(defn archived-older! (app account before)
  (let (found (try (all-messages! app account
                                  (ref (inbox-query (str "before:" before)))
                                  (str "")
                                  (->message-page :message-ids (vec)
                                                  :thread-ids (vec)
                                                  :next-token (str ""))))
        requests (try (archived-in-gmail! app account
                                          (ref (:message-ids found))))
        inboxed (try (all-thread-ids! app account
                                      (ref (inbox-query (str "")))
                                      (str "")
                                      (vec)))
        kept (in-inbox (ref (:thread-ids found))
                       (ref inboxed))
        left (out-of-inbox (ref (:thread-ids found))
                           (ref inboxed)))
    (try (try-for-each (iter left)
           (fn (thread-id)
             (archived-in-cache! app account (as-str thread-id)))))
    (log-archived-older! (ref (:log app))
                         account before
                         (len (:thread-ids found))
                         (len (:message-ids found))
                         requests)
    (when (not (empty? kept))
      (log-kept-in-inbox! (ref (:log app))
                          account
                          (ref kept)))
    (ok (as-count (len left)))))

(defn inbox-query (search)
  (->thread-query (label-scope/only (label-id system-label/inbox))
                  search message-page-size))

(type archived-in-gmail!
  (fn ((mut mail-app)
       (ref str)
       (ref (vec string)))
    (result usize mail-error)))

(defn archived-in-gmail! (app account message-ids)
  (let (chunks (in-chunks message-ids most-batched-messages))
    (try (try-for-each (iter chunks)
           (fn (chunk)
             (delivered-batch! app account
                               (->message-batch :message-ids (clone chunk)
                                                :thread-ids (vec)
                                                :change (archive-change))))))
    (ok (len chunks))))

(type in-inbox
  (fn ((ref (vec string)) (ref (vec string)))
    (vec string)))

(defn in-inbox (thread-ids inboxed)
  (-> (iter thread-ids)
      (filter (fn (thread-id)
                (contains? inboxed (clone thread-id))))
      (map (fn (thread-id) (clone thread-id)))
      collect))

(type out-of-inbox
  (fn ((ref (vec string)) (ref (vec string)))
    (vec string)))

(defn out-of-inbox (thread-ids inboxed)
  (-> (iter thread-ids)
      (filter (fn (thread-id)
                (not (contains? inboxed (clone thread-id)))))
      (map (fn (thread-id) (clone thread-id)))
      collect))

(type archived-in-cache!
  (fn ((mut mail-app) (ref str) (ref str))
    (result unit mail-error)))

(defn archived-in-cache! (app account thread-id)
  (relabel-stored! (mut (:store app))
                   (ref (->thread-ref :account (str account)
                                      :thread-id (str thread-id)))
                   (ref (archive-change))))
