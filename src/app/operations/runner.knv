(use app/mailboxes mailboxes)
(use app/operations/performing performed!)

(use app/operations/operation-log log-failed! log-finished!
                                  log-gave-up! log-queued!
                                  log-started! log-waiting!)

(use domain/mail-error mail-error)

(use domain/operation ->operation operation operation-kind
                      priority)

(use domain/operation-policy operation-policy policy-for)

(use domain/attempt-outcome attempt-outcome
                            attempt-outcome-of)

(use domain/failure-step retryable?)
(use domain/operation-schedule scheduled)
(use ports/driven/clock clock now-milliseconds)
(use ports/driven/event-log event-log)

(export ->operation-runner attempt-once! new-operation!
        operation-runner)

(defstruct operation-runner
  :mailboxes mailboxes
  :clock clock
  :log event-log)

(type new-operation!
  (fn ((ref operation-runner) (ref str) operation-kind priority)
    operation))

(defn new-operation! (runner account kind rank)
  (let (queued (->operation :id (next-operation-id)
                            :account (str account)
                            :kind kind
                            :priority rank
                            :queued-at (now-milliseconds (ref (:clock
                                                                runner)))))
    (log-queued! (ref (:log runner))
                 (ref queued))
    queued))

(type attempt-once!
  (fn ((mut operation-runner) (ref scheduled))
    attempt-outcome))

(defn attempt-once! (runner entry)
  (let (queued (ref (:operation entry))
        attempt (:attempt entry)
        policy (policy-for (ref (:kind queued))
                           (:priority queued))
        started (now-milliseconds (ref (:clock runner))))
    (log-started! (ref (:log runner))
                  queued
                  (ref policy)
                  attempt
                  (- started (:queued-at queued)))
    (let (outcome (attempt-outcome-of (performed! (mut (:mailboxes runner))
                                                  queued)
                                      attempt
                                      (ref policy)))
      (log-outcome! runner queued
                    (ref (->attempt-context :attempt attempt
                                            :policy policy
                                            :started started))
                    (ref outcome))
      outcome)))

(defstruct attempt-context
  :attempt int
  :policy operation-policy
  :started int)

(type log-outcome!
  (fn ((ref operation-runner)
       (ref operation)
       (ref attempt-context)
       (ref attempt-outcome))
    unit))

(defn log-outcome! (runner queued context outcome)
  (match outcome
    ((finished _) (log-finish! runner queued context))
    ((retry plan)
     (log-waiting! (ref (:log runner))
                   queued
                   (ref (:failure plan))
                   (inc (:attempt context))
                   (:delay plan)))
    ((failed failure)
     (log-stopped! runner queued
                   (:attempt context)
                   (ref (:policy context))
                   failure))))

(type log-finish!
  (fn ((ref operation-runner)
       (ref operation)
       (ref attempt-context))
    unit))

(defn log-finish! (runner queued context)
  (let (finished-at (now-milliseconds (ref (:clock runner))))
    (log-finished! (ref (:log runner))
                   queued
                   (:attempt context)
                   (- finished-at (:started context))
                   (- finished-at (:queued-at queued)))))

(type log-stopped!
  (fn ((ref operation-runner)
       (ref operation)
       int
       (ref operation-policy)
       (ref mail-error))
    unit))

(defn log-stopped! (runner queued attempt policy failure)
  (if (retryable? policy failure)
    (log-gave-up! (ref (:log runner)) queued failure attempt)
    (log-failed! (ref (:log runner)) queued failure attempt)))

(def next-operation-id
  (rust "{{ static NEXT: std::sync::atomic::AtomicI64 = std::sync::atomic::AtomicI64::new(1); NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed) }}"
    (fn () int)))
