(use ports/driven/mailbox-provider mailbox-provider)
(use app/mailboxes ->mailboxes mailboxes)
(use app/operations/performing performed!)

(use app/operations/operation-log log-operation!
                                  log-queued!)

(use app/operations/operation-event operation-event)
(use domain/mail-error mail-error)

(use domain/operation ->operation operation operation-kind
                      operation-request priority)

(use domain/operation-policy most-attempts operation-policy
                             policy-for)

(use domain/attempt-outcome attempt-outcome
                            attempt-outcome-of)

(use domain/failure-step retryable?)
(use domain/operation-schedule scheduled)
(use ports/driven/clock clock now-milliseconds)
(use ports/driven/event-log event-log)

(export ->operation-runner attempt-once! new-operation!
        new-runner operation-runner)

(defstruct operation-runner
  :mailboxes mailboxes
  :clock clock
  :log event-log)

(type new-runner
  (fn ((box mailbox-provider) clock event-log)
    operation-runner))

(defn new-runner (provider chosen log)
  (->operation-runner :mailboxes (->mailboxes provider (vec))
                      :clock chosen
                      :log log))

(type new-operation!
  (fn ((ref operation-runner) operation-request) operation))

(defn new-operation! (runner request)
  (let (queued (->operation :id (next-operation-id)
                            :account (clone (:account request))
                            :kind (clone (:kind request))
                            :priority (:priority request)
                            :queued-at (now-milliseconds (ref (:clock
                                                                runner)))))
    (log-queued! (ref (:log runner))
                 (ref queued))
    queued))

(type attempt-once!
  (fn ((mut operation-runner) (ref scheduled))
    attempt-outcome))

(defn attempt-once! (runner entry)
  (let (queued (ref (:operation entry))
        attempt (:attempt entry)
        policy (policy-for (ref (:kind queued))
                           (:priority queued))
        started (now-milliseconds (ref (:clock runner))))
    (log-operation! (ref (:log runner))
                    queued
                    (ref (operation-event/started
                           :attempt attempt
                           :limit (most-attempts (ref policy))
                           :waited (- started (:queued-at queued)))))
    (let (outcome (attempt-outcome-of (performed! (mut (:mailboxes runner))
                                                  queued)
                                      attempt
                                      (ref policy))
          context (->attempt-context :attempt attempt
                                     :policy policy
                                     :started started
                                     :queued-at (:queued-at queued)))
      (log-operation! (ref (:log runner))
                      queued
                      (ref (outcome->event (ref outcome)
                                           (ref context)
                                           (now-milliseconds (ref (:clock
                                                                    runner))))))
      outcome)))

(defstruct attempt-context
  :attempt int
  :policy operation-policy
  :started int
  :queued-at int)

(type outcome->event
  (fn ((ref attempt-outcome) (ref attempt-context) int)
    operation-event))

(defn outcome->event (outcome context now)
  (match outcome
    ((finished _)
     (operation-event/finished :attempt (:attempt context)
                               :took (- now (:started context))
                               :since-queued (- now (:queued-at context))))
    ((retry plan)
     (operation-event/waiting :failure (clone (:failure plan))
                              :next-attempt (inc (:attempt context))
                              :delay (:delay plan)))
    ((failed failure) (stopped-event context (clone failure)))))

(type stopped-event
  (fn ((ref attempt-context) mail-error) operation-event))

(defn stopped-event (context failure)
  (if (retryable? (ref (:policy context))
                  (ref failure))
    (operation-event/gave-up :failure failure
                             :attempts (:attempt context))
    (operation-event/failed :failure failure
                            :attempt (:attempt context))))

(def next-operation-id
  (rust "{{ static NEXT: std::sync::atomic::AtomicI64 = std::sync::atomic::AtomicI64::new(1); NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed) }}"
    (fn () int)))
