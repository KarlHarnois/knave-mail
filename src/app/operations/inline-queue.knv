(use app/mailboxes ->mailboxes)

(use app/operations/runner ->operation-runner attempt-once!
                           new-operation! operation-runner)

(use domain/attempt-outcome attempt-outcome retry-plan)
(use domain/mail-error mail-error)
(use domain/operation operation-result)
(use domain/operation-schedule ->scheduled scheduled)
(use app/operations/operation-log log-left-queued!)
(use ports/driven/clock clock now-milliseconds pause!)
(use ports/driven/event-log event-log)
(use ports/driven/mailbox-provider mailbox-provider)
(use ports/driven/operation-queue operation-queue)

(export ->inline-queue inline-queue new-inline-queue)

(defstruct inline-queue
  :runner operation-runner
  :patience (option int))

(defn new-inline-queue (provider clock log patience)
  (->inline-queue :runner (->operation-runner :mailboxes (->mailboxes provider
                                                                      (vec))
                                              :clock clock
                                              :log log)
                  :patience patience))

(impl operation-queue inline-queue
  (submit! (queue account kind rank)
    (let (queued (new-operation! (ref (:runner queue)) account kind rank))
      (run-to-end! (mut (:runner queue))
                   (:patience queue)
                   (->scheduled :operation queued :attempt 1 :not-before 0)))))

(type run-to-end!
  (fn ((mut operation-runner) (option int) scheduled)
    (result operation-result mail-error)))

(defn run-to-end! (runner patience entry)
  (match (attempt-once! runner (ref entry))
    ((finished outcome) (ok outcome))
    ((retry plan) (retried! runner patience entry plan))
    ((failed failure) (err failure))))

(type retried!
  (fn ((mut operation-runner) (option int) scheduled retry-plan)
    (result operation-result mail-error)))

(defn retried! (runner patience entry plan)
  (let (waited (- (+ (now-milliseconds (ref (:clock runner)))
                     (:delay plan))
                  (:queued-at (:operation entry))))
    (if (out-of-patience? patience waited)
      (do
        (log-left-queued! (ref (:log runner))
                          (ref (:operation entry))
                          (ref (:failure plan))
                          waited)
        (err (clone (:failure plan))))
      (do
        (pause! (ref (:clock runner))
                (:delay plan))
        (run-to-end! runner patience
                     (assoc entry :attempt (inc (:attempt entry))))))))

(defn out-of-patience? (patience waited)
  (match patience
    ((some limit) (> waited limit))
    (none false)))
