(use app/mail-app mail-app)
(use app/operations/calls run-operation! unexpected)
(use domain/labels label-change)
(use domain/mail-error mail-error)

(use domain/operation ->relabel-work message-batch
                      operation-kind operation-result
                      relabel-source)

(use domain/queued-relabel queued-relabel)

(export delivered-batch! delivered-queued! relabeled!)

(type delivered-batch!
  (fn ((mut mail-app) (ref str) message-batch)
    (result unit mail-error)))

(defn delivered-batch! (app account batch)
  (match (try (run-operation! app account
                              (operation-kind/relabel-messages batch)))
    (relabeled (ok (do)))
    (_ (unexpected "relabel batch"))))

(type relabeled!
  (fn ((mut mail-app)
       (ref str)
       (ref str)
       (ref label-change))
    (result unit mail-error)))

(defn relabeled! (app account thread-id change)
  (relabeled-as! app account thread-id change
                 relabel-source/direct))

(type delivered-queued!
  (fn ((mut mail-app) (ref queued-relabel))
    (result unit mail-error)))

(defn delivered-queued! (app queued)
  (relabeled-as! app
                 (as-str (:account queued))
                 (as-str (:thread-id queued))
                 (ref (:change queued))
                 relabel-source/queued))

(type relabeled-as!
  (fn ((mut mail-app)
       (ref str)
       (ref str)
       (ref label-change)
       relabel-source)
    (result unit mail-error)))

(defn relabeled-as! (app account thread-id change source)
  (match (try (run-operation! app account
                              (operation-kind/relabel
                                (->relabel-work :thread-id (str thread-id)
                                                :change (clone change)
                                                :source source))))
    (relabeled (ok (do)))
    (_ (unexpected "relabel"))))
