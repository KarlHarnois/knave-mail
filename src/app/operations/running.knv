(use app/mail-app mail-app)
(use app/operations/performing operation-result performed!)

(use app/operations/operation-log log-failed! log-finished!
                                  log-gave-up! log-queued!
                                  log-retrying!
                                  log-started!)

(use domain/mail-error mail-error)
(use domain/operation ->operation operation operation-kind)

(use domain/operation-policy next-step operation-policy
                             policy-of retryable?
                             step-after-failure)

(use ports/driven/clock now-milliseconds pause!)

(export run-operation!)

(type run-operation!
  (fn ((mut mail-app) (ref str) operation-kind)
    (result operation-result mail-error)))

(defn run-operation! (app account kind)
  (let (queued (->operation :id (next-operation-id)
                            :account (str account)
                            :kind kind
                            :queued-at (now-milliseconds (ref (:clock app)))))
    (log-queued! (ref (:log app))
                 (ref queued))
    (attempted! app (ref queued) 1)))

(type attempted!
  (fn ((mut mail-app) (ref operation) i64)
    (result operation-result mail-error)))

(defn attempted! (app queued attempt)
  (let (policy (policy-of (ref (:kind queued)))
        started (now-milliseconds (ref (:clock app))))
    (log-started! (ref (:log app))
                  queued
                  (ref policy)
                  attempt
                  (- started (:queued-at queued)))
    (match (performed! app queued)
      ((ok outcome)
       (do
         (log-finished! (ref (:log app))
                        queued attempt
                        (- (now-milliseconds (ref (:clock app)))
                           started)
                        (- (now-milliseconds (ref (:clock app)))
                           (:queued-at queued)))
         (ok outcome)))
      ((err failure)
       (match (step-after-failure attempt (ref policy) (ref failure))
         ((retry-after delay)
          (do
            (log-retrying! (ref (:log app))
                           queued
                           (ref failure)
                           (+ attempt 1)
                           delay)
            (pause! (ref (:clock app)) delay)
            (recur app queued (+ attempt 1))))
         (stop (do
                 (if (retryable? (ref failure))
                   (log-gave-up! (ref (:log app))
                                 queued
                                 (ref failure)
                                 attempt)
                   (log-failed! (ref (:log app))
                                queued
                                (ref failure)
                                attempt))
                 (err failure))))))))

(def next-operation-id
  (rust "{{ static NEXT: std::sync::atomic::AtomicI64 = std::sync::atomic::AtomicI64::new(1); NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed) }}"
    (fn () i64)))
