(use domain/queued-relabel relabel-request)
(use domain/log-entry log-area)
(use app/operations/operation-log labels-changed)
(use domain/delivery-tally delivery-count)
(use ports/driven/event-log event-log log-info)

(export log-archived-older! log-batch-delivered!
        log-batch-queued! log-batch-sent!
        log-kept-in-inbox!)

(defn log-batch-sent! (log account change thread-count message-count)
  (log-info log log-area/operations
            (str "relabel batch " account ": " thread-count
                 " threads, " message-count
                 " messages in one request "
                 (labels-changed change))))

(defn log-archived-older! (log account before threads messages requests)
  (log-info log log-area/operations
            (str "archive older " account ": " threads
                 " inbox threads before " before ", "
                 messages " messages in " requests
                 " requests")))

(defn log-kept-in-inbox! (log account thread-ids)
  (log-info log log-area/operations
            (str "archive older " account ": "
                 (len thread-ids)
                 " threads stay in the inbox with newer mail: "
                 (join thread-ids " "))))

(type log-batch-queued!
  (fn ((ref event-log) (ref relabel-request))
    unit))

(defn log-batch-queued! (log request)
  (log-info log log-area/operations
            (str "relabel "
                 (:account request)
                 ": queued "
                 (len (:thread-ids request))
                 " "
                 (labels-changed (ref (:change request)))
                 " for "
                 (join (:thread-ids request) " "))))

(type log-batch-delivered!
  (fn ((ref event-log)
       (ref (vec delivery-count)))
    unit))

(defn log-batch-delivered! (log counts)
  (for-each (iter counts)
    (fn (count)
      (log-info log log-area/operations
                (str "relabel "
                     (:account count)
                     ": delivered "
                     (:delivered count))))))
