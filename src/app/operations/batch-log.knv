(use domain/delivery-batch delivery-batch)
(use domain/queued-relabel relabel-request)
(use domain/log-entry log-area)
(use app/operations/operation-log labels-changed)
(use domain/delivery-tally delivery-count)
(use ports/driven/event-log event-log log-info)

(export ->archive-report log-archived-older!
        log-batch-delivered! log-batch-queued!
        log-batch-sent! log-kept-in-inbox!)

(type log-batch-sent!
  (fn ((ref event-log) (ref delivery-batch))
    unit))

(defn log-batch-sent! (log batch)
  (let (head (at (:rows batch) 0))
    (log-info log log-area/operations
              (str "relabel batch "
                   (:account head)
                   ": "
                   (len (:rows batch))
                   " threads, "
                   (len (:message-ids batch))
                   " messages in one request "
                   (labels-changed (ref (:change head)))))))

(defstruct archive-report
  :account string
  :before string
  :thread-count usize
  :message-count usize
  :request-count usize)

(type log-archived-older!
  (fn ((ref event-log) (ref archive-report))
    unit))

(defn log-archived-older! (log report)
  (log-info log log-area/operations
            (str "archive older "
                 (:account report)
                 ": "
                 (:thread-count report)
                 " inbox threads before "
                 (:before report)
                 ", "
                 (:message-count report)
                 " messages in "
                 (:request-count report)
                 " requests")))

(defn log-kept-in-inbox! (log account thread-ids)
  (log-info log log-area/operations
            (str "archive older " account ": "
                 (len thread-ids)
                 " threads stay in the inbox with newer mail: "
                 (join thread-ids " "))))

(type log-batch-queued!
  (fn ((ref event-log) (ref relabel-request))
    unit))

(defn log-batch-queued! (log request)
  (log-info log log-area/operations
            (str "relabel "
                 (:account request)
                 ": queued "
                 (len (:thread-ids request))
                 " "
                 (labels-changed (ref (:change request)))
                 " for "
                 (join (:thread-ids request) " "))))

(type log-batch-delivered!
  (fn ((ref event-log)
       (ref (vec delivery-count)))
    unit))

(defn log-batch-delivered! (log counts)
  (for-each (iter counts)
    (fn (count)
      (log-info log log-area/operations
                (str "relabel "
                     (:account count)
                     ": delivered "
                     (:delivered count))))))
