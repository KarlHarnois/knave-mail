(use domain/delivery-tally delivery-count)
(use ports/driven/event-log event-log log-info)

(export log-batch-delivered! log-batch-queued!)

(def operations-area "operations")

(defn log-batch-queued! (log account name count)
  (log-info log operations-area
            (str name " " account ": queued " count)))

(type log-batch-delivered!
  (fn ((ref (box event-log))
       (ref str)
       (ref (vec delivery-count)))
    unit))

(defn log-batch-delivered! (log name counts)
  (for-each (iter counts)
    (fn (count)
      (log-info log operations-area
                (str name " "
                     (:account count)
                     ": delivered "
                     (:delivered count))))))
