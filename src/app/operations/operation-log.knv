(use domain/log-entry log-area)
(use domain/label-scope label-scope->label)
(use domain/labels label-change)
(use domain/mail thread-query)
(use domain/mail-error error-kind error-message mail-error)
(use domain/operation operation operation-kind priority)

(use domain/operation-policy most-attempts
                             operation-kind->policy
                             operation-policy)

(use app/operations/operation-event event-step
                                    operation-event)

(use ports/driven/event-log event-log log-debug log-info
                            log-warn)

(export labels-changed log-operation! log-queued!
        operation-event)

(defn log-queued! (log queued)
  (log-debug log log-area/operations
             (line-of queued
                      (with-target (str "queued, "
                                        (rank-name (:priority queued)))
                                   (target-of (ref (:kind queued)))))))

(defn rank-name (rank)
  (match rank
    (interactive (str "interactive"))
    (background (str "background"))))

(type log-operation!
  (fn ((ref event-log)
       (ref operation)
       (ref operation-event))
    unit))

(defn log-operation! (log queued event)
  (let (line (line-of queued (event-step event)))
    (match event
      ((started _ _ _) (log-debug log log-area/operations line))
      ((finished _ _ _) (log-debug log log-area/operations line))
      ((gave-up _ _) (log-warn log log-area/operations line))
      (_ (log-info log log-area/operations line)))))

(type line-of
  (fn ((ref operation) string) string))

(defn line-of (queued step)
  (str "#"
       (:id queued)
       " "
       (:name (operation-kind->policy (ref (:kind queued))))
       " "
       (:account queued)
       ": " step))

(defn with-target (step target)
  (if (empty? target)
    (str step)
    (str step ", " target)))

(defn target-of (kind)
  (match kind
    ((fetch-threads query) (listing-of query))
    ((fetch-thread-ids query) (listing-of query))
    ((fetch-page request) (listing-of (ref (:listing request))))
    ((fetch-message-page request)
     (str "messages matching " (:query (:listing request))))
    ((fetch-summaries ids) (str (len ids) " threads"))
    ((fetch-thread thread-id) (str "thread " thread-id))
    ((fetch-history since) (str "since history " since))
    ((relabel work)
     (str "thread "
          (:thread-id work)
          " "
          (labels-changed (ref (:change work)))))
    ((relabel-messages batch)
     (str (len (:message-ids batch))
          " messages in "
          (len (:thread-ids batch))
          " threads "
          (labels-changed (ref (:change batch)))))
    (_ (str ""))))

(defn listing-of (query)
  (match (label-scope->label (ref (:scope query)))
    ((some label) (str "label " label))
    (none (str "all mail"))))

(defn labels-changed (change)
  (str "+["
       (join (ref (:added change)) ",")
       "] -["
       (join (ref (:removed change)) ",")
       "]"))
