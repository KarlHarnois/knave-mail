(use app/thread-log log-still-unread!)
(use app/mail-app mail-app)
(use domain/labels apply-label-change read-change)
(use domain/mail thread thread-ref)
(use domain/mail-error mail-error)
(use app/operations/relabel-calls relabeled!)
(use ports/driven/store relabel-stored!)

(export marked-read!)

(type marked-read!
  (fn ((mut mail-app) (ref thread-ref) thread)
    thread))

(defn marked-read! (app thread opened)
  (match (mark-thread-read! app thread)
    ((ok _)
     (assoc opened
            :labels (apply-label-change (ref (:labels opened))
                                        (ref (read-change)))))
    ((err failure)
     (log-still-unread! (ref (:log app))
                        thread
                        (ref failure))
     opened)))

(type mark-thread-read!
  (fn ((mut mail-app) (ref thread-ref))
    (result unit mail-error)))

(defn mark-thread-read! (app thread)
  (let (change (read-change))
    (try (relabeled! app thread (ref change)))
    (relabel-stored! (mut (:store app))
                     thread
                     (ref change))))
