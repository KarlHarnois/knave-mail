(use app/mail-app mail-app)
(use app/operations/batch-log log-batch-sent!)
(use app/operations/relabel-calls delivered-batch!)
(use app/single-delivering one-at-a-time!)
(use domain/collections try-for-each)
(use domain/delivery-batch batch-from delivery-batch)

(use domain/delivery-plan batch->message-batch
                          batch-failure->fallback
                          batch-fallback thread-ids-in)

(use domain/mail-error mail-error)
(use domain/queued-relabel delivery-step queued-relabel)

(use ports/driven/store forget-queued!
                        load-pending-downloads
                        load-summaries-of)

(export batch-for delivered-as-batch!)

(type batch-for
  (fn ((ref mail-app)
       (ref (vec queued-relabel)))
    (result delivery-batch mail-error)))

(defn batch-for (app queued)
  (let (account (as-str (:account (at queued 0)))
        thread-ids (thread-ids-in account queued))
    (ok (batch-from queued
                    (ref (try (load-summaries-of (ref (:store app))
                                                 account
                                                 (ref thread-ids))))
                    (ref (try (load-pending-downloads (ref (:store app))
                                                      account)))))))

(type delivered-as-batch!
  (fn ((mut mail-app) delivery-batch)
    (result (vec delivery-step) mail-error)))

(defn delivered-as-batch! (app batch)
  (let (head (clone (at (:rows batch) 0)))
    (match (delivered-batch! app
                             (as-str (:account head))
                             (batch->message-batch (ref batch)))
      ((ok _)
       (do
         (log-batch-sent! (ref (:log app))
                          (ref batch))
         (forgotten! app (clone (:rows batch)))))
      ((err failure)
       (after-batch-failure! app
                             (ref batch)
                             (batch-failure->fallback (ref failure)))))))

(type after-batch-failure!
  (fn ((mut mail-app) (ref delivery-batch) batch-fallback)
    (result (vec delivery-step) mail-error)))

(defn after-batch-failure! (app batch fallback)
  (match fallback
    (keep-queued (ok (vec (delivery-step/kept (clone (at (:rows batch) 0))))))
    (one-at-a-time (one-at-a-time! app
                                   (clone (:rows batch))
                                   (vec)))))

(type forgotten!
  (fn ((mut mail-app) (vec queued-relabel))
    (result (vec delivery-step) mail-error)))

(defn forgotten! (app rows)
  (try (try-for-each (iter rows)
         (fn (row)
           (forget-queued! (mut (:store app))
                           (:id row)))))
  (ok (-> (iter rows)
          (map (fn (row)
                 (delivery-step/delivered (clone row))))
          collect)))
