(use domain/operation page-request)

(use app/activity-log ->label-restored label-restored
                      log-first-listed! log-label-restored!)

(use app/mail-app mail-app)
(use domain/collections concatenated)
(use domain/label-scope label-scope scope-name)

(use domain/listing ->listed-ids current-for-listing
                    first-seen ids-without-summary
                    in-listed-order listed-ids
                    outside-scope)

(use domain/mail ->summary-page summary-page thread-query
                 thread-summary)

(use domain/mail-error mail-error)

(use app/operations/calls fetched-summaries!
                          fetched-thread-ids!
                          fetched-thread-page!)

(use ports/driven/store load-summaries-of save-threads!)

(export listed-page! listed-threads!)

(type listed-threads!
  (fn ((mut mail-app)
       (ref str)
       (ref thread-query))
    (result (vec thread-summary) mail-error)))

(defn listed-threads! (app account query)
  (let (ids (try (fetched-thread-ids! app account query)))
    (summaries-for! app account
                    (ref (->listed-ids :ids ids
                                       :under (clone (:scope query)))))))

(type listed-page!
  (fn ((mut mail-app)
       (ref str)
       (ref page-request))
    (result summary-page mail-error)))

(defn listed-page! (app account request)
  (let (page (try (fetched-thread-page! app account request)))
    (ok (->summary-page
          :summaries (try (summaries-for!
                            app account
                            (ref (->listed-ids :ids (clone (:ids page))
                                               :under (clone (:scope (:listing request)))))))
          :next-token (clone (:next-token page))))))

(type summaries-for!
  (fn ((mut mail-app)
       (ref str)
       (ref listed-ids))
    (result (vec thread-summary) mail-error)))

(defn summaries-for! (app account listed)
  (let (ids (ref (:ids listed))
        scope (ref (:under listed))
        stored (try (load-summaries-of (ref (:store app)) account ids))
        current (current-for-listing (ref stored) scope)
        refreshed (try (refreshed-summaries! app account
                                             (ref (ids-without-summary ids
                                                                       (ref current))))))
    (log-first-seen! app account
                     (ref (first-seen (ref stored) (ref refreshed))))
    (log-back-under-label!
      app account
      (ref (->label-restored :label (scope-name scope)
                             :thread-ids (outside-scope (ref stored) scope))))
    (ok (in-listed-order ids (ref (concatenated current refreshed))))))

(type refreshed-summaries!
  (fn ((mut mail-app)
       (ref str)
       (ref (vec string)))
    (result (vec thread-summary) mail-error)))

(defn refreshed-summaries! (app account ids)
  (if (empty? ids)
    (ok (vec))
    (let (fetched (try (fetched-summaries! app account ids)))
      (try (save-threads! (mut (:store app))
                          account
                          (ref fetched)))
      (load-summaries-of (ref (:store app)) account ids))))

(type log-first-seen!
  (fn ((ref mail-app)
       (ref str)
       (ref (vec thread-summary)))
    unit))

(defn log-first-seen! (app account first-listed)
  (when (not (empty? first-listed))
    (log-first-listed! (ref (:log app)) account first-listed)))

(type log-back-under-label!
  (fn ((ref mail-app)
       (ref str)
       (ref label-restored))
    unit))

(defn log-back-under-label! (app account restored)
  (when (not (empty? (:thread-ids restored)))
    (log-label-restored! (ref (:log app)) account restored)))
