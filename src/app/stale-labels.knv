(use domain/collections try-for-each)
(use app/mail-app mail-app)
(use domain/labels label-removal)
(use domain/listing missing-from-listing)
(use domain/mail thread-query thread-summary)
(use domain/mail-error mail-error)
(use ports/driven/store load-threads relabel-stored!)

(export drop-stale-label!)

(type drop-stale-label!
  (fn ((mut mail-app)
       (ref str)
       (ref thread-query)
       (ref (vec thread-summary)))
    (result unit mail-error)))

(defn drop-stale-label! (app account query listed)
  (let (cached (try (load-threads (ref (:store app)) account query))
        stale (missing-from-listing (ref cached) listed (:limit query)))
    (if (empty? stale)
      (ok (do))
      (do
        (try (unlabel-threads! app account (ref stale) (:label query)))
        (recur app account query listed)))))

(type unlabel-threads!
  (fn ((mut mail-app)
       (ref str)
       (ref (vec string))
       (ref str))
    (result unit mail-error)))

(defn unlabel-threads! (app account thread-ids label)
  (let (removal (label-removal label))
    (try-for-each (iter thread-ids)
      (fn (thread-id)
        (relabel-stored! (mut (:store app))
                         account thread-id
                         (ref removal))))))
