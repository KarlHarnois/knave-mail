(use domain/label-scope label-scope)
(use domain/collections try-for-each)
(use app/mail-app mail-app)

(use domain/labels label-change label-id label-removal
                   system-label)

(use domain/listing missing-from-listing)

(use domain/mail ->thread-query ->thread-ref thread-query
                 thread-summary)

(use domain/mail-error mail-error)
(use ports/driven/store load-threads relabel-stored!)

(export drop-stale-threads! label-query stale-check-for)

(defn label-query (label limit)
  (->thread-query (label-scope/only (label-id label))
                  (str "")
                  limit))

(defstruct stale-check
  :account string
  :listing thread-query
  :removal label-change)

(type stale-check-for
  (fn ((ref str) (ref system-label) int)
    stale-check))

(defn stale-check-for (account label limit)
  (->stale-check :account (str account)
                 :listing (label-query label limit)
                 :removal (label-removal (as-str (label-id label)))))

(type drop-stale-threads!
  (fn ((mut mail-app)
       (ref stale-check)
       (ref (vec thread-summary)))
    (result unit mail-error)))

(defn drop-stale-threads! (app check listed)
  (let (query (ref (:listing check))
        cached (try (load-threads (ref (:store app))
                                  (as-str (:account check))
                                  query))
        stale (missing-from-listing (ref cached) listed (:limit query)))
    (if (empty? stale)
      (ok (do))
      (do
        (try (unlabel-threads! app check (ref stale)))
        (recur app check listed)))))

(type unlabel-threads!
  (fn ((mut mail-app)
       (ref stale-check)
       (ref (vec string)))
    (result unit mail-error)))

(defn unlabel-threads! (app check thread-ids)
  (try-for-each (iter thread-ids)
    (fn (thread-id)
      (relabel-stored! (mut (:store app))
                       (ref (->thread-ref :account (clone (:account check))
                                          :thread-id (clone thread-id)))
                       (ref (:removal check))))))
