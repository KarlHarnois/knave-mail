(use domain/label-scope label-scope)
(use domain/labels label-id system-label)
(use app/activity-log log-full-sync-done!)
(use domain/collections try-for-each)
(use app/mail-app mail-app)
(use app/mailboxes mailbox-for!)
(use app/sync/prefetching prefetch-threads!)
(use app/sync/stale-labels drop-stale-label!)
(use domain/mail ->thread-query)
(use domain/mail-error mail-error)
(use ports/driven/mailbox fetch-history-id! fetch-threads!)
(use ports/driven/store save-checkpoint! save-threads!)

(export full-sync! synced-labels)

(def synced-labels
  (vec system-label/inbox system-label/starred
       system-label/sent))

(type full-sync!
  (fn ((mut mail-app) (ref str))
    (result unit mail-error)))

(defn full-sync! (app account)
  (let (history-id (try (fetch-history-id!
                          (try (mailbox-for! (mut (:mailboxes app)) account)))))
    (try (try-for-each (iter synced-labels)
           (fn (label) (sync-label! app account label))))
    (log-full-sync-done! (ref (:log app)) account history-id)
    (save-checkpoint! (mut (:store app))
                      account
                      (ref history-id))))

(type sync-label!
  (fn ((mut mail-app)
       (ref str)
       (ref system-label))
    (result unit mail-error)))

(defn sync-label! (app account label)
  (let (query (->thread-query (label-scope/only (label-id label))
                              (str "")
                              (:sync-limit app))
        summaries (try (fetch-threads! (try (mailbox-for! (mut (:mailboxes app))
                                                          account))
                                       (ref query))))
    (try (save-threads! (mut (:store app))
                        account
                        (ref summaries)))
    (try (drop-stale-label! app account (ref query) (ref summaries)))
    (prefetch-threads! app account (ref summaries))
    (ok (do))))
