(use domain/label-scope label-scope)
(use domain/labels label-id system-label)
(use app/activity-log log-preview!)
(use app/mail-app mail-app)
(use app/mailboxes open-mailbox!)
(use domain/mail ->thread-query)
(use domain/mail-error mail-error)
(use ports/driven/mailbox fetch-threads!)
(use ports/driven/store save-threads!)

(export list-newest-inbox! preview-limit)

(def preview-limit 25)

(type list-newest-inbox!
  (fn ((mut mail-app) (ref str))
    (result unit mail-error)))

(defn list-newest-inbox! (app account)
  (let (query (->thread-query (label-scope/only (label-id system-label/inbox))
                              (str "")
                              preview-limit)
        summaries (try (fetch-threads!
                         (try (open-mailbox! (mut (:mailboxes app)) account))
                         (ref query))))
    (log-preview! (ref (:log app))
                  account
                  (ref summaries))
    (save-threads! (mut (:store app))
                   account
                   (ref summaries))))
