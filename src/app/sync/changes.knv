(use domain/mail ->thread-ref thread-summary)

(use app/activity-log log-changes! log-gmail-relabel!
                      log-vanished-thread!)

(use domain/collections appended-once try-for-each)
(use app/caching cache-thread!)
(use app/mail-app mail-app)

(use domain/history history-change mail-changes
                    relabeled-only-ids)

(use domain/labels label-change)
(use domain/mail-error error-kind mail-error)
(use app/operations/calls fetched-changes!)

(use ports/driven/store forget-pending-download!
                        forget-thread!
                        load-pending-downloads
                        load-summaries-of relabel-stored!
                        save-checkpoint!
                        save-pending-downloads!)

(export sync-changes!)

(type sync-changes!
  (fn ((mut mail-app) (ref str) (ref str))
    (result unit mail-error)))

(defn sync-changes! (app account since)
  (try (recorded-changes! app account since))
  (download-pending! app account))

(type recorded-changes!
  (fn ((mut mail-app) (ref str) (ref str))
    (result unit mail-error)))

(defn recorded-changes! (app account since)
  (let (changes (try (fetched-changes! app account since))
        cached (try (load-summaries-of (ref (:store app))
                                       account
                                       (ref (relabeled-only-ids (ref
                                                                  changes)))))
        settled (settled-by-history (ref changes) (ref cached))
        downloads (with-unsettled (clone (:refetch changes))
                                  (ref cached)
                                  (ref settled)))
    (try (try-for-each (iter settled)
           (fn (relabel) (relabel-from-history! app account relabel))))
    (try (save-pending-downloads! (mut (:store app))
                                  account
                                  (ref downloads)))
    (try (save-checkpoint! (mut (:store app))
                           account
                           (ref (:history-id changes))))
    (log-changes! (ref (:log app))
                  account
                  (as-str (:history-id changes))
                  (len settled)
                  (ref (try (load-pending-downloads (ref (:store app))
                                                    account))))
    (ok (do))))

(type download-pending!
  (fn ((mut mail-app) (ref str))
    (result unit mail-error)))

(defn download-pending! (app account)
  (let (pending (try (load-pending-downloads (ref (:store app)) account)))
    (try-for-each (iter pending)
      (fn (thread-id)
        (try (refresh-thread! app account thread-id))
        (forget-pending-download! (mut (:store app))
                                  account thread-id)))))

(type settled-by-history
  (fn ((ref mail-changes)
       (ref (vec thread-summary)))
    (vec (pair string label-change))))

(defn settled-by-history (changes cached)
  (reduce (iter cached) (vec)
    (fn (settled summary)
      (match (history-change changes
                             (as-str (:id summary))
                             (:message-count summary))
        ((some change)
         (do
           (push! (mut settled)
                  (pair (clone (:id summary)) change))
           settled))
        (none settled)))))

(type with-unsettled
  (fn ((vec string)
       (ref (vec thread-summary))
       (ref (vec (pair string label-change))))
    (vec string)))

(defn with-unsettled (downloads cached settled)
  (reduce (iter cached) downloads
    (fn (found summary)
      (if (any? (iter settled)
            (fn (relabel)
              (let-match ((pair thread-id _) relabel)
                (= thread-id (:id summary)))))
        found
        (appended-once found (clone (:id summary)))))))

(type relabel-from-history!
  (fn ((mut mail-app)
       (ref str)
       (ref (pair string label-change)))
    (result unit mail-error)))

(defn relabel-from-history! (app account relabel)
  (let-match ((pair thread-id change) relabel)
    (log-gmail-relabel! (ref (:log app))
                        account thread-id change)
    (relabel-stored! (mut (:store app))
                     (ref (->thread-ref :account (str account)
                                        :thread-id (clone thread-id)))
                     change)))

(type refresh-thread!
  (fn ((mut mail-app) (ref str) (ref str))
    (result unit mail-error)))

(defn refresh-thread! (app account thread-id)
  (match (cache-thread! app account thread-id)
    ((err failure)
     (if (= (error-kind (ref failure)) "not-found")
       (do
         (log-vanished-thread! (ref (:log app)) account thread-id)
         (forget-thread! (mut (:store app))
                         (ref (->thread-ref :account (str account)
                                            :thread-id (str thread-id)))))
       (err failure)))
    (done done)))
