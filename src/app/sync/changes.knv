(use domain/mail ->thread-ref thread-ref)
(use app/activity-log ->changes-report log-changes!)
(use app/thread-log log-gmail-relabel! log-vanished-thread!)
(use domain/collections try-for-each)
(use app/caching cache-thread!)
(use app/mail-app mail-app)
(use domain/history relabeled-only-ids)
(use domain/labels label-change)
(use domain/mail-error mail-error)
(use app/operations/calls fetched-changes!)

(use domain/sync-plan changes->sync-plan
                      download-result->step download-step
                      sync-plan)

(use ports/driven/store forget-pending-download!
                        forget-thread!
                        load-pending-downloads
                        load-summaries-of relabel-stored!
                        save-checkpoint!
                        save-pending-downloads!)

(export sync-changes!)

(type sync-changes!
  (fn ((mut mail-app) (ref str) (ref str))
    (result unit mail-error)))

(defn sync-changes! (app account since)
  (let (plan (try (planned-changes! app account since)))
    (try (apply-sync-plan! app account (ref plan)))
    (download-pending! app account)))

(type planned-changes!
  (fn ((mut mail-app) (ref str) (ref str))
    (result sync-plan mail-error)))

(defn planned-changes! (app account since)
  (let (changes (try (fetched-changes! app account since))
        cached (try (load-summaries-of (ref (:store app))
                                       account
                                       (ref (relabeled-only-ids (ref
                                                                  changes))))))
    (ok (changes->sync-plan changes (ref cached)))))

(type apply-sync-plan!
  (fn ((mut mail-app)
       (ref str)
       (ref sync-plan))
    (result unit mail-error)))

(defn apply-sync-plan! (app account plan)
  (try (try-for-each (iter (:relabels plan))
         (fn (relabel) (relabel-from-history! app account relabel))))
  (try (save-pending-downloads! (mut (:store app))
                                account
                                (ref (:downloads plan))))
  (try (save-checkpoint! (mut (:store app))
                         account
                         (ref (:history-id plan))))
  (log-changes! (ref (:log app))
                (ref (->changes-report :account (str account)
                                       :plan (clone plan)
                                       :pending (try (load-pending-downloads
                                                       (ref (:store app))
                                                       account)))))
  (ok (do)))

(type download-pending!
  (fn ((mut mail-app) (ref str))
    (result unit mail-error)))

(defn download-pending! (app account)
  (let (pending (try (load-pending-downloads (ref (:store app)) account)))
    (try-for-each (iter pending)
      (fn (thread-id) (download-thread! app account thread-id)))))

(type download-thread!
  (fn ((mut mail-app) (ref str) (ref str))
    (result unit mail-error)))

(defn download-thread! (app account thread-id)
  (let (thread (->thread-ref :account (str account)
                             :thread-id (str thread-id))
        step (download-result->step (cache-thread! app (ref thread))))
    (try (apply-download-step! app (ref thread) step))
    (forget-pending-download! (mut (:store app))
                              account thread-id)))

(type relabel-from-history!
  (fn ((mut mail-app)
       (ref str)
       (ref (pair string label-change)))
    (result unit mail-error)))

(defn relabel-from-history! (app account relabel)
  (let-match ((pair thread-id change) relabel)
    (let (thread (->thread-ref :account (str account)
                               :thread-id (clone thread-id)))
      (log-gmail-relabel! (ref (:log app))
                          (ref thread)
                          change)
      (relabel-stored! (mut (:store app))
                       (ref thread)
                       change))))

(type apply-download-step!
  (fn ((mut mail-app) (ref thread-ref) download-step)
    (result unit mail-error)))

(defn apply-download-step! (app thread step)
  (match step
    (stored (ok (do)))
    (vanished (forget-vanished-thread! app thread))
    ((failed failure) (err failure))))

(type forget-vanished-thread!
  (fn ((mut mail-app) (ref thread-ref))
    (result unit mail-error)))

(defn forget-vanished-thread! (app thread)
  (log-vanished-thread! (ref (:log app)) thread)
  (forget-thread! (mut (:store app)) thread))
