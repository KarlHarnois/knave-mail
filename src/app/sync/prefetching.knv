(use app/activity-log log-skipped-prefetch!)
(use app/mail-app mail-app)
(use domain/mail thread-summary)
(use domain/mail-error mail-error)
(use domain/prefetch threads-to-prefetch)
(use app/operations/calls fetched-thread!)
(use ports/driven/store load-message-counts save-thread!)

(export prefetch-threads!)

(type prefetch-threads!
  (fn ((mut mail-app)
       (ref str)
       (ref (vec thread-summary)))
    (result unit mail-error)))

(defn prefetch-threads! (app account summaries)
  (let (ids (-> (iter summaries)
                (map (fn (summary) (clone (:id summary))))
                collect)
        stored (try (load-message-counts (ref (:store app))
                                         account
                                         (ref ids)))
        wanted (threads-to-prefetch summaries
                                    (ref stored)
                                    (:prefetch (:limits app))))
    (for-each (iter wanted)
      (fn (thread-id) (prefetch-or-warn! app account thread-id)))
    (ok (do))))

(type prefetch-or-warn!
  (fn ((mut mail-app) (ref str) (ref string))
    unit))

(defn prefetch-or-warn! (app account thread-id)
  (match (prefetch-thread! app account thread-id)
    ((err failure)
     (log-skipped-prefetch! (ref (:log app))
                            account thread-id
                            (ref failure)))
    ((ok _) (do))))

(type prefetch-thread!
  (fn ((mut mail-app) (ref str) (ref string))
    (result unit mail-error)))

(defn prefetch-thread! (app account thread-id)
  (let (fetched (try (fetched-thread! app account (as-str thread-id))))
    (save-thread! (mut (:store app))
                  account
                  (ref fetched))))
