(use domain/log-entry log-area)
(use app/operations/operation-log labels-changed)
(use domain/mail-error error-kind error-message)
(use domain/mail thread-summary)

(use ports/driven/event-log event-log log-debug log-info
                            log-warn)

(export log-changes! log-first-listed! log-full-sync-done!
        log-full-sync-started! log-gmail-relabel!
        log-history-expired! log-incremental-sync-started!
        log-label-restored! log-new-thread! log-preview!
        log-sent-but-uncached! log-skipped-prefetch!
        log-still-unread! log-vanished-thread!)

(defn log-gmail-relabel! (log account thread-id change)
  (log-info log log-area/sync
            (str account ": Gmail has " thread-id " "
                 (labels-changed change)
                 " compared with the cache")))

(defn log-new-thread! (log account thread-id labels)
  (log-info log log-area/sync
            (str account ": cached " thread-id
                 " for the first time with ["
                 (join labels ",")
                 "]")))

(type log-first-listed!
  (fn ((ref event-log)
       (ref str)
       (ref (vec thread-summary)))
    unit))

(defn log-first-listed! (log account fetched)
  (log-info log log-area/sync
            (str account ": a Gmail listing found "
                 (len fetched)
                 " threads the cache did not hold: "
                 (-> (iter fetched)
                     (map (fn (summary) (clone (:id summary))))
                     collect
                     (join " ")))))

(defn log-label-restored! (log account label thread-ids)
  (log-info log log-area/sync
            (str account ": a Gmail listing has "
                 (len thread-ids)
                 " threads under " label
                 " that the cache held without it: "
                 (join thread-ids " "))))

(defn log-incremental-sync-started! (log account since)
  (log-info log log-area/sync
            (str account ": incremental sync from history " since)))

(defn log-full-sync-started! (log account)
  (log-info log log-area/sync
            (str account ": full sync, no checkpoint yet")))

(defn log-history-expired! (log account since)
  (log-warn log log-area/sync
            (str account ": history " since
                 " expired, running a full sync")))

(defn log-full-sync-done! (log account history-id)
  (log-info log log-area/sync
            (str account ": full sync done at history " history-id)))

(defn log-changes! (log account history-id relabeled matched downloads)
  (log-info log log-area/sync
            (str account ": " relabeled
                 " threads relabeled from history, "
                 (len downloads)
                 " threads to download, now at history "
                 history-id ", " matched
                 " already matched the cache"))
  (log-debug log log-area/sync
             (str account ": threads to download " (join downloads " "))))

(defn log-vanished-thread! (log account thread-id)
  (log-debug log log-area/sync
             (str account ": changed thread " thread-id
                  " no longer exists")))

(defn log-skipped-prefetch! (log account thread-id failure)
  (log-warn log log-area/sync
            (str account ": skipped downloading thread "
                 thread-id ": "
                 (error-message failure))))

(defn log-preview! (log account summaries)
  (log-info log log-area/sync
            (str account ": preview listed "
                 (len summaries)
                 " inbox threads")))

(defn log-sent-but-uncached! (log account thread-id failure)
  (log-warn log log-area/send
            (str account ": sent into thread " thread-id
                 ", but caching it failed: "
                 (error-kind failure)
                 ": "
                 (error-message failure))))

(defn log-still-unread! (log account thread-id failure)
  (log-warn log log-area/read
            (str account ": could not mark thread "
                 thread-id " read: "
                 (error-kind failure)
                 ": "
                 (error-message failure))))
