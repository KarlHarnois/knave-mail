(use domain/sync-plan sync-plan)
(use domain/log-entry log-area)
(use app/operations/operation-log labels-changed)
(use domain/labels label-change)
(use domain/mail-error error-kind error-message mail-error)
(use domain/mail thread-ref thread-summary)

(use ports/driven/event-log event-log log-debug log-info
                            log-warn)

(export ->changes-report ->label-restored label-restored
        log-changes! log-first-listed! log-full-sync-done!
        log-full-sync-started! log-history-expired!
        log-incremental-sync-started! log-label-restored!
        log-preview!)

(type log-first-listed!
  (fn ((ref event-log)
       (ref str)
       (ref (vec thread-summary)))
    unit))

(defn log-first-listed! (log account fetched)
  (log-info log log-area/sync
            (str account ": a Gmail listing found "
                 (len fetched)
                 " threads the cache did not hold: "
                 (-> (iter fetched)
                     (map (fn (summary) (clone (:id summary))))
                     collect
                     (join " ")))))

(defstruct label-restored
  :label string
  :thread-ids (vec string))

(type log-label-restored!
  (fn ((ref event-log)
       (ref str)
       (ref label-restored))
    unit))

(defn log-label-restored! (log account restored)
  (log-info log log-area/sync
            (str account ": a Gmail listing has "
                 (len (:thread-ids restored))
                 " threads under "
                 (:label restored)
                 " that the cache held without it: "
                 (join (:thread-ids restored) " "))))

(defn log-incremental-sync-started! (log account since)
  (log-info log log-area/sync
            (str account ": incremental sync from history " since)))

(defn log-full-sync-started! (log account)
  (log-info log log-area/sync
            (str account ": full sync, no checkpoint yet")))

(defn log-history-expired! (log account since)
  (log-warn log log-area/sync
            (str account ": history " since
                 " expired, running a full sync")))

(defn log-full-sync-done! (log account history-id)
  (log-info log log-area/sync
            (str account ": full sync done at history " history-id)))

(defstruct changes-report
  :account string
  :plan sync-plan
  :pending (vec string))

(type log-changes!
  (fn ((ref event-log) (ref changes-report))
    unit))

(defn log-changes! (log report)
  (let (account (:account report)
        plan (ref (:plan report))
        pending (ref (:pending report)))
    (log-info log log-area/sync
              (str account ": "
                   (len (:relabels plan))
                   " threads relabeled from history, "
                   (len pending)
                   " threads to download, now at history "
                   (:history-id plan)
                   ", "
                   (:matched plan)
                   " already matched the cache"))
    (log-debug log log-area/sync
               (str account ": threads to download " (join pending " ")))))

(defn log-preview! (log account summaries)
  (log-info log log-area/sync
            (str account ": preview listed "
                 (len summaries)
                 " inbox threads")))
