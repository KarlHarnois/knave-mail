(use domain/mail-error mail-error)
(use ports/driven/mailbox mailbox)

(use ports/driven/mailbox-provider connect-mailbox!
                                   mailbox-provider)

(export ->mailboxes mailboxes open-mailbox!)

(defstruct opened-mailbox
  :owner string
  :mailbox (box mailbox))

(defstruct mailboxes
  :provider (box mailbox-provider)
  :opened (vec opened-mailbox))

(type open-mailbox!
  (fn ((mut mailboxes) (ref str))
    (result (mut (box mailbox)) mail-error)))

(defn open-mailbox! (all email)
  (match (position-of (ref (:opened all)) email)
    ((some index) (ok (opened-at! all index)))
    (none (do
            (local opened
              (try (connect-mailbox! (mut (:provider all)) email)))
            (let (index (len (:opened all)))
              (push! (mut (:opened all))
                     (->opened-mailbox :owner (str email) :mailbox opened))
              (ok (opened-at! all index)))))))

(type position-of
  (fn ((ref (vec opened-mailbox)) (ref str))
    (option usize)))

(defn position-of (opened wanted)
  (loop (index 0)
    (cond
      ((>= index (len opened)) none)
      ((= (:owner (at opened index)) wanted) (some index))
      (else (recur (inc index))))))

(def opened-at!
  (rust "&mut {0}.opened[{1}].mailbox"
    (fn ((mut mailboxes) usize)
      (mut (box mailbox)))))
