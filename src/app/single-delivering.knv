(use domain/collections appended)
(use app/mail-app mail-app)
(use app/operations/relabel-calls delivered-queued!)
(use domain/mail-error mail-error)

(use domain/queued-relabel ->refusal delivery-step
                           queued-relabel)

(use ports/driven/store forget-queued! revert-queued!)

(export delivered-or-kept! one-at-a-time! worth-keeping?)

(type delivered-or-kept!
  (fn ((mut mail-app) queued-relabel)
    (result delivery-step mail-error)))

(defn delivered-or-kept! (app row)
  (match (delivered-queued! app (ref row))
    ((ok _)
     (do
       (try (forget-queued! (mut (:store app))
                            (:id row)))
       (ok (delivery-step/delivered row))))
    ((err failure) (kept-or-refused! app row failure))))

(type kept-or-refused!
  (fn ((mut mail-app) queued-relabel mail-error)
    (result delivery-step mail-error)))

(defn kept-or-refused! (app row failure)
  (if (worth-keeping? (ref failure))
    (ok (delivery-step/kept row))
    (do
      (try (revert-queued! (mut (:store app))
                           (ref row)))
      (ok (delivery-step/refused (->refusal :queued row :failure failure))))))

(defn worth-keeping? (failure)
  (match failure
    ((network _) true)
    ((throttled _) true)
    ((auth-required _) true)
    (_ false)))

(type one-at-a-time!
  (fn ((mut mail-app)
       (ref (vec queued-relabel))
       usize
       (vec delivery-step))
    (result (vec delivery-step) mail-error)))

(defn one-at-a-time! (app rows index steps)
  (match (try (row-round! app (get rows index) steps))
    ((more taken) (recur app rows (inc index) taken))
    ((finished taken) (ok taken))))

(defenum row-round
  (more (vec delivery-step))
  (finished (vec delivery-step)))

(type row-round!
  (fn ((mut mail-app)
       (option (ref queued-relabel))
       (vec delivery-step))
    (result row-round mail-error)))

(defn row-round! (app row steps)
  (match row
    ((some queued) (delivered-round! app queued steps))
    (none (ok (row-round/finished steps)))))

(type delivered-round!
  (fn ((mut mail-app)
       (ref queued-relabel)
       (vec delivery-step))
    (result row-round mail-error)))

(defn delivered-round! (app row steps)
  (let (step (try (delivered-or-kept! app (clone row)))
        kept (kept? (ref step))
        taken (appended steps step))
    (ok (if kept (row-round/finished taken) (row-round/more taken)))))

(defn kept? (step)
  (match step ((kept _) true) (_ false)))
