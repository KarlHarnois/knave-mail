(use domain/collections try-for-each)
(use app/caching cache-thread!)
(use app/mail-app mail-app)
(use domain/text join-with)
(use ports/driven/event-log log-debug log-info)
(use app/mailboxes mailbox-for!)
(use domain/mail-error error-kind mail-error)
(use ports/driven/mailbox fetch-changes!)
(use ports/driven/store forget-thread! save-checkpoint!)

(export sync-changes!)

(type sync-changes!
  (fn ((mut mail-app) (ref str) (ref str))
    (result unit mail-error)))

(defn sync-changes! (app account since)
  (let (changes (try (fetch-changes! (try (mailbox-for! (mut (:mailboxes app))
                                                        account))
                                     since)))
    (log-info (ref (:log app))
              "sync"
              (str account ": "
                   (len (:thread-ids changes))
                   " threads changed, now at history "
                   (:history-id changes)))
    (log-debug (ref (:log app))
               "sync"
               (str account ": changed threads "
                    (join-with (ref (:thread-ids changes)) " ")))
    (try (try-for-each (iter (:thread-ids changes))
           (fn (thread-id) (refresh-thread! app account thread-id))))
    (save-checkpoint! (mut (:store app))
                      account
                      (ref (:history-id changes)))))

(type refresh-thread!
  (fn ((mut mail-app) (ref str) (ref str))
    (result unit mail-error)))

(defn refresh-thread! (app account thread-id)
  (match (cache-thread! app account thread-id)
    ((err failure)
     (if (= (error-kind (ref failure)) "not-found")
       (do
         (log-debug (ref (:log app))
                    "sync"
                    (str account ": changed thread "
                         thread-id " no longer exists"))
         (forget-thread! (mut (:store app)) account thread-id))
       (err failure)))
    (done done)))
