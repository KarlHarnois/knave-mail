(use app/mail-app mail-app)
(use app/mailboxes mailbox-for!)
(use domain/mail thread-summary)
(use domain/mail-error error-message mail-error)
(use domain/summary message-count)
(use ports/driven/event-log log-warn)
(use ports/driven/mailbox fetch-thread!)
(use ports/driven/store load-thread save-thread!)

(export prefetch-limit prefetch-threads!)

(def prefetch-limit 20)

(type prefetch-threads!
  (fn ((mut mail-app)
       (ref str)
       (ref (vec thread-summary)))
    unit))

(defn prefetch-threads! (app account summaries)
  (for-each (take (iter summaries) prefetch-limit)
    (fn (summary) (prefetch-or-warn! app account summary))))

(type prefetch-or-warn!
  (fn ((mut mail-app)
       (ref str)
       (ref thread-summary))
    unit))

(defn prefetch-or-warn! (app account summary)
  (match (prefetch-thread! app account summary)
    ((err failure)
     (log-warn (ref (:log app))
               "sync"
               (str account ": skipped downloading thread "
                    (:id summary)
                    ": "
                    (error-message (ref failure)))))
    ((ok _) (do))))

(type prefetch-thread!
  (fn ((mut mail-app)
       (ref str)
       (ref thread-summary))
    (result unit mail-error)))

(defn prefetch-thread! (app account summary)
  (if (try (stored-in-full? app account summary))
    (ok (do))
    (let (fetched (try (fetch-thread! (try (mailbox-for! (mut (:mailboxes app))
                                                         account))
                                      (ref (:id summary)))))
      (save-thread! (mut (:store app))
                    account
                    (ref fetched)))))

(type stored-in-full?
  (fn ((ref mail-app)
       (ref str)
       (ref thread-summary))
    (result bool mail-error)))

(defn stored-in-full? (app account summary)
  (match (try (load-thread (ref (:store app))
                           account
                           (ref (:id summary))))
    ((some stored)
     (ok (= (message-count (ref stored))
            (:message-count summary))))
    (none (ok false))))
