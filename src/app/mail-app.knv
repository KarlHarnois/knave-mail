(use domain/operation priority)
(use ports/driven/authorizer authorizer)
(use ports/driven/event-log event-log)
(use ports/driven/operation-queue operation-queue)
(use ports/driven/store store)

(export ->app-mode ->mail-app ->sync-limits app-mode
        delivery mail-app sync-limits)

(defenum delivery
  deliver-now
  deliver-later)

(defstruct app-mode
  :priority priority
  :delivery delivery)

(defstruct sync-limits
  :sync int
  :preview int
  :prefetch usize)

(defstruct mail-app
  :store (box store)
  :operations (box operation-queue)
  :authorizer (box authorizer)
  :log event-log
  :priority priority
  :delivery delivery
  :limits sync-limits)
