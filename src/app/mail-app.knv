(use domain/operation priority)
(use ports/driven/authorizer authorizer)
(use ports/driven/event-log event-log)
(use ports/driven/operation-queue operation-queue)
(use ports/driven/store store)

(export ->mail-app ->sync-limits delivery mail-app
        new-mail-app sync-limits)

(defenum delivery
  deliver-now
  deliver-later)

(defstruct sync-limits
  :sync int
  :preview int
  :prefetch usize)

(defstruct mail-app
  :store (box store)
  :operations (box operation-queue)
  :authorizer (box authorizer)
  :log event-log
  :priority priority
  :delivery delivery
  :limits sync-limits)

(defn new-mail-app (store operations authorizer log rank delivery limits)
  (->mail-app :store store
              :operations operations
              :authorizer authorizer
              :log log
              :priority rank
              :delivery delivery
              :limits limits))
