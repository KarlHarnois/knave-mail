(use domain/operation priority)
(use ports/driven/authorizer authorizer)
(use ports/driven/event-log event-log)
(use ports/driven/operation-queue operation-queue)
(use ports/driven/store store)

(export ->mail-app delivery mail-app new-mail-app)

(defenum delivery
  deliver-now
  deliver-later)

(defstruct mail-app
  :store (box store)
  :operations (box operation-queue)
  :authorizer authorizer
  :log (box event-log)
  :priority priority
  :delivery delivery
  :sync-limit int)

(defn new-mail-app (store operations authorizer log rank delivery sync-limit)
  (->mail-app :store store
              :operations operations
              :authorizer authorizer
              :log log
              :priority rank
              :delivery delivery
              :sync-limit sync-limit))
