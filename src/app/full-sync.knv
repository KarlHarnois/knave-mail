(use app/mail-app mail-app)
(use app/mailboxes mailbox-for!)
(use app/prefetching prefetch-threads!)
(use app/stale-labels drop-stale-label!)
(use domain/mail ->thread-query)
(use domain/mail-error mail-error)
(use ports/driven/event-log log-info)
(use ports/driven/mailbox fetch-history-id! fetch-threads!)
(use ports/driven/store save-checkpoint! save-threads!)

(export full-sync! synced-labels)

(def synced-labels (vec "INBOX" "STARRED" "SENT"))

(type full-sync!
  (fn ((mut mail-app) (ref str))
    (result unit mail-error)))

(defn full-sync! (app account)
  (let (history-id (try (fetch-history-id!
                          (try (mailbox-for! (mut (:mailboxes app)) account)))))
    (try (sync-labels! app account 0))
    (log-info (ref (:log app))
              "sync"
              (str account ": full sync done at history " history-id))
    (save-checkpoint! (mut (:store app))
                      account
                      (ref history-id))))

(type sync-labels!
  (fn ((mut mail-app) (ref str) usize)
    (result unit mail-error)))

(defn sync-labels! (app account index)
  (if (>= index (len synced-labels))
    (ok (do))
    (do
      (try (sync-label! app account (at synced-labels index)))
      (recur app account (+ index 1)))))

(type sync-label!
  (fn ((mut mail-app) (ref str) (ref str))
    (result unit mail-error)))

(defn sync-label! (app account label)
  (let (query (->thread-query (str label)
                              (str "")
                              (:sync-limit app))
        summaries (try (fetch-threads! (try (mailbox-for! (mut (:mailboxes app))
                                                          account))
                                       (ref query))))
    (try (save-threads! (mut (:store app))
                        account
                        (ref summaries)))
    (try (drop-stale-label! app account (ref query) (ref summaries)))
    (prefetch-threads! app account (ref summaries) 0)))
