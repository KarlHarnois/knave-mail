(use app/mail-app mail-app)
(use app/mailboxes mailbox-for!)
(use domain/labels apply-label-change read-change unread?)
(use domain/mail thread thread-query thread-summary)
(use domain/mail-error mail-error)
(use domain/listing ids-without-summary in-listed-order)

(use ports/driven/mailbox fetch-summaries! fetch-thread!
                          list-thread-ids! relabel!)

(use ports/driven/store load-summaries-of load-thread
                        load-threads relabel-stored!
                        save-thread! save-threads!)

(export find-threads! read-thread!)

(type find-threads!
  (fn ((mut mail-app)
       (ref str)
       (ref thread-query))
    (result (vec thread-summary) mail-error)))

(defn find-threads! (app account query)
  (if (empty? (:query query))
    (load-threads (ref (:store app)) account query)
    (search-threads! app account query)))

(type search-threads!
  (fn ((mut mail-app)
       (ref str)
       (ref thread-query))
    (result (vec thread-summary) mail-error)))

(defn search-threads! (app account query)
  (let (ids (try (list-thread-ids! (try (mailbox-for! (mut (:mailboxes app))
                                                      account))
                                   query))
        known (try (load-summaries-of (ref (:store app))
                                      account
                                      (ref ids)))
        fetched (try (missing-summaries!
                       app account
                       (ref (ids-without-summary (ref ids) (ref known))))))
    (try (save-threads! (mut (:store app))
                        account
                        (ref fetched)))
    (ok (in-listed-order (ref ids)
                         (ref (concat known fetched))))))

(type missing-summaries!
  (fn ((mut mail-app)
       (ref str)
       (ref (vec string)))
    (result (vec thread-summary) mail-error)))

(defn missing-summaries! (app account ids)
  (if (empty? ids)
    (ok (vec))
    (fetch-summaries! (try (mailbox-for! (mut (:mailboxes app)) account))
                      ids)))

(def concat
  (rust "{{ let mut {!all} = {0}; {!all}.extend({1}); {!all} }}"
    (fn ((vec thread-summary) (vec thread-summary))
      (vec thread-summary))))

(type read-thread!
  (fn ((mut mail-app) (ref str) (ref str))
    (result thread mail-error)))

(defn read-thread! (app account thread-id)
  (let (opened (try (stored-or-fetched-thread! app account thread-id)))
    (if (unread? (ref (:labels opened)))
      (mark-thread-read! app account opened)
      (ok opened))))

(type stored-or-fetched-thread!
  (fn ((mut mail-app) (ref str) (ref str))
    (result thread mail-error)))

(defn stored-or-fetched-thread! (app account thread-id)
  (match (try (load-thread (ref (:store app)) account thread-id))
    ((some stored) (ok stored))
    (none (fetch-and-store-thread! app account thread-id))))

(type fetch-and-store-thread!
  (fn ((mut mail-app) (ref str) (ref str))
    (result thread mail-error)))

(defn fetch-and-store-thread! (app account thread-id)
  (let (fetched (try (fetch-thread! (try (mailbox-for! (mut (:mailboxes app))
                                                       account))
                                    thread-id)))
    (try (save-thread! (mut (:store app))
                       account
                       (ref fetched)))
    (ok fetched)))

(type mark-thread-read!
  (fn ((mut mail-app) (ref str) thread)
    (result thread mail-error)))

(defn mark-thread-read! (app account opened)
  (let (change (read-change))
    (try (relabel! (try (mailbox-for! (mut (:mailboxes app)) account))
                   (ref (:id opened))
                   (ref change)))
    (try (relabel-stored! (mut (:store app))
                          account
                          (ref (:id opened))
                          (ref change)))
    (ok (assoc opened
               :labels (apply-label-change (ref (:labels opened))
                                           (ref change))))))
