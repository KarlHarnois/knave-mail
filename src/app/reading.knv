(use app/activity-log log-first-listed!)
(use app/mail-app mail-app)
(use domain/collections concatenated)
(use app/marking-read marked-read!)
(use domain/labels unread?)

(use domain/mail ->summary-page ->thread-ref summary-page
                 thread thread-query thread-summary)

(use domain/mail-error mail-error)

(use domain/listing ids-without-summary in-listed-order
                    ready-for-batches)

(use app/operations/calls fetched-summaries! fetched-thread!
                          fetched-thread-ids!
                          fetched-thread-page!)

(use ports/driven/store load-summaries-of load-thread
                        load-threads save-thread!
                        save-threads!)

(export find-threads! listed-page! listed-threads!
        read-thread!)

(type find-threads!
  (fn ((mut mail-app)
       (ref str)
       (ref thread-query))
    (result (vec thread-summary) mail-error)))

(defn find-threads! (app account query)
  (if (empty? (:query query))
    (load-threads (ref (:store app)) account query)
    (listed-threads! app account query)))

(type listed-threads!
  (fn ((mut mail-app)
       (ref str)
       (ref thread-query))
    (result (vec thread-summary) mail-error)))

(defn listed-threads! (app account query)
  (let (ids (try (fetched-thread-ids! app account query)))
    (summaries-for! app account (ref ids))))

(type listed-page!
  (fn ((mut mail-app)
       (ref str)
       (ref thread-query)
       (ref str))
    (result summary-page mail-error)))

(defn listed-page! (app account query page-token)
  (let (page (try (fetched-thread-page! app account query page-token)))
    (ok (->summary-page
          :summaries (try (summaries-for! app account (ref (:ids page))))
          :next-token (clone (:next-token page))))))

(type summaries-for!
  (fn ((mut mail-app)
       (ref str)
       (ref (vec string)))
    (result (vec thread-summary) mail-error)))

(defn summaries-for! (app account ids)
  (let (stored (try (load-summaries-of (ref (:store app)) account ids))
        known (ready-for-batches (ref stored))
        fetched (try (missing-summaries!
                       app account
                       (ref (ids-without-summary ids (ref known)))))
        first-seen (ids-without-summary-in (ref fetched) (ref stored)))
    (try (save-threads! (mut (:store app))
                        account
                        (ref fetched)))
    (when (not (empty? first-seen))
      (log-first-listed! (ref (:log app))
                         account
                         (ref first-seen)))
    (ok (in-listed-order ids (ref (concatenated known fetched))))))

(type ids-without-summary-in
  (fn ((ref (vec thread-summary))
       (ref (vec thread-summary)))
    (vec thread-summary)))

(defn ids-without-summary-in (fetched stored)
  (-> (iter fetched)
      (filter (fn (summary)
                (not (any? (iter stored)
                       (fn (held) (= (:id held) (:id summary)))))))
      (map (fn (summary) (clone summary)))
      collect))

(type missing-summaries!
  (fn ((mut mail-app)
       (ref str)
       (ref (vec string)))
    (result (vec thread-summary) mail-error)))

(defn missing-summaries! (app account ids)
  (if (empty? ids)
    (ok (vec))
    (fetched-summaries! app account ids)))

(type read-thread!
  (fn ((mut mail-app) (ref str) (ref str))
    (result thread mail-error)))

(defn read-thread! (app account thread-id)
  (let (opened (try (stored-or-fetched-thread! app account thread-id)))
    (if (unread? (ref (:labels opened)))
      (ok (marked-read! app account opened))
      (ok opened))))

(type stored-or-fetched-thread!
  (fn ((mut mail-app) (ref str) (ref str))
    (result thread mail-error)))

(defn stored-or-fetched-thread! (app account thread-id)
  (match (try (load-thread (ref (:store app))
                           (ref (->thread-ref :account (str account)
                                              :thread-id (str thread-id)))))
    ((some stored) (ok stored))
    (none (fetch-and-store-thread! app account thread-id))))

(type fetch-and-store-thread!
  (fn ((mut mail-app) (ref str) (ref str))
    (result thread mail-error)))

(defn fetch-and-store-thread! (app account thread-id)
  (let (fetched (try (fetched-thread! app account thread-id)))
    (try (save-thread! (mut (:store app))
                       account
                       (ref fetched)))
    (ok fetched)))
