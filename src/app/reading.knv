(use app/caching cached-thread!)
(use app/listing listed-threads!)
(use app/mail-app mail-app)
(use app/marking-read marked-read!)
(use domain/labels unread?)

(use domain/mail thread thread-query thread-ref
                 thread-summary)

(use domain/mail-error mail-error)

(use ports/driven/store load-thread load-threads
                        save-thread!)

(export find-threads! read-thread!)

(type find-threads!
  (fn ((mut mail-app)
       (ref str)
       (ref thread-query))
    (result (vec thread-summary) mail-error)))

(defn find-threads! (app account query)
  (if (empty? (:query query))
    (load-threads (ref (:store app)) account query)
    (listed-threads! app account query)))

(type read-thread!
  (fn ((mut mail-app) (ref thread-ref))
    (result thread mail-error)))

(defn read-thread! (app thread)
  (let (opened (try (stored-or-fetched-thread! app thread)))
    (if (unread? (ref (:labels opened)))
      (ok (marked-read! app thread opened))
      (ok opened))))

(type stored-or-fetched-thread!
  (fn ((mut mail-app) (ref thread-ref))
    (result thread mail-error)))

(defn stored-or-fetched-thread! (app thread)
  (match (try (load-thread (ref (:store app)) thread))
    ((some stored) (ok stored))
    (none (cached-thread! app thread))))
