(use domain/labels label-change)
(use domain/mail-error mail-error)

(export ->queued-relabel ->refusal ->relabel-request
        delivery-finished? delivery-step queued-relabel
        refusal relabel-request step-account)

(defstruct relabel-request
  :account string
  :thread-ids (vec string)
  :change label-change)

(defstruct queued-relabel
  :id int
  :account string
  :thread-id string
  :change label-change)

(defstruct refusal
  :queued queued-relabel
  :failure mail-error)

(defenum delivery-step
  (delivered queued-relabel)
  (kept queued-relabel)
  (refused refusal))

(defn delivery-finished? (steps)
  (or (empty? steps)
      (any? (iter steps)
        (fn (step)
          (match step ((kept _) true) (_ false))))))

(defn step-account (step)
  (match step
    ((delivered row) (clone (:account row)))
    ((kept row) (clone (:account row)))
    ((refused refused) (clone (:account (:queued refused))))))
