(use domain/collections as-count)
(use domain/label-scope label-scope label-scope->label)
(use domain/labels in-all-mail?)

(use domain/mail ->thread-summary message thread
                 thread-query thread-summary)

(export in-scope? message-count newest-first summarize)

(def snippet-length 120)

(type summarize
  (fn ((ref thread))
    (option thread-summary)))

(defn summarize (summarized)
  (map-some (last (:messages summarized))
    (fn (latest) (summary-ending-with summarized latest))))

(type summary-ending-with
  (fn ((ref thread) (ref message))
    thread-summary))

(defn summary-ending-with (summarized latest)
  (->thread-summary :id (clone (:id summarized))
                    :subject (clone (:subject summarized))
                    :participants (participants summarized)
                    :snippet (snippet (:text latest) snippet-length)
                    :date (:date latest)
                    :labels (clone (:labels summarized))
                    :message-count (message-count summarized)
                    :message-ids (-> (iter (:messages summarized))
                                     (map (fn (held) (clone (:id held))))
                                     collect)))

(type in-scope?
  (fn ((ref thread-summary) (ref label-scope))
    bool))

(defn in-scope? (summary scope)
  (match (label-scope->label scope)
    ((some label)
     (any? (iter (:labels summary))
       (fn (held)
         (= (as-str held) (as-str label)))))
    (none (in-all-mail? (ref (:labels summary))))))

(defn newest-first (summaries query)
  (let (sorted (sorted-by-date-descending summaries))
    (first-few sorted (:limit query))))

(defn participants (summarized)
  (join (ref (distinct-senders (ref (:messages summarized))))
        ", "))

(defn message-count (summarized)
  (as-count (len (:messages summarized))))

(def distinct-senders
  (rust "{0}.iter().fold(Vec::<String>::new(), |mut {!names}, {!message}| {{ let {!name} = {!message}.from.split('<').next().unwrap_or(\"\").trim().trim_matches('\"').to_string(); let {!shown} = if {!name}.is_empty() {{ {!message}.from.clone() }} else {{ {!name} }}; if !{!names}.contains(&{!shown}) {{ {!names}.push({!shown}); }} {!names} }})"
    (fn ((ref (vec message))) (vec string))))

(def snippet
  (rust "{0}.split_whitespace().collect::<Vec<_>>().join(\" \").chars().take({1}).collect::<String>()"
    (fn ((ref str) usize) string)))

(defn sorted-by-date-descending (summaries)
  (sort! (mut summaries) newer-first)
  summaries)

(type newer-first
  (fn ((ref thread-summary) (ref thread-summary))
    int))

(defn newer-first (left right)
  (comparison (:date right) (:date left)))

(defn comparison (left right)
  (cond
    ((< left right) -1)
    ((> left right) 1)
    (else 0)))

(def first-few
  (rust "{0}.into_iter().take({1} as usize).collect::<Vec<_>>()"
    (fn ((vec thread-summary) int)
      (vec thread-summary))))
