(use domain/label-scope label-scope)

(export ->account ->draft ->label ->mail-changes ->message
        ->message-ref ->outgoing ->summary-page ->thread
        ->thread-page ->thread-query ->thread-ref
        ->thread-summary account draft label mail-changes
        message message-ref outgoing summary-page thread
        thread-page thread-query thread-ref thread-summary)

(defstruct account
  :email string)

(defstruct message-ref
  :account string
  :message-id string)

(defstruct thread-ref
  :account string
  :thread-id string)

(defstruct label
  :id string
  :name string
  :unread i64)

(defstruct thread-summary
  :id string
  :subject string
  :participants string
  :snippet string
  :date i64
  :labels (vec string)
  :message-count i64)

(defstruct message
  :id string
  :thread-id string
  :from string
  :to (vec string)
  :cc (vec string)
  :subject string
  :date i64
  :text string
  :html (option string)
  :header-id string
  :references string)

(defstruct thread
  :id string
  :subject string
  :labels (vec string)
  :messages (vec message))

(defstruct draft
  :to (vec string)
  :cc (vec string)
  :subject string
  :body string
  :reply-to (option string))

(defstruct thread-query
  :scope label-scope
  :query string
  :limit i64)

(defstruct thread-page
  :ids (vec string)
  :next-token string)

(defstruct summary-page
  :summaries (vec thread-summary)
  :next-token string)

(defstruct mail-changes
  :thread-ids (vec string)
  :history-id string)

(defstruct outgoing
  :from string
  :to (vec string)
  :cc (vec string)
  :subject string
  :body string
  :thread-id (option string)
  :in-reply-to (option string)
  :references string)
