(use domain/label-scope label-scope)

(export ->account ->draft ->label ->message ->message-page
        ->message-ref ->outgoing ->summary-page ->thread
        ->thread-page ->thread-query ->thread-ref
        ->thread-summary account draft label message
        message-page message-ref outgoing summary-page
        thread thread-page thread-query thread-ref
        thread-summary)

(defstruct account
  :email string)

(defstruct message-ref
  :account string
  :message-id string)

(defstruct thread-ref
  :account string
  :thread-id string)

(defstruct label
  :id string
  :name string
  :unread int
  :total int)

(defstruct thread-summary
  :id string
  :subject string
  :participants string
  :snippet string
  :date int
  :labels (vec string)
  :message-count int
  :message-ids (vec string))

(defstruct message
  :id string
  :thread-id string
  :from string
  :to (vec string)
  :cc (vec string)
  :subject string
  :date int
  :text string
  :html (option string)
  :header-id string
  :references string)

(defstruct thread
  :id string
  :subject string
  :labels (vec string)
  :messages (vec message))

(defstruct draft
  :to (vec string)
  :cc (vec string)
  :subject string
  :body string
  :reply-to (option string))

(defstruct thread-query
  :scope label-scope
  :query string
  :limit int)

(defstruct thread-page
  :ids (vec string)
  :next-token string)

(defstruct message-page
  :message-ids (vec string)
  :thread-ids (vec string)
  :next-token string)

(defstruct summary-page
  :summaries (vec thread-summary)
  :next-token string)

(defstruct outgoing
  :from string
  :to (vec string)
  :cc (vec string)
  :subject string
  :body string
  :thread-id (option string)
  :in-reply-to (option string)
  :references string)
