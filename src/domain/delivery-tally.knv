(use domain/collections appended)
(use domain/queued-relabel delivery-step)

(export ->delivery-count counted-delivery delivery-count
        tallied-deliveries)

(defstruct delivery-count
  :account string
  :delivered int)

(type counted-delivery
  (fn ((vec delivery-count) (ref str))
    (vec delivery-count)))

(defn counted-delivery (counts account)
  (if (any? (iter counts)
        (fn (count)
          (= (:account count) account)))
    (-> (iter counts)
        (map (fn (count) (counted-once-more count account)))
        collect)
    (appended counts
              (->delivery-count :account (str account) :delivered 1))))

(type counted-once-more
  (fn ((ref delivery-count) (ref str))
    delivery-count))

(defn counted-once-more (count account)
  (->delivery-count :account (clone (:account count))
                    :delivered (if (= (:account count) account)
                                 (inc (:delivered count))
                                 (:delivered count))))

(type tallied-deliveries
  (fn ((ref (vec delivery-step))
       (vec delivery-count))
    (vec delivery-count)))

(defn tallied-deliveries (steps counts)
  (reduce (iter steps) counts
    (fn (tally step)
      (match step
        ((delivered row)
         (counted-delivery tally (as-str (:account row))))
        (_ tally)))))
