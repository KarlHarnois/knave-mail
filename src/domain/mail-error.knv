(export ->throttling error-kind error-message
        history-expired? mail-error not-found? throttling)

(defstruct throttling
  :message string
  :retry-after-milliseconds int)

(defenum mail-error
  (usage string)
  (not-found string)
  (history-expired string)
  (auth-required string)
  (network string)
  (throttled throttling)
  (internal string))

(defn error-kind (error)
  (match error
    ((usage _) "usage")
    ((not-found _) "not-found")
    ((history-expired _) "history-expired")
    ((auth-required _) "auth-required")
    ((network _) "network")
    ((throttled _) "throttled")
    ((internal _) "internal")))

(type error-message
  (fn ((ref mail-error)) (ref str)))

(defn error-message (error)
  (match error
    ((usage message) message)
    ((not-found message) message)
    ((history-expired message) message)
    ((auth-required message) message)
    ((network message) message)
    ((throttled throttle) (:message throttle))
    ((internal message) message)))

(defn not-found? (error)
  (match error
    ((not-found _) true)
    (_ false)))

(defn history-expired? (error)
  (match error
    ((history-expired _) true)
    (_ false)))
