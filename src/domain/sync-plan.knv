(use domain/collections appended-once)

(use domain/history already-applied? history-change
                    mail-changes)

(use domain/labels label-change)
(use domain/mail thread-summary)
(use domain/mail-error mail-error not-found?)

(export ->sync-plan changes->sync-plan download-result->step
        download-step sync-plan)

(defstruct sync-plan
  :relabels (vec (pair string label-change))
  :downloads (vec string)
  :history-id string
  :matched usize)

(defenum download-step
  stored
  vanished
  (failed mail-error))

(defn changes->sync-plan (changes cached)
  (let (unapplied (not-yet-applied (ref changes) cached)
        relabels (settled-by-history (ref changes) (ref unapplied)))
    (->sync-plan :downloads (with-unsettled (clone (:refetch changes))
                                            (ref unapplied)
                                            (ref relabels))
                 :relabels relabels
                 :history-id (clone (:history-id changes))
                 :matched (- (len cached) (len unapplied)))))

(type download-result->step
  (fn ((result unit mail-error)) download-step))

(defn download-result->step (outcome)
  (match outcome
    ((ok _) download-step/stored)
    ((err failure) (failure->download-step failure))))

(defn failure->download-step (failure)
  (if (not-found? (ref failure))
    download-step/vanished
    (download-step/failed failure)))

(type settled-by-history
  (fn ((ref mail-changes)
       (ref (vec thread-summary)))
    (vec (pair string label-change))))

(defn settled-by-history (changes cached)
  (reduce (iter cached) (vec)
    (fn (settled summary)
      (match (history-change changes
                             (as-str (:id summary))
                             (:message-count summary))
        ((some change)
         (do
           (push! (mut settled)
                  (pair (clone (:id summary)) change))
           settled))
        (none settled)))))

(type not-yet-applied
  (fn ((ref mail-changes)
       (ref (vec thread-summary)))
    (vec thread-summary)))

(defn not-yet-applied (changes cached)
  (-> (iter cached)
      (filter (fn (summary)
                (not (already-applied? changes
                                       (as-str (:id summary))
                                       (ref (:labels summary))))))
      (map (fn (summary) (clone summary)))
      collect))

(type with-unsettled
  (fn ((vec string)
       (ref (vec thread-summary))
       (ref (vec (pair string label-change))))
    (vec string)))

(defn with-unsettled (downloads cached settled)
  (reduce (iter cached) downloads
    (fn (found summary)
      (if (any? (iter settled)
            (fn (relabel)
              (let-match ((pair thread-id _) relabel)
                (= thread-id (:id summary)))))
        found
        (appended-once found (clone (:id summary)))))))
