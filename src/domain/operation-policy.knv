(use domain/operation operation-kind priority
                      relabel-source)

(export ->operation-policy longest-backoff-milliseconds
        longest-wait most-attempts network-failure
        operation-kind->policy operation-policy persistence
        policy-for retry-limits)

(def read-attempts 3)

(def relabel-attempts 6)

(def send-attempts 3)

(def longest-backoff-milliseconds 60000)

(def background-attempts 10)

(def interactive-wait-milliseconds 15000)

(def background-wait-milliseconds 120000)

(defenum network-failure
  retried
  final)

(defstruct retry-limits
  :most-attempts int
  :longest-wait int)

(defenum persistence
  durable
  (transient retry-limits))

(defstruct operation-policy
  :name string
  :network-failure network-failure
  :persistence persistence)

(defn most-attempts (policy)
  (match (:persistence policy)
    (durable none)
    ((transient limits) (some (:most-attempts limits)))))

(defn longest-wait (policy)
  (match (:persistence policy)
    (durable none)
    ((transient limits) (some (:longest-wait limits)))))

(defn policy-for (kind rank)
  (paced-for (operation-kind->policy kind) rank))

(defn paced-for (policy rank)
  (match (:persistence policy)
    (durable policy)
    ((transient limits)
     (assoc policy
            :persistence (persistence/transient (paced-by-rank (clone limits)
                                                               rank))))))

(defn paced-by-rank (limits rank)
  (match rank
    (interactive (assoc limits :longest-wait interactive-wait-milliseconds))
    (background (->retry-limits :most-attempts background-attempts
                                :longest-wait background-wait-milliseconds))))

(defn operation-kind->policy (kind)
  (match kind
    (fetch-labels (read-policy "fetch labels"))
    ((fetch-threads _) (read-policy "fetch threads"))
    ((fetch-thread-ids _) (read-policy "fetch thread ids"))
    ((fetch-page _) (read-policy "fetch page"))
    ((fetch-message-page _) (read-policy "fetch message page"))
    ((fetch-summaries _) (read-policy "fetch summaries"))
    ((fetch-thread _) (read-policy "fetch thread"))
    (fetch-history-id (read-policy "fetch history id"))
    ((fetch-history _) (read-policy "fetch history"))
    ((send _)
     (transient-policy "send" send-attempts
                       network-failure/final))
    ((relabel work) (relabel-policy (ref (:source work))))
    ((relabel-messages _) (durable-policy "relabel batch"))))

(defn durable-policy (name)
  (->operation-policy :name (str name)
                      :network-failure network-failure/retried
                      :persistence persistence/durable))

(defn transient-policy (name attempts network)
  (->operation-policy
    :name (str name)
    :network-failure network
    :persistence (persistence/transient
                   (->retry-limits
                     :most-attempts attempts
                     :longest-wait longest-backoff-milliseconds))))

(defn read-policy (name)
  (transient-policy name read-attempts
                    network-failure/retried))

(type relabel-policy
  (fn ((ref relabel-source)) operation-policy))

(defn relabel-policy (source)
  (match source
    (queued (durable-policy "relabel"))
    (direct (transient-policy "relabel" relabel-attempts
                              network-failure/retried))))
