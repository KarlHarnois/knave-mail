(use domain/operation operation-kind priority)

(export ->operation-policy longest-backoff-milliseconds
        network-failure operation-policy persistence
        policy-for policy-of)

(def read-attempts 3)

(def relabel-attempts 6)

(def send-attempts 3)

(def longest-backoff-milliseconds 60000)

(def background-attempts 10)

(def interactive-wait-milliseconds 15000)

(def background-wait-milliseconds 120000)

(defenum network-failure
  retried
  final)

(defenum persistence
  durable
  transient)

(defstruct operation-policy
  :name string
  :most-attempts (option int)
  :network-failure network-failure
  :persistence persistence
  :longest-wait (option int))

(defn policy-for (kind rank)
  (paced-for (policy-of kind) rank))

(defn paced-for (policy rank)
  (match (:persistence policy)
    (durable policy)
    (transient (paced-by-rank policy rank))))

(defn paced-by-rank (policy rank)
  (match rank
    (interactive (assoc policy
                        :longest-wait (some interactive-wait-milliseconds)))
    (background (assoc policy
                       :most-attempts (some background-attempts)
                       :longest-wait (some background-wait-milliseconds)))))

(defn policy-of (kind)
  (match kind
    (fetch-labels (read-policy "fetch labels"))
    ((fetch-threads _) (read-policy "fetch threads"))
    ((fetch-thread-ids _) (read-policy "fetch thread ids"))
    ((fetch-page _) (read-policy "fetch page"))
    ((fetch-message-page _) (read-policy "fetch message page"))
    ((fetch-summaries _) (read-policy "fetch summaries"))
    ((fetch-thread _) (read-policy "fetch thread"))
    (fetch-history-id (read-policy "fetch history id"))
    ((fetch-history _) (read-policy "fetch history"))
    ((send _)
     (->operation-policy :name (str "send")
                         :most-attempts (some send-attempts)
                         :network-failure network-failure/final
                         :persistence persistence/transient
                         :longest-wait (some longest-backoff-milliseconds)))
    ((relabel work) (relabel-policy (:queued-id work)))
    ((relabel-messages _) (queued-batch-policy))))

(defn queued-batch-policy ()
  (->operation-policy :name (str "relabel batch")
                      :most-attempts none
                      :network-failure network-failure/retried
                      :persistence persistence/durable
                      :longest-wait none))

(defn read-policy (name)
  (->operation-policy :name (str name)
                      :most-attempts (some read-attempts)
                      :network-failure network-failure/retried
                      :persistence persistence/transient
                      :longest-wait (some longest-backoff-milliseconds)))

(defn relabel-policy (queued-id)
  (match queued-id
    ((some _)
     (->operation-policy :name (str "relabel")
                         :most-attempts none
                         :network-failure network-failure/retried
                         :persistence persistence/durable
                         :longest-wait none))
    (none (->operation-policy :name (str "relabel")
                              :most-attempts (some relabel-attempts)
                              :network-failure network-failure/retried
                              :persistence persistence/transient
                              :longest-wait (some
                                              longest-backoff-milliseconds)))))
