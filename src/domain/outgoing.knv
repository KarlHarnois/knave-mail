(use domain/mail ->outgoing draft message outgoing)

(export new-outgoing reply-outgoing)

(type new-outgoing (fn ((ref draft) (ref str)) outgoing))

(defn new-outgoing (written from)
  (->outgoing :from (str from)
              :to (clone (:to written))
              :cc (clone (:cc written))
              :subject (clone (:subject written))
              :body (clone (:body written))
              :thread-id none
              :in-reply-to none
              :references (str "")))

(type reply-outgoing (fn ((ref draft) (ref str) (ref message)) outgoing))

(defn reply-outgoing (written from original)
  (assoc (new-outgoing written from)
    :thread-id (some (clone (:thread-id original)))
    :in-reply-to (some (clone (:header-id original)))
    :references (references-after original)))

(type references-after (fn ((ref message)) string))

(defn references-after (original)
  (if (empty? (:references original))
    (clone (:header-id original))
    (str (:references original) " " (:header-id original))))
