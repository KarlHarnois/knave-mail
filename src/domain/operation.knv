(use domain/history mail-changes)
(use domain/labels label-change)

(use domain/mail label message-page outgoing thread
                 thread-page thread-query thread-summary)

(export ->message-batch ->operation ->page-request
        ->relabel-work message-batch operation
        operation-kind operation-result page-request
        priority relabel-work)

(defstruct page-request
  :listing thread-query
  :page-token string)

(defstruct message-batch
  :message-ids (vec string)
  :thread-ids (vec string)
  :change label-change)

(defstruct relabel-work
  :thread-id string
  :change label-change
  :queued-id (option int))

(defenum operation-kind
  fetch-labels
  (fetch-threads thread-query)
  (fetch-thread-ids thread-query)
  (fetch-page page-request)
  (fetch-message-page page-request)
  (fetch-summaries (vec string))
  (fetch-thread string)
  fetch-history-id
  (fetch-history string)
  (send outgoing)
  (relabel relabel-work)
  (relabel-messages message-batch))

(defenum priority
  interactive
  background)

(defstruct operation
  :id int
  :account string
  :kind operation-kind
  :priority priority
  :queued-at int)

(defenum operation-result
  (labels-fetched (vec label))
  (summaries-fetched (vec thread-summary))
  (ids-fetched (vec string))
  (page-fetched thread-page)
  (message-page-fetched message-page)
  (thread-fetched thread)
  (history-id-fetched string)
  (history-fetched mail-changes)
  (delivered string)
  relabeled)
