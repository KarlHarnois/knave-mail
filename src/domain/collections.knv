(export appended appended-once one-of? try-for-each)

(defn one-of? (word words)
  (any? (iter words)
    (fn (listed) (= (deref listed) word))))

(defn appended (items item)
  (push! (mut items) item)
  items)

(defn appended-once (items item)
  (if (any? (iter items)
        (fn (known)
          (= (as-str known) (as-str item))))
    items
    (appended items item)))

(def try-for-each
  (rust "{0}.try_for_each({1})"
    (where (item failure)
      (fn ((iterator item)
           (fn-mut (item) (result unit failure)))
        (result unit failure)))))
