(export appended appended-once as-count concatenated
        first-present in-chunks one-of? option->vec
        owned-items present try-for-each)

(defn one-of? (word words)
  (any? (iter words)
    (fn (listed) (= (deref listed) word))))

(defn appended (items item)
  (push! (mut items) item)
  items)

(defn appended-once (items item)
  (if (any? (iter items)
        (fn (known)
          (= (as-str known) (as-str item))))
    items
    (appended items item)))

(def as-count
  (rust "{0} as i64" (fn (usize) int)))

(def concatenated
  (rust "{{ let mut {!all} = {0}; {!all}.extend({1}); {!all} }}"
    (where (item)
      (fn ((vec item) (vec item)) (vec item)))))

(def in-chunks
  (rust "{0}.chunks({1}.max(1)).map(<[_]>::to_vec).collect::<Vec<_>>()"
    (where (item)
      (fn ((ref (vec item)) usize)
        (vec (vec item))))))

(def owned-items
  (rust "{0}.into_iter()"
    (where (item)
      (fn ((vec item)) (iterator item)))))

(def try-for-each
  (rust "{0}.try_for_each({1})"
    (where (item failure)
      (fn ((iterator item)
           (fn-mut (item) (result unit failure)))
        (result unit failure)))))

(def present
  (rust "{0}.flatten()"
    (where (item)
      (fn ((iterator (option item)))
        (iterator item)))))

(def first-present
  (rust "{0}.flatten().next()"
    (where (item)
      (fn ((iterator (option item)))
        (option item)))))

(def option->vec
  (rust "{0}.into_iter().collect::<Vec<_>>()"
    (where (item)
      (fn ((option item)) (vec item)))))
