(export appended appended-once as-count concatenated one-of?
        owned-items try-for-each)

(defn one-of? (word words)
  (any? (iter words)
    (fn (listed) (= (deref listed) word))))

(defn appended (items item)
  (push! (mut items) item)
  items)

(defn appended-once (items item)
  (if (any? (iter items)
        (fn (known)
          (= (as-str known) (as-str item))))
    items
    (appended items item)))

(def as-count
  (rust "{0} as i64" (fn (usize) int)))

(def concatenated
  (rust "{{ let mut {!all} = {0}; {!all}.extend({1}); {!all} }}"
    (where (item)
      (fn ((vec item) (vec item)) (vec item)))))

(def owned-items
  (rust "{0}.into_iter()"
    (where (item)
      (fn ((vec item)) (iterator item)))))

(def try-for-each
  (rust "{0}.try_for_each({1})"
    (where (item failure)
      (fn ((iterator item)
           (fn-mut (item) (result unit failure)))
        (result unit failure)))))
