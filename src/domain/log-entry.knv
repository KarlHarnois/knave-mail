(export ->log-entry log-area log-area->name log-entry
        log-level log-level->name severity text->log-area
        text->log-level)

(defenum log-level
  error
  warn
  info
  debug)

(defenum log-area
  app
  delivery
  frontend
  gmail
  operations
  read
  send
  sync
  window)

(defstruct log-entry
  :level log-level
  :area log-area
  :message string)

(def log-areas
  (vec log-area/app log-area/delivery log-area/frontend
       log-area/gmail log-area/operations log-area/read
       log-area/send log-area/sync log-area/window))

(type log-area->name
  (fn ((ref log-area)) (ref str)))

(defn log-area->name (area)
  (match area
    (app "app")
    (delivery "delivery")
    (frontend "frontend")
    (gmail "gmail")
    (operations "operations")
    (read "read")
    (send "send")
    (sync "sync")
    (window "window")))

(defn text->log-area (text)
  (-> (iter log-areas)
      (find (fn (area)
              (= (log-area->name area) text)))
      (map-some (fn (area) (deref area)))))

(def levels-by-severity
  (vec log-level/error log-level/warn log-level/info
       log-level/debug))

(defn log-level->name (level)
  (match level
    (error "error")
    (warn "warn")
    (info "info")
    (debug "debug")))

(defn text->log-level (text)
  (-> (iter levels-by-severity)
      (find (fn (level)
              (= (log-level->name level) text)))
      (map-some (fn (level) (deref level)))))

(defn severity (level)
  (-> (iter levels-by-severity)
      (take-while (fn (listed)
                    (not= (deref listed) (deref level))))
      count))
