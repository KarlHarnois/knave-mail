(export prefixed-ignoring-case? quoted replaced trimmed-of)

(def prefixed-ignoring-case?
  (rust "{0}.to_lowercase().starts_with(&{1}.to_lowercase())"
    (fn ((ref str) (ref str)) bool)))

(def quoted
  (rust "{0}.lines().map(|line| if line.is_empty() {{ String::from(\">\") }} else {{ format!(\"> {{line}}\") }}).collect::<Vec<_>>().join(\"\\n\")"
    (fn ((ref str)) string)))

(def replaced
  (rust "{0}.replace({1}, {2})"
    (fn (string (ref str) (ref str)) string)))

(def trimmed-of
  (rust "{0}.trim_matches(|{!c}| {1}.contains({!c})).to_string()"
    (fn ((ref str) (ref str)) string)))
