(use domain/collections concatenated)
(use domain/mail thread-summary)
(use domain/queued-relabel queued-relabel)

(export ->delivery-batch batch-from delivery-batch
        most-batched-messages)

(def most-batched-messages 1000)

(defstruct delivery-batch
  :rows (vec queued-relabel)
  :message-ids (vec string))

(defn batch-from (queued summaries pending)
  (let (head (at queued 0)
        candidates (-> (iter queued)
                       (take-while (fn (row) (same-change? row head)))
                       (map (fn (row)
                              (pair (clone row)
                                    (message-ids-of row summaries pending))))
                       collect))
    (gathered (ref candidates)
              0
              (->delivery-batch :rows (vec) :message-ids (vec)))))

(defenum gather-step
  (take :row queued-relabel :ids (vec string))
  skip
  stop)

(type gathered
  (fn ((ref (vec (pair queued-relabel (option (vec string)))))
       usize delivery-batch)
    delivery-batch))

(defn gathered (candidates index batch)
  (match (step-at candidates index (ref batch))
    ((take row ids)
     (recur candidates
            (inc index)
            (with-row batch row (clone ids))))
    (skip (recur candidates (inc index) batch))
    (stop batch)))

(defn step-at (candidates index batch)
  (match (get candidates index)
    ((some candidate)
     (let-match ((pair row found) candidate)
       (step-with-ids row (clone found) batch)))
    (none gather-step/stop)))

(defn step-with-ids (row found batch)
  (match found
    ((some ids) (taken-if-it-fits row ids batch))
    (none gather-step/skip)))

(defn taken-if-it-fits (row ids batch)
  (if (fits? batch (ref ids))
    (gather-step/take :row (clone row) :ids ids)
    gather-step/stop))

(type same-change?
  (fn ((ref queued-relabel) (ref queued-relabel))
    bool))

(defn same-change? (row head)
  (and (= (:account row) (:account head))
       (= (:change row) (:change head))))

(type message-ids-of
  (fn ((ref queued-relabel)
       (ref (vec thread-summary))
       (ref (vec string)))
    (option (vec string))))

(defn message-ids-of (row summaries pending)
  (if (contains? pending (clone (:thread-id row)))
    none
    (listed-ids row summaries)))

(type listed-ids
  (fn ((ref queued-relabel)
       (ref (vec thread-summary)))
    (option (vec string))))

(defn listed-ids (row summaries)
  (match (find (iter summaries)
           (fn (summary)
             (= (:id summary) (:thread-id row))))
    ((some summary) (ids-of summary))
    (none none)))

(type ids-of
  (fn ((ref thread-summary))
    (option (vec string))))

(defn ids-of (summary)
  (if (empty? (:message-ids summary))
    none
    (some (clone (:message-ids summary)))))

(type fits?
  (fn ((ref delivery-batch)
       (ref (vec string)))
    bool))

(defn fits? (batch ids)
  (<= (+ (len (:message-ids batch)) (len ids))
      most-batched-messages))

(defn with-row (batch row ids)
  (->delivery-batch :rows (concatenated (clone (:rows batch))
                                        (vec (clone row)))
                    :message-ids (concatenated (clone (:message-ids batch))
                                               ids)))
