(use domain/collections concatenated)

(export ->label-change apply-label-change archive-change
        holds? in-all-mail? inbox-change label-change
        label-difference label-id label-removal no-change?
        read-change reversed-change star-change starred?
        system-label trash-change unread-change unread?
        unstar-change untrash-change)

(defenum system-label
  inbox
  unread
  starred
  sent
  spam
  trash)

(defn label-id (label)
  (str (match label
         (inbox "INBOX")
         (unread "UNREAD")
         (starred "STARRED")
         (sent "SENT")
         (spam "SPAM")
         (trash "TRASH"))))

(type in-all-mail?
  (fn ((ref (vec string))) bool))

(defn in-all-mail? (labels)
  (not (or (contains? labels (label-id system-label/spam))
           (contains? labels (label-id system-label/trash)))))

(defstruct label-change
  :added (vec string)
  :removed (vec string))

(defn archive-change ()
  (->label-change (vec)
                  (vec (label-id system-label/inbox))))

(defn trash-change ()
  (->label-change (vec (label-id system-label/trash))
                  (vec (label-id system-label/inbox))))

(defn inbox-change ()
  (->label-change (vec (label-id system-label/inbox))
                  (vec)))

(defn untrash-change ()
  (->label-change (vec (label-id system-label/inbox))
                  (vec (label-id system-label/trash))))

(defn star-change ()
  (->label-change (vec (label-id system-label/starred))
                  (vec)))

(defn unstar-change ()
  (->label-change (vec)
                  (vec (label-id system-label/starred))))

(defn read-change ()
  (->label-change (vec)
                  (vec (label-id system-label/unread))))

(defn reversed-change (change)
  (->label-change (clone (:removed change))
                  (clone (:added change))))

(defn label-removal (label)
  (->label-change (vec) (vec (str label))))

(defn unread-change ()
  (->label-change (vec (label-id system-label/unread))
                  (vec)))

(defn unread? (labels)
  (holds? labels (as-str (label-id system-label/unread))))

(defn starred? (labels)
  (holds? labels (as-str (label-id system-label/starred))))

(defn apply-label-change (labels change)
  (with-added (without-removed labels (ref (:removed change)))
              (ref (:added change))))

(type holds?
  (fn ((ref (vec string)) (ref str)) bool))

(defn holds? (labels wanted)
  (any? (iter labels)
    (fn (label) (= label wanted))))

(type without-removed
  (fn ((ref (vec string)) (ref (vec string)))
    (vec string)))

(defn without-removed (labels removed)
  (-> (iter labels)
      (filter (fn (label)
                (not (holds? removed label))))
      (map (fn (label) (clone label)))
      collect))

(defn with-added (labels added)
  (let (missing (without-removed added labels))
    (concatenated (clone labels) missing)))

(type label-difference
  (fn ((ref (vec string)) (ref (vec string)))
    label-change))

(defn label-difference (before after)
  (->label-change :added (labels-missing-from after before)
                  :removed (labels-missing-from before after)))

(type labels-missing-from
  (fn ((ref (vec string)) (ref (vec string)))
    (vec string)))

(defn labels-missing-from (labels others)
  (-> (iter labels)
      (filter (fn (label)
                (not (contains? others (clone label)))))
      (map (fn (label) (clone label)))
      collect))

(type no-change?
  (fn ((ref label-change)) bool))

(defn no-change? (change)
  (and (empty? (:added change))
       (empty? (:removed change))))
