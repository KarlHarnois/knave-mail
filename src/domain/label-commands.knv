(use domain/labels archive-change inbox-change label-change
                   read-change star-change trash-change
                   unread-change unstar-change
                   untrash-change)

(export label-change-named)

(defstruct label-command
  :name (ref str)
  :change label-change)

(def label-commands
  (vec (->label-command :name "archive" :change (archive-change))
       (->label-command :name "move-to-inbox"
                        :change (inbox-change))
       (->label-command :name "trash" :change (trash-change))
       (->label-command :name "untrash" :change (untrash-change))
       (->label-command :name "star" :change (star-change))
       (->label-command :name "unstar" :change (unstar-change))
       (->label-command :name "mark-read" :change (read-change))
       (->label-command :name "mark-unread"
                        :change (unread-change))))

(type label-change-named
  (fn ((ref str)) (option label-change)))

(defn label-change-named (command)
  (-> (iter label-commands)
      (find (fn (listed) (= (:name listed) command)))
      (map-some (fn (listed) (clone (:change listed))))))
