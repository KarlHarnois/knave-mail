(use domain/collections collect-ok)

(use domain/log-entry log-area log-entry log-level severity
                      text->log-area text->log-level)

(export ->level-spec allows? level-spec text->level-spec)

(defstruct level-spec
  :default log-level
  :areas (vec (pair log-area log-level)))

(defenum level-part
  (everywhere log-level)
  (in-area :area log-area :level log-level))

(defn text->level-spec (text)
  (let (parts (try (-> (split text ",")
                       (map (fn (part)
                              (text->level-part (trim part))))
                       collect-ok)))
    (ok (reduce (iter parts)
                (->level-spec :default log-level/info :areas (vec))
                with-part))))

(type with-part
  (fn (level-spec (ref level-part)) level-spec))

(defn with-part (spec part)
  (match part
    ((everywhere level) (assoc spec :default (deref level)))
    ((in-area area level)
     (with-area spec (deref area) (deref level)))))

(defn with-area (spec area level)
  (push! (mut (:areas spec))
         (pair area level))
  spec)

(defn text->level-part (part)
  (let (sides (collect (split part "=")))
    (match (len sides)
      (1
       (map-ok (named-level part)
         (fn (level) (level-part/everywhere level))))
      (2 (area-part (deref (at sides 0)) (deref (at sides 1))))
      (_ (err (str "cannot read the log level `" part "`"))))))

(defn area-part (area level)
  (let-try (found-area (named-area area)
            found-level (named-level level))
    (ok (level-part/in-area :area found-area :level found-level))))

(defn named-area (name)
  (ok-or (text->log-area (trim name))
         (str "unknown log area `" name "`")))

(defn named-level (name)
  (ok-or (text->log-level (as-str (ref (lower-case (trim name)))))
         (str "unknown log level `" name "`")))

(defn allows? (spec entry)
  (<= (severity (ref (:level entry)))
      (severity (ref (threshold-for spec (ref (:area entry)))))))

(type threshold-for
  (fn ((ref level-spec) (ref log-area))
    log-level))

(defn threshold-for (spec area)
  (-> (iter (:areas spec))
      (find (fn (entry)
              (let-match ((pair listed _) entry)
                (= listed area))))
      (map-some (fn (entry)
                  (let-match ((pair _ threshold) entry)
                    (deref threshold))))
      (unwrap-or (:default spec))))
