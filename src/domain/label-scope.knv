(export label-scope label-scope->label scope-name
        text->label-scope)

(defenum label-scope
  all-mail
  (only string))

(def all-mail-name "ALL")

(defn text->label-scope (name)
  (if (= name all-mail-name)
    label-scope/all-mail
    (label-scope/only (str name))))

(defn label-scope->label (scope)
  (match scope
    (all-mail none)
    ((only label) (some (clone label)))))

(defn scope-name (scope)
  (match scope
    (all-mail (str all-mail-name))
    ((only label) (clone label))))
