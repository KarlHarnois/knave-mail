(export label-of label-scope scope-name scope-named)

(defenum label-scope
  all-mail
  (only string))

(def all-mail-name "ALL")

(defn scope-named (name)
  (if (= name all-mail-name)
    label-scope/all-mail
    (label-scope/only (str name))))

(defn label-of (scope)
  (match scope
    (all-mail none)
    ((only label) (some (clone label)))))

(defn scope-name (scope)
  (match scope
    (all-mail (str all-mail-name))
    ((only label) (clone label))))
