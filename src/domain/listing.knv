(use domain/collections appended as-count)
(use domain/label-scope label-of label-scope)
(use domain/labels label-id system-label)
(use domain/mail thread-summary)

(export current-for-listing ids-without-summary
        in-listed-order missing-from-listing outside-scope)

(type current-for-listing
  (fn ((ref (vec thread-summary))
       (ref label-scope))
    (vec thread-summary)))

(defn current-for-listing (summaries scope)
  (-> (iter summaries)
      (filter (fn (summary)
                (and (not (inbox-without-message-ids? summary))
                     (under-scope? summary scope))))
      (map (fn (summary) (clone summary)))
      collect))

(type outside-scope
  (fn ((ref (vec thread-summary))
       (ref label-scope))
    (vec string)))

(defn outside-scope (summaries scope)
  (-> (iter summaries)
      (filter (fn (summary)
                (not (under-scope? summary scope))))
      (map (fn (summary) (clone (:id summary))))
      collect))

(type under-scope?
  (fn ((ref thread-summary) (ref label-scope))
    bool))

(defn under-scope? (summary scope)
  (match (label-of scope)
    ((some label) (contains? (:labels summary) label))
    (none true)))

(type inbox-without-message-ids?
  (fn ((ref thread-summary)) bool))

(defn inbox-without-message-ids? (summary)
  (and (empty? (:message-ids summary))
       (contains? (:labels summary) (label-id system-label/inbox))))

(type ids-without-summary
  (fn ((ref (vec string))
       (ref (vec thread-summary)))
    (vec string)))

(defn ids-without-summary (ids known)
  (-> (iter ids)
      (filter (fn (id)
                (not (any? (iter known)
                       (fn (summary) (= (:id summary) id))))))
      (map (fn (id) (clone id)))
      collect))

(defn in-listed-order (ids known)
  (reduce (iter ids) (vec)
    (fn (ordered id)
      (match (summary-with id known)
        ((some summary) (appended ordered (clone summary)))
        (none ordered)))))

(type summary-with
  (fn ((ref string)
       (ref (vec thread-summary)))
    (option (ref thread-summary))))

(defn summary-with (id known)
  (find (iter known)
    (fn (summary) (= (:id summary) id))))

(defn missing-from-listing (cached listed limit)
  (-> (iter cached)
      (filter (fn (summary) (missing-from? summary listed limit)))
      (map (fn (summary) (clone (:id summary))))
      collect))

(type missing-from?
  (fn ((ref thread-summary)
       (ref (vec thread-summary))
       int)
    bool))

(defn missing-from? (summary listed limit)
  (and (none? (summary-with (ref (:id summary)) listed))
       (or (listing-complete? listed limit)
           (newer-than-listed? summary listed))))

(defn listing-complete? (listed limit)
  (< (as-count (len listed)) limit))

(type newer-than-listed?
  (fn ((ref thread-summary)
       (ref (vec thread-summary)))
    bool))

(defn newer-than-listed? (summary listed)
  (match (min (map (iter listed)
                (fn (listed-summary) (:date listed-summary))))
    ((some oldest) (> (:date summary) oldest))
    (none true)))
