(use domain/operation operation priority)

(export ->scheduled next-ready scheduled wait-until-due)

(defstruct scheduled
  :operation operation
  :attempt int
  :not-before int)

(defn next-ready (waiting now)
  (loop (index 0
         best none)
    (if (>= index (len waiting))
      best
      (recur (inc index) (better-ready waiting index now best)))))

(defn better-ready (waiting index now best)
  (if (and (<= (:not-before (at waiting index)) now)
           (runs-before? waiting index best))
    (some index)
    best))

(defn runs-before? (waiting index best)
  (match best
    ((some chosen)
     (and (interactive? (:priority (:operation (at waiting index))))
          (not (interactive? (:priority (:operation (at waiting chosen)))))))
    (none true)))

(defn interactive? (rank)
  (match rank (interactive true) (background false)))

(defn wait-until-due (waiting now)
  (reduce (iter waiting) none
    (fn (soonest entry)
      (sooner soonest
              (max 0 (- (:not-before entry) now))))))

(defn sooner (soonest wait)
  (match soonest
    ((some known) (some (min wait known)))
    (none (some wait))))
