(use domain/collections concatenated first-present
                        owned-items)

(use domain/operation operation priority)

(export ->scheduled next-ready scheduled wait-until-due)

(defstruct scheduled
  :operation operation
  :attempt int
  :not-before int)

(type next-ready
  (fn ((ref (vec scheduled)) int)
    (option usize)))

(defn next-ready (waiting now)
  (let (due (-> (range 0 (len waiting))
                (filter (fn (index)
                          (<= (:not-before (at waiting index)) now)))
                collect)
        interactive (-> (iter due)
                        (filter (fn (index)
                                  (interactive-at? waiting (deref index))))
                        (map (fn (index) (deref index)))
                        collect))
    (-> (concatenated interactive due)
        owned-items
        (map some)
        first-present)))

(defn interactive-at? (waiting index)
  (interactive? (:priority (:operation (at waiting index)))))

(defn interactive? (rank)
  (match rank (interactive true) (background false)))

(defn wait-until-due (waiting now)
  (reduce (iter waiting) none
    (fn (soonest entry)
      (sooner soonest
              (max 0 (- (:not-before entry) now))))))

(defn sooner (soonest wait)
  (match soonest
    ((some known) (some (min wait known)))
    (none (some wait))))
