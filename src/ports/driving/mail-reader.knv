(use domain/mail label summary-page thread thread-query
                 thread-summary)

(use domain/mail-error mail-error)

(export mail-reader)

(deftrait mail-reader
  (list-labels! (fn ((mut self) (ref str))
                  (result (vec label) mail-error)))
  (list-threads! (fn ((mut self)
                      (ref str)
                      (ref thread-query))
                   (result (vec thread-summary) mail-error)))
  (list-fresh-threads! (fn ((mut self)
                            (ref str)
                            (ref thread-query))
                         (result (vec thread-summary) mail-error)))
  (list-thread-page! (fn ((mut self)
                          (ref str)
                          (ref thread-query)
                          (ref str))
                       (result summary-page mail-error)))
  (open-thread! (fn ((mut self) (ref str) (ref str))
                  (result thread mail-error))))
