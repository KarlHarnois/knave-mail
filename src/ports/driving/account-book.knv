(use domain/mail account)
(use domain/mail-error mail-error)

(export account-book)

(deftrait account-book
  (list-accounts!
    (fn ((mut self))
      (result (vec account) mail-error)))

  (add-account!
    (fn ((mut self))
      (result account mail-error)))

  (remove-account!
    (fn ((mut self) (ref str))
      (result unit mail-error))))
