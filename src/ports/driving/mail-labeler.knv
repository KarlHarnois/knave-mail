(use domain/labels label-change)
(use domain/mail-error mail-error)
(use domain/queued-relabel delivery-step)

(export mail-labeler)

(deftrait mail-labeler
  (relabel-threads!
    (fn ((mut self)
         (ref str)
         (ref (vec string))
         (ref label-change))
      (result unit mail-error)))

  (deliver-next-change!
    (fn ((mut self))
      (result (vec delivery-step) mail-error)))

  (archive-older!
    (fn ((mut self) (ref str) (ref str))
      (result int mail-error)))

  (waiting-changes
    (fn ((ref self) (ref str))
      (result int mail-error))))
