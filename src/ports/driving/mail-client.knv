(use domain/labels label-change)
(use domain/mail account draft label thread thread-query thread-summary)
(use domain/mail-error mail-error)

(export mail-client)

(deftrait mail-client
  (list-accounts! (fn ((mut self)) (result (vec account) mail-error)))
  (list-labels! (fn ((mut self) (ref str)) (result (vec label) mail-error)))
  (list-threads!
    (fn ((mut self) (ref str) (ref thread-query))
      (result (vec thread-summary) mail-error)))
  (open-thread! (fn ((mut self) (ref str) (ref str)) (result thread mail-error)))
  (draft-reply! (fn ((mut self) (ref str) (ref str)) (result draft mail-error)))
  (draft-reply-all!
    (fn ((mut self) (ref str) (ref str)) (result draft mail-error)))
  (draft-forward!
    (fn ((mut self) (ref str) (ref str)) (result draft mail-error)))
  (send-draft! (fn ((mut self) (ref str) (ref draft)) (result unit mail-error)))
  (relabel-threads!
    (fn ((mut self) (ref str) (ref (vec string)) (ref label-change))
      (result unit mail-error)))
  (sync-account! (fn ((mut self) (ref str)) (result unit mail-error)))
  (add-account! (fn ((mut self)) (result account mail-error)))
  (remove-account! (fn ((mut self) (ref str)) (result unit mail-error))))
