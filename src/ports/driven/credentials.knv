(use domain/mail-error mail-error)

(export credentials)

(deftrait credentials
  (load-token (fn ((ref self) (ref str)) (result (option string) mail-error)))
  (save-token! (fn ((mut self) (ref str) (ref str)) (result unit mail-error)))
  (forget-token! (fn ((mut self) (ref str)) (result unit mail-error))))
