(use adapters/driven/file-credentials/credentials file-credentials
                                                  file-token
                                                  forget-file-token!
                                                  save-file-token!)

(use adapters/driven/keyring/credentials forget-keyring-token!
                                         keyring-credentials
                                         keyring-token
                                         save-keyring-token!)

(use domain/mail-error mail-error)

(export credentials forget-token! load-token save-token!)

(defenum credentials
  (keyring keyring-credentials)
  (file file-credentials))

(type load-token
  (fn ((ref credentials) (ref str))
    (result (option string) mail-error)))

(defn load-token (vault account)
  (match vault
    ((keyring held) (keyring-token held account))
    ((file held) (file-token held account))))

(type save-token!
  (fn ((mut credentials) (ref str) (ref str))
    (result unit mail-error)))

(defn save-token! (vault account token)
  (match vault
    ((keyring held) (save-keyring-token! held account token))
    ((file held) (save-file-token! held account token))))

(type forget-token!
  (fn ((mut credentials) (ref str))
    (result unit mail-error)))

(defn forget-token! (vault account)
  (match vault
    ((keyring held) (forget-keyring-token! held account))
    ((file held) (forget-file-token! held account))))
