(use adapters/driven/browser/system-browser launch-in-browser!
                                            system-browser)

(use adapters/driven/memory/shared shared with-shared!)

(export link-opener open-link!)

(defenum link-opener
  (system system-browser)
  (recording (shared (vec string))))

(defn open-link! (opener url)
  (match opener
    ((system browser) (launch-in-browser! browser url))
    ((recording opened)
     (with-shared! opened
       (fn (links) (push! links (str url)))))))
