(use adapters/driven/memory/memory-clock memory-clock
                                         memory-now
                                         memory-pause!
                                         same-clock)

(use adapters/driven/system-clock sleep-for
                                  wall-milliseconds)

(export clock now-milliseconds pause! share-clock)

(defenum clock
  system
  (memory memory-clock))

(defn now-milliseconds (chosen)
  (match chosen
    (system (wall-milliseconds))
    ((memory fake) (memory-now fake))))

(defn share-clock (chosen)
  (match chosen
    (system clock/system)
    ((memory fake) (clock/memory (same-clock fake)))))

(defn pause! (chosen milliseconds)
  (match chosen
    (system (sleep-for milliseconds))
    ((memory fake) (memory-pause! fake milliseconds))))
