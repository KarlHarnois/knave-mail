(use adapters/driven/file-log/file-log file-log
                                       share-file-log
                                       written-to-file!)

(use adapters/driven/memory/memory-log memory-log same-log
                                       written-to-memory!)

(use domain/log-entry ->log-entry log-area log-entry
                      log-level)

(export event-log log-debug log-error log-info log-warn
        record! share-log)

(defenum event-log
  (file file-log)
  (memory memory-log))

(defn record! (log entry)
  (match log
    ((file held) (written-to-file! held entry))
    ((memory held) (written-to-memory! held entry))))

(defn share-log (log)
  (match log
    ((file held) (event-log/file (share-file-log held)))
    ((memory held) (event-log/memory (same-log held)))))

(defn log-error (log area message)
  (record! log
           (ref (->log-entry log-level/error area message))))

(defn log-warn (log area message)
  (record! log
           (ref (->log-entry log-level/warn area message))))

(defn log-info (log area message)
  (record! log
           (ref (->log-entry log-level/info area message))))

(defn log-debug (log area message)
  (record! log
           (ref (->log-entry log-level/debug area message))))
