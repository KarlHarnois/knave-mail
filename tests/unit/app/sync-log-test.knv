(use adapters/driven/memory/remote-operation remote-operation)

(use adapters/driven/memory/memory-log logged-lines
                                       new-memory-log
                                       same-log)

(use domain/labels archive-change)
(use domain/mail ->draft)
(use app/client/mail-reader open-thread!)
(use app/client/mail-writer send-draft!)
(use app/client/mail-labeler relabel-threads!)
(use app/client/mail-syncer preview-account! sync-account!)
(use support/app-steps ada-thread fail-remote! synced!)
(use support/log-lines mentions?)

(use support/memory-world app-logging-to remote-with
                          sample-thread world-account)

(use support/remote-changes arrive-remotely!
                            expire-remote-history!
                            relabel-remotely!)

(use support/sample-mail addresses)

(defn remote ()
  (remote-with (vec (sample-thread "t-1" (vec "INBOX") 100)
                    (sample-thread "t-2" (vec "INBOX") 200))))

(deftest a-first-sync-logs-that-it-is-full
  (let (world (remote)
        log (new-memory-log)
        app (app-logging-to (ref world)
                            (same-log (ref log))))
    (synced! (mut app))
    (assert (mentions? (ref (logged-lines (ref log)))
                       "full sync, no checkpoint yet"))))

(deftest a-later-sync-logs-how-many-threads-it-downloads
  (let (world (remote)
        log (new-memory-log)
        app (app-logging-to (ref world)
                            (same-log (ref log))))
    (synced! (mut app))
    (arrive-remotely! (ref world)
                      (sample-thread "t-3" (vec "INBOX") 300))
    (synced! (mut app))
    (assert (mentions? (ref (logged-lines (ref log)))
                       "1 threads to download"))))

(deftest a-later-sync-logs-label-changes-it-applied-from-history
  (let (world (remote)
        log (new-memory-log)
        app (app-logging-to (ref world)
                            (same-log (ref log))))
    (synced! (mut app))
    (relabel-remotely! (ref world) "t-1" (archive-change))
    (synced! (mut app))
    (assert (mentions?
              (ref (logged-lines (ref log)))
              "1 threads relabeled from history, 0 threads to download"))))

(deftest an-expired-history-logs-the-fallback
  (let (world (remote)
        log (new-memory-log)
        app (app-logging-to (ref world)
                            (same-log (ref log))))
    (synced! (mut app))
    (expire-remote-history! (ref world))
    (arrive-remotely! (ref world)
                      (sample-thread "t-3" (vec "INBOX") 300))
    (expire-remote-history! (ref world))
    (synced! (mut app))
    (assert (mentions? (ref (logged-lines (ref log)))
                       "expired, running a full sync"))))

(deftest a-preview-logs-how-many-threads-it-listed
  (let (world (remote)
        log (new-memory-log)
        app (app-logging-to (ref world)
                            (same-log (ref log))))
    (unwrap-ok (preview-account! (mut app) world-account))
    (assert (mentions? (ref (logged-lines (ref log)))
                       "preview listed 2 inbox threads"))))

(deftest a-failed-refresh-after-sending-is-logged
  (let (world (remote)
        log (new-memory-log)
        app (app-logging-to (ref world)
                            (same-log (ref log))))
    (fail-remote! (ref world) remote-operation/fetch-thread)
    (unwrap-ok (send-draft! (mut app)
                            world-account
                            (ref (->draft :to (addresses (vec
                                                           "alan@example.com"))
                                          :cc (vec)
                                          :subject (str "Hello")
                                          :body (str "Hi Alan")
                                          :reply-to none))))
    (assert (mentions? (ref (logged-lines (ref log)))
                       "caching it failed"))))

(deftest a-label-change-to-several-threads-is-logged-as-one-batch
  (let (world (remote)
        log (new-memory-log)
        app (app-logging-to (ref world)
                            (same-log (ref log))))
    (synced! (mut app))
    (unwrap-ok (relabel-threads! (mut app)
                                 world-account
                                 (ref (vec (str "t-1") (str "t-2")))
                                 (ref (archive-change))))
    (assert (mentions?
              (ref (logged-lines (ref log)))
              "relabel ada@example.com: queued 2 +[] -[INBOX] for t-1 t-2"))
    (assert (mentions? (ref (logged-lines (ref log)))
                       "relabel batch ada@example.com: queued, interactive, 2 messages in 2 threads +[] -[INBOX]"))))

(deftest opening-a-thread-offline-logs-that-it-stays-unread
  (let (world (remote-with (vec
                             (sample-thread "t-1" (vec "INBOX" "UNREAD") 100)))
        log (new-memory-log)
        app (app-logging-to (ref world)
                            (same-log (ref log))))
    (synced! (mut app))
    (fail-remote! (ref world) remote-operation/relabel)
    (unwrap-ok (open-thread! (mut app)
                             (ref (ada-thread "t-1"))))
    (assert (mentions? (ref (logged-lines (ref log)))
                       "could not mark thread t-1 read"))))
