(use domain/queued-relabel ->relabel-request)
(use app/client/mail-labeler relabel-threads!)
(use domain/freshness ->listing-request freshness)
(use domain/labels archive-change)

(use adapters/driven/memory/memory-log logged-lines
                                       new-memory-log
                                       same-log)

(use app/client/mail-reader list-threads!)
(use support/app-steps inbox-query synced!)
(use support/log-lines mentions?)

(use support/memory-world app-logging-to remote-with
                          sample-thread world-account)

(use support/remote-changes arrive-remotely!
                            relabel-remotely!)

(defn remote ()
  (remote-with (vec (sample-thread "t-1" (vec "INBOX") 100)
                    (sample-thread "t-2" (vec "Receipts") 200))))

(deftest a-label-gmail-changed-is-logged-against-the-cache
  (let (world (remote)
        log (new-memory-log)
        app (app-logging-to (ref world)
                            (same-log (ref log))))
    (synced! (mut app))
    (relabel-remotely! (ref world) "t-1" (archive-change))
    (synced! (mut app))
    (assert (mentions? (ref (logged-lines (ref log)))
                       "ada@example.com: Gmail has t-1 +[] -[INBOX] compared with the cache"))))

(deftest a-thread-cached-for-the-first-time-is-logged-with-its-labels
  (let (world (remote)
        log (new-memory-log)
        app (app-logging-to (ref world)
                            (same-log (ref log))))
    (synced! (mut app))
    (arrive-remotely! (ref world)
                      (sample-thread "t-3" (vec "INBOX") 300))
    (synced! (mut app))
    (assert (mentions?
              (ref (logged-lines (ref log)))
              "ada@example.com: cached t-3 for the first time with [INBOX]"))))

(deftest threads-a-gmail-listing-adds-to-the-cache-are-logged
  (let (world (remote)
        log (new-memory-log)
        app (app-logging-to (ref world)
                            (same-log (ref log))))
    (unwrap-ok (list-threads! (mut app)
                              world-account
                              (ref (->listing-request
                                     :threads (inbox-query)
                                     :freshness freshness/fresh))))
    (assert (mentions? (ref (logged-lines (ref log)))
                       "ada@example.com: a Gmail listing found 1 threads the cache did not hold: t-1"))))

(deftest an-archive-made-here-is-not-logged-as-a-gmail-change
  (let (world (remote)
        log (new-memory-log)
        app (app-logging-to (ref world)
                            (same-log (ref log))))
    (synced! (mut app))
    (unwrap-ok (relabel-threads! (mut app)
                                 (ref (->relabel-request
                                        :account (str world-account)
                                        :thread-ids (clone (vec (str "t-1")))
                                        :change (clone (archive-change))))))
    (synced! (mut app))
    (assert (not (mentions? (ref (logged-lines (ref log)))
                            "Gmail has t-1")))
    (assert (mentions? (ref (logged-lines (ref log)))
                       "1 already matched the cache"))))
