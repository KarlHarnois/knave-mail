(use app/client/mail-syncer)
(use app/client/mail-reader)
(use domain/labels archive-change unread-change)
(use ports/driving/mail-reader open-thread!)

(use support/app-steps inbox-query listed-ids! remote-thread
                       synced! world-thread)

(use support/memory-world app-over remote-with sample-thread
                          world-account)

(use support/remote-changes expire-remote-history!
                            relabel-remotely!)

(defn remote ()
  (remote-with (vec (sample-thread "t-1" (vec "INBOX") 100)
                    (sample-thread "t-2" (vec "INBOX") 200))))

(deftest a-thread-archived-while-history-expired-leaves-the-inbox
  (let (world (remote)
        app (app-over (ref world)))
    (synced! (mut app))
    (relabel-remotely! (ref world) "t-1" (archive-change))
    (expire-remote-history! (ref world))
    (synced! (mut app))
    (assert (= (listed-ids! (mut app)
                            (ref (inbox-query)))
               (vec (str "t-2"))))))

(deftest opening-a-thread-marked-unread-while-history-expired-marks-it-read
  (let (world (remote)
        app (app-over (ref world)))
    (synced! (mut app))
    (relabel-remotely! (ref world) "t-1" (unread-change))
    (expire-remote-history! (ref world))
    (synced! (mut app))
    (unwrap-ok (open-thread! (mut app)
                             (ref (world-thread "t-1"))))
    (assert (= (:labels (remote-thread (ref world) "t-1"))
               (vec (str "INBOX"))))))
