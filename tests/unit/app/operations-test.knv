(use adapters/driven/memory/remote-mail failing-plan)
(use domain/queued-relabel ->relabel-request)
(use adapters/driven/memory/remote-operation remote-operation)

(use adapters/driven/memory/memory-clock new-memory-clock
                                         pauses-of
                                         same-clock)

(use adapters/driven/memory/memory-log logged-lines
                                       new-memory-log
                                       same-log)

(use domain/labels archive-change)
(use domain/mail ->draft)
(use app/client/mail-labeler relabel-threads!)
(use app/client/mail-writer send-draft!)

(use support/app-steps fail-remote! plan-remote-failure!
                       plan-remote-failure! remote-sent
                       remote-thread synced!)

(use support/log-lines mentions?)

(use support/memory-world app-timed-by remote-with
                          sample-thread world-account)

(use support/remote-changes arrive-remotely!
                            expire-remote-history!)

(use support/sample-mail addresses)

(defn remote ()
  (remote-with (vec (sample-thread "t-1" (vec "INBOX") 100))))

(defn archive-t-1! (app)
  (relabel-threads! app
                    (ref (->relabel-request :account (str world-account)
                                            :thread-ids (clone (vec (str
                                                                      "t-1")))
                                            :change (clone (archive-change))))))

(defn draft-to-alan ()
  (->draft :to (addresses (vec "alan@example.com"))
           :cc (vec)
           :subject (str "Hello")
           :body (str "Hi Alan")
           :reply-to none))

(deftest a-relabel-that-fails-twice-reaches-gmail-on-the-third-attempt
  (let (world (remote)
        clock (new-memory-clock)
        app (app-timed-by (ref world)
                          (new-memory-log)
                          (same-clock (ref clock))))
    (synced! (mut app))
    (plan-remote-failure! (ref world)
                          (failing-plan remote-operation/relabel 2))
    (unwrap-ok (archive-t-1! (mut app)))
    (assert (empty? (:labels (remote-thread (ref world) "t-1"))))
    (assert (= (pauses-of (ref clock))
               (vec 1000 2000)))))

(deftest a-retry-is-logged-with-its-failure-and-wait
  (let (world (remote)
        log (new-memory-log)
        app (app-timed-by (ref world)
                          (same-log (ref log))
                          (new-memory-clock)))
    (synced! (mut app))
    (plan-remote-failure! (ref world)
                          (failing-plan remote-operation/relabel 1))
    (unwrap-ok (archive-t-1! (mut app)))
    (assert (mentions? (ref (logged-lines (ref log)))
                       "relabel ada@example.com: failed, will retry: network: simulated failure of relabel; attempt 2 in 1000ms"))))

(deftest a-failed-send-is-not-retried
  (let (world (remote)
        clock (new-memory-clock)
        app (app-timed-by (ref world)
                          (new-memory-log)
                          (same-clock (ref clock))))
    (fail-remote! (ref world) remote-operation/deliver)
    (assert (err? (send-draft! (mut app)
                               world-account
                               (ref (draft-to-alan)))))
    (assert (empty? (remote-sent (ref world))))
    (assert (empty? (pauses-of (ref clock))))))

(deftest every-step-of-an-operation-shares-its-id
  (let (world (remote)
        log (new-memory-log)
        app (app-timed-by (ref world)
                          (same-log (ref log))
                          (new-memory-clock)))
    (synced! (mut app))
    (let (lines (logged-lines (ref log))
          id (operation-id-of (ref lines)
                              " fetch labels ada@example.com: queued"))
      (assert (mentions? (ref lines)
                         (as-str (str id
                                      " fetch labels ada@example.com: started, attempt 1 of 3, waited 0ms"))))
      (assert (mentions? (ref lines)
                         (as-str (str id
                                      " fetch labels ada@example.com: finished in 0ms, attempt 1, 0ms since queued")))))))

(deftest a-missing-history-is-not-retried
  (let (world (remote)
        log (new-memory-log)
        app (app-timed-by (ref world)
                          (same-log (ref log))
                          (new-memory-clock)))
    (synced! (mut app))
    (expire-remote-history! (ref world))
    (arrive-remotely! (ref world)
                      (sample-thread "t-2" (vec "INBOX") 200))
    (expire-remote-history! (ref world))
    (synced! (mut app))
    (assert (mentions? (ref (logged-lines (ref log)))
                       "fetch history ada@example.com: failed on attempt 1: history-expired"))))

(type operation-id-of
  (fn ((ref (vec string)) (ref str))
    string))

(defn operation-id-of (lines step)
  (match (find (iter lines)
           (fn (line) (contains? line step)))
    ((some line)
     (str (-> (split line step)
              (find (fn (_) true))
              (unwrap-or ""))))
    (none (str "no such line"))))
