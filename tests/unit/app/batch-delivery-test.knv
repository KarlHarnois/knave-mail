(use domain/queued-relabel ->relabel-request)
(use domain/freshness ->listing-request freshness)
(use domain/mail thread-summary)
(use domain/summary summarize)
(use app/client/mail-reader list-threads!)
(use ports/driven/store load-summaries-of save-threads!)

(use adapters/driven/memory/memory-log logged-lines
                                       new-memory-log
                                       same-log)

(use adapters/driven/memory/memory-clock new-memory-clock)
(use domain/labels archive-change)
(use app/client/mail-labeler relabel-threads!)

(use support/app-steps inbox-query listed-ids! remote-thread
                       synced!)

(use support/log-lines mentions?)

(use support/memory-world app-timed-by remote-with
                          sample-thread world-account)

(use support/remote-changes delete-remotely!)

(defn remote ()
  (remote-with (vec (sample-thread "t-1" (vec "INBOX") 100)
                    (sample-thread "t-2" (vec "INBOX") 200)
                    (sample-thread "t-3" (vec "INBOX") 300))))

(defn archive-first-two! (app)
  (relabel-threads! app
                    (ref (->relabel-request :account (str world-account)
                                            :thread-ids (clone (ref (vec (str "t-1")
                                                                         (str "t-2"))))
                                            :change (clone (archive-change))))))

(deftest archiving-several-threads-sends-one-batch
  (let (world (remote)
        log (new-memory-log)
        app (app-timed-by (ref world)
                          (same-log (ref log))
                          (new-memory-clock)))
    (synced! (mut app))
    (unwrap-ok (archive-first-two! (mut app)))
    (assert (mentions? (ref (logged-lines (ref log)))
                       "relabel batch ada@example.com: 2 threads, 2 messages in one request +[] -[INBOX]"))
    (assert (empty? (:labels (remote-thread (ref world) "t-1"))))
    (assert (empty? (:labels (remote-thread (ref world) "t-2"))))))

(deftest a-batch-gmail-refuses-goes-out-one-thread-at-a-time
  (let (world (remote)
        app (app-timed-by (ref world)
                          (new-memory-log)
                          (new-memory-clock)))
    (synced! (mut app))
    (delete-remotely! (ref world) "t-2")
    (assert (err? (archive-first-two! (mut app))))
    (assert (empty? (:labels (remote-thread (ref world) "t-1"))))
    (assert (= (listed-ids! (mut app)
                            (ref (inbox-query)))
               (vec (str "t-3") (str "t-2"))))))

(deftest a-listing-fills-in-message-ids-an-inbox-summary-lacks
  (let (world (remote)
        app (app-timed-by (ref world)
                          (new-memory-log)
                          (new-memory-clock)))
    (unwrap-ok (save-threads!
                 (mut (:store app))
                 world-account
                 (ref (vec (without-message-ids (unwrap (summarize (ref (sample-thread
                                                                          "t-1"
                                                                          (vec "INBOX")
                                                                          100)))))))))
    (unwrap-ok (list-threads! (mut app)
                              world-account
                              (ref (->listing-request
                                     :threads (inbox-query)
                                     :freshness freshness/fresh))))
    (assert (= (-> (iter (unwrap-ok (load-summaries-of (ref (:store app))
                                                       world-account
                                                       (ref (vec (str
                                                                   "t-1"))))))
                   (map (fn (summary)
                          (clone (:message-ids summary))))
                   collect)
               (vec (vec (str "m-t-1")))))))

(type without-message-ids
  (fn (thread-summary) thread-summary))

(defn without-message-ids (summary)
  (assoc summary :message-ids (vec)))
