(use domain/operation ->page-request)
(use adapters/driven/memory/remote-operation remote-operation)
(use domain/label-scope label-scope)
(use domain/mail ->thread-query summary-page)
(use app/client/mail-reader list-thread-page!)
(use support/app-steps fail-remote! synced!)

(use support/memory-world app-over remote-with sample-thread
                          world-account)

(defn remote ()
  (remote-with (vec (sample-thread "t-1" (vec "INBOX") 100)
                    (sample-thread "t-2" (vec "INBOX") 200)
                    (sample-thread "t-3" (vec "INBOX") 300))))

(defn inbox-page (size)
  (->thread-query (label-scope/only (str "INBOX"))
                  (str "")
                  size))

(type ids-of
  (fn ((ref summary-page)) (vec string)))

(defn ids-of (page)
  (-> (iter (:summaries page))
      (map (fn (summary) (clone (:id summary))))
      collect))

(deftest the-first-page-lists-the-newest-threads-and-points-to-the-next
  (let (world (remote)
        app (app-over (ref world)))
    (let (page (unwrap-ok (list-thread-page! (mut app)
                                             world-account
                                             (ref (->page-request
                                                    :listing (clone (ref (inbox-page
                                                                           2)))
                                                    :page-token none)))))
      (assert (= (ids-of (ref page))
                 (vec (str "t-3") (str "t-2"))))
      (assert (some? (:next-token page))))))

(deftest the-last-page-has-no-next-token
  (let (world (remote)
        app (app-over (ref world))
        first (unwrap-ok (list-thread-page! (mut app)
                                            world-account
                                            (ref (->page-request
                                                   :listing (clone (ref (inbox-page
                                                                          2)))
                                                   :page-token none))))
        last (unwrap-ok (list-thread-page! (mut app)
                                           world-account
                                           (ref (->page-request
                                                  :listing (inbox-page 2)
                                                  :page-token (clone (:next-token
                                                                       first)))))))
    (assert (= (ids-of (ref last))
               (vec (str "t-1"))))
    (assert (none? (:next-token last)))))

(deftest a-page-reuses-summaries-already-in-the-cache
  (let (world (remote)
        app (app-over (ref world)))
    (synced! (mut app))
    (fail-remote! (ref world) remote-operation/fetch-summaries)
    (assert (= (ids-of (ref (unwrap-ok (list-thread-page!
                                         (mut app)
                                         world-account
                                         (ref (->page-request
                                                :listing (clone (ref (inbox-page
                                                                       3)))
                                                :page-token none))))))
               (vec (str "t-3")
                    (str "t-2")
                    (str "t-1"))))))
