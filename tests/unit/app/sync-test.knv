(use adapters/driven/memory/remote-operation remote-operation)
(use domain/collections as-count)
(use domain/label-scope label-scope)
(use domain/freshness ->listing-request freshness)
(use domain/mail ->thread-query)
(use domain/mail-error error-kind)

(use app/client/mail-reader list-labels! list-threads!
                            open-thread!)

(use app/client/mail-syncer sync-account!)
(use support/app-steps ada-thread fail-remote!)

(use support/memory-world app-over remote-with sample-thread
                          test-prefetch-limit world-account)

(defn inbox-query ()
  (->thread-query (label-scope/only (str "INBOX"))
                  (str "")
                  50))

(defn remote ()
  (remote-with (vec (sample-thread "t-1" (vec "INBOX" "UNREAD") 100)
                    (sample-thread "t-2" (vec "INBOX") 200)
                    (sample-thread "t-3" (vec "Receipts") 300))))

(deftest nothing-is-listed-before-the-first-sync
  (let (app (app-over (ref (remote))))
    (assert (empty? (unwrap-ok (list-threads!
                                 (mut app)
                                 world-account
                                 (ref (->listing-request
                                        :threads (inbox-query)
                                        :freshness freshness/cached))))))))

(deftest a-sync-lists-inbox-threads-newest-first
  (let (app (app-over (ref (remote))))
    (unwrap-ok (sync-account! (mut app) world-account))
    (assert (= (-> (iter (unwrap-ok (list-threads!
                                      (mut app)
                                      world-account
                                      (ref (->listing-request
                                             :threads (inbox-query)
                                             :freshness freshness/cached)))))
                   (map (fn (summary) (clone (:id summary))))
                   collect)
               (vec (str "t-2") (str "t-1"))))))

(defn busy-remote ()
  (remote-with (-> (range 0 (+ test-prefetch-limit 5))
                   (map (fn (number)
                          (sample-thread (ref (str "t-" number))
                                         (vec "INBOX")
                                         (as-count (+ 1000 number)))))
                   collect)))

(deftest a-sync-downloads-the-newest-threads-in-full
  (let (world (busy-remote)
        app (app-over (ref world)))
    (unwrap-ok (sync-account! (mut app) world-account))
    (fail-remote! (ref world) remote-operation/fetch-thread)
    (assert (= (:subject (unwrap-ok (open-thread! (mut app)
                                                  (ref (ada-thread (str "t-"
                                                                        (+ test-prefetch-limit
                                                                           4)))))))
               (str "Subject of t-" (+ test-prefetch-limit 4))))))

(deftest a-sync-leaves-older-threads-to-download-when-opened
  (let (world (busy-remote)
        app (app-over (ref world)))
    (unwrap-ok (sync-account! (mut app) world-account))
    (fail-remote! (ref world) remote-operation/fetch-thread)
    (assert (= (str (error-kind (ref (unwrap-err (open-thread! (mut app)
                                                               (ref (ada-thread "t-0")))))))
               "network"))))

(deftest a-thread-that-fails-to-download-does-not-abort-the-sync
  (let (world (remote)
        app (app-over (ref world)))
    (fail-remote! (ref world) remote-operation/fetch-thread)
    (unwrap-ok (sync-account! (mut app) world-account))
    (assert (= (len (unwrap-ok (list-threads!
                                 (mut app)
                                 world-account
                                 (ref (->listing-request
                                        :threads (inbox-query)
                                        :freshness freshness/cached)))))
               2))))
