(use domain/freshness freshness)
(use domain/label-scope label-scope)

(use adapters/driving/cli/arguments parse-arguments switch?
                                    value-of)

(use adapters/driving/cli/command arguments->cli-command
                                  cli-command
                                  cli-command-word?
                                  reply-scope)

(use adapters/driving/cli/command-options body-format)
(use domain/labels archive-change inbox-change)
(use domain/mail-error error-message)
(use support/sample-mail addresses)

(defn parsed (tokens)
  (unwrap-ok (parse-arguments (ref (addresses tokens)))))

(defn command (tokens)
  (unwrap-ok (arguments->cli-command (ref (parsed tokens)))))

(defn failure (tokens)
  (str (error-message (ref (unwrap-err (arguments->cli-command (ref (parsed tokens))))))))

(deftest a-valued-option-takes-the-next-token
  (assert (= (value-of (ref (parsed
                              (vec "--account" "ada@example.com" "labels")))
                       "--account")
             (some (str "ada@example.com")))))

(deftest a-flag-takes-no-value
  (assert (switch? (ref (parsed (vec "reply" "m-1" "--all")))
                   "--all")))

(deftest a-known-word-is-a-cli-command
  (assert (cli-command-word?
            (ref (parsed (vec "--backend" "memory" "threads" "list"))))))

(def setting-flags
  (vec "--backend" "--latency" "--fail" "--e2e-script"
       "--cache" "--credentials-file" "--client-id"
       "--client-secret" "--gmail-base-url" "--token-url"
       "--auth-url" "--theme" "--keymap" "--browser"
       "--log-file" "--log-level"))

(deftest a-setting-before-the-command-keeps-the-command
  (assert (not (any? (iter setting-flags)
                 (fn (flag)
                   (not (cli-command-word?
                          (ref (parsed (vec flag "some-value" "sync"))))))))))

(deftest a-cache-path-is-not-mistaken-for-a-command
  (assert (= (command (vec "--cache" "/tmp/cache.sqlite3" "sync"))
             cli-command/sync)))

(deftest no-word-means-the-window
  (assert (not (cli-command-word? (ref (parsed (vec "--backend" "memory")))))))

(deftest threads-list-defaults-to-the-inbox
  (assert (= (command (vec "threads" "list"))
             (cli-command/list-threads (label-scope/only (str "INBOX"))
                                       (str "")
                                       50
                                       freshness/cached))))

(deftest threads-list-reads-its-label-query-and-limit
  (assert
    (= (command (vec "threads" "list" "--label" "STARRED"
                     "--query" "lunch" "--limit" "5"))
       (cli-command/list-threads (label-scope/only (str "STARRED"))
                                 (str "lunch")
                                 5 freshness/cached))))

(deftest search-looks-in-all-mail
  (assert (= (command (vec "search" "from:alan"))
             (cli-command/list-threads label-scope/all-mail
                                       (str "from:alan")
                                       50
                                       freshness/cached))))

(deftest threads-show-defaults-to-text
  (assert (= (command (vec "threads" "show" "t-1"))
             (cli-command/show-thread (str "t-1") body-format/plain))))

(deftest threads-show-needs-a-thread-id
  (assert (= (failure (vec "threads" "show")) "expected a thread id")))

(deftest send-collects-every-recipient
  (assert (= (command (vec "send" "--to" "a@example.com"
                           "--to" "b@example.com"
                           "--subject" "Hi"))
             (cli-command/send (addresses (vec "a@example.com" "b@example.com"))
                               (the (vec string) (vec))
                               (str "Hi")))))

(deftest reply-to-everyone
  (assert (= (command (vec "reply" "m-1" "--all"))
             (cli-command/reply (str "m-1") reply-scope/everyone))))

(deftest forward-names-its-recipients
  (assert (= (command (vec "forward" "m-1" "--to" "c@example.com"))
             (cli-command/forward (str "m-1")
                                  (addresses (vec "c@example.com"))))))

(deftest archive-takes-several-threads
  (assert (= (command (vec "archive" "t-1" "t-2"))
             (cli-command/relabel (archive-change)
                                  (addresses (vec "t-1" "t-2"))))))

(deftest accounts-remove-needs-an-email
  (assert (= (failure (vec "accounts" "remove"))
             "expected an account email")))

(deftest an-unknown-action-is-a-usage-error
  (assert (= (failure (vec "threads" "delete"))
             "unknown action `delete` for `threads`")))

(deftest no-command-asks-for-help
  (assert (= (command (the (vec (ref str)) (vec)))
             cli-command/help)))

(deftest inbox-takes-several-threads
  (assert (= (command (vec "inbox" "t-1" "t-2"))
             (cli-command/relabel (inbox-change)
                                  (addresses (vec "t-1" "t-2"))))))

(deftest fresh-lists-threads-from-gmail
  (assert (= (command (vec "threads" "list" "--fresh"))
             (cli-command/list-threads (label-scope/only (str "INBOX"))
                                       (str "")
                                       50
                                       freshness/fresh))))
