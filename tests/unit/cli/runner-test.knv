(use domain/freshness freshness)
(use domain/label-scope label-scope)
(use adapters/driving/cli/cli-result cli-result)
(use adapters/driving/cli/command cli-command reply-scope)

(use adapters/driving/cli/json-presenter error-json-text
                                         result-json-text)

(use adapters/driving/cli/runner ->cli-request
                                 run-cli-command! sending)

(use adapters/driving/cli/text-presenter result-text)
(use adapters/driving/cli/exit-codes exit-code)
(use adapters/driving/cli/command-options body-format)
(use domain/labels archive-change inbox-change)
(use domain/mail-error mail-error)
(use support/app-steps remote-sent synced!)

(use support/memory-world app-over remote-with sample-thread
                          world-account)

(use support/sample-mail addresses)

(defn remote ()
  (remote-with (vec
                 (sample-thread "t-1" (vec "INBOX" "UNREAD") 1700000000000))))

(defn ran (command body dry-run)
  (let (world (remote)
        app (app-over (ref world)))
    (synced! (mut app))
    (run-cli-command! (mut app)
                      (ref (->cli-request command
                                          (str world-account)
                                          (str body)
                                          dry-run)))))

(defn text-of (command)
  (result-text (ref (unwrap-ok (ran command "" sending/deliver)))))

(deftest lists-threads-as-aligned-text
  (assert (= (text-of (cli-command/list-threads (label-scope/only (str "INBOX"))
                                                (str "")
                                                10
                                                freshness/cached))
             "t-1                 2023-11-14 22:13  N  Grace                       Subject of t-1")))

(deftest shows-a-thread-as-text
  (assert (= (text-of (cli-command/show-thread (str "t-1") body-format/plain))
             "Message: m-t-1\nFrom: Grace <grace@example.com>\nTo: ada@example.com\nDate: 2023-11-14 22:13\nSubject: Subject of t-1\n\nBody of t-1\n")))

(deftest lists-labels-with-unread-counts
  (assert (= (text-of cli-command/list-labels)
             "INBOX                   1 unread\nUNREAD                  1 unread")))

(deftest a-dry-run-reply-shows-the-draft-without-sending
  (assert (= (result-text (ref (unwrap-ok (ran (cli-command/reply
                                                 (str "m-t-1")
                                                 reply-scope/sender)
                                               "Sounds good."
                                               sending/preview))))
             "To: Grace <grace@example.com>\nCc: \nSubject: Re: Subject of t-1\n\nSounds good.\n\nGrace <grace@example.com> wrote:\n> Body of t-1")))

(deftest sending-delivers-the-body
  (let (world (remote)
        app (app-over (ref world)))
    (unwrap-ok (run-cli-command! (mut app)
                                 (ref (->cli-request (cli-command/send
                                                       (addresses (vec "a@example.com"))
                                                       (vec)
                                                       (str "Hi"))
                                                     (str world-account)
                                                     (str "Hello there")
                                                     sending/deliver))))
    (assert (= (:body (at (remote-sent (ref world)) 0))
               "Hello there"))))

(deftest prints-results-as-versioned-json
  (assert (= (result-json-text (ref (unwrap-ok (ran (cli-command/relabel (archive-change)
                                                                         (addresses
                                                                           (vec "t-1")))
                                                    ""
                                                    sending/deliver))))
             "{\"result\":{},\"schema\":1}")))

(deftest prints-errors-as-versioned-json
  (assert (= (error-json-text
               (ref (unwrap-err (ran (cli-command/show-thread (str "t-9")
                                                              body-format/plain)
                                     "" sending/deliver))))
             "{\"error\":{\"kind\":\"not-found\",\"message\":\"no thread t-9\"},\"schema\":1}")))

(deftest a-usage-failure-exits-with-one
  (assert (= (exit-code (ref (mail-error/usage (str "unknown command"))))
             1)))

(deftest a-missing-thread-exits-with-not-found
  (assert (= (exit-code (ref (unwrap-err
                               (ran (cli-command/show-thread (str "t-9")
                                                             body-format/plain)
                                    "" sending/deliver))))
             2)))

(deftest a-network-failure-exits-with-four
  (assert (= (exit-code (ref (mail-error/network (str "offline"))))
             4)))

(deftest inbox-moves-an-archived-thread-back
  (let (world (remote)
        app (app-over (ref world)))
    (synced! (mut app))
    (unwrap-ok (run-cli-command! (mut app)
                                 (ref (->cli-request (cli-command/relabel
                                                       (archive-change)
                                                       (addresses (vec "t-1")))
                                                     (str world-account)
                                                     (str "")
                                                     sending/deliver))))
    (unwrap-ok (run-cli-command! (mut app)
                                 (ref (->cli-request (cli-command/relabel
                                                       (inbox-change)
                                                       (addresses (vec "t-1")))
                                                     (str world-account)
                                                     (str "")
                                                     sending/deliver))))
    (assert (= (listed-count! (mut app)
                              (cli-command/list-threads (label-scope/only (str "INBOX"))
                                                        (str "")
                                                        10
                                                        freshness/cached))
               1))))

(defn listed-count! (app command)
  (match (unwrap-ok (run-cli-command! app
                                      (ref (->cli-request command
                                                          (str world-account)
                                                          (str "")
                                                          sending/deliver))))
    ((threads-listed summaries) (len summaries))
    (_ 0)))
