(use adapters/driven/memory/memory-log logged-lines
                                       new-memory-log
                                       same-log)

(use adapters/driven/memory/shared handle share
                                   with-shared!)

(use adapters/json/value parse-json)
(use adapters/driving/json/commands json->mail-call)

(use adapters/driving/json/mail-command mail-call
                                        worker-listing?)

(use adapters/driving/webview/listing-runner call-inbox
                                             reply-sink)

(use domain/label-commands command-name->label-change)

(use adapters/driving/webview/logged-answers answer-listings!
                                             refuse-listings!)

(use domain/mail-error mail-error)
(use ports/driven/event-log event-log)
(use support/app-steps synced!)
(use support/log-lines mentions?)

(use support/memory-world app-over remote-with sample-thread
                          world-account)

(defn collected-of (held)
  (reply-sink/collected (handle (ref held))))

(defn call-of (request-text)
  (unwrap-ok (json->mail-call (ref (unwrap-ok (parse-json request-text))))))

(defn inbox-holding (request-texts)
  (calls-inbox (-> (iter request-texts)
                   (map (fn (text) (call-of (as-str text))))
                   collect)))

(def calls-inbox
  (rust "{{ let ({!sender}, {!inbox}) = std::sync::mpsc::channel(); for {!call} in {0} {{ {!sender}.send({!call}).expect(\"the inbox is open\"); }} {!inbox} }}"
    (fn ((vec mail-call)) call-inbox)))

(def inbox-page
  "{\"id\":7,\"command\":\"thread-page\",\"args\":{\"account\":\"ada@example.com\",\"label\":\"INBOX\",\"query\":\"\",\"limit\":10,\"pageToken\":\"\"}}")

(defn remote ()
  (remote-with (vec (sample-thread "t-1" (vec "INBOX") 100))))

(defn to-worker? (command arguments)
  (worker-listing? (ref (:command (call-of (as-str (ref (str "{\"id\":1,\"command\":\""
                                                             command
                                                             "\",\"args\":"
                                                             arguments
                                                             "}"))))))))

(def listed-inbox
  "{\"account\":\"ada@example.com\",\"label\":\"INBOX\",\"limit\":10")

(deftest label-commands-are-queued-on-the-window-loop
  (assert (not (to-worker?
                 "archive"
                 "{\"account\":\"ada@example.com\",\"threadIds\":[]}")))
  (assert (some? (command-name->label-change "archive")))
  (assert (some? (command-name->label-change "mark-unread"))))

(deftest gmail-listings-go-to-the-worker
  (assert (to-worker? "thread-page"
                      (str listed-inbox ",\"query\":\"\"}")))
  (assert (to-worker? "threads"
                      (str listed-inbox ",\"query\":\"invoice\"}")))
  (assert (to-worker? "threads"
                      (str listed-inbox ",\"query\":\"\",\"fresh\":true}"))))

(deftest cache-reads-stay-on-the-window-loop
  (assert (not (to-worker? "threads"
                           (str listed-inbox
                                ",\"query\":\"\",\"fresh\":false}"))))
  (assert (not (to-worker? "threads" (str listed-inbox ",\"query\":\"\"}"))))
  (assert (not (to-worker?
                 "thread"
                 "{\"account\":\"ada@example.com\",\"threadId\":\"t-1\"}")))
  (assert (not (to-worker? "accounts" "{}"))))

(deftest the-worker-answers-a-gmail-listing
  (let (world (remote)
        app (app-over (ref world))
        held (share (vec))
        sink (collected-of held))
    (synced! (mut app))
    (answer-listings! (mut app)
                      (ref (event-log/memory (new-memory-log)))
                      (ref (inbox-holding (ref (vec (str inbox-page)))))
                      (ref sink))
    (let (replies (with-shared! (ref held)
                    (fn (replies) (clone replies))))
      (assert (contains? (at replies 0) "t-1")))))

(deftest the-worker-replies-to-each-request-by-its-id
  (let (world (remote)
        app (app-over (ref world))
        held (share (vec))
        sink (collected-of held))
    (synced! (mut app))
    (answer-listings! (mut app)
                      (ref (event-log/memory (new-memory-log)))
                      (ref (inbox-holding (ref (vec (str inbox-page)))))
                      (ref sink))
    (let (replies (with-shared! (ref held)
                    (fn (replies) (clone replies))))
      (assert (= (len replies) 1))
      (assert (contains? (at replies 0) "\"id\":7")))))

(deftest a-failed-listing-is-logged-under-its-command
  (let (world (remote)
        app (app-over (ref world))
        log (new-memory-log)
        held (share (vec))
        sink (collected-of held))
    (answer-listings! (mut app)
                      (ref (event-log/memory (same-log (ref log))))
                      (ref (inbox-holding (ref (vec (str "{\"id\":9,\"command\":\"thread-page\",\"args\":{\"account\":\"nobody@example.com\",\"label\":\"INBOX\",\"query\":\"x\",\"limit\":10,\"pageToken\":\"\"}}")))))
                      (ref sink))
    (assert (mentions? (ref (logged-lines (ref log)))
                       "thread-page failed"))))

(deftest a-worker-that-cannot-start-refuses-each-request-by-its-id
  (let (held (share (vec))
        sink (collected-of held))
    (refuse-listings! (ref (mail-error/auth-required (str "no account")))
                      (ref (inbox-holding (ref (vec (str inbox-page)))))
                      (ref sink))
    (let (replies (with-shared! (ref held)
                    (fn (replies) (clone replies))))
      (assert (contains? (at replies 0) "\"id\":7"))
      (assert (contains? (at replies 0) "\"error\"")))))
