(use adapters/driven/memory/memory-log logged-lines
                                       memory-log
                                       new-memory-log
                                       same-log)

(use adapters/driving/webview/link-requests open-requested-link!)
(use ports/driven/event-log event-log)
(use adapters/driven/memory/shared shared)
(use support/log-lines mentions-none? mentions?)

(use support/recording-browser new-recording-browser
                               opened-links
                               recording-opener)

(type open-through!
  (fn ((ref (shared (vec string)))
       (ref memory-log)
       (ref str))
    unit))

(defn open-through! (browser log url)
  (open-requested-link! (ref (recording-opener browser))
                        (ref (event-log/memory (same-log log)))
                        url))

(deftest an-https-link-opens-in-the-browser
  (let (browser (new-recording-browser)
        log (new-memory-log))
    (open-through! (ref browser)
                   (ref log)
                   "https://example.com/a")
    (assert (= (opened-links (ref browser))
               (vec (str "https://example.com/a"))))))

(deftest an-opened-link-logs-only-its-host
  (let (browser (new-recording-browser)
        log (new-memory-log))
    (open-through! (ref browser)
                   (ref log)
                   "https://example.com/private-token")
    (assert (mentions? (ref (logged-lines (ref log)))
                       "opened link to example.com"))
    (assert (mentions-none? (ref (logged-lines (ref log)))
                            (ref (vec "private-token"))))))

(deftest a-file-link-stays-closed-and-is-logged
  (let (browser (new-recording-browser)
        log (new-memory-log))
    (open-through! (ref browser) (ref log) "file:///etc/passwd")
    (assert (empty? (opened-links (ref browser))))
    (assert (mentions? (ref (logged-lines (ref log)))
                       "refused to open a link"))))
