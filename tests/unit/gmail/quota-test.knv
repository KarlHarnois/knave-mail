(use adapters/driven/gmail/quota ->quota-bucket pace-at
                                 slowed-at!)

(def ceiling 200)

(def throttled-at 1000000)

(defn bucket-at-full-pace ()
  (->quota-bucket :ceiling ceiling
                  :slowed-to ceiling
                  :slowed-at 0
                  :throttled-at none
                  :available ceiling
                  :refilled-at 0))

(defn throttled-bucket ()
  (let (bucket (bucket-at-full-pace))
    (slowed-at! (mut bucket) throttled-at)
    bucket))

(deftest a-throttle-halves-the-pace
  (assert (= (pace-at (ref (throttled-bucket)) throttled-at)
             100)))

(deftest the-pace-recovers-a-tenth-of-the-ceiling-each-minute
  (assert (= (pace-at (ref (throttled-bucket))
                      (+ throttled-at 60000))
             120)))

(deftest the-pace-never-passes-the-ceiling
  (assert (= (pace-at (ref (throttled-bucket))
                      (+ throttled-at 3600000))
             ceiling)))

(deftest throttles-in-the-same-minute-halve-the-pace-once
  (let (bucket (throttled-bucket))
    (slowed-at! (mut bucket) (+ throttled-at 1000))
    (slowed-at! (mut bucket) (+ throttled-at 30000))
    (assert (= (pace-at (ref bucket) (+ throttled-at 30000))
               110))))

(deftest a-throttle-a-minute-later-halves-the-pace-again
  (let (bucket (throttled-bucket))
    (slowed-at! (mut bucket) (+ throttled-at 60000))
    (assert (= (pace-at (ref bucket) (+ throttled-at 60000))
               60))))

(deftest the-pace-never-drops-below-the-slowest-pace
  (let (bucket (->quota-bucket :ceiling 15
                               :slowed-to 15
                               :slowed-at 0
                               :throttled-at none
                               :available 15
                               :refilled-at 0))
    (slowed-at! (mut bucket) throttled-at)
    (assert (= (pace-at (ref bucket) throttled-at) 10))))
