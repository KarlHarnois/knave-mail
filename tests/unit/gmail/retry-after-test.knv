(use adapters/driven/gmail/throttling retry-wait-in)

(def five-past-four 1794931500000)

(deftest gmail-asks-to-wait-until-the-time-in-its-message
  (assert (= (retry-wait-in
               "User-rate limit exceeded. Retry after 2026-11-17T16:05:12.123Z"
               five-past-four)
             (some 12123))))

(deftest a-retry-time-without-milliseconds-is-read
  (assert (= (retry-wait-in "Retry after 2000-02-29T23:59:59Z"
                            951868798000)
             (some 1000))))

(deftest a-retry-time-already-past-asks-for-no-wait
  (assert (= (retry-wait-in "Retry after 2026-11-17T16:04:00.000Z"
                            five-past-four)
             (some 0))))

(deftest a-message-without-a-retry-time-asks-for-nothing
  (assert (= (retry-wait-in "Quota exceeded for quota metric 'Queries'"
                            five-past-four)
             none)))

(def twenty-six-past-five-past-four 1794931526000)

(deftest a-per-minute-quota-asks-to-wait-for-the-next-minute
  (assert (= (retry-wait-in "Quota exceeded for quota metric 'Total Query Cost' and limit 'Units per minute per user'"
                            twenty-six-past-five-past-four)
             (some 34500))))
