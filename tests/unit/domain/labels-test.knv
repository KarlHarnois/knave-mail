(use domain/labels apply-label-change archive-change read-change
                   star-change starred? trash-change unread-change
                   unread? unstar-change)

(defn labels (names)
  (collect (map (iter names) (fn (name) (str name)))))

(defn changed (names change)
  (apply-label-change (ref (labels names)) (ref change)))

(deftest archiving-removes-the-inbox-label
  (assert (= (changed (vec "INBOX" "UNREAD") (archive-change))
             (labels (vec "UNREAD")))))

(deftest trashing-moves-a-thread-from-the-inbox-to-the-trash
  (assert (= (changed (vec "INBOX") (trash-change)) (labels (vec "TRASH")))))

(deftest starring-adds-the-starred-label-once
  (assert (= (changed (vec "INBOX" "STARRED") (star-change))
             (labels (vec "INBOX" "STARRED")))))

(deftest unstarring-removes-the-starred-label
  (assert (= (changed (vec "STARRED" "INBOX") (unstar-change))
             (labels (vec "INBOX")))))

(deftest reading-removes-the-unread-label
  (assert (= (changed (vec "UNREAD") (read-change)) (the (vec string) (vec)))))

(deftest marking-unread-adds-the-unread-label
  (assert (= (changed (vec "INBOX") (unread-change))
             (labels (vec "INBOX" "UNREAD")))))

(deftest a-change-keeps-labels-it-does-not-name
  (assert (= (changed (vec "Receipts" "INBOX") (archive-change))
             (labels (vec "Receipts")))))

(deftest unread-threads-carry-the-unread-label
  (assert (unread? (ref (labels (vec "INBOX" "UNREAD"))))))

(deftest read-threads-lack-the-unread-label
  (assert (not (unread? (ref (labels (vec "INBOX")))))))

(deftest starred-threads-carry-the-starred-label
  (assert (starred? (ref (labels (vec "STARRED"))))))
