(use domain/timestamp milliseconds->utc-timestamp)

(deftest the-epoch-is-the-first-of-january-1970
  (assert (= (milliseconds->utc-timestamp 0)
             "1970-01-01T00:00:00.000Z")))

(deftest a-leap-day-is-written-with-milliseconds
  (assert (= (milliseconds->utc-timestamp 951868799123)
             "2000-02-29T23:59:59.123Z")))

(deftest a-date-this-century-is-written
  (assert (= (milliseconds->utc-timestamp 1794931512123)
             "2026-11-17T16:05:12.123Z")))
