(use domain/label-commands label-change-named)

(use domain/labels archive-change inbox-change read-change
                   untrash-change)

(deftest names-every-label-command
  (assert (= (label-change-named "move-to-inbox")
             (some (inbox-change))))
  (assert (= (label-change-named "untrash")
             (some (untrash-change))))
  (assert (= (label-change-named "archive")
             (some (archive-change))))
  (assert (= (label-change-named "mark-read")
             (some (read-change)))))

(deftest an-unknown-command-names-no-change
  (assert (= (label-change-named "explode") none)))
