(use domain/label-commands command-name->label-change)

(use domain/labels archive-change inbox-change read-change
                   untrash-change)

(deftest names-every-label-command
  (assert (= (command-name->label-change "move-to-inbox")
             (some (inbox-change))))
  (assert (= (command-name->label-change "untrash")
             (some (untrash-change))))
  (assert (= (command-name->label-change "archive")
             (some (archive-change))))
  (assert (= (command-name->label-change "mark-read")
             (some (read-change)))))

(deftest an-unknown-command-names-no-change
  (assert (= (command-name->label-change "explode") none)))
