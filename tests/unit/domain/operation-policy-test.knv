(use domain/labels archive-change)
(use domain/mail ->outgoing outgoing-thread)
(use domain/mail-error ->throttling mail-error)
(use domain/operation ->relabel-work operation-kind)

(use domain/failure-step backoff-after next-step
                         step-after-failure)

(use domain/operation-policy policy-of)

(defn network-failure ()
  (mail-error/network (str "connection reset")))

(defn relabel-kind ()
  (operation-kind/relabel (->relabel-work :thread-id (str "t")
                                          :change (archive-change)
                                          :queued-id none)))

(defn queued-relabel-kind ()
  (operation-kind/relabel (->relabel-work :thread-id (str "t")
                                          :change (archive-change)
                                          :queued-id (some 7))))

(deftest a-read-is-tried-three-times
  (assert (= (:most-attempts (policy-of (ref operation-kind/fetch-labels)))
             (some 3))))

(deftest a-relabel-is-tried-six-times
  (assert (= (:most-attempts (policy-of (ref (relabel-kind))))
             (some 6))))

(deftest an-operation-is-named-by-its-kind
  (assert (= (:name (policy-of (ref (relabel-kind))))
             "relabel")))

(deftest a-network-failure-is-retried-after-a-second
  (assert (= (step-after-failure 1
                                 (ref (policy-of (ref (relabel-kind))))
                                 (ref (network-failure)))
             (next-step/retry-after 1000))))

(deftest each-retry-waits-twice-as-long
  (assert (= (step-after-failure 2
                                 (ref (policy-of (ref (relabel-kind))))
                                 (ref (network-failure)))
             (next-step/retry-after 2000))))

(deftest the-last-attempt-stops
  (assert (= (step-after-failure 3
                                 (ref (policy-of (ref operation-kind/fetch-labels)))
                                 (ref (network-failure)))
             next-step/stop)))

(deftest a-missing-item-is-not-retried
  (assert (= (step-after-failure 1
                                 (ref (policy-of (ref (relabel-kind))))
                                 (ref (mail-error/not-found (str
                                                              "no thread t"))))
             next-step/stop)))

(defn throttled-for (milliseconds)
  (mail-error/throttled (->throttling :message (str "slow down")
                                      :retry-after-milliseconds milliseconds)))

(defn send-kind ()
  (operation-kind/send (->outgoing :from (str "ada@example.com")
                                   :to (vec)
                                   :cc (vec)
                                   :subject (str "")
                                   :body (str "")
                                   :thread outgoing-thread/new-thread)))

(deftest a-throttled-call-waits-as-long-as-gmail-asks
  (assert (= (step-after-failure 1
                                 (ref (policy-of (ref (relabel-kind))))
                                 (ref (throttled-for 7000)))
             (next-step/retry-after 7000))))

(deftest a-throttled-call-without-a-wait-backs-off
  (assert (= (step-after-failure 2
                                 (ref (policy-of (ref (relabel-kind))))
                                 (ref (throttled-for 0)))
             (next-step/retry-after 2000))))

(deftest a-throttled-send-is-retried
  (assert (= (step-after-failure 1
                                 (ref (policy-of (ref (send-kind))))
                                 (ref (throttled-for 0)))
             (next-step/retry-after 1000))))

(deftest a-send-that-failed-on-the-network-is-not-retried
  (assert (= (step-after-failure 1
                                 (ref (policy-of (ref (send-kind))))
                                 (ref (network-failure)))
             next-step/stop)))

(deftest the-wait-stops-growing-at-a-minute
  (assert (= (backoff-after 10) 60000)))

(deftest a-queued-relabel-keeps-trying
  (assert (= (step-after-failure 40
                                 (ref (policy-of (ref (queued-relabel-kind))))
                                 (ref (network-failure)))
             (next-step/retry-after 60000))))

(deftest a-queued-relabel-waits-for-a-new-sign-in
  (assert (= (step-after-failure 1
                                 (ref (policy-of (ref (queued-relabel-kind))))
                                 (ref (mail-error/auth-required (str "sign in again"))))
             (next-step/retry-after 1000))))

(deftest an-unqueued-relabel-gives-up-on-a-refused-sign-in
  (assert (= (step-after-failure 1
                                 (ref (policy-of (ref (relabel-kind))))
                                 (ref (mail-error/auth-required (str "sign in again"))))
             next-step/stop)))

(deftest a-read-gives-up-when-gmail-asks-for-a-long-wait
  (assert (= (step-after-failure 1
                                 (ref (policy-of (ref operation-kind/fetch-labels)))
                                 (ref (throttled-for 120000)))
             next-step/stop)))

(deftest a-queued-relabel-waits-as-long-as-gmail-asks
  (assert (= (step-after-failure 1
                                 (ref (policy-of (ref (queued-relabel-kind))))
                                 (ref (throttled-for 120000)))
             (next-step/retry-after 120000))))
