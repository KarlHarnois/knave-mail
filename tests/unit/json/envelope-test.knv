(use adapters/driving/json/commands answer!)
(use support/app-steps synced!)

(use support/memory-world app-over remote-with
                          sample-thread)

(defn remote ()
  (remote-with (vec (sample-thread "t-1" (vec "INBOX" "UNREAD") 100))))

(defn answered (request)
  (let (world (remote)
        app (app-over (ref world)))
    (synced! (mut app))
    (answer! (mut app) request)))

(deftest drafts-a-reply-to-the-sender-alone
  (assert (= (answered "{\"id\":13,\"command\":\"reply-draft\",\"args\":{\"account\":\"ada@example.com\",\"messageId\":\"m-t-1\"}}")
             "{\"id\":13,\"ok\":{\"body\":\"\\n\\nGrace <grace@example.com> wrote:\\n> Body of t-1\",\"cc\":[],\"replyTo\":\"m-t-1\",\"subject\":\"Re: Subject of t-1\",\"to\":[\"Grace <grace@example.com>\"]}}")))

(deftest moves-threads-back-to-the-inbox
  (assert (= (answered "{\"id\":10,\"command\":\"move-to-inbox\",\"args\":{\"account\":\"ada@example.com\",\"threadIds\":[\"t-1\"]}}")
             "{\"id\":10,\"ok\":{}}")))

(deftest reports-an-unknown-command-as-a-usage-error
  (assert (= (answered "{\"id\":7,\"command\":\"explode\",\"args\":{}}")
             "{\"error\":{\"kind\":\"usage\",\"message\":\"unknown command `explode`\"},\"id\":7}")))

(deftest reports-a-missing-argument-as-a-usage-error
  (assert (= (answered "{\"id\":8,\"command\":\"labels\",\"args\":{}}")
             "{\"error\":{\"kind\":\"usage\",\"message\":\"expected a string in `account`\"},\"id\":8}")))

(deftest reports-malformed-json-without-an-id
  (assert (= (answered "{nope")
             "{\"error\":{\"kind\":\"usage\",\"message\":\"key must be a string at line 1 column 2\"},\"id\":null}")))

(deftest reports-an-unreadable-date-as-a-usage-error
  (assert (= (answered "{\"id\":15,\"command\":\"archive-older\",\"args\":{\"account\":\"ada@example.com\",\"before\":\"last week\"}}")
             "{\"error\":{\"kind\":\"usage\",\"message\":\"expected a date like 2026/10/01 in `before`, not last week\"},\"id\":15}")))
