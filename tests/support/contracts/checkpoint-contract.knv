(use ports/driven/store load-checkpoint save-checkpoint!
                        store)

(export has-no-checkpoint-at-first!
        keeps-checkpoints-per-account!
        keeps-the-latest-checkpoint!)

(def account "ada@example.com")

(type has-no-checkpoint-at-first!
  (where ((cache store))
    (fn ((mut cache)) bool)))

(defn has-no-checkpoint-at-first! (cache)
  (= (unwrap-ok (load-checkpoint cache account)) none))

(defn keeps-the-latest-checkpoint! (cache)
  (unwrap-ok (save-checkpoint! cache account "100"))
  (unwrap-ok (save-checkpoint! cache account "250"))
  (= (unwrap-ok (load-checkpoint cache account))
     (some (str "250"))))

(defn keeps-checkpoints-per-account! (cache)
  (unwrap-ok (save-checkpoint! cache account "100"))
  (unwrap-ok (save-checkpoint! cache "other@example.com" "900"))
  (= (unwrap-ok (load-checkpoint cache account))
     (some (str "100"))))
