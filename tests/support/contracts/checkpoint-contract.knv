(use ports/driven/store load-checkpoint save-checkpoint!
                        store)

(export has-no-checkpoint-at-first!
        keeps-checkpoints-per-account!
        keeps-the-latest-checkpoint!)

(def account "ada@example.com")

(type has-no-checkpoint-at-first!
  (where ((kept store))
    (fn ((mut kept)) bool)))

(defn has-no-checkpoint-at-first! (kept)
  (= (unwrap-ok (load-checkpoint kept account)) none))

(defn keeps-the-latest-checkpoint! (kept)
  (unwrap-ok (save-checkpoint! kept account "100"))
  (unwrap-ok (save-checkpoint! kept account "250"))
  (= (unwrap-ok (load-checkpoint kept account))
     (some (str "250"))))

(defn keeps-checkpoints-per-account! (kept)
  (unwrap-ok (save-checkpoint! kept account "100"))
  (unwrap-ok (save-checkpoint! kept "other@example.com" "900"))
  (= (unwrap-ok (load-checkpoint kept account))
     (some (str "100"))))
