(use domain/label-scope label-scope)
(use domain/labels archive-change)
(use domain/mail ->thread-query ->thread-ref)
(use domain/summary summarize)

(use ports/driven/store load-summaries-of load-thread
                        load-threads relabel-stored!
                        save-thread! save-threads! store)

(use support/memory-world sample-thread)

(export aligns-cached-thread-labels! finds-summaries-by-id!
        keeps-message-ids!
        leaves-spam-and-trash-out-of-all-mail!
        relabels-a-summary-without-its-thread!)

(def account "ada@example.com")

(defn thread-of (thread-id)
  (->thread-ref :account (str account)
                :thread-id (str thread-id)))

(defn ids (cache scope)
  (-> (iter (unwrap-ok (load-threads cache account
                                     (ref (->thread-query scope (str "") 10)))))
      (map (fn (summary) (clone (:id summary))))
      collect))

(defn finds-summaries-by-id! (cache)
  (unwrap-ok
    (save-threads!
      cache account
      (ref (vec (unwrap (summarize (ref
                                     (sample-thread "t-1" (vec "INBOX") 100))))
                (unwrap (summarize
                          (ref (sample-thread "t-2" (vec "INBOX") 200))))))))
  (unwrap-ok (save-threads! cache "other@example.com"
                            (ref (vec (unwrap (summarize (ref (sample-thread
                                                                "t-3"
                                                                (vec "INBOX")
                                                                300))))))))
  (= (-> (iter (unwrap-ok (load-summaries-of cache account
                                             (ref (vec (str "t-2")
                                                       (str "t-3")
                                                       (str "t-9"))))))
         (map (fn (summary) (clone (:id summary))))
         collect)
     (vec (str "t-2"))))

(defn relabels-a-summary-without-its-thread! (cache)
  (unwrap-ok (save-threads! cache account
                            (ref (vec (unwrap (summarize (ref (sample-thread
                                                                "t-1"
                                                                (vec "INBOX")
                                                                100))))))))
  (unwrap-ok (relabel-stored! cache
                              (ref (thread-of "t-1"))
                              (ref (archive-change))))
  (empty? (ids cache (label-scope/only (str "INBOX")))))

(defn aligns-cached-thread-labels! (cache)
  (unwrap-ok (save-thread! cache account
                           (ref (sample-thread "t-1" (vec "INBOX") 100))))
  (unwrap-ok (save-threads! cache account
                            (ref (vec (unwrap (summarize (ref (sample-thread
                                                                "t-1"
                                                                (vec "INBOX"
                                                                     "UNREAD")
                                                                100))))))))
  (= (unwrap (unwrap-ok (load-thread cache (ref (thread-of "t-1")))))
     (sample-thread "t-1" (vec "INBOX" "UNREAD") 100)))

(defn keeps-message-ids! (cache)
  (unwrap-ok (save-threads! cache account
                            (ref (vec (unwrap (summarize (ref (sample-thread
                                                                "t-1"
                                                                (vec "INBOX")
                                                                100))))))))
  (= (-> (iter (unwrap-ok (load-summaries-of cache account
                                             (ref (vec (str "t-1"))))))
         (map (fn (summary)
                (clone (:message-ids summary))))
         collect)
     (vec (vec (str "m-t-1")))))

(defn leaves-spam-and-trash-out-of-all-mail! (cache)
  (unwrap-ok
    (save-threads!
      cache account
      (ref (vec
             (unwrap (summarize (ref (sample-thread "t-1" (vec "INBOX") 100))))
             (unwrap (summarize (ref (sample-thread "t-2" (vec "SPAM") 200))))
             (unwrap (summarize (ref
                                  (sample-thread "t-3" (vec "TRASH") 300))))))))
  (= (ids cache label-scope/all-mail)
     (vec (str "t-1"))))
