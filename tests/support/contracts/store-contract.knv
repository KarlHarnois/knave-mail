(use domain/label-scope label-scope)
(use domain/labels archive-change)
(use domain/mail ->account ->label ->thread-query)
(use domain/summary summarize)

(use ports/driven/store forget-account! forget-thread!
                        load-accounts load-labels
                        load-message load-thread
                        load-threads relabel-stored!
                        save-account! save-labels!
                        save-thread! save-threads! store)

(use support/memory-world sample-thread)

(export finds-messages! forgets-accounts! forgets-threads!
        keeps-accounts-once! keeps-labels-per-account!
        keeps-whole-threads! lists-label-newest-first!
        misses-unknown-threads!
        relabels-threads-and-summaries!)

(def account "ada@example.com")

(defn inbox ()
  (->thread-query (label-scope/only (str "INBOX"))
                  (str "")
                  10))

(type ids
  (where ((cache store))
    (fn ((ref cache)) (vec string))))

(defn ids (cache)
  (collect (map (iter (unwrap-ok (load-threads cache account (ref (inbox)))))
             (fn (summary) (clone (:id summary))))))

(defn keeps-accounts-once! (cache)
  (unwrap-ok (save-account! cache
                            (ref (->account (str account)))))
  (unwrap-ok (save-account! cache
                            (ref (->account (str account)))))
  (= (len (unwrap-ok (load-accounts cache)))
     1))

(defn forgets-accounts! (cache)
  (unwrap-ok (save-account! cache
                            (ref (->account (str account)))))
  (unwrap-ok (forget-account! cache account))
  (empty? (unwrap-ok (load-accounts cache))))

(defn keeps-labels-per-account! (cache)
  (unwrap-ok (save-labels! cache account
                           (ref (vec (->label (str "INBOX") (str "Inbox") 3)))))
  (unwrap-ok (save-labels! cache "other@example.com"
                           (ref (vec (->label (str "SENT") (str "Sent") 0)))))
  (= (unwrap-ok (load-labels cache account))
     (vec (->label (str "INBOX") (str "Inbox") 3))))

(defn lists-label-newest-first! (cache)
  (unwrap-ok
    (save-threads!
      cache account
      (ref (vec (summarize (ref (sample-thread "old" (vec "INBOX") 100)))
                (summarize (ref (sample-thread "new" (vec "INBOX") 300)))
                (summarize (ref (sample-thread "other" (vec "SENT") 200)))))))
  (= (ids cache)
     (vec (str "new") (str "old"))))

(defn keeps-whole-threads! (cache)
  (let (saved (sample-thread "t-1" (vec "INBOX" "UNREAD") 100))
    (unwrap-ok (save-thread! cache account (ref saved)))
    (= (unwrap-ok (load-thread cache account "t-1"))
       (some saved))))

(defn finds-messages! (cache)
  (unwrap-ok (save-thread! cache account
                           (ref (sample-thread "t-1" (vec "INBOX") 100))))
  (= (map-some (unwrap-ok (load-message cache account "m-t-1"))
       (fn (found) (clone (:text found))))
     (some (str "Body of t-1"))))

(type misses-unknown-threads!
  (where ((cache store))
    (fn ((mut cache)) bool)))

(defn misses-unknown-threads! (cache)
  (and (= (unwrap-ok (load-thread cache account "t-9")) none)
       (= (unwrap-ok (load-message cache account "m-9")) none)))

(defn relabels-threads-and-summaries! (cache)
  (let (saved (sample-thread "t-1" (vec "INBOX") 100))
    (unwrap-ok (save-thread! cache account (ref saved)))
    (unwrap-ok (save-threads! cache account
                              (ref (vec (summarize (ref saved))))))
    (unwrap-ok (relabel-stored! cache account "t-1" (ref (archive-change))))
    (and (empty? (ids cache))
         (empty? (:labels (unwrap (unwrap-ok
                                    (load-thread cache account "t-1"))))))))

(defn forgets-threads! (cache)
  (let (forgotten (sample-thread "t-1" (vec "INBOX") 100)
        kept-thread (sample-thread "t-2" (vec "INBOX") 200))
    (unwrap-ok (save-thread! cache account (ref forgotten)))
    (unwrap-ok (save-threads! cache account
                              (ref (vec (summarize (ref forgotten))
                                        (summarize (ref kept-thread))))))
    (unwrap-ok (forget-thread! cache account "t-1"))
    (and (= (ids cache) (vec (str "t-2")))
         (= (unwrap-ok (load-thread cache account "t-1")) none)
         (= (unwrap-ok (load-message cache account "m-t-1")) none))))
