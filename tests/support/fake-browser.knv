(use adapters/driven/google-oauth/consent-browser consent-browser)
(use domain/mail-error mail-error)

(export ->idle-browser browser-answering fake-browser
        idle-browser sharing-page shown-page)

(deftype shown-page-slot
  (rust "std::sync::Arc<std::sync::Mutex<Option<std::thread::JoinHandle<String>>>>"))

(defstruct fake-browser
  :stray-path string
  :answer string
  :page shown-page-slot)

(impl consent-browser fake-browser
  (open-url! (browser url)
    (ok (answer-in-background url browser))))

(defstruct idle-browser)

(impl consent-browser idle-browser
  (open-url! (browser url) (ok (do))))

(defn browser-answering (stray-path answer)
  (->fake-browser :stray-path (str stray-path)
                  :answer (str answer)
                  :page (empty-page-slot)))

(def empty-page-slot
  (rust "std::sync::Arc::new(std::sync::Mutex::new(None))"
    (fn () shown-page-slot)))

(def sharing-page
  (rust "crate::support::fake_browser::FakeBrowser {{ stray_path: {0}.stray_path.clone(), answer: {0}.answer.clone(), page: std::sync::Arc::clone(&{0}.page) }}"
    (fn ((ref fake-browser)) fake-browser)))

(def shown-page
  (rust "{0}.page.lock().expect(\"the page slot\").take().map(|{!handle}| {!handle}.join().unwrap_or_default()).unwrap_or_default()"
    (fn ((ref fake-browser)) string)))

(def answer-in-background
  (rust "{{ *{1}.page.lock().expect(\"the page slot\") = Some(native_testing::answer_in_background({0}, &{1}.stray_path, &{1}.answer)); }}"
    (fn ((ref str) (ref fake-browser)) unit)))
