(use adapters/driven/memory/shared handle share shared
                                   with-shared!)

(use ports/driven/link-opener link-opener)

(export new-recording-browser opened-links recording-opener)

(type new-recording-browser
  (fn () (shared (vec string))))

(defn new-recording-browser ()
  (share (vec)))

(type recording-opener
  (fn ((ref (shared (vec string))))
    link-opener))

(defn recording-opener (opened)
  (link-opener/recording (handle opened)))

(type opened-links
  (fn ((ref (shared (vec string))))
    (vec string)))

(defn opened-links (opened)
  (with-shared! opened
    (fn (links) (clone links))))
