(use domain/label-scope label-scope)
(use domain/freshness freshness)

(use adapters/driven/memory/remote-mail fail-times!
                                        fail-when!
                                        remote-mail
                                        throttle-times!)

(use adapters/driven/memory/shared shared with-shared!)
(use app/mail-app mail-app)

(use domain/mail ->message-ref ->thread-query ->thread-ref
                 outgoing thread thread-query
                 thread-summary)

(use domain/mail-error error-kind mail-error)
(use ports/driving/mail-reader list-threads!)
(use ports/driving/mail-syncer sync-account!)
(use support/memory-world world-account)

(export ada-message ada-thread fail-remote!
        fail-remote-times! failing-kind inbox-query
        listed-ids! remote-sent remote-thread synced!
        throttle-remote-times!)

(defn inbox-query ()
  (->thread-query (label-scope/only (str "INBOX"))
                  (str "")
                  50))

(defn ada-message (message-id)
  (->message-ref :account (str world-account)
                 :message-id (str message-id)))

(defn ada-thread (thread-id)
  (->thread-ref :account (str world-account)
                :thread-id (str thread-id)))

(defn synced! (app)
  (unwrap-ok (sync-account! app world-account)))

(defn listed-ids! (app query)
  (collect (map (iter (unwrap-ok (list-threads!
                                   app world-account query
                                   freshness/cached)))
                (fn (summary) (clone (:id summary))))))

(defn throttle-remote-times! (remote operation times delay)
  (with-shared! remote
    (fn (state) (throttle-times! state operation times delay))))

(defn fail-remote-times! (remote operation times)
  (with-shared! remote
    (fn (state) (fail-times! state operation times))))

(defn fail-remote! (remote operation)
  (with-shared! remote
    (fn (state)
      (fail-when! state (some (str operation))))))

(defn remote-sent (remote)
  (with-shared! remote
    (fn (state) (clone (:sent state)))))

(type remote-thread
  (fn ((ref (shared remote-mail)) (ref str))
    thread))

(defn remote-thread (remote thread-id)
  (with-shared! remote
    (fn (state)
      (clone (unwrap (find (iter (:threads state))
                       (fn (candidate)
                         (= (:id candidate) thread-id))))))))

(defn failing-kind (outcome)
  (str (error-kind (ref (unwrap-err outcome)))))
