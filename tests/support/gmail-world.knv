(use adapters/driven/gmail/http new-agent)
(use adapters/driven/gmail/quota full-bucket)

(use adapters/driven/gmail/mailbox ->gmail-mailbox
                                   gmail-mailbox)

(use adapters/driven/gmail/session-state ->gmail-endpoints
                                         ->gmail-session)

(use adapters/driven/memory/memory-log memory-log
                                       new-memory-log)

(use ports/driven/event-log event-log)

(use support/fake-gmail fake-gmail fake-gmail-base
                        start-fake-gmail)

(export fixture-routes gmail-logging gmail-over gmail-paced
        route)

(def fixtures "tests/fixtures/gmail/")

(defn route (request answer)
  (pair (str request) (str answer)))

(defn fixture-routes ()
  (vec (route "POST /token"
              (ref (str "200 " fixtures "token.json")))
       (route "GET /gmail/v1/users/me/profile"
              (ref (str "200 " fixtures "profile.json")))
       (route "GET /gmail/v1/users/me/labels"
              (ref (str "200 " fixtures "labels.json")))
       (route "GET /gmail/v1/users/me/labels/INBOX"
              (ref (str "200 " fixtures "label-inbox.json")))
       (route "GET /gmail/v1/users/me/labels/Label_1"
              (ref (str "200 " fixtures "label-receipts.json")))
       (route "GET /gmail/v1/users/me/threads?"
              (ref (str "200 " fixtures "threads-inbox.json")))
       (route "GET /gmail/v1/users/me/threads/t1?format=metadata"
              (ref (str "200 " fixtures "thread-t1-metadata.json")))
       (route "GET /gmail/v1/users/me/threads/t2?format=metadata"
              (ref (str "200 " fixtures "thread-t2-metadata.json")))
       (route "GET /gmail/v1/users/me/threads/t1?format=minimal"
              (ref (str "200 " fixtures "thread-t1-minimal.json")))
       (route "GET /gmail/v1/users/me/messages/m1"
              (ref (str "200 " fixtures "message-m1-raw.json")))
       (route "GET /gmail/v1/users/me/messages/m2"
              (ref (str "200 " fixtures "message-m2-raw.json")))
       (route "GET /gmail/v1/users/me/threads/t2?format=minimal"
              (ref (str "200 " fixtures "thread-t2-minimal.json")))
       (route "GET /gmail/v1/users/me/messages/m3"
              (ref (str "200 " fixtures "message-m3-raw.json")))
       (route "POST /gmail/v1/users/me/messages/send"
              (ref (str "200 " fixtures "sent.json")))
       (route "POST /gmail/v1/users/me/threads/t1/modify"
              (ref (str "200 " fixtures "empty.json")))))

(def unlimited-units-per-second 1000000)

(defn gmail-over (server)
  (gmail-paced server unlimited-units-per-second))

(defn gmail-paced (server units-per-second)
  (gmail-built server units-per-second (new-memory-log)))

(defn gmail-logging (server log)
  (gmail-built server unlimited-units-per-second log))

(type gmail-built
  (fn ((ref fake-gmail) i64 memory-log) gmail-mailbox))

(defn gmail-built (server units-per-second log)
  (let (base (fake-gmail-base server))
    (->gmail-mailbox (->gmail-session
                       :agent (new-agent)
                       :endpoints (->gmail-endpoints
                                    :api-base (clone base)
                                    :token-url (str base "/token")
                                    :client-id (str "fake-client")
                                    :client-secret (str "fake-secret")
                                    :quota-units-per-second units-per-second)
                       :refresh-token (str "fake-refresh")
                       :access-token none
                       :quota (full-bucket units-per-second)
                       :log (the (box event-log) (box log))))))
