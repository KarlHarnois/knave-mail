(use adapters/driven/memory/authorizer ->memory-authorizer)
(use adapters/driven/memory/provider ->memory-provider)

(use adapters/driven/memory/remote-mail ->remote-mail
                                        remote-mail)

(use adapters/driven/memory/shared handle share shared)
(use adapters/driven/memory/store)
(use adapters/driven/memory/memory-store empty-memory-store)

(use adapters/driven/memory/memory-log memory-log
                                       new-memory-log
                                       same-log)

(use adapters/driven/memory/memory-clock memory-clock
                                         new-memory-clock)

(use app/operations/inline-queue ->inline-queue)
(use app/operations/runner new-runner)
(use domain/operation priority)
(use ports/driven/clock clock)
(use ports/driven/operation-queue operation-queue)

(use app/mail-app ->mail-app ->sync-limits delivery
                  mail-app)

(use ports/driven/event-log event-log)

(use domain/mail ->account ->message ->thread account
                 message thread)

(use support/sample-mail addresses)

(export app-logging-to app-over app-timed-by remote-with
        sample-conversation sample-thread
        test-prefetch-limit world-account)

(def fake-patience-milliseconds 600000)

(def world-account "ada@example.com")

(defn sample-thread (id labels date)
  (->thread :id (str id)
            :subject (str "Subject of " id)
            :labels (addresses labels)
            :messages (vec (sample-message id (str "m-" id) date))))

(defn sample-conversation (id labels dates)
  (->thread :id (str id)
            :subject (str "Subject of " id)
            :labels (addresses labels)
            :messages (-> (iter dates)
                          enumerate
                          (map (fn (numbered)
                                 (let-match ((pair position date) numbered)
                                   (sample-message id
                                                   (str "m-" id "-" position)
                                                   (deref date)))))
                          collect)))

(defn sample-message (thread-id message-id date)
  (->message :id (str message-id)
             :thread-id (str thread-id)
             :from (str "Grace <grace@example.com>")
             :to (addresses (vec world-account))
             :cc (vec)
             :subject (str "Subject of " thread-id)
             :date date
             :text (str "Body of " thread-id)
             :html none
             :header-id (str "<" message-id "@example.com>")
             :references (str "")))

(defn remote-with (threads)
  (share (->remote-mail :threads threads
                        :sent (vec)
                        :latency-milliseconds 0
                        :clock clock/system
                        :failures none
                        :next-id 1
                        :history-id 1
                        :history-floor 0
                        :changes (vec))))

(defn app-over (remote)
  (app-logging-to remote (new-memory-log)))

(type app-logging-to
  (fn ((ref (shared remote-mail)) memory-log)
    mail-app))

(defn app-logging-to (remote log)
  (app-timed-by remote log (new-memory-clock)))

(type app-timed-by
  (fn ((ref (shared remote-mail)) memory-log memory-clock)
    mail-app))

(defn app-timed-by (remote log clock)
  (->mail-app
    :store (box (empty-memory-store))
    :operations (the (box operation-queue)
                     (box (->inline-queue
                            :runner (new-runner (box (->memory-provider
                                                       (vec (str world-account))
                                                       (vec (handle remote))))
                                                (clock/memory clock)
                                                (event-log/memory (same-log (ref
                                                                              log))))
                            :patience (some fake-patience-milliseconds))))
    :authorizer (box (->memory-authorizer (vec (->account (str "new@example.com")))))
    :log (event-log/memory log)
    :priority priority/interactive
    :delivery delivery/deliver-now
    :limits (->sync-limits :sync 50
                           :preview 25
                           :prefetch test-prefetch-limit)))

(def test-prefetch-limit 20)
