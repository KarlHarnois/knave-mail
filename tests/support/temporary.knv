(export temporary-path)

(def temporary-path
  (rust "{{ static {!counter}: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0); std::env::temp_dir().join(format!(\"knave-mail-test-{{}}-{{}}-{{}}\", std::process::id(), {!counter}.fetch_add(1, std::sync::atomic::Ordering::SeqCst), {0})).to_string_lossy().into_owned() }}"
    (fn ((ref str)) string)))
