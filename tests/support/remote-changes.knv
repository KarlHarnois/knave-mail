(use adapters/driven/memory/remote-history expire-history!
                                           record-change!
                                           record-relabel!)

(use adapters/driven/memory/remote-mail fail-when!
                                        remote-mail)

(use adapters/driven/memory/shared shared with-shared!)
(use domain/labels apply-label-change label-change)
(use domain/mail thread)

(export arrive-remotely! delete-remotely!
        expire-remote-history! heal-remote!
        relabel-remotely! surface-remotely!)

(type arrive-remotely!
  (fn ((ref (shared remote-mail)) thread)
    unit))

(defn arrive-remotely! (remote arrived)
  (with-shared! remote
    (fn (state)
      (let (thread-id (clone (:id arrived)))
        (push! (mut (:threads state)) arrived)
        (record-change! state (ref thread-id))))))

(defn expire-remote-history! (remote)
  (with-shared! remote
    (fn (state) (expire-history! state))))

(defn heal-remote! (remote)
  (with-shared! remote
    (fn (state) (fail-when! state none))))

(type surface-remotely!
  (fn ((ref (shared remote-mail)) thread)
    unit))

(defn surface-remotely! (remote surfaced)
  (with-shared! remote
    (fn (state)
      (push! (mut (:threads state)) surfaced))))

(type delete-remotely!
  (fn ((ref (shared remote-mail)) (ref str))
    unit))

(defn delete-remotely! (remote thread-id)
  (with-shared! remote
    (fn (state)
      (set! (:threads state)
            (collect (map (filter (iter (:threads state))
                            (fn (thread)
                              (not= (:id thread) thread-id)))
                          (fn (thread) (clone thread)))))
      (record-change! state thread-id))))

(type relabel-remotely!
  (fn ((ref (shared remote-mail))
       (ref str)
       label-change)
    unit))

(defn relabel-remotely! (remote thread-id change)
  (with-shared! remote
    (fn (state)
      (set! (:threads state)
            (collect (map (iter (:threads state))
                       (fn (held)
                         (if (= (:id held) thread-id)
                           (relabeled held (ref change))
                           (clone held))))))
      (record-relabel! state thread-id (ref change)))))

(type relabeled
  (fn ((ref thread) (ref label-change))
    thread))

(defn relabeled (held change)
  (assoc (clone held)
         :labels (apply-label-change (ref (:labels held)) change)))
