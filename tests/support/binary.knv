(defstruct binary-output
  :code i32
  :stdout string
  :stderr string)

(def binary-path "target/knave/knave-mail/knave-mail")

(export binary-output binary-path output-code output-stderr
        output-stdout run-binary)

(def run-binary
  (rust "{{ use std::io::Write; let mut {!child} = std::process::Command::new({0}).args({1}).env(\"KNAVE_MAIL_LOG_FILE\", std::env::temp_dir().join(format!(\"knave-mail-test-{{}}.log\", std::process::id()))).envs({2}.iter().map(|({!k}, {!v})| ({!k}.as_str(), {!v}.as_str()))).env_remove(\"KNAVE_MAIL_BACKEND\").stdin(std::process::Stdio::piped()).stdout(std::process::Stdio::piped()).stderr(std::process::Stdio::piped()).spawn().expect(\"run `knave build` before the e2e tests\"); {!child}.stdin.take().expect(\"stdin\").write_all({3}.as_bytes()).expect(\"write stdin\"); let {!output} = {!child}.wait_with_output().expect(\"the binary finishes\"); crate::support::binary::BinaryOutput {{ code: {!output}.status.code().unwrap_or(-1), stdout: String::from_utf8_lossy(&{!output}.stdout).into_owned(), stderr: String::from_utf8_lossy(&{!output}.stderr).into_owned() }} }}"
    (fn ((ref str)
         (ref (vec string))
         (ref (vec (pair string string)))
         (ref str))
      binary-output)))

(type output-code
  (fn ((ref binary-output)) i32))

(defn output-code (output) (:code output))

(type output-stdout
  (fn ((ref binary-output)) string))

(defn output-stdout (output)
  (clone (:stdout output)))

(type output-stderr
  (fn ((ref binary-output)) string))

(defn output-stderr (output)
  (clone (:stderr output)))
