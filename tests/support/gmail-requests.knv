(use domain/label-scope label-scope)
(use domain/mail ->thread-query thread-query)
(use domain/collections owned-items)
(use support/fake-gmail fake-gmail requests-seen)

(export inbox mime-header requests-matching sent-mime)

(defn inbox ()
  (->thread-query (label-scope/only (str "INBOX"))
                  (str "")
                  20))

(defn requests-matching (server prefix)
  (collect (filter (owned-items (requests-seen server))
             (fn (request) (starts-with? request prefix)))))

(def sent-mime
  (rust "{{ use base64::Engine; let {!body} = {0}.splitn(3, '\\n').nth(2).unwrap_or(\"\"); let {!json}: serde_json::Value = serde_json::from_str({!body}).unwrap_or_default(); let {!raw} = {!json}[\"raw\"].as_str().unwrap_or(\"\"); String::from_utf8_lossy(&base64::engine::general_purpose::URL_SAFE.decode({!raw}).unwrap_or_default()).into_owned() }}"
    (fn ((ref str)) string)))

(def mime-header
  (rust "{0}.lines().find_map(|{!line}| {!line}.split_once(':').filter(|({!name}, _)| {!name}.eq_ignore_ascii_case({1})).map(|(_, {!value})| {!value}.trim().to_string())).unwrap_or_default()"
    (fn ((ref str) (ref str)) string)))
