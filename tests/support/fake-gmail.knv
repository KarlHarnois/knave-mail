(export fake-gmail fake-gmail-base requests-seen start-fake-gmail)

(deftype fake-gmail (rust "(u16, std::sync::Arc<std::sync::Mutex<Vec<String>>>)"))

(def start-fake-gmail
  (rust "{{ let {!routes}: Vec<(String, u16, String)> = {0}.iter().map(|({!route}, {!answer})| {{ let ({!status}, {!file}) = {!answer}.split_once(' ').unwrap_or((\"200\", {!answer}.as_str())); ({!route}.clone(), {!status}.parse::<u16>().unwrap_or(200), {!file}.to_string()) }}).collect(); let {!listener} = std::net::TcpListener::bind(\"127.0.0.1:0\").expect(\"the fake Gmail server binds\"); let {!port} = {!listener}.local_addr().expect(\"a local address\").port(); let {!seen} = std::sync::Arc::new(std::sync::Mutex::new(Vec::<String>::new())); let {!recorder} = std::sync::Arc::clone(&{!seen}); std::thread::spawn(move || for {!stream} in {!listener}.incoming() {{ let Ok(mut {!stream}) = {!stream} else {{ continue }}; let {!routes} = {!routes}.clone(); let {!recorder} = std::sync::Arc::clone(&{!recorder}); std::thread::spawn(move || {{ use std::io::{{BufRead, Read, Write}}; let mut {!reader} = std::io::BufReader::new({!stream}.try_clone().expect(\"a stream clone\")); let mut {!line} = String::new(); if {!reader}.read_line(&mut {!line}).is_err() {{ return; }} let mut {!length} = 0usize; let mut {!authorization} = String::new(); loop {{ let mut {!header} = String::new(); if {!reader}.read_line(&mut {!header}).unwrap_or(0) == 0 || {!header}.trim().is_empty() {{ break; }} let {!lower} = {!header}.to_ascii_lowercase(); if let Some({!value}) = {!lower}.strip_prefix(\"content-length:\") {{ {!length} = {!value}.trim().parse().unwrap_or(0); }} if {!lower}.starts_with(\"authorization:\") {{ {!authorization} = {!header}.trim().to_string(); }} }} let mut {!body} = vec![0u8; {!length}]; let _ = {!reader}.read_exact(&mut {!body}); let {!request} = {!line}.split_whitespace().take(2).collect::<Vec<_>>().join(\" \"); {!recorder}.lock().expect(\"the request log\").push(format!(\"{{}}\\n{{}}\\n{{}}\", {!request}, {!authorization}, String::from_utf8_lossy(&{!body}))); let {!matched} = {!routes}.iter().filter(|({!route}, _, _)| {!request}.starts_with({!route}.as_str())).max_by_key(|({!route}, _, _)| {!route}.len()); let ({!status}, {!payload}) = match {!matched} {{ Some((_, {!status}, {!file})) => (*{!status}, std::fs::read_to_string({!file}).unwrap_or_else(|_| String::from(\"{{}}\"))), None => (404, String::from(\"{{\\\"error\\\":\\\"no route\\\"}}\")) }}; let _ = write!({!stream}, \"HTTP/1.1 {{}} OK\\r\\nContent-Type: application/json\\r\\nContent-Length: {{}}\\r\\nConnection: close\\r\\n\\r\\n{{}}\", {!status}, {!payload}.len(), {!payload}); }}); }}); ({!port}, {!seen}) }}"
    (fn ((ref (vec (pair string string)))) fake-gmail)))

(def fake-gmail-base
  (rust "format!(\"http://127.0.0.1:{{}}\", {0}.0)"
    (fn ((ref fake-gmail)) string)))

(def requests-seen
  (rust "{0}.1.lock().expect(\"the request log\").clone()"
    (fn ((ref fake-gmail)) (vec string))))
