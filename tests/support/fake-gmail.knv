(export fake-gmail fake-gmail-base requests-seen
        start-fake-gmail)

(deftype fake-gmail
  (rust "(u16, std::sync::Arc<std::sync::Mutex<Vec<String>>>)"))

(def start-fake-gmail
  (rust "native_testing::start_fake_gmail({0})"
    (fn ((ref (vec (pair string string))))
      fake-gmail)))

(def fake-gmail-base
  (rust "format!(\"http://127.0.0.1:{{}}\", {0}.0)"
    (fn ((ref fake-gmail)) string)))

(def requests-seen
  (rust "{0}.1.lock().expect(\"the request log\").clone()"
    (fn ((ref fake-gmail)) (vec string))))
