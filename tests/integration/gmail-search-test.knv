(use domain/label-scope label-scope)
(use adapters/driven/gmail/mailbox gmail-mailbox)
(use domain/mail ->thread-query)

(use ports/driven/mailbox fetch-summaries! fetch-thread-ids!
                          fetch-thread-page!)

(use support/fake-gmail start-fake-gmail)
(use support/gmail-requests requests-matching)
(use support/gmail-world fixture-routes gmail-over route)

(def metadata-request "GET /gmail/v1/users/me/threads/t")

(deftest listing-thread-ids-reads-no-thread
  (let (server (start-fake-gmail (ref (fixture-routes)))
        gmail (gmail-over (ref server)))
    (assert (= (unwrap-ok (fetch-thread-ids! (mut gmail)
                                             (ref (->thread-query
                                                    (label-scope/only (str "INBOX"))
                                                    (str "")
                                                    20))))
               (vec (str "t1") (str "t2"))))
    (assert (empty? (requests-matching (ref server) metadata-request)))))

(deftest fetching-summaries-reads-only-the-asked-threads
  (let (server (start-fake-gmail (ref (fixture-routes)))
        gmail (gmail-over (ref server)))
    (assert (= (len (unwrap-ok (fetch-summaries! (mut gmail)
                                                 (ref (vec (str "t2"))))))
               1))
    (assert (= (len (requests-matching (ref server) metadata-request))
               1))))

(def first-page-request
  "GET /gmail/v1/users/me/threads?maxResults=1&labelIds=INBOX")

(defn paged-routes ()
  (let (routes (fixture-routes))
    (push! (mut routes)
           (route first-page-request
                  "200 tests/fixtures/gmail/threads-page-1.json"))
    (push! (mut routes)
           (route (ref (str first-page-request "&pageToken=p2"))
                  "200 tests/fixtures/gmail/threads-page-2.json"))
    routes))

(deftest a-thread-page-returns-gmail-s-next-page-token
  (let (server (start-fake-gmail (ref (paged-routes)))
        gmail (gmail-over (ref server))
        page (unwrap-ok (fetch-thread-page!
                          (mut gmail)
                          (ref (->thread-query (label-scope/only (str "INBOX"))
                                               (str "")
                                               1))
                          "")))
    (assert (= (:ids page) (vec (str "t1"))))
    (assert (= (:next-token page) "p2"))))

(deftest the-next-page-is-asked-for-with-its-token
  (let (server (start-fake-gmail (ref (paged-routes)))
        gmail (gmail-over (ref server))
        page (unwrap-ok (fetch-thread-page!
                          (mut gmail)
                          (ref (->thread-query (label-scope/only (str "INBOX"))
                                               (str "")
                                               1))
                          "p2")))
    (assert (= (:ids page) (vec (str "t2"))))
    (assert (empty? (:next-token page)))))
