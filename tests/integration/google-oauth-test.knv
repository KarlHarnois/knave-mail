(use adapters/driven/file-credentials/credentials ->file-credentials)
(use adapters/driven/google-oauth/consent-browser consent-browser)
(use adapters/driven/gmail/http new-agent)

(use adapters/driven/google-oauth/authorizer ->google-authorizer
                                             google-authorizer)

(use adapters/driven/google-oauth/oauth-settings ->oauth-settings)
(use adapters/driven/google-oauth/pkce challenge-of)
(use domain/mail-error error-kind)
(use ports/driven/authorizer authorize!)
(use ports/driven/credentials load-token)

(use support/fake-browser ->idle-browser browser-answering
                          sharing-page shown-page)

(use support/fake-gmail fake-gmail fake-gmail-base
                        requests-seen start-fake-gmail)

(use support/gmail-world route)
(use support/temporary temporary-path)

(defn consent-server ()
  (start-fake-gmail (ref (vec
                           (route "POST /token"
                                  "200 tests/fixtures/gmail/consent-token.json")
                           (route "GET /gmail/v1/users/me/profile"
                                  "200 tests/fixtures/gmail/profile.json")))))

(defn authorizer-over (server credentials-path answer)
  (->google-authorizer :agent (new-agent)
                       :settings (settings-over server 5000)
                       :credentials (box (->file-credentials (str credentials-path)))
                       :browser (box (browser-answering "" answer))))

(defn authorizer-with (server browser wait)
  (->google-authorizer :agent (new-agent)
                       :settings (settings-over server wait)
                       :credentials (box (->file-credentials (temporary-path
                                                               "tokens.json")))
                       :browser browser))

(defn settings-over (server wait)
  (let (base (fake-gmail-base server))
    (->oauth-settings :auth-url (str base "/auth")
                      :token-url (str base "/token")
                      :api-base (clone base)
                      :client-id (str "fake-client")
                      :client-secret (str "fake-secret")
                      :sign-in-wait-milliseconds wait)))

(deftest consent-names-the-account-from-the-gmail-profile
  (let (server (consent-server)
        path (temporary-path "tokens.json")
        granting (authorizer-over (ref server) (ref path) "code=fake-code"))
    (assert (= (:email (unwrap-ok (authorize! (mut granting))))
               "ada@example.com"))))

(deftest consent-keeps-the-refresh-token
  (let (server (consent-server)
        path (temporary-path "tokens.json")
        granting (authorizer-over (ref server) (ref path) "code=fake-code")
        credentials (->file-credentials (clone path)))
    (unwrap-ok (authorize! (mut granting)))
    (assert (= (unwrap-ok (load-token (ref credentials) "ada@example.com"))
               (some (str "fake-refresh-token"))))))

(deftest the-code-exchange-proves-the-pkce-verifier
  (let (server (consent-server)
        path (temporary-path "tokens.json")
        granting (authorizer-over (ref server) (ref path) "code=fake-code"))
    (unwrap-ok (authorize! (mut granting)))
    (assert (contains? (at (requests-seen (ref server)) 0)
                       "code=fake-code"))
    (assert (contains? (at (requests-seen (ref server)) 0)
                       "code_verifier="))))

(deftest a-refused-consent-needs-authorization
  (let (server (consent-server)
        path (temporary-path "tokens.json")
        granting (authorizer-over (ref server)
                                  (ref path)
                                  "error=access_denied"))
    (assert (= (error-kind (ref (unwrap-err (authorize! (mut granting)))))
               "auth-required"))))

(deftest a-forged-state-is-rejected
  (let (server (consent-server)
        path (temporary-path "tokens.json")
        granting (authorizer-over (ref server)
                                  (ref path)
                                  "code=fake-code&wrong-state"))
    (assert (= (error-kind (ref (unwrap-err (authorize! (mut granting)))))
               "auth-required"))))

(deftest a-stray-request-does-not-end-the-sign-in
  (let (server (consent-server)
        granting (authorizer-with (ref server)
                                  (box (browser-answering "/favicon.ico"
                                                          "code=fake-code"))
                                  5000))
    (assert (ok? (ref (authorize! (mut granting)))))))

(deftest a-forged-state-shows-an-error-page
  (let (server (consent-server)
        browser (browser-answering "" "code=fake-code&wrong-state")
        granting (authorizer-with (ref server)
                                  (box (sharing-page (ref browser)))
                                  5000))
    (authorize! (mut granting))
    (assert (contains? (ref (shown-page (ref browser)))
                       "Sign-in failed"))))

(deftest a-malformed-escape-fails-the-sign-in-without-a-crash
  (let (server (consent-server)
        granting (authorizer-with (ref server)
                                  (box (browser-answering "/?state=%a\u{e9}x"
                                                          "code=fake-code"))
                                  5000))
    (assert (= (error-kind (ref (unwrap-err (authorize! (mut granting)))))
               "auth-required"))))

(deftest a-browser-that-never-answers-ends-the-sign-in
  (let (server (consent-server)
        granting (authorizer-with (ref server)
                                  (box (->idle-browser))
                                  200))
    (assert (= (error-kind (ref (unwrap-err (authorize! (mut granting)))))
               "auth-required"))))

(deftest a-pkce-challenge-is-the-hashed-verifier
  (assert (= (challenge-of "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk")
             "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM")))
