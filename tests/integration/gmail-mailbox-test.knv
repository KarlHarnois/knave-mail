(use adapters/driven/gmail/mailbox gmail-mailbox)
(use domain/labels archive-change)
(use domain/mail ->outgoing ->thread-query)
(use domain/mail-error error-kind)
(use ports/driven/mailbox deliver! fetch-labels! fetch-thread! fetch-threads!
                          relabel!)
(use support/fake-gmail requests-seen start-fake-gmail)
(use support/gmail-world fixture-routes gmail-over route)
(use support/sample-mail addresses)

(defn inbox () (->thread-query (str "INBOX") (str "") 20))

(defn requests-matching (server prefix)
  (collect (filter (into-iter (requests-seen server))
                   (fn (request) (starts-with? request prefix)))))

(def into-iter (rust "{0}.into_iter()" (fn ((vec string)) (iterator string))))

(def starts-with? (rust "{0}.starts_with({1})" (fn ((ref string) (ref str)) bool)))

(def contains? (rust "{0}.contains({1})" (fn ((ref str) (ref str)) bool)))

(deftest fetches-labels-with-unread-counts
  (let (server (start-fake-gmail (ref (fixture-routes))) gmail (gmail-over (ref server)))
    (assert (= (collect (map (iter (unwrap-ok (fetch-labels! (mut gmail))))
                             (fn (label) (str (:name label) " " (:unread label)))))
               (addresses (vec "INBOX 2" "Receipts 0"))))))

(deftest asks-google-for-an-access-token-first
  (let (server (start-fake-gmail (ref (fixture-routes))) gmail (gmail-over (ref server)))
    (unwrap-ok (fetch-labels! (mut gmail)))
    (assert (contains? (at (requests-seen (ref server)) 0) "refresh_token=fake-refresh"))))

(deftest sends-the-access-token-with-each-request
  (let (server (start-fake-gmail (ref (fixture-routes))) gmail (gmail-over (ref server)))
    (unwrap-ok (fetch-labels! (mut gmail)))
    (assert (contains? (at (requests-seen (ref server)) 1) "Bearer fake-access-token"))))

(deftest lists-a-label-with-its-query-and-limit
  (let (server (start-fake-gmail (ref (fixture-routes))) gmail (gmail-over (ref server)))
    (unwrap-ok (fetch-threads! (mut gmail) (ref (->thread-query (str "INBOX") (str "from:grace is:unread") 20))))
    (assert (= (len (requests-matching (ref server) "GET /gmail/v1/users/me/threads?maxResults=20&labelIds=INBOX&q=from%3Agrace%20is%3Aunread")) 1))))

(deftest all-mail-lists-without-a-label
  (let (server (start-fake-gmail (ref (fixture-routes))) gmail (gmail-over (ref server)))
    (unwrap-ok (fetch-threads! (mut gmail) (ref (->thread-query (str "ALL") (str "") 5))))
    (assert (= (len (requests-matching (ref server) "GET /gmail/v1/users/me/threads?maxResults=5\n")) 1))))

(deftest summarizes-threads-from-their-metadata
  (let (server (start-fake-gmail (ref (fixture-routes))) gmail (gmail-over (ref server))
        first-summary (at (unwrap-ok (fetch-threads! (mut gmail) (ref (inbox)))) 0))
    (assert (= (str (:subject first-summary) "|" (:participants first-summary) "|"
                    (:snippet first-summary) "|" (:date first-summary) "|" (:message-count first-summary))
               "Compiler meeting|Grace Hopper, ada@example.com|Sure & see you|1700000600000|2"))))

(deftest merges-the-labels-of-every-message
  (let (server (start-fake-gmail (ref (fixture-routes))) gmail (gmail-over (ref server)))
    (assert (= (:labels (at (unwrap-ok (fetch-threads! (mut gmail) (ref (inbox)))) 0))
               (addresses (vec "INBOX" "UNREAD" "SENT"))))))

(deftest unquotes-a-quoted-sender-name
  (let (server (start-fake-gmail (ref (fixture-routes))) gmail (gmail-over (ref server)))
    (assert (= (:participants (at (unwrap-ok (fetch-threads! (mut gmail) (ref (inbox)))) 1)) "Billing"))))

(deftest fetches-every-message-of-a-thread-in-order
  (let (server (start-fake-gmail (ref (fixture-routes))) gmail (gmail-over (ref server)))
    (assert (= (collect (map (iter (:messages (unwrap-ok (fetch-thread! (mut gmail) "t1"))))
                             (fn (message) (clone (:id message)))))
               (addresses (vec "m1" "m2"))))))

(deftest decodes-encoded-subjects-and-addresses
  (let (server (start-fake-gmail (ref (fixture-routes))) gmail (gmail-over (ref server))
        first-message (at (:messages (unwrap-ok (fetch-thread! (mut gmail) "t1"))) 0))
    (assert (= (str (:subject first-message) "|" (:from first-message) "|" (at (:to first-message) 1) "|" (at (:cc first-message) 0))
               "Compiler meeting — Tuesday|Grace Hopper <grace@example.com>|Alan Turing <alan@example.com>|edsger@example.com"))))

(deftest keeps-both-parts-of-an-alternative-message
  (let (server (start-fake-gmail (ref (fixture-routes))) gmail (gmail-over (ref server))
        first-message (at (:messages (unwrap-ok (fetch-thread! (mut gmail) "t1"))) 0))
    (assert (= (pair (clone (:text first-message)) (clone (:html first-message)))
               (pair (str "Can we meet Tuesday?\n\nGrace") (some (str "<p>Can we meet <b>Tuesday</b>?</p>")))))))

(deftest decodes-a-latin-one-quoted-printable-body
  (let (server (start-fake-gmail (ref (fixture-routes))) gmail (gmail-over (ref server))
        reply (at (:messages (unwrap-ok (fetch-thread! (mut gmail) "t1"))) 1))
    (assert (= (pair (clone (:text reply)) (clone (:html reply)))
               (pair (str "Sure, café at noon.\n") none)))))

(deftest keeps-the-threading-headers
  (let (server (start-fake-gmail (ref (fixture-routes))) gmail (gmail-over (ref server))
        reply (at (:messages (unwrap-ok (fetch-thread! (mut gmail) "t1"))) 1))
    (assert (= (str (:header-id reply) "|" (:references reply))
               "<m2@example.com>|<m0@example.com> <m1@example.com>"))))

(deftest sends-a-reply-as-raw-mime-in-its-thread
  (let (server (start-fake-gmail (ref (fixture-routes))) gmail (gmail-over (ref server)))
    (unwrap-ok (deliver! (mut gmail) (ref (->outgoing :from (str "ada@example.com")
                                                       :to (addresses (vec "Grace Hopper <grace@example.com>"))
                                                       :cc (vec) :subject (str "Re: Compiler meeting")
                                                       :body (str "Tuesday works.")
                                                       :thread-id (some (str "t1"))
                                                       :in-reply-to (some (str "<m1@example.com>"))
                                                       :references (str "<m0@example.com> <m1@example.com>")))))
    (assert (contains? (at (requests-matching (ref server) "POST /gmail/v1/users/me/messages/send") 0)
                       "\"threadId\":\"t1\""))))

(deftest relabels-a-thread-with-added-and-removed-labels
  (let (server (start-fake-gmail (ref (fixture-routes))) gmail (gmail-over (ref server)))
    (unwrap-ok (relabel! (mut gmail) "t1" (ref (archive-change))))
    (assert (contains? (at (requests-matching (ref server) "POST /gmail/v1/users/me/threads/t1/modify") 0)
                       "{\"addLabelIds\":[],\"removeLabelIds\":[\"INBOX\"]}"))))

(deftest a-missing-thread-is-not-found
  (let (server (start-fake-gmail (ref (fixture-routes))) gmail (gmail-over (ref server)))
    (assert (= (error-kind (ref (unwrap-err (fetch-thread! (mut gmail) "t9")))) "not-found"))))

(deftest a-refused-refresh-token-needs-authorization
  (let (server (start-fake-gmail (ref (vec (route "POST /token" "400 tests/fixtures/gmail/empty.json"))))
        gmail (gmail-over (ref server)))
    (assert (= (error-kind (ref (unwrap-err (fetch-labels! (mut gmail))))) "auth-required"))))

(deftest an-unavailable-gmail-is-a-network-error
  (let (server (start-fake-gmail (ref (vec (route "POST /token" "200 tests/fixtures/gmail/token.json")
                                           (route "GET /gmail" "503 tests/fixtures/gmail/empty.json"))))
        gmail (gmail-over (ref server)))
    (assert (= (error-kind (ref (unwrap-err (fetch-labels! (mut gmail))))) "network"))))
