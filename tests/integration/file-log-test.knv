(use ports/driven/clock clock)
(use adapters/driven/file-log/file-log open-file-log)
(use domain/level-spec text->level-spec)

(defn levels (text)
  (unwrap-ok (text->level-spec text)))

(use domain/log-entry ->log-entry log-area log-level)
(use ports/driven/event-log event-log record!)
(use support/temporary temporary-path)

(defn read-file (path)
  (match (slurp path)
    ((ok text) text)
    ((err _) (str ""))))

(def write-bytes
  (rust "{{ let _ = std::fs::write({0}, vec![b'x'; {1}]); }}"
    (fn ((ref str) usize) unit)))

(def exists?
  (rust "std::path::Path::new({0}).exists()"
    (fn ((ref str)) bool)))

(type line-count (fn ((ref str)) usize))

(defn line-count (text)
  (count (lines text)))

(defn record-at! (log entry)
  (record! (ref log) (ref entry)))

(deftest writes-one-timestamped-line-per-entry
  (let (path (temporary-path "one-line-per-entry.log")
        log (event-log/file
              (open-file-log (ref path) (levels "info") clock/system)))
    (record-at! log
                (->log-entry log-level/info log-area/gmail
                             (str "GET /labels 200 12ms")))
    (let (written (read-file (ref path)))
      (assert (contains? (ref written)
                         "INFO  gmail    GET /labels 200 12ms\n"))
      (assert (contains? (ref written) "Z ")))))

(deftest drops-entries-below-the-level
  (let (path (temporary-path "below-level.log")
        log (event-log/file
              (open-file-log (ref path) (levels "info") clock/system)))
    (record-at! log
                (->log-entry log-level/debug log-area/gmail (str "hidden")))
    (record-at! log
                (->log-entry log-level/warn log-area/gmail (str "shown")))
    (assert (= (line-count (ref (read-file (ref path))))
               1))))

(deftest an-area-can-log-more-than-the-default
  (let (path (temporary-path "area-level.log")
        log (event-log/file (open-file-log (ref path)
                                           (levels "warn,gmail=debug")
                                           clock/system)))
    (record-at! log
                (->log-entry log-level/debug log-area/gmail (str "request")))
    (record-at! log
                (->log-entry log-level/info log-area/sync (str "dropped")))
    (assert (= (line-count (ref (read-file (ref path))))
               1))))

(deftest keeps-each-entry-on-one-line
  (let (path (temporary-path "single-line.log")
        log (event-log/file
              (open-file-log (ref path) (levels "info") clock/system)))
    (record-at! log
                (->log-entry log-level/error
                             log-area/frontend
                             (str "first\nsecond")))
    (assert (= (line-count (ref (read-file (ref path))))
               1))))

(deftest rotates-a-large-log-when-opened
  (let (path (temporary-path "rotation.log"))
    (write-bytes (ref path) 5000001)
    (let (log (event-log/file
                (open-file-log (ref path) (levels "info") clock/system)))
      (record-at! log
                  (->log-entry log-level/info log-area/app (str "fresh")))
      (assert (exists? (ref (str path ".1"))))
      (assert (= (line-count (ref (read-file (ref path))))
                 1)))))
