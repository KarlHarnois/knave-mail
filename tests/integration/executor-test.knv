(use adapters/driven/threaded-queue threaded-operations)
(use composition/operation-executor start-gmail-executor)
(use adapters/driving/cli/arguments parse-arguments)
(use composition/settings arguments->settings settings)

(use domain/operation operation-kind operation-result
                      priority)

(use ports/driven/operation-queue submit!)
(use support/cli-world signed-in-tokens)

(use support/fake-gmail fake-gmail fake-gmail-base
                        start-fake-gmail)

(use support/gmail-world fixture-routes)
(use support/temporary temporary-path)

(defn settings-over (server tokens)
  (let (base (fake-gmail-base server))
    (unwrap-ok (arguments->settings (ref (unwrap-ok (parse-arguments
                                                      (ref (vec
                                                             (str "--gmail-base-url")
                                                             (clone base)
                                                             (str "--token-url")
                                                             (str base "/token")
                                                             (str "--client-id")
                                                             (str "fake-client")
                                                             (str "--client-secret")
                                                             (str "fake-secret")
                                                             (str "--credentials-file")
                                                             tokens
                                                             (str "--log-file")
                                                             (temporary-path "executor.log"))))))))))

(deftest the-executor-answers-an-operation-submitted-from-another-thread
  (let (server (start-fake-gmail (ref (fixture-routes)))
        chosen (settings-over (ref server) (signed-in-tokens))
        client (unwrap (clone (:google-client chosen)))
        executor (start-gmail-executor chosen client)
        queue (threaded-operations (ref executor)))
    (local asking queue)
    (assert (match (submit! (mut asking)
                            "ada@example.com"
                            operation-kind/fetch-labels
                            priority/interactive)
              ((ok (labels-fetched labels)) (not (empty? labels)))
              (_ false)))))
