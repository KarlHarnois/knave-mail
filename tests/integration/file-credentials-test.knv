(use adapters/driven/file-credentials/credentials ->file-credentials)
(use domain/mail-error error-kind)

(use ports/driven/credentials forget-token! load-token
                              save-token!)

(use support/temporary temporary-path)

(def file-mode
  (rust "{{ use std::os::unix::fs::PermissionsExt; std::fs::metadata({0}).map(|{!metadata}| {!metadata}.permissions().mode() & 0o777).unwrap_or(0) }}"
    (fn ((ref str)) u32)))

(def write-file
  (rust "std::fs::write({0}, {1}).expect(\"the test file is written\")"
    (fn ((ref str) (ref str)) unit)))

(def owner-only-mode 384)

(deftest the-credentials-file-is-readable-only-by-its-owner
  (let (path (temporary-path "tokens.json")
        credentials (->file-credentials (clone path)))
    (local kept credentials)
    (unwrap-ok (save-token! (mut kept) "ada@example.com" "fake-refresh"))
    (assert (= (file-mode (ref path)) owner-only-mode))))

(deftest saving-a-token-keeps-the-other-accounts
  (let (path (temporary-path "tokens.json")
        credentials (->file-credentials (clone path)))
    (local kept credentials)
    (unwrap-ok (save-token! (mut kept) "ada@example.com" "ada-refresh"))
    (unwrap-ok (save-token! (mut kept) "grace@example.com" "grace-refresh"))
    (assert (= (unwrap-ok (load-token (ref kept) "ada@example.com"))
               (some (str "ada-refresh"))))))

(deftest forgetting-a-token-keeps-the-other-accounts
  (let (path (temporary-path "tokens.json")
        credentials (->file-credentials (clone path)))
    (local kept credentials)
    (unwrap-ok (save-token! (mut kept) "ada@example.com" "ada-refresh"))
    (unwrap-ok (save-token! (mut kept) "grace@example.com" "grace-refresh"))
    (unwrap-ok (forget-token! (mut kept) "ada@example.com"))
    (assert (= (unwrap-ok (load-token (ref kept) "grace@example.com"))
               (some (str "grace-refresh"))))))

(deftest a-corrupt-file-refuses-the-save
  (let (path (temporary-path "tokens.json")
        credentials (->file-credentials (clone path)))
    (write-file (ref path) "{\"ada@example.com\": ")
    (local kept credentials)
    (assert (= (error-kind (ref (unwrap-err (save-token! (mut kept)
                                                         "grace@example.com"
                                                         "grace-refresh"))))
               "auth-required"))))

(deftest a-corrupt-file-is-left-as-it-was
  (let (path (temporary-path "tokens.json")
        credentials (->file-credentials (clone path)))
    (write-file (ref path) "{\"ada@example.com\": ")
    (local kept credentials)
    (save-token! (mut kept) "grace@example.com" "grace-refresh")
    (assert (= (unwrap-ok (slurp (ref path)))
               "{\"ada@example.com\": "))))
