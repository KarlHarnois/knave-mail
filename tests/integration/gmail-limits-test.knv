(use domain/label-scope label-scope)
(use adapters/driven/gmail/mailbox gmail-mailbox)
(use domain/mail-error error-kind mail-error)
(use domain/mail ->thread-query)
(use ports/driven/mailbox fetch-labels! fetch-threads!)
(use support/fake-gmail start-fake-gmail)
(use support/gmail-requests requests-matching)
(use support/truncating-gmail start-truncating-gmail)

(use support/trickling-server start-trickling-server
                              trickled-body)

(use adapters/driven/gmail/http agent-with-timeouts
                                http-get)

(use support/gmail-world fixture-routes gmail-over
                         gmail-paced route)

(use adapters/clock clock-milliseconds)

(def labels-request "GET /gmail/v1/users/me/labels")

(defn routes-answering-labels-with (answer)
  (let (routes (fixture-routes))
    (push! (mut routes) (route labels-request answer))
    routes))

(deftest a-rate-limited-request-is-throttled-at-once
  (let (server (start-fake-gmail (ref (routes-answering-labels-with "403 tests/fixtures/gmail/rate-limited.json")))
        gmail (gmail-over (ref server)))
    (assert (= (str (error-kind (ref (unwrap-err (fetch-labels! (mut gmail))))))
               "throttled"))
    (assert (= (len (requests-matching (ref server) labels-request))
               1))))

(deftest a-throttled-request-carries-the-wait-gmail-asks-for
  (let (server (start-fake-gmail (ref (routes-answering-labels-with "429 tests/fixtures/gmail/rate-limited.json")))
        gmail (gmail-over (ref server)))
    (assert (= (match (unwrap-err (fetch-labels! (mut gmail)))
                 ((throttled throttle) (:retry-after-milliseconds throttle))
                 (_ 0))
               2000))))

(deftest a-used-up-daily-limit-is-a-network-error
  (let (server (start-fake-gmail (ref (routes-answering-labels-with "403 tests/fixtures/gmail/daily-limit.json")))
        gmail (gmail-over (ref server)))
    (assert (= (str (error-kind (ref (unwrap-err (fetch-labels! (mut gmail))))))
               "network"))))

(deftest a-used-up-quota-is-a-network-error
  (let (server (start-fake-gmail (ref (routes-answering-labels-with "403 tests/fixtures/gmail/quota-exceeded.json")))
        gmail (gmail-over (ref server)))
    (assert (= (str (error-kind (ref (unwrap-err (fetch-labels! (mut gmail))))))
               "network"))))

(deftest a-forbidden-request-asks-to-sign-in-again
  (let (server (start-fake-gmail (ref (routes-answering-labels-with "403 tests/fixtures/gmail/forbidden.json")))
        gmail (gmail-over (ref server)))
    (assert (= (str (error-kind (ref (unwrap-err (fetch-labels! (mut gmail))))))
               "auth-required"))
    (assert (= (len (requests-matching (ref server) labels-request))
               1))))

(deftest reads-wait-for-the-quota-to-refill
  (let (server (start-fake-gmail (ref (fixture-routes)))
        gmail (gmail-paced (ref server) 20)
        query (->thread-query (label-scope/only (str "INBOX"))
                              (str "")
                              20)
        started (clock-milliseconds))
    (unwrap-ok (fetch-threads! (mut gmail) (ref query)))
    (assert (>= (- (clock-milliseconds) started) 400))))

(deftest a-truncated-answer-is-a-network-error
  (let (server (start-truncating-gmail)
        gmail (gmail-over (ref server)))
    (assert (= (str (error-kind (ref (unwrap-err (fetch-labels! (mut gmail))))))
               "network"))))

(deftest a-slow-answer-that-keeps-arriving-is-read-in-full
  (let (base (start-trickling-server 60 trickled-body)
        reply (http-get (ref (agent-with-timeouts 1000 300))
                        (ref (str base "/gmail/v1/users/me/labels"))
                        "fake-access"))
    (assert (= (:body (unwrap-ok reply)) trickled-body))))
