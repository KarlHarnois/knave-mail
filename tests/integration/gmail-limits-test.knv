(use adapters/driven/gmail/mailbox gmail-mailbox)
(use domain/mail-error error-kind)
(use domain/mail ->thread-query)
(use ports/driven/mailbox fetch-labels! fetch-threads!)
(use support/fake-gmail start-fake-gmail)
(use support/gmail-requests requests-matching)

(use support/gmail-world fixture-routes gmail-over
                         gmail-paced route)

(def labels-request "GET /gmail/v1/users/me/labels")

(type routes-answering-labels-with
  (fn ((ref str))
    (vec (pair string string))))

(defn routes-answering-labels-with (answer)
  (let (routes (fixture-routes))
    (push! (mut routes) (route labels-request answer))
    routes))

(deftest a-rate-limited-request-is-retried-before-failing
  (let (server (start-fake-gmail (ref (routes-answering-labels-with "403 tests/fixtures/gmail/rate-limited.json")))
        gmail (gmail-over (ref server)))
    (fetch-labels! (mut gmail))
    (assert (= (len (requests-matching (ref server) labels-request))
               7))))

(deftest a-rate-limit-that-outlasts-the-retries-is-a-network-error
  (let (server (start-fake-gmail (ref (routes-answering-labels-with "429 tests/fixtures/gmail/rate-limited.json")))
        gmail (gmail-over (ref server)))
    (assert (= (str (error-kind (ref (unwrap-err (fetch-labels! (mut gmail))))))
               "network"))))

(deftest a-forbidden-request-asks-to-sign-in-again
  (let (server (start-fake-gmail (ref (routes-answering-labels-with "403 tests/fixtures/gmail/forbidden.json")))
        gmail (gmail-over (ref server)))
    (assert (= (str (error-kind (ref (unwrap-err (fetch-labels! (mut gmail))))))
               "auth-required"))
    (assert (= (len (requests-matching (ref server) labels-request))
               1))))

(def clock-milliseconds
  (rust "std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|{!elapsed}| {!elapsed}.as_millis() as u64).unwrap_or(0)"
    (fn () u64)))

(deftest reads-are-spaced-to-stay-under-the-rate-limit
  (let (server (start-fake-gmail (ref (fixture-routes)))
        gmail (gmail-paced (ref server) 100)
        query (->thread-query (str "INBOX") (str "") 20)
        started (clock-milliseconds))
    (unwrap-ok (fetch-threads! (mut gmail) (ref query)))
    (assert (>= (- (clock-milliseconds) started) 300))))
