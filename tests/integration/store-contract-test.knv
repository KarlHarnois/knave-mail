(use adapters/driven/memory/store empty-memory-store)
(use adapters/driven/sqlite/store open-sqlite-store)

(use support/contracts/store-contract finds-messages!
                                      forgets-accounts!
                                      forgets-threads!
                                      keeps-accounts-once!
                                      keeps-labels-per-account!
                                      keeps-whole-threads!
                                      lists-label-newest-first!
                                      misses-unknown-threads!
                                      relabels-threads-and-summaries!)

(use support/contracts/summary-contract aligns-cached-thread-labels!
                                        finds-summaries-by-id!
                                        relabels-a-summary-without-its-thread!)

(use support/temporary temporary-path)

(defn sqlite ()
  (unwrap-ok (open-sqlite-store (ref (temporary-path "cache.sqlite3")))))

(deftest memory-store-keeps-accounts-once
  (let (kept (empty-memory-store))
    (assert (keeps-accounts-once! (mut kept)))))

(deftest sqlite-store-keeps-accounts-once
  (let (kept (sqlite))
    (assert (keeps-accounts-once! (mut kept)))))

(deftest memory-store-forgets-accounts
  (let (kept (empty-memory-store))
    (assert (forgets-accounts! (mut kept)))))

(deftest sqlite-store-forgets-accounts
  (let (kept (sqlite))
    (assert (forgets-accounts! (mut kept)))))

(deftest memory-store-forgets-threads
  (let (kept (empty-memory-store))
    (assert (forgets-threads! (mut kept)))))

(deftest sqlite-store-forgets-threads
  (let (kept (sqlite))
    (assert (forgets-threads! (mut kept)))))

(deftest memory-store-keeps-labels-per-account
  (let (kept (empty-memory-store))
    (assert (keeps-labels-per-account! (mut kept)))))

(deftest sqlite-store-keeps-labels-per-account
  (let (kept (sqlite))
    (assert (keeps-labels-per-account! (mut kept)))))

(deftest memory-store-lists-a-label-newest-first
  (let (kept (empty-memory-store))
    (assert (lists-label-newest-first! (mut kept)))))

(deftest sqlite-store-lists-a-label-newest-first
  (let (kept (sqlite))
    (assert (lists-label-newest-first! (mut kept)))))

(deftest memory-store-keeps-whole-threads
  (let (kept (empty-memory-store))
    (assert (keeps-whole-threads! (mut kept)))))

(deftest sqlite-store-keeps-whole-threads
  (let (kept (sqlite))
    (assert (keeps-whole-threads! (mut kept)))))

(deftest memory-store-finds-messages
  (let (kept (empty-memory-store))
    (assert (finds-messages! (mut kept)))))

(deftest sqlite-store-finds-messages
  (let (kept (sqlite))
    (assert (finds-messages! (mut kept)))))

(deftest memory-store-misses-unknown-threads
  (let (kept (empty-memory-store))
    (assert (misses-unknown-threads! (mut kept)))))

(deftest sqlite-store-misses-unknown-threads
  (let (kept (sqlite))
    (assert (misses-unknown-threads! (mut kept)))))

(deftest memory-store-relabels-threads-and-summaries
  (let (kept (empty-memory-store))
    (assert (relabels-threads-and-summaries! (mut kept)))))

(deftest sqlite-store-relabels-threads-and-summaries
  (let (kept (sqlite))
    (assert (relabels-threads-and-summaries! (mut kept)))))

(deftest memory-store-relabels-a-summary-without-its-thread
  (let (kept (empty-memory-store))
    (assert (relabels-a-summary-without-its-thread! (mut kept)))))

(deftest sqlite-store-relabels-a-summary-without-its-thread
  (let (kept (sqlite))
    (assert (relabels-a-summary-without-its-thread! (mut kept)))))

(deftest memory-store-finds-summaries-by-id
  (let (kept (empty-memory-store))
    (assert (finds-summaries-by-id! (mut kept)))))

(deftest sqlite-store-finds-summaries-by-id
  (let (kept (sqlite))
    (assert (finds-summaries-by-id! (mut kept)))))

(deftest memory-store-aligns-cached-thread-labels-with-saved-summaries
  (let (kept (empty-memory-store))
    (assert (aligns-cached-thread-labels! (mut kept)))))

(deftest sqlite-store-aligns-cached-thread-labels-with-saved-summaries
  (let (kept (sqlite))
    (assert (aligns-cached-thread-labels! (mut kept)))))
