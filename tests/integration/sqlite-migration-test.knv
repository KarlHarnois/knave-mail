(use adapters/driven/sqlite/store open-sqlite-store)
(use domain/summary summarize)
(use ports/driven/store load-summaries-of save-threads!)
(use support/memory-world sample-thread)
(use support/temporary temporary-path)

(def summaries-before-message-ids
  "CREATE TABLE summaries (account TEXT NOT NULL, id TEXT NOT NULL, subject TEXT NOT NULL, participants TEXT NOT NULL, snippet TEXT NOT NULL, date INTEGER NOT NULL, labels TEXT NOT NULL, message_count INTEGER NOT NULL, PRIMARY KEY (account, id)); INSERT INTO summaries VALUES ('ada@example.com', 't-0', 'Old', 'Grace', '', 1, '[\"INBOX\"]', 1);")

(def cache-made-with
  (rust "rusqlite::Connection::open({0}).and_then(|{!connection}| {!connection}.execute_batch({1})).expect(\"the old cache is written\")"
    (fn ((ref str) (ref str)) unit)))

(deftest an-older-cache-gains-message-ids-and-keeps-its-summaries
  (let (path (temporary-path "old-cache.sqlite3"))
    (cache-made-with (as-str path) summaries-before-message-ids)
    (let (cache (unwrap-ok (open-sqlite-store (ref path))))
      (local opened cache)
      (unwrap-ok (save-threads! (mut opened)
                                "ada@example.com"
                                (ref (vec (summarize (ref (sample-thread
                                                            "t-1"
                                                            (vec "INBOX")
                                                            100)))))))
      (let (found (unwrap-ok (load-summaries-of (ref opened)
                                                "ada@example.com"
                                                (ref (vec (str "t-0")
                                                          (str "t-1"))))))
        (assert (= (collect (map (iter found)
                              (fn (summary)
                                (clone (:message-ids summary)))))
                   (vec (vec) (vec (str "m-t-1")))))))))
