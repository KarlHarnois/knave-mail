(use support/binary binary-path output-code output-stderr
                    output-stdout run-binary)

(use support/cli-world cli-environment gmail-cli
                       last-request signed-in-tokens)

(use support/fake-gmail start-fake-gmail)
(use support/gmail-requests requests-matching)
(use support/gmail-world fixture-routes)
(use support/sample-mail addresses)
(use support/temporary temporary-path)

(deftest sends-a-reply-with-the-body-from-standard-input
  (let (server (start-fake-gmail (ref (fixture-routes)))
        cache (temporary-path "cache.sqlite3")
        tokens (signed-in-tokens))
    (gmail-cli (ref (cli-environment (ref server)
                                     (ref cache)
                                     (ref tokens)))
               (vec "sync")
               "")
    (assert (zero? (output-code (ref (gmail-cli (ref (cli-environment
                                                       (ref server)
                                                       (ref cache)
                                                       (ref tokens)))
                                                (vec "reply" "m1")
                                                "Tuesday works.\n")))))
    (assert (contains? (at (requests-matching
                             (ref server)
                             "POST /gmail/v1/users/me/messages/send")
                           0)
                       "\"threadId\":\"t1\""))))

(deftest a-dry-run-sends-nothing
  (let (server (start-fake-gmail (ref (fixture-routes)))
        cache (temporary-path "cache.sqlite3")
        tokens (signed-in-tokens))
    (gmail-cli (ref (cli-environment (ref server)
                                     (ref cache)
                                     (ref tokens)))
               (vec "sync")
               "")
    (let (output (gmail-cli (ref (cli-environment (ref server)
                                                  (ref cache)
                                                  (ref tokens)))
                            (vec "reply" "m1" "--dry-run")
                            "Tuesday works.\n"))
      (assert (contains? (ref (output-stdout (ref output)))
                         "Subject: Re: Compiler meeting — Tuesday"))
      (assert (not (contains? (ref (last-request (ref server)))
                              "messages/send"))))))

(deftest archives-a-thread-remotely
  (let (server (start-fake-gmail (ref (fixture-routes)))
        cache (temporary-path "cache.sqlite3")
        tokens (signed-in-tokens))
    (gmail-cli (ref (cli-environment (ref server)
                                     (ref cache)
                                     (ref tokens)))
               (vec "sync")
               "")
    (gmail-cli (ref (cli-environment (ref server)
                                     (ref cache)
                                     (ref tokens)))
               (vec "archive" "t1")
               "")
    (assert (contains? (ref (last-request (ref server)))
                       "POST /gmail/v1/users/me/threads/t1/modify"))))
